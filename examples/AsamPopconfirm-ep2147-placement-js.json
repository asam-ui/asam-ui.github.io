ult\">右侧</AsamButton>\n\t\t\t\t</template>\n\t\t\t</AsamPopconfirm>\n\t\t</div>\n\t\t<div class=\"row demo-layout-5\">\n\t\t\t<AsamPopconfirm class=\"box-item\" title=\"左下方显示提示\" placement=\"left-end\">\n\t\t\t\t<template #reference>\n\t\t\t\t\t<AsamButton type=\"default\">左侧底部</AsamButton>\n\t\t\t\t</template>\n\t\t\t</AsamPopconfirm>\n\t\t\t<AsamPopconfirm class=\"box-item\" title=\"右下方显示提示\" placement=\"right-end\">\n\t\t\t\t<template #reference>\n\t\t\t\t\t<AsamButton type=\"default\">右侧底部</AsamButton>\n\t\t\t\t</template>\n\t\t\t</AsamPopconfirm>\n\t\t</div>\n\t\t<div class=\"row center demo-layout-6\">\n\t\t\t<AsamPopconfirm class=\"box-item\" title=\"左下方显示提示\" placement=\"bottom-start\">\n\t\t\t\t<template #reference> <AsamButton type=\"default\">底部左侧</AsamButton></template>\n\t\t\t</AsamPopconfirm>\n\t\t\t<AsamPopconfirm class=\"box-item\" title=\"底部居中显示提示\" placement=\"bottom\">\n\t\t\t\t<template #reference> <AsamButton type=\"default\">底部</AsamButton></template>\n\t\t\t</AsamPopconfirm>\n\t\t\t<AsamPopconfirm class=\"box-item\" title=\"右下方显示提示\" placement=\"bottom-end\">\n\t\t\t\t<template #reference>\n\t\t\t\t\t<AsamButton type=\"default\">底部右侧</AsamButton>\n\t\t\t\t</template>\n\t\t\t</AsamPopconfirm>\n\t\t</div>\n\t</div>\n</template>\n\n<script setup>\nimport { AsamButton, AsamPopconfirm } from '@asam-ui/ui';\n</script>\n\n<style>\n.popconfirm-base-box {\n\twidth: 600px;\n}\n\n.popconfirm-base-box .row {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n}\n\n.popconfirm-base-box .center {\n\tjustify-content: center;\n}\n\n.popconfirm-base-box .box-item {\n\twidth: 110px;\n\tmargin-top: 10px;\n}\n</style>\n\n<style scoped>\n/* Keep layout utilities local so the downloaded SFC needs no CSS preset. */\n.mt-3 {\n\tmargin-top: calc(var(--asam-space-xs) * 3);\n}\n.mb-3 {\n\tmargin-bottom: calc(var(--asam-space-xs) * 3);\n}\n</style>\n\n<style scoped>\n.demo-layout-1 {\n\tdisplay: grid;\n\tgap: var(--asam-space-md);\n}\n.demo-layout-2 {\n\tgap: var(--asam-space-md);\n}\n.demo-layout-3 {\n\tgap: var(--asam-space-md);\n}\n.demo-layout-4 {\n\tgap: var(--asam-space-md);\n}\n.demo-layout-5 {\n\tgap: var(--asam-space-md);\n}\n.demo-layout-6 {\n\tgap: var(--asam-space-md);\n}\n</style>\n",
