	"entry": "Demo.vue",
	"files": [
		{
			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamTreeV2/native-custom-node/js/Demo.vue",
			"sha256": "a99f93013f337b8e734e1b207eec423271468ab5bcf5dbf6e66df73def209cf3",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\nNotice resource: /licenses/source-notices/0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\n-->\n<template>\n\t<AsamTreeV2 style=\"max-width: 600px\" :data=\"data\" :props=\"props\" :height=\"200\">\n\t\t<template #default=\"{ node }\">\n\t\t\t<AsamIcon class=\"el-icon--left\">\n\t\t\t\t<Document v-if=\"node.isLeaf\" />\n\t\t\t\t<Folder v-else-if=\"!node.expanded\" />\n\t\t\t\t<FolderOpened v-else />\n\t\t\t</AsamIcon>\n\t\t\t<span class=\"prefix\" :class=\"{ 'is-leaf': node.isLeaf }\">[ElementPlus]</span>\n\t\t\t<span>{{ node.label }}</span>\n\t\t</template>\n\t</AsamTreeV2>\n</template>\n\n<script setup>\n\n\nimport { AsamTreeV2, AsamIcon } from '@asam-ui/ui';\n// Adapted from the fixed upstream MIT example: tree-v2/custom-node.vue\nimport { Document, Folder, FolderOpened } from '@asam-ui/icons-vue';\nconst getKey = (prefix, id) => {\n\treturn `${prefix}-${id}`;\n};\nconst createData = (maxDeep, maxChildren, minNodesNumber, deep = 1, key = 'node') => {\n\tlet id = 0;\n\treturn Array.from({ length: minNodesNumber })\n\t\t.fill(deep)\n\t\t.map(() => {\n\t\t\tconst childrenNumber = deep === maxDeep ? 0 : Math.round(Math.random() * maxChildren);\n\t\t\tconst nodeKey = getKey(key, ++id);\n\t\t\treturn {\n\t\t\t\tid: nodeKey,\n\t\t\t\tlabel: nodeKey.replace(/^node/, '节点'),\n\t\t\t\tchildren: childrenNumber\n\t\t\t\t\t? createData(maxDeep, maxChildren, childrenNumber, deep + 1, nodeKey)\n\t\t\t\t\t: undefined\n\t\t\t};\n\t\t});\n};\nconst props = {\n\tvalue: 'id',\n\tlabel: 'label',\n\tchildren: 'children'\n};\nconst data = createData(4, 30, 40);\n</script>\n\n<style scoped>\n.prefix {\n\tcolor: var(--el-color-primary);\n\tmargin-right: 10px;\n}\n\n.prefix.is-leaf {\n\tcolor: var(--el-color-success);\n}\n</style>\n",
			"originalSourceSha256": "41385f2ce997202391f21cf55d56ddb9c72fe007f44090cb174802fe9c307263",
