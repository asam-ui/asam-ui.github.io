		{
			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamWatermark/cap-custom/js/Demo.vue",
			"sha256": "00935978b73f3449801134b0d9b96f905343218bb03db71dd5aac46670ffb489",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-686bc0b23059d4738afce60b230fb9756b289db071b6d6e453ad30a96c152bda.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/686bc0b23059d4738afce60b230fb9756b289db071b6d6e453ad30a96c152bda.txt\n-->\n<template>\n\t<div class=\"demo-root-layout\">\n\t\t<AsamButton type=\"default\" native-type=\"button\" @click=\"isDark = !isDark\"\n\t\t\t>切换深色水印</AsamButton\n\t\t>\n\t\t<div class=\"wrapper demo-layout-1\">\n\t\t\t<AsamWatermark\n\t\t\t\tclass=\"watermark\"\n\t\t\t\t:content=\"config.content\"\n\t\t\t\t:font=\"config.font\"\n\t\t\t\t:z-index=\"config.zIndex\"\n\t\t\t\t:rotate=\"config.rotate\"\n\t\t\t\t:gap=\"config.gap\"\n\t\t\t\t:offset=\"watermarkOffset\"\n\t\t\t>\n\t\t\t\t<div class=\"watermark-container\">\n\t\t\t\t\t<h1>ASAM UI</h1>\n\t\t\t\t\t<h2>面向设计师与开发者的 Vue 3 组件库</h2>\n\t\t\t\t\t<AsamImage\n\t\t\t\t\t\tsrc=\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22320%22%20height%3D%22180%22%3E%3Crect%20width%3D%22320%22%20height%3D%22180%22%20fill%3D%22%238899aa%22%2F%3E%3Ccircle%20cx%3D%22240%22%20cy%3D%2245%22%20r%3D%2228%22%20fill%3D%22%23fff%22%2F%3E%3Cpath%20d%3D%22M0%20180L100%2060L220%20180%22%20fill%3D%22%2340566c%22%2F%3E%3Ctext%20x%3D%2212%22%20y%3D%2230%22%20fill%3D%22%23fff%22%3EASAM%20%E7%A4%BA%E4%BE%8B%3C%2Ftext%3E%3C%2Fsvg%3E\"\n\t\t\t\t\t\talt=\"示例图片\"\n\t\t\t\t\t/>\n\t\t\t\t</div>\n\t\t\t</AsamWatermark>\n\t\t\t<!-- prettier-ignore -->\n\t\t\t<AsamBaseForm\n\t\t\tclass=\"form\"\n\t\t\t:model=\"config\"\n\t\t\tlabel-position=\"top\"\n\t\t\tlabel-width=\"50px\"\n\t\t>\n\t\t\t<AsamFormItem label=\"内容\">\n\t\t\t\t<AsamInput\n\t\t\t\t\t:model-value=\"config.content\"\n\t\t\t\t\t@update:model-value=\"\n\t\t\t\t\t\t(value) => {\n\t\t\t\t\t\t\tif (typeof value === 'string') config.content = value;\n\t\t\t\t\t\t}\n\t\t\t\t\t\"\n\t\t\t\t/>\n\t\t\t</AsamFormItem>\n\t\t\t<AsamFormItem label=\"颜色\">\n\t\t\t\t<AsamColorPicker\n\t\t\t\t\t:model-value=\"config.font.color\"\n\t\t\t\t\tshow-alpha\n\t\t\t\t\t@update:model-value=\"\n\t\t\t\t\t\t(value) => {\n\t\t\t\t\t\t\tconfig.font.color =\n\t\t\t\t\t\t\t\ttypeof value === 'string'\n\t\t\t\t\t\t\t\t\t? value\n\t\t\t\t\t\t\t\t\t: isDark\n\t\t\t\t\t\t\t\t\t\t? 'rgba(255, 255, 255, .15)'\n\t\t\t\t\t\t\t\t\t\t: 'rgba(0, 0, 0, .15)';\n\t\t\t\t\t\t}\n\t\t\t\t\t\"\n\t\t\t\t/>\n\t\t\t</AsamFormItem>\n\t\t\t<AsamFormItem label=\"字号\">\n\t\t\t\t<AsamSlider\n\t\t\t\t\t:model-value=\"config.font.fontSize\"\n\t\t\t\t\t@update:model-value=\"\n\t\t\t\t\t\t(value) => {\n\t\t\t\t\t\t\tif (typeof value === 'number') config.font.fontSize = value;\n\t\t\t\t\t\t}\n\t\t\t\t\t\"\n\t\t\t\t/>\n\t\t\t</AsamFormItem>\n\t\t\t<AsamFormItem label=\"zIndex\">\n\t\t\t\t<AsamSlider\n\t\t\t\t\t:model-value=\"config.zIndex\"\n\t\t\t\t\t@update:model-value=\"\n\t\t\t\t\t\t(value) => {\n\t\t\t\t\t\t\tif (typeof value === 'number') config.zIndex = value;\n\t\t\t\t\t\t}\n\t\t\t\t\t\"\n\t\t\t\t/>\n\t\t\t</AsamFormItem>\n\t\t\t<AsamFormItem label=\"旋转\">\n\t\t\t\t<AsamSlider\n\t\t\t\t\t:model-value=\"config.rotate\"\n\t\t\t\t\t:min=\"-180\"\n\t\t\t\t\t:max=\"180\"\n\t\t\t\t\t@update:model-value=\"\n\t\t\t\t\t\t(value) => {\n\t\t\t\t\t\t\tif (typeof value === 'number') config.rotate = value;\n\t\t\t\t\t\t}\n\t\t\t\t\t\"\n\t\t\t\t/>\n\t\t\t</AsamFormItem>\n\t\t\t<AsamFormItem label=\"间距\">\n\t\t\t\t<AsamSpace>\n\t\t\t\t\t<AsamInputNumber\n\t\t\t\t\t\t:model-value=\"config.gap[0]\"\n\t\t\t\t\t\tcontrols-position=\"right\"\n\t\t\t\t\t\t@update:model-value=\"\n\t\t\t\t\t\t\t(value) => {\n\t\t\t\t\t\t\t\tconfig.gap[0] = typeof value === 'number' ? value : 100;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\"\n\t\t\t\t\t/>\n\t\t\t\t\t<AsamInputNumber\n\t\t\t\t\t\t:model-value=\"config.gap[1]\"\n\t\t\t\t\t\tcontrols-position=\"right\"\n\t\t\t\t\t\t@update:model-value=\"\n\t\t\t\t\t\t\t(value) => {\n\t\t\t\t\t\t\t\tconfig.gap[1] = typeof value === 'number' ? value : 100;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\"\n\t\t\t\t\t/>\n\t\t\t\t</AsamSpace>\n\t\t\t</AsamFormItem>\n\t\t\t<AsamFormItem label=\"偏移量\">\n\t\t\t\t<AsamSpace>\n\t\t\t\t\t<AsamInputNumber\n\t\t\t\t\t\t:model-value=\"offset[0]\"\n\t\t\t\t\t\tplaceholder=\"offsetLeft\"\n\t\t\t\t\t\tcontrols-position=\"right\"\n\t\t\t\t\t\t@update:model-value=\"\n\t\t\t\t\t\t\t(value) => {\n\t\t\t\t\t\t\t\toffset[0] = typeof value === 'number' ? value : undefined;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\"\n\t\t\t\t\t/>\n\t\t\t\t\t<AsamInputNumber\n\t\t\t\t\t\t:model-value=\"offset[1]\"\n\t\t\t\t\t\tplaceholder=\"offsetTop\"\n\t\t\t\t\t\tcontrols-position=\"right\"\n\t\t\t\t\t\t@update:model-value=\"\n\t\t\t\t\t\t\t(value) => {\n\t\t\t\t\t\t\t\toffset[1] = typeof value === 'number' ? value : undefined;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\"\n\t\t\t\t\t/>\n\t\t\t\t</AsamSpace>\n\t\t\t</AsamFormItem>\n\t\t</AsamBaseForm>\n\t\t</div>\n\t</div>\n</template>\n\n<script setup>\ndefineOptions({ name: 'AsamWatermarkCapCustomDemo' });\nimport {\n\tAsamImage,\n\tAsamButton,\n\tAsamWatermark,\n\tAsamBaseForm,\n\tAsamFormItem,\n\tAsamInput,\n\tAsamColorPicker,\n\tAsamSlider,\n\tAsamSpace,\n\tAsamInputNumber\n} from '@asam-ui/ui';\nimport { computed, reactive, watch } from 'vue';\nimport { ref } from 'vue';\nconst isDark = ref(false);\nconst gap = reactive([100, 100]);\nconst offset = reactive([undefined, undefined]);\n\nconst config = reactive({\n\tcontent: 'ASAM UI',\n\tfont: {\n\t\tfontSize: 16,\n\t\tcolor: 'rgba(0, 0, 0, 0.15)'\n\t},\n\tzIndex: -1,\n\trotate: -22,\n\tgap\n});\nconst watermarkOffset = computed(() => {\n\tconst [left, top] = offset;\n\treturn left === undefined && top === undefined\n\t\t? undefined\n\t\t: [left ?? config.gap[0] / 2, top ?? config.gap[1] / 2];\n});\n\nwatch(\n\tisDark,\n\t(value) => {\n\t\tconfig.font.color = value ? 'rgba(255, 255, 255, .15)' : 'rgba(0, 0, 0, .15)';\n\t},\n\t{ immediate: true }\n);\n</script>\n\n<style scoped>\n.wrapper {\n\tdisplay: flex;\n}\n\n.watermark {\n\tdisplay: flex;\n\tflex: auto;\n}\n\n.watermark-container {\n\tflex: auto;\n}\n\n.form {\n\twidth: 330px;\n\tmargin-left: 20px;\n\tborder-left: 1px solid #eee;\n\tpadding-left: 20px;\n}\n\nimg {\n\tz-index: 10;\n\twidth: 100%;\n\tmax-width: 300px;\n\tposition: relative;\n}\n</style>\n\n<style scoped>\n.demo-layout-1 {\n\tgap: var(--asam-space-md);\n}\n</style>\n\n<style scoped>\n.demo-root-layout {\n\tdisplay: flex;\n\tgap: var(--asam-space-md);\n\tflex-wrap: wrap;\n\talign-items: center;\n}\n.demo-root-layout > :is(p, pre, output) {\n\tmargin-block: 0;\n}\n</style>\n",
