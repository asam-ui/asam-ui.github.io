			"source": "<template>\n\t<div class=\"example\">\n\t\t<AsamSelectV2\n\t\t\tv-model=\"selected\"\n\t\t\t:options=\"options\"\n\t\t\t:estimated-option-height=\"40\"\n\t\t\t:height=\"180\"\n\t\t\t:fit-input-width=\"420\"\n\t\t\tfilterable\n\t\t\taria-label=\"可变行高选项\"\n\t\t\t@end-reached=\"direction = $event\"\n\t\t>\n\t\t\t<template #default=\"{ item, index }\"\n\t\t\t\t><div\n\t\t\t\t\t:style=\"{\n\t\t\t\t\t\tminHeight: index % 2 ? (tall ? '96px' : '64px') : '32px',\n\t\t\t\t\t\twhiteSpace: 'normal',\n\t\t\t\t\t\tlineHeight: '20px'\n\t\t\t\t\t}\"\n\t\t\t\t>\n\t\t\t\t\t{{ item?.label }}\n\t\t\t\t</div></template\n\t\t\t>\n\t\t</AsamSelectV2>\n\t\t<AsamButton @click=\"tall = !tall\">切换实际内容高度</AsamButton>\n\t\t<output>选择：{{ selected }}；方向：{{ direction }}</output>\n\t</div>\n</template>\n<script setup>\nimport { ref } from 'vue';\nimport { AsamSelectV2, AsamButton } from '@asam-ui/ui';\nconst options = Array.from({ length: 100 }, (_, value) => ({\n\tvalue,\n\tlabel: '动态选项 ' + value,\n\traw: { value }\n}));\nconst selected = ref(null);\nconst tall = ref(false);\nconst direction = ref('');\ndefineOptions({ name: 'AsamSelectV2DynamicDemo' });\n</script>\n<style scoped>\n.example {\n\tdisplay: grid;\n\tgap: var(--asam-space-md, 16px);\n}\n</style>\n"
		}
