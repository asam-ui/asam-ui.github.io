			"sha256": "194b5fba1907df19a2cdb688e4468f17d5c4ad203435b2a8c55c588f4101dd30",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-5a2d0a045fd22a05a3dd92f6b49fb96b9716d60658c9a7b3ddb9eaaf805033c5.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/5a2d0a045fd22a05a3dd92f6b49fb96b9716d60658c9a7b3ddb9eaaf805033c5.txt\n-->\n<template>\n\t<AsamRow :gutter=\"16\">\n\t\t<AsamCol :xs=\"24\" :sm=\"12\" :md=\"6\" class=\"text-center mb-4\">\n\t\t\t<AsamStatistic title=\"日活跃用户\" :value=\"268500\" />\n\t\t</AsamCol>\n\t\t<AsamCol :xs=\"24\" :sm=\"12\" :md=\"6\" class=\"text-center mb-4\">\n\t\t\t<AsamStatistic :value=\"138\">\n\t\t\t\t<template #title>\n\t\t\t\t\t<div style=\"display: inline-flex; align-items: center\">\n\t\t\t\t\t\t男女比例\n\t\t\t\t\t\t<AsamIcon style=\"margin-left: 4px\" :size=\"12\">\n\t\t\t\t\t\t\t<Male />\n\t\t\t\t\t\t</AsamIcon>\n\t\t\t\t\t</div>\n\t\t\t\t</template>\n\t\t\t\t<template #suffix>/100</template>\n\t\t\t</AsamStatistic>\n\t\t</AsamCol>\n\t\t<AsamCol :xs=\"24\" :sm=\"12\" :md=\"6\" class=\"text-center mb-4\">\n\t\t\t<AsamStatistic title=\"交易总数\" :value=\"outputValue\" />\n\t\t</AsamCol>\n\t\t<AsamCol :xs=\"24\" :sm=\"12\" :md=\"6\" class=\"text-center mb-4\">\n\t\t\t<AsamStatistic title=\"反馈数量\" :value=\"562\">\n\t\t\t\t<template #suffix>\n\t\t\t\t\t<AsamIcon style=\"vertical-align: -0.125em\">\n\t\t\t\t\t\t<ChatLineRound />\n\t\t\t\t\t</AsamIcon>\n\t\t\t\t</template>\n\t\t\t</AsamStatistic>\n\t\t</AsamCol>\n\t</AsamRow>\n</template>\n\n<script lang=\"ts\" setup>\ndefineOptions({ name: 'AsamStatisticCapBasicDemo' });\nimport { AsamRow, AsamCol, AsamStatistic, AsamIcon } from '@asam-ui/ui';\n\nimport { ref } from 'vue';\nimport { onMounted, onBeforeUnmount } from 'vue';\nimport { ChatLineRound, Male } from '@asam-ui/icons-vue';\n\nconst outputValue = ref(0);\nlet frame = 0;\nonMounted(() => {\n\tconst start = performance.now();\n\tconst animate = (now: number) => {\n\t\tconst progress = Math.min((now - start) / 1500, 1);\n\t\toutputValue.value = Math.round(172000 * progress);\n\t\tif (progress < 1) frame = requestAnimationFrame(animate);\n\t};\n\tframe = requestAnimationFrame(animate);\n});\nonBeforeUnmount(() => cancelAnimationFrame(frame));\n</script>\n\n<style scoped>\n/* Local styles keep this sample runnable without a website utility-CSS preset. */\n.text-center {\n\ttext-align: center;\n}\n\n.mb-4 {\n\tmargin-bottom: 1rem;\n}\n</style>\n",
