			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-f7620ad880e1b8308c6581b94bba471c6e236d661f67db72943410af20b95f06.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/f7620ad880e1b8308c6581b94bba471c6e236d661f67db72943410af20b95f06.txt\n-->\n<template>\n\t<AsamRow :gutter=\"16\">\n\t\t<AsamCol :xs=\"24\" :sm=\"12\" :md=\"8\" class=\"text-center mb-4\">\n\t\t\t<AsamCountdown title=\"开始拖拽\" :value=\"value\" />\n\t\t</AsamCol>\n\t\t<AsamCol :xs=\"24\" :sm=\"12\" :md=\"8\" class=\"text-center mb-4\">\n\t\t\t<AsamCountdown title=\"会员剩余时间\" format=\"HH:mm:ss\" :value=\"value1\" />\n\t\t\t<AsamButton class=\"countdown-footer\" type=\"default\" @click=\"reset\"> 重置 </AsamButton>\n\t\t</AsamCol>\n\t\t<AsamCol :xs=\"24\" :sm=\"12\" :md=\"8\" class=\"text-center mb-4\">\n\t\t\t<AsamCountdown format=\"DD [天] HH:mm:ss\" :value=\"value2\">\n\t\t\t\t<template #title>\n\t\t\t\t\t<div style=\"display: inline-flex; align-items: center\">\n\t\t\t\t\t\t<AsamIcon style=\"margin-right: 4px\" :size=\"12\">\n\t\t\t\t\t\t\t<Calendar />\n\t\t\t\t\t\t</AsamIcon>\n\t\t\t\t\t\t距离下个月还有\n\t\t\t\t\t</div>\n\t\t\t\t</template>\n\t\t\t</AsamCountdown>\n\t\t\t<div class=\"countdown-footer\">{{ value2.format('YYYY-MM-DD') }}</div>\n\t\t</AsamCol>\n\t</AsamRow>\n</template>\n\n<script lang=\"ts\" setup>\ndefineOptions({ name: 'AsamStatisticCapCountdownDemo' });\nimport { AsamRow, AsamCol, AsamCountdown, AsamButton, AsamIcon } from '@asam-ui/ui';\n\nimport { ref } from 'vue';\nimport dayjs from 'dayjs';\nimport { Calendar } from '@asam-ui/icons-vue';\n\nconst value = ref(Date.now() + 1000 * 60 * 60 * 7);\nconst value1 = ref(Date.now() + 1000 * 60 * 60 * 24 * 2);\nconst value2 = ref(dayjs().add(1, 'month').startOf('month'));\n\nfunction reset() {\n\tvalue1.value = Date.now() + 1000 * 60 * 60 * 24 * 2;\n}\n</script>\n\n<style scoped>\n.countdown-footer {\n\tmargin-top: 8px;\n}\n</style>\n\n<style scoped>\n/* Local styles keep this sample runnable without a website utility-CSS preset. */\n.text-center {\n\ttext-align: center;\n}\n\n.mb-4 {\n\tmargin-bottom: 1rem;\n}\n</style>\n",
