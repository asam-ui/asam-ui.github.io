		{
			"name": "ControlledBoundary.vue",
			"sourcePath": "apps/website/examples/AsamCascader/native-show-checked-strategy/ts/ControlledBoundary.vue",
			"sha256": "f9fc728a334919b4a5f42fd9473b8ffe5ce0dc1aae93ba149a5a93dc99861b30",
			"source": "<template>\n\t<section class=\"controlled-boundary\">\n\t\t<h3>常驻面板的受控回写边界</h3>\n\t\t<p class=\"example-paragraph\">\n\t\t\t初始宿主值为3。选择节点2后，忽略回写或第一次转换回旧值3时，常驻面板可能保留候选2。\n\t\t\t关闭再打开不会自动回滚；随后将宿主改为4，可观察真实新值的同步。\n\t\t</p>\n\t\t<label>\n\t\t\t值模式\n\t\t\t<AsamSelect v-model=\"mode\" @change=\"resetLog\">\n\t\t\t\t<AsamOption value=\"native\" :label=\"'native'\">native</AsamOption>\n\t\t\t\t<AsamOption value=\"value\" :label=\"'value'\">value</AsamOption>\n\t\t\t\t<AsamOption value=\"object\" :label=\"'object'\">object</AsamOption>\n\t\t\t</AsamSelect>\n\t\t</label>\n\t\t<label>\n\t\t\t宿主回写\n\t\t\t<AsamSelect v-model=\"behavior\" @change=\"resetLog\">\n\t\t\t\t<AsamOption value=\"accept\" :label=\"'接受候选值'\">接受候选值</AsamOption>\n\t\t\t\t<AsamOption value=\"reject\" :label=\"'忽略回写'\">忽略回写</AsamOption>\n\t\t\t\t<AsamOption value=\"transform\" :label=\"'非幂等转换：依次返回3、2、3'\"\n\t\t\t\t\t>非幂等转换：依次返回3、2、3</AsamOption\n\t\t\t\t>\n\t\t\t</AsamSelect>\n\t\t</label>\n\t\t<div class=\"boundary-actions\">\n\t\t\t<AsamButton type=\"default\" native-type=\"button\" @click=\"closePanel\"\n\t\t\t\t>关闭面板</AsamButton\n\t\t\t>\n\t\t\t<AsamButton type=\"default\" native-type=\"button\" @click=\"openPanel\">重新打开</AsamButton>\n\t\t\t<AsamButton type=\"default\" native-type=\"button\" @click=\"readDisplay\"\n\t\t\t\t>读取显示与节点</AsamButton\n\t\t\t>\n\t\t\t<AsamButton type=\"default\" native-type=\"button\" @click=\"setParent\"\n\t\t\t\t>宿主改为4</AsamButton\n\t\t\t>\n\t\t</div>\n\t\t<AsamCascader\n\t\t\tv-if=\"mode === 'native'\"\n\t\t\tref=\"control\"\n\t\t\tvalue-mode=\"native\"\n\t\t\t:model-value=\"nativeModel\"\n\t\t\t:options=\"boundaryOptions\"\n\t\t\t:props=\"configuration\"\n\t\t\t:persistent=\"true\"\n\t\t\t@update:model-value=\"updateNative\"\n\t\t\t@change=\"record('change', $event)\"\n\t\t/>\n\t\t<AsamCascader\n\t\t\tv-else-if=\"mode === 'value'\"\n\t\t\tref=\"control\"\n\t\t\tvalue-mode=\"value\"\n\t\t\t:model-value=\"valueModel\"\n\t\t\t:options=\"boundaryOptions\"\n\t\t\t:props=\"configuration\"\n\t\t\t:persistent=\"true\"\n\t\t\t@update:model-value=\"updateValue\"\n\t\t\t@change=\"record('change', $event)\"\n\t\t/>\n\t\t<AsamCascader\n\t\t\tv-else\n\t\t\tref=\"control\"\n\t\t\tvalue-mode=\"object\"\n\t\t\t:model-value=\"objectModel\"\n\t\t\t:options=\"boundaryOptions\"\n\t\t\t:props=\"configuration\"\n\t\t\t:persistent=\"true\"\n\t\t\t@update:model-value=\"updateObject\"\n\t\t\t@change=\"record('change', $event)\"\n\t\t/>\n\t\t<output class=\"boundary-model\">宿主模型：{{ model }}</output>\n\t\t<output class=\"boundary-display\">\n\t\t\t实际显示：{{ display.text }}；公开节点：{{ display.nodes }}；面板存在：{{\n\t\t\t\tdisplay.panel\n\t\t\t}}\n\t\t</output>\n\t\t<output class=\"boundary-events\">模型事件：{{ events }}</output>\n\t\t<output class=\"boundary-transformations\">转换调用：{{ transformations }}</output>\n\t</section>\n</template>\n\n<script lang=\"ts\" setup>\nimport { computed, nextTick, ref, unref } from 'vue';\nimport { AsamSelect, AsamOption, AsamButton, AsamCascader } from '@asam-ui/ui';\nimport type { AsamCascaderExpose, AsamCascaderNativeProps, AsamHierarchyOption } from '@asam-ui/ui';\n\nconst mode = ref<'native' | 'value' | 'object'>('native');\nconst behavior = ref<'accept' | 'reject' | 'transform'>('reject');\nconst configuration = { multiple: false, emitPath: false } as const;\nconst children = [\n\t{ value: 2, label: '节点2', raw: { id: 2 } },\n\t{ value: 3, label: '节点3', raw: { id: 3 } },\n\t{ value: 4, label: '节点4', raw: { id: 4 } }\n];\nconst boundaryOptions = [{ value: 1, label: '根节点', raw: { id: 1 }, children }];\nconst nativeModel = ref<AsamCascaderNativeProps['modelValue']>(3);\nconst valueModel = ref<AsamHierarchyOption['value'] | null>(3);\nconst objectModel = ref<AsamHierarchyOption | null>(children[1]);\nconst control = ref<AsamCascaderExpose>();\nconst transformations = ref(0);\nconst events = ref<{ name: string; value: unknown }[]>([]);\nconst display = ref<{ text: string; nodes: unknown[]; panel: boolean }>({\n\ttext: '',\n\tnodes: [],\n\tpanel: false\n});\nconst model = computed(() =>\n\tmode.value === 'native'\n\t\t? nativeModel.value\n\t\t: mode.value === 'value'\n\t\t\t? valueModel.value\n\t\t\t: objectModel.value\n);\nasync function readDisplay() {\n\tawait nextTick();\n\tdisplay.value = {\n\t\ttext: unref(control.value?.presentText) ?? '',\n\t\tnodes: control.value?.getCheckedNodes(true)?.map((node) => node.value) ?? [],\n\t\tpanel: !!control.value?.cascaderPanelRef\n\t};\n}\nfunction record(name: string, value: unknown) {\n\tevents.value.push({ name, value });\n\tvoid readDisplay();\n}\nfunction transformedValue() {\n\treturn ++transformations.value % 2 ? 3 : 2;\n}\nfunction updateNative(value: AsamCascaderNativeProps['modelValue']) {\n\trecord('update:modelValue', value);\n\tif (behavior.value !== 'reject')\n\t\tnativeModel.value = behavior.value === 'transform' ? transformedValue() : value;\n}\nfunction updateValue(value: AsamHierarchyOption['value'] | null) {\n\trecord('update:modelValue', value);\n\tif (behavior.value !== 'reject')\n\t\tvalueModel.value = behavior.value === 'transform' ? transformedValue() : value;\n}\nfunction updateObject(value: AsamHierarchyOption | null) {\n\trecord('update:modelValue', value);\n\tif (behavior.value === 'reject') return;\n\tconst transformed = behavior.value === 'transform' ? transformedValue() : undefined;\n\tobjectModel.value =\n\t\ttransformed === undefined\n\t\t\t? value\n\t\t\t: (children.find((option) => option.value === transformed) ?? null);\n}\nfunction resetLog() {\n\tevents.value = [];\n\ttransformations.value = 0;\n\tvoid readDisplay();\n}\nasync function closePanel() {\n\tcontrol.value?.togglePopperVisible(false);\n\tawait readDisplay();\n}\nasync function openPanel() {\n\tcontrol.value?.togglePopperVisible(true);\n\tawait readDisplay();\n}\nasync function setParent() {\n\tnativeModel.value = 4;\n\tvalueModel.value = 4;\n\tobjectModel.value = children[2];\n\tawait readDisplay();\n}\n</script>\n\n<style scoped>\n.controlled-boundary {\n\tdisplay: grid;\n\tgap: var(--asam-space-sm, 8px);\n\tmargin-block: var(--asam-space-lg, 24px);\n}\n\n.boundary-actions {\n\tdisplay: flex;\n\tflex-wrap: wrap;\n\tgap: var(--asam-space-sm, 8px);\n}\n\noutput {\n\toverflow-wrap: anywhere;\n}\n</style>\n\n<style scoped>\np:where(.example-paragraph) {\n\tmargin-block: 16px;\n\tline-height: 1.8;\n\toverflow-wrap: anywhere;\n}\n</style>\n"
		}
	],
