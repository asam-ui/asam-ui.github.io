	"entry": "Demo.vue",
	"files": [
		{
			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamCascader/native-show-checked-strategy/ts/Demo.vue",
			"sha256": "1d05077251d840f2ec30c9a20434966e6e0bf433c73f2875f5f3ff0744f95820",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\nNotice resource: /licenses/source-notices/0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\n-->\n<template>\n\t<p class=\"example-paragraph\">弹层设为 persistent=false；关闭后保留选中标签，可直接删除或清空，再打开按当前值回填。</p>\n\t<div class=\"m-4\">\n\t\t<p class=\"example-paragraph\">策略：child（默认，显示全部选中的子节点）</p>\n\t\t<AsamCascader\n\t\t\tvalue-mode=\"native\"\n\t\t\tv-model=\"value1\"\n\t\t\t:options=\"options\"\n\t\t\t:props=\"props\"\n\t\t\tshow-checked-strategy=\"child\"\n\t\t\t:persistent=\"false\"\n\t\t\tclearable\n\t\t\t@change=\"handleChange1\"\n\t\t/>\n\t</div>\n\n\t<div class=\"m-4\">\n\t\t<p class=\"example-paragraph\">策略：parent（全部子节点选中时仅显示父节点）</p>\n\t\t<AsamCascader\n\t\t\tvalue-mode=\"native\"\n\t\t\tv-model=\"value2\"\n\t\t\t:options=\"options\"\n\t\t\t:props=\"props\"\n\t\t\tshow-checked-strategy=\"parent\"\n\t\t\t:persistent=\"false\"\n\t\t\tclearable\n\t\t\t@change=\"handleChange2\"\n\t\t/>\n\t</div>\n\t<ControlledBoundary />\n</template>\n\n<script lang=\"ts\" setup>\n\n\nimport { AsamCascader } from '@asam-ui/ui';\nimport ControlledBoundary from './ControlledBoundary.vue';\nimport type { AsamCascaderNativeProps } from '@asam-ui/ui';\n// Adapted from the fixed upstream MIT example: cascader/show-checked-strategy.vue\n\nimport { ref } from 'vue';\n\nconst value1 = ref<AsamCascaderNativeProps['modelValue']>([['guide', 'disciplines', 'feedback']]);\nconst value2 = ref<AsamCascaderNativeProps['modelValue']>([['guide', 'disciplines', 'feedback']]);\nconst props = {\n\tmultiple: true\n};\n\nconst handleChange1 = (value: unknown) => {\n\tconsole.log('Child strategy:', value);\n};\n\nconst handleChange2 = (value: unknown) => {\n\tconsole.log('Parent strategy:', value);\n};\n\nconst options = [\n\t{\n\t\tvalue: 'guide',\n\t\tlabel: '指南',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tvalue: 'disciplines',\n\t\t\t\tlabel: 'Disciplines',\n\t\t\t\tchildren: [\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'consistency',\n\t\t\t\t\t\tlabel: '一致性'\n\t\t\t\t\t},\n\t\t\t\t\t{ value: 'feedback', label: '反馈' }\n\t\t\t\t]\n\t\t\t},\n\t\t\t{\n\t\t\t\tvalue: 'navigation',\n\t\t\t\tlabel: 'Navigation',\n\t\t\t\tchildren: [\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'side nav',\n\t\t\t\t\t\tlabel: 'Side Navigation'\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t}\n\t\t]\n\t},\n\t{\n\t\tvalue: 'component',\n\t\tlabel: '组件',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tvalue: 'basic',\n\t\t\t\tlabel: 'Basic',\n\t\t\t\tchildren: [\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'layout',\n\t\t\t\t\t\tlabel: 'Layout'\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t},\n\t\t\t{\n\t\t\t\tvalue: 'form',\n\t\t\t\tlabel: 'Form',\n\t\t\t\tchildren: [\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'radio',\n\t\t\t\t\t\tlabel: 'Radio'\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t}\n\t\t]\n\t},\n\t{\n\t\tvalue: 'resource',\n\t\tlabel: '资源',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tvalue: 'axure',\n\t\t\t\tlabel: 'Axure Components'\n\t\t\t}\n\t\t]\n\t}\n];\n</script>\n\n<style scoped>\n/* Keep layout utilities local so the downloaded SFC needs no CSS preset. */\n.m-4 {\n\tmargin: var(--asam-space-lg);\n}\n</style>\n\n<style scoped>\np:where(.example-paragraph) {\n\tmargin-block: 16px;\n\tline-height: 1.8;\n\toverflow-wrap: anywhere;\n}\n</style>\n",
			"originalSourceSha256": "900dc5bcc2228dbe18fb12ef08ed7601bcafc59160bf00be14c0a9036f6884f3",
