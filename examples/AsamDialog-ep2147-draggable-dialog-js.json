			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-dbc2fc85a49b4bc413f7357a2df49933e7afdc6a1f7930f3d31878dcc6316dd3.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/dbc2fc85a49b4bc413f7357a2df49933e7afdc6a1f7930f3d31878dcc6316dd3.txt\n-->\n<template>\n\t<div class=\"flex flex-wrap gap-1\">\n\t\t<AsamButton class=\"!ml-0\" plain @click=\"dialogVisible = true\">\n\t\t\tOpen a draggable Dialog\n\t\t</AsamButton>\n\t\t<AsamButton class=\"!ml-0\" plain @click=\"dialogOverflowVisible = true\">\n\t\t\tOpen a overflow draggable Dialog\n\t\t</AsamButton>\n\t\t<AsamButton class=\"!ml-0\" plain @click=\"customDraggingVisible = true\">\n\t\t\tOpen a custom dragging style Dialog\n\t\t</AsamButton>\n\t</div>\n\n\t<AsamDialog v-model=\"dialogVisible\" title=\"Tips\" width=\"500\" draggable>\n\t\t<span>It's a draggable Dialog</span>\n\t\t<template #footer>\n\t\t\t<div class=\"dialog-footer\">\n\t\t\t\t<AsamButton @click=\"dialogVisible = false\">Cancel</AsamButton>\n\t\t\t\t<AsamButton type=\"primary\" @click=\"dialogVisible = false\"> Confirm </AsamButton>\n\t\t\t</div>\n\t\t</template>\n\t</AsamDialog>\n\n\t<AsamDialog v-model=\"dialogOverflowVisible\" title=\"Tips\" width=\"500\" draggable overflow>\n\t\t<span>It's a overflow draggable Dialog</span>\n\t\t<template #footer>\n\t\t\t<div class=\"dialog-footer\">\n\t\t\t\t<AsamButton @click=\"dialogOverflowVisible = false\">Cancel</AsamButton>\n\t\t\t\t<AsamButton type=\"primary\" @click=\"dialogOverflowVisible = false\">\n\t\t\t\t\tConfirm\n\t\t\t\t</AsamButton>\n\t\t\t</div>\n\t\t</template>\n\t</AsamDialog>\n\n\t<AsamDialog\n\t\tv-model=\"customDraggingVisible\"\n\t\tclass=\"custom-dragging-style\"\n\t\ttitle=\"Custom Dragging Style\"\n\t\twidth=\"500\"\n\t\tdraggable\n\t>\n\t\t<span>This dialog has custom dragging styles. Try dragging it to see the effects!</span>\n\t\t<template #footer>\n\t\t\t<div class=\"dialog-footer\">\n\t\t\t\t<AsamButton @click=\"customDraggingVisible = false\">Cancel</AsamButton>\n\t\t\t\t<AsamButton type=\"primary\" @click=\"customDraggingVisible = false\">\n\t\t\t\t\tConfirm\n\t\t\t\t</AsamButton>\n\t\t\t</div>\n\t\t</template>\n\t</AsamDialog>\n</template>\n\n<script setup>\nimport { AsamButton, AsamDialog } from '@asam-ui/ui';\nimport { ref } from 'vue';\nconst dialogVisible = ref(false);\nconst dialogOverflowVisible = ref(false);\nconst customDraggingVisible = ref(false);\n</script>\n\n<style scoped>\n:global(.custom-dragging-style.is-dragging) {\n\tborder: 2px dashed var(--el-color-primary);\n\topacity: 0.65;\n}\n</style>\n",
