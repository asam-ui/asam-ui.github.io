			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-dbc2fc85a49b4bc413f7357a2df49933e7afdc6a1f7930f3d31878dcc6316dd3.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/dbc2fc85a49b4bc413f7357a2df49933e7afdc6a1f7930f3d31878dcc6316dd3.txt\n-->\n<template>\n\t<div class=\"flex flex-wrap gap-1\">\n\t\t<AsamButton type=\"primary\" class=\"!ml-0\" plain @click=\"dialogVisible = true\">\n\t\t\t打开可拖拽对话框\n\t\t</AsamButton>\n\t\t<AsamButton type=\"primary\" class=\"!ml-0\" plain @click=\"dialogOverflowVisible = true\">\n\t\t\t打开允许越界拖拽的对话框\n\t\t</AsamButton>\n\t\t<AsamButton type=\"primary\" class=\"!ml-0\" plain @click=\"customDraggingVisible = true\">\n\t\t\t打开自定义拖拽样式的对话框\n\t\t</AsamButton>\n\t</div>\n\n\t<AsamDialog v-model=\"dialogVisible\" title=\"提示\" width=\"500\" draggable>\n\t\t<span>可拖拽对话框</span>\n\t\t<template #footer>\n\t\t\t<div class=\"dialog-footer\">\n\t\t\t\t<AsamButton type=\"primary\" @click=\"dialogVisible = false\">取消</AsamButton>\n\t\t\t\t<AsamButton type=\"primary\" @click=\"dialogVisible = false\"> 确认 </AsamButton>\n\t\t\t</div>\n\t\t</template>\n\t</AsamDialog>\n\n\t<AsamDialog v-model=\"dialogOverflowVisible\" title=\"提示\" width=\"500\" draggable overflow>\n\t\t<span>允许越界拖拽的对话框</span>\n\t\t<template #footer>\n\t\t\t<div class=\"dialog-footer\">\n\t\t\t\t<AsamButton type=\"primary\" @click=\"dialogOverflowVisible = false\">取消</AsamButton>\n\t\t\t\t<AsamButton type=\"primary\" @click=\"dialogOverflowVisible = false\">\n\t\t\t\t\t确认\n\t\t\t\t</AsamButton>\n\t\t\t</div>\n\t\t</template>\n\t</AsamDialog>\n\n\t<AsamDialog\n\t\tv-model=\"customDraggingVisible\"\n\t\tclass=\"custom-dragging-style\"\n\t\ttitle=\"自定义拖拽样式\"\n\t\twidth=\"500\"\n\t\tdraggable\n\t>\n\t\t<span>此对话框采用自定义拖拽样式，可以拖动查看效果。</span>\n\t\t<template #footer>\n\t\t\t<div class=\"dialog-footer\">\n\t\t\t\t<AsamButton type=\"primary\" @click=\"customDraggingVisible = false\">取消</AsamButton>\n\t\t\t\t<AsamButton type=\"primary\" @click=\"customDraggingVisible = false\">\n\t\t\t\t\t确认\n\t\t\t\t</AsamButton>\n\t\t\t</div>\n\t\t</template>\n\t</AsamDialog>\n</template>\n\n<script setup>\nimport { AsamButton, AsamDialog } from '@asam-ui/ui';\nimport { ref } from 'vue';\nconst dialogVisible = ref(false);\nconst dialogOverflowVisible = ref(false);\nconst customDraggingVisible = ref(false);\n</script>\n\n<style scoped>\n:global(.custom-dragging-style.is-dragging) {\n\tborder: 2px dashed var(--el-color-primary);\n\topacity: 0.65;\n}\n</style>\n",
