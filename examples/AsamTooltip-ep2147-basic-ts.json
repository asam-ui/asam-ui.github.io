\t\t<template #content>\n\t\t\t\t\tRight Center\n\t\t\t\t\t<br />\n\t\t\t\t\tprompts info\n\t\t\t\t</template>\n\t\t\t\t<AsamButton>right</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t</div>\n\t\t<div class=\"row\">\n\t\t\t<AsamTooltip class=\"box-item\" effect=\"dark\" placement=\"left-end\">\n\t\t\t\t<template #content>\n\t\t\t\t\tLeft Bottom\n\t\t\t\t\t<br />\n\t\t\t\t\tprompts info\n\t\t\t\t</template>\n\t\t\t\t<AsamButton>left-end</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t\t<AsamTooltip class=\"box-item\" effect=\"dark\" placement=\"right-end\">\n\t\t\t\t<template #content>\n\t\t\t\t\tRight Bottom\n\t\t\t\t\t<br />\n\t\t\t\t\tprompts info\n\t\t\t\t</template>\n\t\t\t\t<AsamButton>right-end</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t</div>\n\t\t<div class=\"row center\">\n\t\t\t<AsamTooltip\n\t\t\t\tclass=\"box-item\"\n\t\t\t\teffect=\"dark\"\n\t\t\t\tcontent=\"Bottom Left prompts info\"\n\t\t\t\tplacement=\"bottom-start\"\n\t\t\t>\n\t\t\t\t<AsamButton>bottom-start</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t\t<AsamTooltip\n\t\t\t\tclass=\"box-item\"\n\t\t\t\teffect=\"dark\"\n\t\t\t\tcontent=\"Bottom Center prompts info\"\n\t\t\t\tplacement=\"bottom\"\n\t\t\t>\n\t\t\t\t<AsamButton>bottom</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t\t<AsamTooltip\n\t\t\t\tclass=\"box-item\"\n\t\t\t\teffect=\"dark\"\n\t\t\t\tcontent=\"Bottom Right prompts info\"\n\t\t\t\tplacement=\"bottom-end\"\n\t\t\t>\n\t\t\t\t<AsamButton>bottom-end</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t</div>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\nimport { AsamButton, AsamTooltip } from '@asam-ui/ui';\n</script>\n\n<style>\n.tooltip-base-box {\n\twidth: 600px;\n}\n\n.tooltip-base-box .row {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n}\n\n.tooltip-base-box .center {\n\tjustify-content: center;\n}\n\n.tooltip-base-box .box-item {\n\twidth: 110px;\n\tmargin-top: 10px;\n}\n</style>\n",
