			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-f0f62c75188cf16f50b91236be898b3d5f6690814168f8fa37a972d7aaaddb98.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/f0f62c75188cf16f50b91236be898b3d5f6690814168f8fa37a972d7aaaddb98.txt\n-->\n<template>\n\t<div class=\"demo-date-picker\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"block\">\n\t\t\t\t<span class=\"demonstration\">Week</span>\n\t\t\t\t<AsamDatePicker\n\t\t\t\t\tv-model=\"value1\"\n\t\t\t\t\tvalue-format=\"\"\n\t\t\t\t\ttype=\"week\"\n\t\t\t\t\tformat=\"[Week] ww\"\n\t\t\t\t\tplaceholder=\"Pick a week\"\n\t\t\t\t/>\n\t\t\t</div>\n\t\t\t<div class=\"block\">\n\t\t\t\t<span class=\"demonstration\">Year</span>\n\t\t\t\t<AsamDatePicker\n\t\t\t\t\tv-model=\"value3\"\n\t\t\t\t\tvalue-format=\"\"\n\t\t\t\t\ttype=\"year\"\n\t\t\t\t\tplaceholder=\"Pick a year\"\n\t\t\t\t/>\n\t\t\t</div>\n\t\t\t<div class=\"block\">\n\t\t\t\t<span class=\"demonstration\">Month</span>\n\t\t\t\t<AsamDatePicker\n\t\t\t\t\tv-model=\"value5\"\n\t\t\t\t\tvalue-format=\"\"\n\t\t\t\t\ttype=\"month\"\n\t\t\t\t\tplaceholder=\"Pick a month\"\n\t\t\t\t/>\n\t\t\t</div>\n\t\t\t<div class=\"block\">\n\t\t\t\t<span class=\"demonstration\">Quarter</span>\n\t\t\t\t<AsamDatePicker\n\t\t\t\t\tv-model=\"value7\"\n\t\t\t\t\tvalue-format=\"\"\n\t\t\t\t\ttype=\"quarter\"\n\t\t\t\t\tplaceholder=\"Pick a quarter\"\n\t\t\t\t/>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"container\">\n\t\t\t<div class=\"block\">\n\t\t\t\t<span class=\"demonstration\">Dates</span>\n\t\t\t\t<AsamDatePicker\n\t\t\t\t\tv-model=\"value2\"\n\t\t\t\t\tvalue-format=\"\"\n\t\t\t\t\ttype=\"dates\"\n\t\t\t\t\tplaceholder=\"Pick one or more dates\"\n\t\t\t\t/>\n\t\t\t</div>\n\t\t\t<div class=\"block\">\n\t\t\t\t<span class=\"demonstration\">Years</span>\n\t\t\t\t<AsamDatePicker\n\t\t\t\t\tv-model=\"value4\"\n\t\t\t\t\tvalue-format=\"\"\n\t\t\t\t\ttype=\"years\"\n\t\t\t\t\tplaceholder=\"Pick one or more years\"\n\t\t\t\t/>\n\t\t\t</div>\n\t\t\t<div class=\"block\">\n\t\t\t\t<span class=\"demonstration\">Months</span>\n\t\t\t\t<AsamDatePicker\n\t\t\t\t\tv-model=\"value6\"\n\t\t\t\t\tvalue-format=\"\"\n\t\t\t\t\ttype=\"months\"\n\t\t\t\t\tplaceholder=\"Pick one or more months\"\n\t\t\t\t/>\n\t\t\t</div>\n\t\t\t<div class=\"block\">\n\t\t\t\t<span class=\"demonstration\">Quarters</span>\n\t\t\t\t<AsamDatePicker\n\t\t\t\t\tv-model=\"value8\"\n\t\t\t\t\tvalue-format=\"\"\n\t\t\t\t\ttype=\"quarters\"\n\t\t\t\t\tplaceholder=\"Pick one or more quarters\"\n\t\t\t\t/>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\nimport type { AsamDateValue } from '@asam-ui/ui';\nimport { AsamDatePicker } from '@asam-ui/ui';\ndefineOptions({ name: 'AsamDatePickerofficialdatepickerothermeasurementsExample' });\n\nimport { ref } from 'vue';\n\nconst value1 = ref<AsamDateValue>('');\nconst value2 = ref<AsamDateValue>('');\nconst value3 = ref<AsamDateValue>('');\nconst value4 = ref<AsamDateValue>('');\nconst value5 = ref<AsamDateValue>('');\nconst value6 = ref<AsamDateValue>('');\nconst value7 = ref<AsamDateValue>('');\nconst value8 = ref<AsamDateValue>([]);\n</script>\n\n<style scoped>\n/* stylelint-disable selector-pseudo-class-no-unknown, selector-class-pattern, no-descending-specificity -- Vue deep/native BEM selectors and equivalent media selector groups retained from the fixed official example. */\n.demo-date-picker {\n\tdisplay: flex;\n\twidth: 100%;\n\tpadding: 0;\n\tflex-wrap: wrap;\n}\n\n.demo-date-picker .container {\n\tflex: 1;\n\tmin-width: 300px;\n\tborder-right: solid 1px var(--el-border-color);\n}\n\n.demo-date-picker .container:last-child {\n\tborder-right: none;\n}\n\n.demo-date-picker .block {\n\tpadding: 1.5rem 0;\n\ttext-align: center;\n}\n\n.demo-date-picker .container .block:not(:first-child) {\n\tborder-top: solid 1px var(--el-border-color);\n}\n\n.demo-date-picker .demonstration {\n\tdisplay: block;\n\tcolor: var(--el-text-color-secondary);\n\tfont-size: 14px;\n\tmargin-bottom: 1rem;\n}\n\n@media screen and (width <= 768px) {\n\t.demo-date-picker .container {\n\t\tflex: 0 0 100%;\n\t\tmin-width: auto;\n\t\tborder-right: none;\n\t\tborder-bottom: solid 1px var(--el-border-color);\n\t}\n\n\t.demo-date-picker .container:last-child {\n\t\tborder-bottom: none;\n\t}\n\n\t.demo-date-picker .block {\n\t\tpadding: 1rem 0;\n\t}\n\n\t.demo-date-picker .container .block:not(:first-child) {\n\t\tborder-top: solid 1px var(--el-border-color);\n\t}\n}\n</style>\n",
