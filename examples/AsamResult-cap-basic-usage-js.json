			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-ec4ce9db82c6ab1fa0e72f855af2c030149b88e1b23508d51d9ba83e359b4ed3.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/ec4ce9db82c6ab1fa0e72f855af2c030149b88e1b23508d51d9ba83e359b4ed3.txt\n-->\n<template>\n\t<AsamRow>\n\t\t<AsamCol :sm=\"12\" :lg=\"6\" :xl=\"4\">\n\t\t\t<AsamResult icon=\"primary\" title=\"主要提示\" sub-title=\"请按照提示操作\">\n\t\t\t\t<template #extra>\n\t\t\t\t\t<AsamButton type=\"default\">返回</AsamButton>\n\t\t\t\t</template>\n\t\t\t</AsamResult>\n\t\t</AsamCol>\n\t\t<AsamCol :sm=\"12\" :lg=\"6\" :xl=\"4\">\n\t\t\t<AsamResult icon=\"success\" title=\"成功提示\" sub-title=\"请按照提示操作\">\n\t\t\t\t<template #extra>\n\t\t\t\t\t<AsamButton type=\"default\">返回</AsamButton>\n\t\t\t\t</template>\n\t\t\t</AsamResult>\n\t\t</AsamCol>\n\t\t<AsamCol :sm=\"12\" :lg=\"6\" :xl=\"4\">\n\t\t\t<AsamResult icon=\"warning\" title=\"警告提示\" sub-title=\"请按照提示操作\">\n\t\t\t\t<template #extra>\n\t\t\t\t\t<AsamButton type=\"default\">返回</AsamButton>\n\t\t\t\t</template>\n\t\t\t</AsamResult>\n\t\t</AsamCol>\n\t\t<AsamCol :sm=\"12\" :lg=\"6\" :xl=\"4\">\n\t\t\t<AsamResult icon=\"error\" title=\"错误提示\" sub-title=\"请按照提示操作\">\n\t\t\t\t<template #extra>\n\t\t\t\t\t<AsamButton type=\"default\">返回</AsamButton>\n\t\t\t\t</template>\n\t\t\t</AsamResult>\n\t\t</AsamCol>\n\t\t<AsamCol :sm=\"12\" :lg=\"6\" :xl=\"4\">\n\t\t\t<AsamResult icon=\"info\" title=\"信息提示\">\n\t\t\t\t<template #sub-title>\n\t\t\t\t\t<p class=\"example-paragraph\">通过插槽提供副标题</p>\n\t\t\t\t</template>\n\t\t\t\t<template #extra>\n\t\t\t\t\t<AsamButton type=\"default\">返回</AsamButton>\n\t\t\t\t</template>\n\t\t\t</AsamResult>\n\t\t</AsamCol>\n\t</AsamRow>\n</template>\n\n<script setup>\ndefineOptions({ name: 'AsamResultCapBasicUsageDemo' });\nimport { AsamRow, AsamCol, AsamResult, AsamButton } from '@asam-ui/ui';\n</script>\n\n<style scoped>\np:where(.example-paragraph) {\n\tmargin-block: 16px;\n\tline-height: 1.8;\n\toverflow-wrap: anywhere;\n}\n</style>\n",
