	"entry": "Demo.vue",
	"files": [
		{
			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamDialog/ep2147-custom-animation/js/Demo.vue",
			"sha256": "75e8f7f068c987b43944ac9ceace755aa9e09bd2326a4d7d21c1ded99b27cf4f",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-8360bef9a6e8218080736f5d26b7810a3936280f460d9fb13c82858948247523.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/8360bef9a6e8218080736f5d26b7810a3936280f460d9fb13c82858948247523.txt\n-->\n<template>\n\t<div>\n\t\t<AsamButton type=\"default\" plain @click=\"openDialog('fade')\"> 默认 </AsamButton>\n\t\t<AsamButton type=\"default\" plain @click=\"openDialog('scale')\"> 缩放 </AsamButton>\n\t\t<AsamButton type=\"default\" plain @click=\"openDialog('slide')\"> 滑动 </AsamButton>\n\t\t<AsamButton type=\"default\" plain @click=\"openDialog('bounce')\"> 弹跳 </AsamButton>\n\t\t<AsamButton type=\"default\" plain @click=\"openDialogWithObject\"> 对象配置 </AsamButton>\n\t</div>\n\n\t<AsamDialog\n\t\tv-model=\"dialogVisible\"\n\t\tclass=\"custom-transition-dialog\"\n\t\t:title=\"`${currentAnimation} Animation Dialog`\"\n\t\twidth=\"30%\"\n\t\t:transition=\"transitionConfig\"\n\t>\n\t\t<div>\n\t\t\t<p>\n\t\t\t\t当前动画： <strong>{{ currentAnimation }}</strong>\n\t\t\t</p>\n\t\t\t<p>此对话框演示 {{ currentAnimation }} 动画效果。</p>\n\t\t\t<p v-if=\"isObjectConfig\">\n\t\t\t\t<strong>使用对象配置：</strong><br />\n\t\t\t\t<code>{{ JSON.stringify(transitionConfig, null, 2) }}</code>\n\t\t\t</p>\n\t\t</div>\n\t\t<template #footer>\n\t\t\t<AsamButton type=\"default\" @click=\"dialogVisible = false\">取消</AsamButton>\n\t\t\t<AsamButton type=\"default\" @click=\"dialogVisible = false\"> 确认 </AsamButton>\n\t\t</template>\n\t</AsamDialog>\n</template>\n\n<script setup>\nimport { AsamButton, AsamDialog } from '@asam-ui/ui';\nimport { computed, ref } from 'vue';\nconst dialogVisible = ref(false);\nconst currentAnimation = ref('fade');\nconst isObjectConfig = ref(false);\nconst transitionConfig = computed(() => {\n\tif (isObjectConfig.value) {\n\t\treturn {\n\t\t\tname: 'dialog-custom-object',\n\t\t\tappear: true,\n\t\t\tmode: 'out-in',\n\t\t\tduration: 500\n\t\t};\n\t}\n\treturn `dialog-${currentAnimation.value}`;\n});\nconst openDialog = (type) => {\n\tcurrentAnimation.value = type;\n\tisObjectConfig.value = false;\n\tdialogVisible.value = true;\n};\nconst openDialogWithObject = () => {\n\tcurrentAnimation.value = 'object-config';\n\tisObjectConfig.value = true;\n\tdialogVisible.value = true;\n};\n</script>\n\n<style scoped>\ncode {\n\tbackground: var(--el-bg-color-page);\n\tpadding: 4px 8px;\n\tborder-radius: 4px;\n\tfont-size: 12px;\n\tdisplay: block;\n\tmargin-top: 8px;\n}\n</style>\n\n<style>\n/* Scale Animation */\n.dialog-scale-enter-active,\n.dialog-scale-leave-active,\n.dialog-scale-enter-active .el-dialog,\n.dialog-scale-leave-active .el-dialog {\n\ttransition: all 0.2s cubic-bezier(0.645, 0.045, 0.355, 1);\n}\n\n.dialog-scale-enter-from,\n.dialog-scale-leave-to {\n\topacity: 0;\n}\n\n.dialog-scale-enter-from .el-dialog,\n.dialog-scale-leave-to .el-dialog {\n\ttransform: scale(0.5);\n\topacity: 0;\n}\n\n/* Slide Animation */\n.dialog-slide-enter-active,\n.dialog-slide-leave-active,\n.dialog-slide-enter-active .el-dialog,\n.dialog-slide-leave-active .el-dialog {\n\ttransition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);\n}\n\n.dialog-slide-enter-from,\n.dialog-slide-leave-to {\n\topacity: 0;\n}\n\n.dialog-slide-enter-from .el-dialog,\n.dialog-slide-leave-to .el-dialog {\n\ttransform: translateY(-100px);\n\topacity: 0;\n}\n\n/* Bounce Animation */\n.dialog-bounce-enter-active,\n.dialog-bounce-leave-active,\n.dialog-bounce-enter-active .el-dialog,\n.dialog-bounce-leave-active .el-dialog {\n\ttransition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n}\n\n.dialog-bounce-enter-from,\n.dialog-bounce-leave-to {\n\topacity: 0;\n}\n\n.dialog-bounce-enter-from .el-dialog,\n.dialog-bounce-leave-to .el-dialog {\n\ttransform: scale(0.3) translateY(-50px);\n\topacity: 0;\n}\n\n/* Object Configuration Animation */\n.dialog-custom-object-enter-active,\n.dialog-custom-object-leave-active,\n.dialog-custom-object-enter-active .el-dialog,\n.dialog-custom-object-leave-active .el-dialog {\n\ttransition: all 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);\n}\n\n.dialog-custom-object-enter-from,\n.dialog-custom-object-leave-to {\n\topacity: 0;\n}\n\n.dialog-custom-object-enter-from .el-dialog,\n.dialog-custom-object-leave-to .el-dialog {\n\ttransform: rotate(180deg) scale(0.5);\n\topacity: 0;\n}\n</style>\n",
			"originalSourceSha256": "6e4aed291713dab1fa7aea8832093450b6d4798038de7f402ac465348a429995",
