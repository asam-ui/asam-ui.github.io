\n<script lang=\"ts\" setup>\ndefineOptions({ name: 'AsamContainerCapExampleDemo' });\nimport {\n\tAsamContainer,\n\tAsamAside,\n\tAsamScrollbar,\n\tAsamMenu,\n\tAsamSubMenu,\n\tAsamIcon,\n\tAsamMenuItemGroup,\n\tAsamMenuItem,\n\tAsamHeader,\n\tAsamDropdown,\n\tAsamDropdownMenu,\n\tAsamDropdownItem,\n\tAsamMain,\n\tAsamTable,\n\tAsamTableColumn\n} from '@asam-ui/ui';\n\nimport { ref } from 'vue';\nimport { Menu as IconMenu, Message, Setting } from '@asam-ui/icons-vue';\n\nconst item = {\n\tdate: '2016-05-02',\n\tname: 'Tom',\n\taddress: 'No. 189, Grove St, Los Angeles'\n};\nconst tableData = ref(Array.from({ length: 20 }, () => ({ ...item })));\n</script>\n\n<style scoped>\n.layout-container-demo .el-header {\n\tposition: relative;\n\tbackground-color: var(--el-color-primary-light-7);\n\tcolor: var(--el-text-color-primary);\n}\n\n.layout-container-demo .el-aside {\n\tcolor: var(--el-text-color-primary);\n\tbackground: var(--el-color-primary-light-8);\n}\n\n.layout-container-demo .el-menu {\n\tborder-right: none;\n}\n\n.layout-container-demo .el-main {\n\tpadding: 0;\n}\n\n.layout-container-demo .toolbar {\n\tdisplay: inline-flex;\n\talign-items: center;\n\tjustify-content: center;\n\theight: 100%;\n\tright: 20px;\n}\n</style>\n",
