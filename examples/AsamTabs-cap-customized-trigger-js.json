			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamTabs/cap-customized-trigger/js/Demo.vue",
			"sha256": "225bd779220985b79b158a2a7fdcffb389a0b84887a736969e91c2ff036d97f9",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-27a1ee50e9ea6238b62b521e5ebaaa3b24e2937491f280afcb35e330fa489cb7.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/27a1ee50e9ea6238b62b521e5ebaaa3b24e2937491f280afcb35e330fa489cb7.txt\n-->\n<template>\n\t<div style=\"margin-bottom: 20px\">\n\t\t<AsamButton size=\"small\" @click=\"addTab(editableTabsValue)\"> add tab </AsamButton>\n\t</div>\n\t<AsamTabs\n\t\t:model-value=\"editableTabsValue\"\n\t\ttype=\"card\"\n\t\tclass=\"demo-tabs\"\n\t\tclosable\n\t\t@update:model-value=\"\n\t\t\t(value) => {\n\t\t\t\tif (typeof value === 'string') editableTabsValue = value;\n\t\t\t}\n\t\t\"\n\t\t@tab-remove=\"removeTab\"\n\t>\n\t\t<AsamTabPane\n\t\t\tv-for=\"item in editableTabs\"\n\t\t\t:key=\"item.name\"\n\t\t\t:label=\"item.title\"\n\t\t\t:name=\"item.name\"\n\t\t>\n\t\t\t{{ item.content }}\n\t\t</AsamTabPane>\n\t</AsamTabs>\n</template>\n\n<script setup>\ndefineOptions({ name: 'AsamTabsCapCustomizedTriggerDemo' });\nimport { AsamButton, AsamTabs, AsamTabPane } from '@asam-ui/ui';\nimport { ref } from 'vue';\nlet tabIndex = 2;\nconst editableTabsValue = ref('2');\nconst editableTabs = ref([\n\t{\n\t\ttitle: 'Tab 1',\n\t\tname: '1',\n\t\tcontent: 'Tab 1 content'\n\t},\n\t{\n\t\ttitle: 'Tab 2',\n\t\tname: '2',\n\t\tcontent: 'Tab 2 content'\n\t}\n]);\nconst addTab = (targetName) => {\n\tvoid targetName;\n\tconst newTabName = `${++tabIndex}`;\n\teditableTabs.value.push({\n\t\ttitle: 'New Tab',\n\t\tname: newTabName,\n\t\tcontent: 'New Tab content'\n\t});\n\teditableTabsValue.value = newTabName;\n};\nconst removeTab = (targetName) => {\n\tconst tabs = editableTabs.value;\n\tlet activeName = editableTabsValue.value;\n\tif (activeName === targetName) {\n\t\ttabs.forEach((tab, index) => {\n\t\t\tif (tab.name === targetName) {\n\t\t\t\tconst nextTab = tabs[index + 1] || tabs[index - 1];\n\t\t\t\tif (nextTab) {\n\t\t\t\t\tactiveName = nextTab.name;\n\t\t\t\t}\n\t\t\t}\n\t\t});\n\t}\n\teditableTabsValue.value = activeName;\n\teditableTabs.value = tabs.filter((tab) => tab.name !== targetName);\n};\n</script>\n\n<style>\n/* stylelint-disable selector-class-pattern -- Base-component BEM selectors are required for this demonstration. */\n\n.demo-tabs > .el-tabs__content {\n\tpadding: 32px;\n\tcolor: #6b778c;\n\tfont-size: 32px;\n\tfont-weight: 600;\n}\n\n/* stylelint-enable selector-class-pattern */\n</style>\n",
			"originalSourceSha256": "92f36557bc736bde9aa00f861c0bf757da996cba047a2bf917f859c01b07d122",
