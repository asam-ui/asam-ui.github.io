			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-e2abb3963f7c8a32af22c1d80ed1e086ee8dcbeabb0fff2a0a3c1e7c5fc69ddd.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/e2abb3963f7c8a32af22c1d80ed1e086ee8dcbeabb0fff2a0a3c1e7c5fc69ddd.txt\n-->\n<template>\n\t<div class=\"flex gap-2\">\n\t\t<AsamCheckTag checked>Checked</AsamCheckTag>\n\t\t<AsamCheckTag :checked=\"checked\" @change=\"onChange\">Toggle me</AsamCheckTag>\n\t\t<AsamCheckTag disabled>Disabled</AsamCheckTag>\n\t</div>\n\t<div class=\"flex gap-2 mt-4\">\n\t\t<AsamCheckTag :checked=\"checked1\" type=\"primary\" @change=\"onChange1\"> Tag 1 </AsamCheckTag>\n\t\t<AsamCheckTag :checked=\"checked2\" type=\"success\" @change=\"onChange2\"> Tag 2 </AsamCheckTag>\n\t\t<AsamCheckTag :checked=\"checked3\" type=\"info\" @change=\"onChange3\"> Tag 3 </AsamCheckTag>\n\t\t<AsamCheckTag :checked=\"checked4\" type=\"warning\" @change=\"onChange4\"> Tag 4 </AsamCheckTag>\n\t\t<AsamCheckTag :checked=\"checked5\" type=\"danger\" @change=\"onChange5\"> Tag 5 </AsamCheckTag>\n\t\t<AsamCheckTag :checked=\"checked6\" disabled type=\"success\" @change=\"onChange6\">\n\t\t\tTag 6\n\t\t</AsamCheckTag>\n\t</div>\n</template>\n\n<script setup>\ndefineOptions({ name: 'AsamTagCapCheckableDemo' });\nimport { AsamCheckTag } from '@asam-ui/ui';\nimport { ref } from 'vue';\nconst checked = ref(false);\nconst checked1 = ref(true);\nconst checked2 = ref(true);\nconst checked3 = ref(true);\nconst checked4 = ref(true);\nconst checked5 = ref(true);\nconst checked6 = ref(true);\nconst onChange = (status) => {\n\tchecked.value = status;\n};\nconst onChange1 = (status) => {\n\tchecked1.value = status;\n};\nconst onChange2 = (status) => {\n\tchecked2.value = status;\n};\nconst onChange3 = (status) => {\n\tchecked3.value = status;\n};\nconst onChange4 = (status) => {\n\tchecked4.value = status;\n};\nconst onChange5 = (status) => {\n\tchecked5.value = status;\n};\nconst onChange6 = (status) => {\n\tchecked6.value = status;\n};\n</script>\n\n<style scoped>\n/* Local styles keep this sample runnable without a website utility-CSS preset. */\n.flex {\n\tdisplay: flex;\n}\n\n.gap-2 {\n\tgap: 0.5rem;\n}\n\n.mt-4 {\n\tmargin-top: 1rem;\n}\n</style>\n",
