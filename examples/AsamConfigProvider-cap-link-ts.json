			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamConfigProvider/cap-link/ts/Demo.vue",
			"sha256": "23b8d7c2b2f8f24b1c2ebf53c8a8cec3ad738d764865839cbbd3b983755d598b",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-9cd45b6ce88479c1e538ca5919fd10a573b838cdc2d8d3a10a8526a8ee1994d8.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/9cd45b6ce88479c1e538ca5919fd10a573b838cdc2d8d3a10a8526a8ee1994d8.txt\n-->\n<template>\n\t<div>\n\t\t<div class=\"flex gap-4\">\n\t\t\t<div class=\"flex flex-col basis-150px demo-gap\">\n\t\t\t\t<span>类型：</span>\n\t\t\t\t<AsamSelect\n\t\t\t\t\t:model-value=\"config.type\"\n\t\t\t\t\t@update:model-value=\"\n\t\t\t\t\t\t(value: unknown) => {\n\t\t\t\t\t\t\tif (\n\t\t\t\t\t\t\t\tvalue === 'primary' ||\n\t\t\t\t\t\t\t\tvalue === 'success' ||\n\t\t\t\t\t\t\t\tvalue === 'warning' ||\n\t\t\t\t\t\t\t\tvalue === 'danger' ||\n\t\t\t\t\t\t\t\tvalue === 'info' ||\n\t\t\t\t\t\t\t\tvalue === 'default'\n\t\t\t\t\t\t\t)\n\t\t\t\t\t\t\t\tconfig.type = value;\n\t\t\t\t\t\t}\n\t\t\t\t\t\"\n\t\t\t\t>\n\t\t\t\t\t<AsamOption v-for=\"type in linkTypes\" :key=\"type\" :value=\"type\" />\n\t\t\t\t</AsamSelect>\n\t\t\t</div>\n\t\t\t<div class=\"flex flex-col basis-150px demo-gap\">\n\t\t\t\t<span>下划线：</span>\n\t\t\t\t<AsamSelect\n\t\t\t\t\t:model-value=\"config.underline\"\n\t\t\t\t\t@update:model-value=\"\n\t\t\t\t\t\t(value: unknown) => {\n\t\t\t\t\t\t\tif (value === 'always' || value === 'hover' || value === 'never')\n\t\t\t\t\t\t\t\tconfig.underline = value;\n\t\t\t\t\t\t}\n\t\t\t\t\t\"\n\t\t\t\t>\n\t\t\t\t\t<AsamOption v-for=\"type in underlineOptions\" :key=\"type\" :value=\"type\" />\n\t\t\t\t</AsamSelect>\n\t\t\t</div>\n\t\t</div>\n\t\t<AsamDivider />\n\t\t<AsamConfigProvider :link=\"config\">\n\t\t\t<AsamLink>链接示例</AsamLink>\n\t\t</AsamConfigProvider>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\ndefineOptions({ name: 'AsamConfigProviderCapLinkDemo' });\nimport { AsamSelect, AsamOption, AsamDivider, AsamConfigProvider, AsamLink } from '@asam-ui/ui';\n\nimport { reactive } from 'vue';\n\nimport type { AsamConfigProviderLinkConfigContext } from '@asam-ui/ui';\n\nconst linkTypes = ['primary', 'success', 'warning', 'info', 'danger', 'default'];\nconst underlineOptions = ['always', 'never', 'hover'];\n\nconst config = reactive<AsamConfigProviderLinkConfigContext>({\n\ttype: 'success',\n\tunderline: 'always'\n});\n</script>\n\n<style scoped>\n/* Local styles keep this sample runnable without a website utility-CSS preset. */\n.flex {\n\tdisplay: flex;\n}\n\n.gap-4 {\n\tgap: 1rem;\n}\n\n.flex-col {\n\tflex-direction: column;\n}\n\n.basis-150px {\n\tflex-basis: 150px;\n}\n\n.demo-gap {\n\tgap: var(--asam-space-sm);\n}\n</style>\n",
