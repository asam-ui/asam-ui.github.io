			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-3ae45b3c0f8c8fb56fbd8abb45644a72c7c2db8a0114d3c3d73073a08299d7d2.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/3ae45b3c0f8c8fb56fbd8abb45644a72c7c2db8a0114d3c3d73073a08299d7d2.txt\n-->\n<template>\n\t<AsamSpace style=\"width: 100%\" fill>\n\t\t<div>\n\t\t\t<AsamButton type=\"default\" @click=\"setLoading\">点击重新加载</AsamButton>\n\t\t</div>\n\t\t<AsamSkeleton style=\"display: flex; gap: 8px\" :loading=\"loading\" animated :count=\"3\">\n\t\t\t<template #template>\n\t\t\t\t<div style=\"flex: 1\">\n\t\t\t\t\t<AsamSkeletonItem variant=\"image\" style=\"height: 240px\" />\n\t\t\t\t\t<div style=\"padding: 14px\">\n\t\t\t\t\t\t<AsamSkeletonItem variant=\"h3\" style=\"width: 50%\" />\n\t\t\t\t\t\t<div\n\t\t\t\t\t\t\tstyle=\"\n\t\t\t\t\t\t\t\tdisplay: flex;\n\t\t\t\t\t\t\t\talign-items: center;\n\t\t\t\t\t\t\t\tjustify-content: space-between;\n\t\t\t\t\t\t\t\tmargin-top: 16px;\n\t\t\t\t\t\t\t\theight: 16px;\n\t\t\t\t\t\t\t\"\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t<AsamSkeletonItem variant=\"text\" style=\"margin-right: 16px\" />\n\t\t\t\t\t\t\t<AsamSkeletonItem variant=\"text\" style=\"width: 30%\" />\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</template>\n\t\t\t<template #default>\n\t\t\t\t<AsamCard\n\t\t\t\t\tv-for=\"item in lists\"\n\t\t\t\t\t:key=\"item.name\"\n\t\t\t\t\t:body-style=\"{ padding: '0px', marginBottom: '1px' }\"\n\t\t\t\t>\n\t\t\t\t\t<AsamImage\n\t\t\t\t\t\t:src=\"item.imgUrl\"\n\t\t\t\t\t\tclass=\"image multi-content\"\n\t\t\t\t\t\tstyle=\"max-width: 100%\"\n\t\t\t\t\t/>\n\t\t\t\t\t<div style=\"padding: 14px\">\n\t\t\t\t\t\t<span>{{ item.name }}</span>\n\t\t\t\t\t\t<div class=\"bottom card-header\">\n\t\t\t\t\t\t\t<div class=\"time\">{{ currentDate }}</div>\n\t\t\t\t\t\t\t<AsamButton type=\"default\" text class=\"button\">操作按钮</AsamButton>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</AsamCard>\n\t\t\t</template>\n\t\t</AsamSkeleton>\n\t</AsamSpace>\n</template>\n\n<script setup>\ndefineOptions({ name: 'AsamSkeletonCapRenderingWithDataDemo' });\nimport {\n\tAsamImage,\n\tAsamSpace,\n\tAsamButton,\n\tAsamSkeleton,\n\tAsamSkeletonItem,\n\tAsamCard\n} from '@asam-ui/ui';\nimport { onMounted, ref } from 'vue';\nconst loading = ref(true);\nconst lists = ref([]);\nconst currentDate = new Date().toLocaleDateString('zh-CN');\nconst setLoading = () => {\n\tloading.value = true;\n\tsetTimeout(() => {\n\t\tloading.value = false;\n\t}, 2000);\n};\nonMounted(() => {\n\tloading.value = false;\n\tlists.value = [\n\t\t{\n\t\t\timgUrl: 'data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22320%22%20height%3D%22180%22%3E%3Crect%20width%3D%22320%22%20height%3D%22180%22%20fill%3D%22%238899aa%22%2F%3E%3Ccircle%20cx%3D%22240%22%20cy%3D%2245%22%20r%3D%2228%22%20fill%3D%22%23fff%22%2F%3E%3Cpath%20d%3D%22M0%20180L100%2060L220%20180%22%20fill%3D%22%2340566c%22%2F%3E%3Ctext%20x%3D%2212%22%20y%3D%2230%22%20fill%3D%22%23fff%22%3EASAM%20%E7%A4%BA%E4%BE%8B%3C%2Ftext%3E%3C%2Fsvg%3E',\n\t\t\tname: '鹿'\n\t\t},\n\t\t{\n\t\t\timgUrl: 'data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22320%22%20height%3D%22180%22%3E%3Crect%20width%3D%22320%22%20height%3D%22180%22%20fill%3D%22%238899aa%22%2F%3E%3Ccircle%20cx%3D%22240%22%20cy%3D%2245%22%20r%3D%2228%22%20fill%3D%22%23fff%22%2F%3E%3Cpath%20d%3D%22M0%20180L100%2060L220%20180%22%20fill%3D%22%2340566c%22%2F%3E%3Ctext%20x%3D%2212%22%20y%3D%2230%22%20fill%3D%22%23fff%22%3EASAM%20%E7%A4%BA%E4%BE%8B%3C%2Ftext%3E%3C%2Fsvg%3E',\n\t\t\tname: '马'\n\t\t},\n\t\t{\n\t\t\timgUrl: 'data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22320%22%20height%3D%22180%22%3E%3Crect%20width%3D%22320%22%20height%3D%22180%22%20fill%3D%22%238899aa%22%2F%3E%3Ccircle%20cx%3D%22240%22%20cy%3D%2245%22%20r%3D%2228%22%20fill%3D%22%23fff%22%2F%3E%3Cpath%20d%3D%22M0%20180L100%2060L220%20180%22%20fill%3D%22%2340566c%22%2F%3E%3Ctext%20x%3D%2212%22%20y%3D%2230%22%20fill%3D%22%23fff%22%3EASAM%20%E7%A4%BA%E4%BE%8B%3C%2Ftext%3E%3C%2Fsvg%3E',\n\t\t\tname: '山狮'\n\t\t}\n\t];\n});\n</script>\n",
