			"sha256": "77c2b4a9201e988a520a940d48292b6164591059ca7f59f8f37be47eccaabcaf",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-6d56f9725e34e0bedb6ca7f38537a7db3d68893fef699ead36e4a38cb740c8da.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/6d56f9725e34e0bedb6ca7f38537a7db3d68893fef699ead36e4a38cb740c8da.txt\n-->\n<template>\n\t<div class=\"flex flex-wrap demo-gap\">\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" @click=\"open\">普通 VNode</AsamButton>\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" @click=\"open1\">动态属性</AsamButton>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\nimport { AsamButton, AsamNotification, AsamSwitch, type AsamNotificationHandle } from '@asam-ui/ui';\n\nimport { onBeforeUnmount } from 'vue';\n\nimport { h, ref } from 'vue';\n\nconst open = () => {\n\ttrackAsamNotification(\n\t\tAsamNotification({\n\t\t\ttitle: '使用 VNode',\n\t\t\tmessage: h('p', null, [\n\t\t\t\th('span', null, '消息内容可以使用 '),\n\t\t\t\th('i', { style: 'color: teal' }, 'VNode')\n\t\t\t])\n\t\t})\n\t);\n};\n\nconst open1 = () => {\n\tconst checked = ref<boolean | string | number>(false);\n\ttrackAsamNotification(\n\t\tAsamNotification({\n\t\t\ttitle: '使用 VNode',\n\t\t\t// Should pass a function if VNode contains dynamic props\n\t\t\tmessage: () =>\n\t\t\t\th(AsamSwitch, {\n\t\t\t\t\tmodelValue: checked.value,\n\t\t\t\t\t'onUpdate:modelValue': (val: boolean | string | number) => {\n\t\t\t\t\t\tchecked.value = val;\n\t\t\t\t\t}\n\t\t\t\t})\n\t\t})\n\t);\n};\n\nconst ownedAsamNotification = new Set<AsamNotificationHandle>();\nlet mountedAsamNotification = true;\nconst trackAsamNotification = (handle: AsamNotificationHandle) => {\n\tif (mountedAsamNotification) ownedAsamNotification.add(handle);\n\telse handle.close();\n\treturn handle;\n};\nonBeforeUnmount(() => {\n\tmountedAsamNotification = false;\n\tfor (const handle of ownedAsamNotification) handle.close();\n\townedAsamNotification.clear();\n});\n</script>\n\n<style scoped>\n/* Keep layout utilities local so the downloaded SFC needs no CSS preset. */\n.flex {\n\tdisplay: flex;\n}\n.flex-wrap {\n\tflex-wrap: wrap;\n}\n.demo-gap {\n\tgap: var(--asam-space-sm);\n}\n</style>\n",
			"originalSourceSha256": "cf37502ef8591664286d6592f42acf6a19d8e11be044bb941f1b1e04e97907d1",
