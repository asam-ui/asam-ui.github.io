			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\nNotice resource: /licenses/source-notices/0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\n-->\n<template>\n\t<div class=\"custom-tree-node-container\">\n\t\t<AsamTree\n\t\t\tstyle=\"max-width: 600px\"\n\t\t\t:data=\"data\"\n\t\t\tshow-checkbox\n\t\t\tnode-key=\"id\"\n\t\t\tdefault-expand-all\n\t\t\t:expand-on-click-node=\"false\"\n\t\t\t:props=\"{ class: customNodeClass }\"\n\t\t/>\n\t</div>\n</template>\n\n<script setup>\n\n\nimport { AsamTree } from '@asam-ui/ui';\nconst customNodeClass = ({ isPenultimate }) => (isPenultimate ? 'is-penultimate' : '');\nconst data = [\n\t{\n\t\tid: 1,\n\t\tlabel: '一级节点 1',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tid: 4,\n\t\t\t\tlabel: '二级节点 1-1',\n\t\t\t\tisPenultimate: true,\n\t\t\t\tchildren: [\n\t\t\t\t\t{\n\t\t\t\t\t\tid: 9,\n\t\t\t\t\t\tlabel: '三级节点 1-1-1'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tid: 10,\n\t\t\t\t\t\tlabel: '三级节点 1-1-2'\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t}\n\t\t]\n\t},\n\t{\n\t\tid: 2,\n\t\tlabel: '一级节点 2',\n\t\tisPenultimate: true,\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tid: 5,\n\t\t\t\tlabel: '二级节点 2-1'\n\t\t\t},\n\t\t\t{\n\t\t\t\tid: 6,\n\t\t\t\tlabel: '二级节点 2-2'\n\t\t\t}\n\t\t]\n\t},\n\t{\n\t\tid: 3,\n\t\tlabel: '一级节点 3',\n\t\tisPenultimate: true,\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tid: 7,\n\t\t\t\tlabel: '二级节点 3-1'\n\t\t\t},\n\t\t\t{\n\t\t\t\tid: 8,\n\t\t\t\tlabel: '二级节点 3-2'\n\t\t\t}\n\t\t]\n\t}\n];\n</script>\n\n<style>\n.is-penultimate > .el-tree-node__content .el-tree-node__label {\n\tcolor: #626aef;\n}\n\n.is-penultimate > .el-tree-node__children > div {\n\tdisplay: inline-block;\n\tmargin-right: 4px;\n\n\t.el-tree-node__content {\n\t\tpadding-right: 16px;\n\t}\n\n\t&:not(:first-child) .el-tree-node__content {\n\t\tpadding-left: 0 !important;\n\t}\n}\n</style>\n",
			"originalSourceSha256": "40842172e5e7e02e6eac50270857c36e99dd74973ca925066305abbfae6ff2c1",
