			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-df191ba806c6c5db6ae6331d3ba4f8274e2c3a37755e20c85c561c158c72cc72.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/df191ba806c6c5db6ae6331d3ba4f8274e2c3a37755e20c85c561c158c72cc72.txt\n-->\n<template>\n\t<AsamSpace direction=\"vertical\" alignment=\"flex-start\">\n\t\t<div>\n\t\t\t<label style=\"margin-right: 16px\">切换加载状态</label>\n\t\t\t<AsamSwitch\n\t\t\t\t:model-value=\"loading\"\n\t\t\t\t@update:model-value=\"\n\t\t\t\t\t(value) => {\n\t\t\t\t\t\tif (typeof value === 'boolean') loading = value;\n\t\t\t\t\t}\n\t\t\t\t\"\n\t\t\t/>\n\t\t</div>\n\t\t<AsamSkeleton style=\"width: 240px\" :loading=\"loading\" animated>\n\t\t\t<template #template>\n\t\t\t\t<AsamSkeletonItem variant=\"image\" style=\"width: 240px; height: 240px\" />\n\t\t\t\t<div style=\"padding: 14px\">\n\t\t\t\t\t<AsamSkeletonItem variant=\"h3\" style=\"width: 50%\" />\n\t\t\t\t\t<div\n\t\t\t\t\t\tstyle=\"\n\t\t\t\t\t\t\tdisplay: flex;\n\t\t\t\t\t\t\talign-items: center;\n\t\t\t\t\t\t\tjustify-content: space-between;\n\t\t\t\t\t\t\tmargin-top: 16px;\n\t\t\t\t\t\t\theight: 16px;\n\t\t\t\t\t\t\"\n\t\t\t\t\t>\n\t\t\t\t\t\t<AsamSkeletonItem variant=\"text\" style=\"margin-right: 16px\" />\n\t\t\t\t\t\t<AsamSkeletonItem variant=\"text\" style=\"width: 30%\" />\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</template>\n\t\t\t<template #default>\n\t\t\t\t<AsamCard :body-style=\"{ padding: '0px', marginBottom: '1px' }\">\n\t\t\t\t\t<AsamImage\n\t\t\t\t\t\tsrc=\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22320%22%20height%3D%22180%22%3E%3Crect%20width%3D%22320%22%20height%3D%22180%22%20fill%3D%22%238899aa%22%2F%3E%3Ctext%20x%3D%2224%22%20y%3D%2290%22%20fill%3D%22white%22%3EASAM%20local%20sample%3C%2Ftext%3E%3C%2Fsvg%3E\"\n\t\t\t\t\t\tclass=\"image\"\n\t\t\t\t\t/>\n\t\t\t\t\t<div style=\"padding: 14px\">\n\t\t\t\t\t\t<span>美味汉堡</span>\n\t\t\t\t\t\t<div class=\"bottom card-header\">\n\t\t\t\t\t\t\t<div class=\"time\">{{ currentDate }}</div>\n\t\t\t\t\t\t\t<AsamButton type=\"default\" text class=\"button\">操作按钮</AsamButton>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</AsamCard>\n\t\t\t</template>\n\t\t</AsamSkeleton>\n\t</AsamSpace>\n</template>\n\n<script lang=\"ts\" setup>\ndefineOptions({ name: 'AsamSkeletonCapLoadingStateDemo' });\nimport {\n\tAsamImage,\n\tAsamSpace,\n\tAsamSwitch,\n\tAsamSkeleton,\n\tAsamSkeletonItem,\n\tAsamCard,\n\tAsamButton\n} from '@asam-ui/ui';\n\nimport { ref } from 'vue';\n\nconst loading = ref(true);\nconst currentDate = new Date().toLocaleDateString('zh-CN');\n</script>\n",
