			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-d506e3b4e856eba886e222d5382f2d0343f0ff6b20486c3baad501d5ce03c8f9.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/d506e3b4e856eba886e222d5382f2d0343f0ff6b20486c3baad501d5ce03c8f9.txt\n-->\n<template>\n\t<div class=\"demo-datetime-picker demo-layout-1\">\n\t\t<div class=\"block\">\n\t\t\t<span class=\"demonstration\">返回 Date 对象</span>\n\t\t\t<div class=\"demonstration\">值： {{ value1 }}</div>\n\t\t\t<AsamDatePicker\n\t\t\t\tv-model=\"value1\"\n\t\t\t\tvalue-format=\"\"\n\t\t\t\ttype=\"datetime\"\n\t\t\t\tplaceholder=\"选择日期\"\n\t\t\t\tformat=\"YYYY/MM/DD HH:mm:ss\"\n\t\t\t/>\n\t\t</div>\n\t\t<div class=\"block\">\n\t\t\t<span class=\"demonstration\">使用 value-format</span>\n\t\t\t<div class=\"demonstration\">值：{{ value2 }}</div>\n\t\t\t<AsamDatePicker\n\t\t\t\tv-model=\"value2\"\n\t\t\t\ttype=\"datetime\"\n\t\t\t\tplaceholder=\"选择日期\"\n\t\t\t\tformat=\"YYYY/MM/DD hh:mm:ss\"\n\t\t\t\tvalue-format=\"YYYY-MM-DD h:m:s a\"\n\t\t\t/>\n\t\t</div>\n\t\t<div class=\"block\">\n\t\t\t<span class=\"demonstration\">时间戳</span>\n\t\t\t<div class=\"demonstration\">值：{{ value3 }}</div>\n\t\t\t<AsamDatePicker\n\t\t\t\tv-model=\"value3\"\n\t\t\t\ttype=\"datetime\"\n\t\t\t\tplaceholder=\"选择日期\"\n\t\t\t\tformat=\"YYYY/MM/DD hh:mm:ss\"\n\t\t\t\tvalue-format=\"x\"\n\t\t\t/>\n\t\t</div>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\nimport type { AsamDateValue } from '@asam-ui/ui';\nimport { AsamDatePicker } from '@asam-ui/ui';\ndefineOptions({ name: 'AsamDatePickerofficialdatetimepickerdateandtimeformatsExample' });\n\nimport { ref } from 'vue';\n\nconst value1 = ref<AsamDateValue>('');\nconst value2 = ref<AsamDateValue>('');\nconst value3 = ref<AsamDateValue>('');\n</script>\n\n<style scoped>\n/* stylelint-disable selector-pseudo-class-no-unknown, selector-class-pattern, no-descending-specificity -- Vue deep/native BEM selectors and equivalent media selector groups retained from the fixed official example. */\n.demo-datetime-picker {\n\tdisplay: flex;\n\twidth: 100%;\n\tpadding: 0;\n\tflex-wrap: wrap;\n}\n\n.demo-datetime-picker .block {\n\tpadding: 30px 0;\n\ttext-align: center;\n\tborder-right: solid 1px var(--el-border-color);\n\tflex: 1;\n\tmin-width: 300px;\n}\n\n.demo-datetime-picker .block:last-child {\n\tborder-right: none;\n}\n\n.demo-datetime-picker .demonstration {\n\tdisplay: block;\n\tcolor: var(--el-text-color-secondary);\n\tfont-size: 14px;\n\tmargin-bottom: 20px;\n}\n\n@media (width <= 768px) {\n\t.demo-datetime-picker .block {\n\t\tflex: 100%;\n\t\tborder-right: none;\n\t\tborder-bottom: solid 1px var(--el-border-color);\n\t}\n\n\t.demo-datetime-picker .block:last-child {\n\t\tborder-bottom: none;\n\t}\n\n\t:deep(.el-date-editor.el-input) {\n\t\twidth: 100%;\n\t}\n\n\t:deep(.el-date-editor.el-input__wrapper) {\n\t\twidth: 100%;\n\t\tmax-width: 300px;\n\t}\n}\n</style>\n\n<style scoped>\n.demo-layout-1 {\n\tgap: var(--asam-space-md);\n}\n</style>\n",
