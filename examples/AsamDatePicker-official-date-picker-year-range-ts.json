			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-b3d472ff7065ee70592e3de9945804d78390e20a85c0f04f340cb91b303d4d3b.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/b3d472ff7065ee70592e3de9945804d78390e20a85c0f04f340cb91b303d4d3b.txt\n-->\n<template>\n\t<div class=\"demo-date-picker demo-layout-1\">\n\t\t<div class=\"block\">\n\t\t\t<span class=\"demonstration\">默认</span>\n\t\t\t<AsamDatePicker\n\t\t\t\tv-model=\"value1\"\n\t\t\t\tvalue-format=\"\"\n\t\t\t\ttype=\"yearrange\"\n\t\t\t\trange-separator=\"To\"\n\t\t\t\tstart-placeholder=\"Start Year\"\n\t\t\t\tend-placeholder=\"End Year\"\n\t\t\t/>\n\t\t</div>\n\t\t<div class=\"block\">\n\t\t\t<span class=\"demonstration\">带快捷选项</span>\n\t\t\t<AsamDatePicker\n\t\t\t\tv-model=\"value2\"\n\t\t\t\tvalue-format=\"\"\n\t\t\t\ttype=\"yearrange\"\n\t\t\t\tunlink-panels\n\t\t\t\trange-separator=\"To\"\n\t\t\t\tstart-placeholder=\"Start Year\"\n\t\t\t\tend-placeholder=\"End Year\"\n\t\t\t\t:shortcuts=\"shortcuts\"\n\t\t\t/>\n\t\t</div>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\nimport type { AsamDateValue } from '@asam-ui/ui';\nimport { AsamDatePicker } from '@asam-ui/ui';\ndefineOptions({ name: 'AsamDatePickerofficialdatepickeryearrangeExample' });\n\nimport { ref } from 'vue';\n\nconst value1 = ref<AsamDateValue>();\nconst value2 = ref<AsamDateValue>();\n\nconst shortcuts = [\n\t{\n\t\ttext: '今年',\n\t\tvalue: [new Date(), new Date()]\n\t},\n\t{\n\t\ttext: 'Last 10 years',\n\t\tvalue: () => {\n\t\t\tconst end = new Date();\n\t\t\tconst start = new Date(new Date().setFullYear(new Date().getFullYear() - 10));\n\t\t\treturn [start, end];\n\t\t}\n\t},\n\t{\n\t\ttext: 'Next 50 years',\n\t\tvalue: () => {\n\t\t\tconst start = new Date();\n\t\t\tconst end = new Date(new Date().setFullYear(new Date().getFullYear() + 50));\n\t\t\treturn [start, end];\n\t\t}\n\t}\n];\n</script>\n\n<style scoped>\n/* stylelint-disable selector-pseudo-class-no-unknown, selector-class-pattern, no-descending-specificity -- Vue deep/native BEM selectors and equivalent media selector groups retained from the fixed official example. */\n.demo-date-picker {\n\tdisplay: flex;\n\twidth: 100%;\n\tpadding: 0;\n\tflex-wrap: wrap;\n}\n\n.demo-date-picker .block {\n\tpadding: 1.5rem 0;\n\ttext-align: center;\n\tborder-right: solid 1px var(--el-border-color);\n\tflex: 1;\n\tmin-width: 300px;\n}\n\n.demo-date-picker .block:last-child {\n\tborder-right: none;\n}\n\n.demo-date-picker .demonstration {\n\tdisplay: block;\n\tcolor: var(--el-text-color-secondary);\n\tfont-size: 14px;\n\tmargin-bottom: 1rem;\n}\n\n@media screen and (width <= 768px) {\n\t.demo-date-picker .block {\n\t\tflex: 0 0 100%;\n\t\tpadding: 1rem 0;\n\t\tmin-width: auto;\n\t\tborder-right: none;\n\t\tborder-bottom: solid 1px var(--el-border-color);\n\t}\n\n\t.demo-date-picker .block:last-child {\n\t\tborder-bottom: none;\n\t}\n}\n</style>\n\n<style scoped>\n.demo-layout-1 {\n\tgap: var(--asam-space-md);\n}\n</style>\n",
