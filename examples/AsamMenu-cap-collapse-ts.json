			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-26264adc5c12d2f61d6407ce474ad0bec2e8b72a61329badf88827a9aff4c879.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/26264adc5c12d2f61d6407ce474ad0bec2e8b72a61329badf88827a9aff4c879.txt\n-->\n<template>\n\t<AsamRadioGroup\n\t\t:model-value=\"isCollapse\"\n\t\tstyle=\"margin-bottom: 20px\"\n\t\t@update:model-value=\"\n\t\t\t(value) => {\n\t\t\t\tif (typeof value === 'boolean') isCollapse = value;\n\t\t\t}\n\t\t\"\n\t>\n\t\t<AsamRadioButton :value=\"false\">expand</AsamRadioButton>\n\t\t<AsamRadioButton :value=\"true\">collapse</AsamRadioButton>\n\t</AsamRadioGroup>\n\t<AsamMenu\n\t\tdefault-active=\"2\"\n\t\tclass=\"el-menu-vertical-demo\"\n\t\t:collapse=\"isCollapse\"\n\t\t@open=\"handleOpen\"\n\t\t@close=\"handleClose\"\n\t>\n\t\t<AsamSubMenu index=\"1\">\n\t\t\t<template #title>\n\t\t\t\t<AsamIcon><location /></AsamIcon>\n\t\t\t\t<span>Navigator One</span>\n\t\t\t</template>\n\t\t\t<AsamMenuItemGroup>\n\t\t\t\t<template #title><span>Group One</span></template>\n\t\t\t\t<AsamMenuItem index=\"1-1\">item one</AsamMenuItem>\n\t\t\t\t<AsamMenuItem index=\"1-2\">item two</AsamMenuItem>\n\t\t\t</AsamMenuItemGroup>\n\t\t\t<AsamMenuItemGroup title=\"Group Two\">\n\t\t\t\t<AsamMenuItem index=\"1-3\">item three</AsamMenuItem>\n\t\t\t</AsamMenuItemGroup>\n\t\t\t<AsamSubMenu index=\"1-4\">\n\t\t\t\t<template #title><span>item four</span></template>\n\t\t\t\t<AsamMenuItem index=\"1-4-1\">item one</AsamMenuItem>\n\t\t\t</AsamSubMenu>\n\t\t</AsamSubMenu>\n\t\t<AsamMenuItem index=\"2\">\n\t\t\t<AsamIcon><icon-menu /></AsamIcon>\n\t\t\t<template #title>Navigator Two</template>\n\t\t</AsamMenuItem>\n\t\t<AsamMenuItem index=\"3\" disabled>\n\t\t\t<AsamIcon><document /></AsamIcon>\n\t\t\t<template #title>Navigator Three</template>\n\t\t</AsamMenuItem>\n\t\t<AsamMenuItem index=\"4\">\n\t\t\t<AsamIcon><setting /></AsamIcon>\n\t\t\t<template #title>Navigator Four</template>\n\t\t</AsamMenuItem>\n\t</AsamMenu>\n</template>\n\n<script lang=\"ts\" setup>\ndefineOptions({ name: 'AsamMenuCapCollapseDemo' });\nimport {\n\tAsamRadioGroup,\n\tAsamRadioButton,\n\tAsamMenu,\n\tAsamSubMenu,\n\tAsamIcon,\n\tAsamMenuItemGroup,\n\tAsamMenuItem\n} from '@asam-ui/ui';\n\nimport { ref } from 'vue';\nimport { Document, Menu as IconMenu, Location, Setting } from '@asam-ui/icons-vue';\n\nconst isCollapse = ref(true);\nconst handleOpen = (key: string, keyPath: string[]) => {\n\tconsole.log(key, keyPath);\n};\nconst handleClose = (key: string, keyPath: string[]) => {\n\tconsole.log(key, keyPath);\n};\n</script>\n\n<style>\n/* stylelint-disable selector-class-pattern -- Base-component BEM selectors are required for this demonstration. */\n\n.el-menu-vertical-demo:not(.el-menu--collapse) {\n\twidth: 200px;\n\tmin-height: 400px;\n}\n\n/* stylelint-enable selector-class-pattern */\n</style>\n",
