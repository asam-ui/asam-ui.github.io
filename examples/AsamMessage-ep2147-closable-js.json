			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-652a0d5e0d44a641b5626cfbe9664958dc8e7ac60872fa68006f99af10e50688.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/652a0d5e0d44a641b5626cfbe9664958dc8e7ac60872fa68006f99af10e50688.txt\n-->\n<template>\n\t<div class=\"flex flex-wrap gap-1\">\n\t\t<AsamButton class=\"!ml-0\" :plain=\"true\" @click=\"open6\">Primary</AsamButton>\n\t\t<AsamButton class=\"!ml-0\" :plain=\"true\" @click=\"open2\">Success</AsamButton>\n\t\t<AsamButton class=\"!ml-0\" :plain=\"true\" @click=\"open3\">Warning</AsamButton>\n\t\t<AsamButton class=\"!ml-0\" :plain=\"true\" @click=\"open1\">Info</AsamButton>\n\t\t<AsamButton class=\"!ml-0\" :plain=\"true\" @click=\"open4\">Error</AsamButton>\n\t\t<AsamButton class=\"!ml-0\" :plain=\"true\" @click=\"open5\">\n\t\t\tWon't close automatically\n\t\t</AsamButton>\n\t</div>\n</template>\n\n<script setup>\nimport { AsamButton, AsamMessage } from '@asam-ui/ui';\nimport { onBeforeUnmount } from 'vue';\nconst open1 = () => {\n\ttrackAsamMessage(\n\t\tAsamMessage({\n\t\t\tshowClose: true,\n\t\t\tmessage: 'This is a info message.'\n\t\t})\n\t);\n};\nconst open2 = () => {\n\ttrackAsamMessage(\n\t\tAsamMessage({\n\t\t\tshowClose: true,\n\t\t\tmessage: 'Congrats, this is a success message.',\n\t\t\ttype: 'success'\n\t\t})\n\t);\n};\nconst open3 = () => {\n\ttrackAsamMessage(\n\t\tAsamMessage({\n\t\t\tshowClose: true,\n\t\t\tmessage: 'Warning, this is a warning message.',\n\t\t\ttype: 'warning'\n\t\t})\n\t);\n};\nconst open4 = () => {\n\ttrackAsamMessage(\n\t\tAsamMessage({\n\t\t\tshowClose: true,\n\t\t\tmessage: 'Oops, this is a error message.',\n\t\t\ttype: 'error'\n\t\t})\n\t);\n};\nconst open5 = () => {\n\ttrackAsamMessage(\n\t\tAsamMessage({\n\t\t\tshowClose: true,\n\t\t\tmessage: 'Oops, this is a message that does not automatically close.',\n\t\t\tduration: 0\n\t\t})\n\t);\n};\nconst open6 = () => {\n\ttrackAsamMessage(\n\t\tAsamMessage({\n\t\t\tshowClose: true,\n\t\t\tmessage: 'This is a primary message.',\n\t\t\ttype: 'primary'\n\t\t})\n\t);\n};\nconst ownedAsamMessage = new Set();\nlet mountedAsamMessage = true;\nconst trackAsamMessage = (handle) => {\n\tif (mountedAsamMessage) ownedAsamMessage.add(handle);\n\telse handle.close();\n\treturn handle;\n};\nonBeforeUnmount(() => {\n\tmountedAsamMessage = false;\n\tfor (const handle of ownedAsamMessage) handle.close();\n\townedAsamMessage.clear();\n});\n</script>\n",
