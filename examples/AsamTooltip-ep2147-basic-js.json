			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-d726dfe1e5f34355c678d76444101807f213a070e24152795115e085590081d4.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/d726dfe1e5f34355c678d76444101807f213a070e24152795115e085590081d4.txt\n-->\n<template>\n\t<div class=\"tooltip-base-box demo-layout-1\">\n\t\t<div class=\"row center demo-layout-2\">\n\t\t\t<AsamTooltip\n\t\t\t\tclass=\"box-item\"\n\t\t\t\teffect=\"dark\"\n\t\t\t\tcontent=\"顶部左侧提示信息\"\n\t\t\t\tplacement=\"top-start\"\n\t\t\t>\n\t\t\t\t<AsamButton type=\"default\">顶部左侧</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t\t<AsamTooltip class=\"box-item\" effect=\"dark\" content=\"顶部居中提示信息\" placement=\"top\">\n\t\t\t\t<AsamButton type=\"default\">顶部</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t\t<AsamTooltip\n\t\t\t\tclass=\"box-item\"\n\t\t\t\teffect=\"dark\"\n\t\t\t\tcontent=\"顶部右侧提示信息\"\n\t\t\t\tplacement=\"top-end\"\n\t\t\t>\n\t\t\t\t<AsamButton type=\"default\">顶部右侧</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t</div>\n\t\t<div class=\"row demo-layout-3\">\n\t\t\t<AsamTooltip class=\"box-item\" effect=\"dark\" placement=\"left-start\">\n\t\t\t\t<template #content>\n\t\t\t\t\t左上方\n\t\t\t\t\t<br />\n\t\t\t\t\t显示提示\n\t\t\t\t</template>\n\t\t\t\t<AsamButton type=\"default\">左侧顶部</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t\t<AsamTooltip class=\"box-item\" effect=\"dark\" placement=\"right-start\">\n\t\t\t\t<template #content>\n\t\t\t\t\t右上方\n\t\t\t\t\t<br />\n\t\t\t\t\t显示提示\n\t\t\t\t</template>\n\t\t\t\t<AsamButton type=\"default\">右侧顶部</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t</div>\n\t\t<div class=\"row demo-layout-4\">\n\t\t\t<AsamTooltip class=\"box-item\" effect=\"dark\" placement=\"left\">\n\t\t\t\t<template #content>\n\t\t\t\t\t左侧居中\n\t\t\t\t\t<br />\n\t\t\t\t\t显示提示\n\t\t\t\t</template>\n\t\t\t\t<AsamButton type=\"default\" class=\"mt-3 mb-3\">左侧</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t\t<AsamTooltip class=\"box-item\" effect=\"dark\" placement=\"right\">\n\t\t\t\t<template #content>\n\t\t\t\t\t右侧居中\n\t\t\t\t\t<br />\n\t\t\t\t\t显示提示\n\t\t\t\t</template>\n\t\t\t\t<AsamButton type=\"default\">右侧</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t</div>\n\t\t<div class=\"row demo-layout-5\">\n\t\t\t<AsamTooltip class=\"box-item\" effect=\"dark\" placement=\"left-end\">\n\t\t\t\t<template #content>\n\t\t\t\t\t左下方\n\t\t\t\t\t<br />\n\t\t\t\t\t显示提示\n\t\t\t\t</template>\n\t\t\t\t<AsamButton type=\"default\">左侧底部</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t\t<AsamTooltip class=\"box-item\" effect=\"dark\" placement=\"right-end\">\n\t\t\t\t<template #content>\n\t\t\t\t\t右下方\n\t\t\t\t\t<br />\n\t\t\t\t\t显示提示\n\t\t\t\t</template>\n\t\t\t\t<AsamButton type=\"default\">右侧底部</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t</div>\n\t\t<div class=\"row center demo-layout-6\">\n\t\t\t<AsamTooltip\n\t\t\t\tclass=\"box-item\"\n\t\t\t\teffect=\"dark\"\n\t\t\t\tcontent=\"底部左侧提示信息\"\n\t\t\t\tplacement=\"bottom-start\"\n\t\t\t>\n\t\t\t\t<AsamButton type=\"default\">底部左侧</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t\t<AsamTooltip\n\t\t\t\tclass=\"box-item\"\n\t\t\t\teffect=\"dark\"\n\t\t\t\tcontent=\"底部居中提示信息\"\n\t\t\t\tplacement=\"bottom\"\n\t\t\t>\n\t\t\t\t<AsamButton type=\"default\">底部</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t\t<AsamTooltip\n\t\t\t\tclass=\"box-item\"\n\t\t\t\teffect=\"dark\"\n\t\t\t\tcontent=\"底部右侧提示信息\"\n\t\t\t\tplacement=\"bottom-end\"\n\t\t\t>\n\t\t\t\t<AsamButton type=\"default\">底部右侧</AsamButton>\n\t\t\t</AsamTooltip>\n\t\t</div>\n\t</div>\n</template>\n\n<script setup>\nimport { AsamButton, AsamTooltip } from '@asam-ui/ui';\n</script>\n\n<style>\n.tooltip-base-box {\n\twidth: 600px;\n}\n\n.tooltip-base-box .row {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n}\n\n.tooltip-base-box .center {\n\tjustify-content: center;\n}\n\n.tooltip-base-box .box-item {\n\twidth: 110px;\n\tmargin-top: 10px;\n}\n</style>\n\n<style scoped>\n/* Keep layout utilities local so the downloaded SFC needs no CSS preset. */\n.mt-3 {\n\tmargin-top: calc(var(--asam-space-xs) * 3);\n}\n.mb-3 {\n\tmargin-bottom: calc(var(--asam-space-xs) * 3);\n}\n</style>\n\n<style scoped>\n.demo-layout-1 {\n\tdisplay: grid;\n\tgap: var(--asam-space-md);\n}\n.demo-layout-2 {\n\tgap: var(--asam-space-md);\n}\n.demo-layout-3 {\n\tgap: var(--asam-space-md);\n}\n.demo-layout-4 {\n\tgap: var(--asam-space-md);\n}\n.demo-layout-5 {\n\tgap: var(--asam-space-md);\n}\n.demo-layout-6 {\n\tgap: var(--asam-space-md);\n}\n</style>\n",
