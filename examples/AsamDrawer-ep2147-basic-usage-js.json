	"entry": "Demo.vue",
	"files": [
		{
			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamDrawer/ep2147-basic-usage/js/Demo.vue",
			"sha256": "0abad54abc433c4d802334816eadd4ec18e1b35fb244b122236ac3f9e484b7bb",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-f353c5b32e4e2002a6fae49f2c13e5ee7acf3149cef89f67e875495d3e29cb80.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/f353c5b32e4e2002a6fae49f2c13e5ee7acf3149cef89f67e875495d3e29cb80.txt\n-->\n<template>\n\t<label\n\t\t>展开方向\n\t\t<select :value=\"direction\" @change=\"changeDirection\">\n\t\t\t<option value=\"ltr\">从左展开</option>\n\t\t\t<option value=\"rtl\">从右展开</option>\n\t\t\t<option value=\"ttb\">从上展开</option>\n\t\t\t<option value=\"btt\">从下展开</option>\n\t\t</select></label\n\t>\n\n\t<AsamButton type=\"primary\" style=\"margin-left: 16px\" @click=\"drawer = true\"> open </AsamButton>\n\t<AsamButton type=\"primary\" style=\"margin-left: 16px\" @click=\"drawer2 = true\">\n\t\twith footer\n\t</AsamButton>\n\n\t<AsamDrawer\n\t\tv-model=\"drawer\"\n\t\ttitle=\"I am the title\"\n\t\t:direction=\"direction\"\n\t\t:before-close=\"handleClose\"\n\t>\n\t\t<span>Hi, there!</span>\n\t</AsamDrawer>\n\t<AsamDrawer v-model=\"drawer2\" :direction=\"direction\">\n\t\t<template #header>\n\t\t\t<h4>set title by slot</h4>\n\t\t</template>\n\t\t<template #default>\n\t\t\t<div>\n\t\t\t\t<label\n\t\t\t\t\t><input v-model=\"radio1\" type=\"radio\" value=\"Option 1\" />\n\t\t\t\t\tOption 1\n\t\t\t\t</label>\n\t\t\t\t<label\n\t\t\t\t\t><input v-model=\"radio1\" type=\"radio\" value=\"Option 2\" />\n\t\t\t\t\tOption 2\n\t\t\t\t</label>\n\t\t\t</div>\n\t\t</template>\n\t\t<template #footer>\n\t\t\t<div style=\"flex: auto\">\n\t\t\t\t<AsamButton @click=\"cancelClick\">cancel</AsamButton>\n\t\t\t\t<AsamButton type=\"primary\" @click=\"confirmClick\">confirm</AsamButton>\n\t\t\t</div>\n\t\t</template>\n\t</AsamDrawer>\n</template>\n\n<script setup>\nimport { AsamButton, AsamDrawer, AsamMessageBox } from '@asam-ui/ui';\nimport { ref } from 'vue';\nconst drawer = ref(false);\nconst drawer2 = ref(false);\nconst direction = ref('rtl');\nconst radio1 = ref('Option 1');\nconst handleClose = (done) => {\n\tAsamMessageBox.confirm('Are you sure you want to close this?')\n\t\t.then(() => {\n\t\t\tdone();\n\t\t})\n\t\t.catch(() => {\n\t\t\t// catch error\n\t\t});\n};\nfunction cancelClick() {\n\tdrawer2.value = false;\n}\nfunction confirmClick() {\n\tAsamMessageBox.confirm(`Are you confirm to chose ${radio1.value} ?`)\n\t\t.then(() => {\n\t\t\tdrawer2.value = false;\n\t\t})\n\t\t.catch(() => {\n\t\t\t// catch error\n\t\t});\n}\nconst changeDirection = (event) => {\n\tconst target = event.currentTarget;\n\tif (!(target instanceof HTMLSelectElement)) return;\n\tconst value = target.value;\n\tif (value === 'ltr' || value === 'rtl' || value === 'ttb' || value === 'btt') {\n\t\tdirection.value = value;\n\t}\n};\n</script>\n",
