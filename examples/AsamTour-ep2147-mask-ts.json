			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-ad4e3582dbd72d671469cb2994ffb5b9a4bc49f1e12615d246cf979ebdab3538.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/ad4e3582dbd72d671469cb2994ffb5b9a4bc49f1e12615d246cf979ebdab3538.txt\n-->\n<template>\n\t<AsamButton type=\"default\" @click=\"open = true\">开始导览</AsamButton>\n\n\t<AsamDivider />\n\n\t<AsamSpace>\n\t\t<AsamButton type=\"default\" ref=\"ref1\">上传</AsamButton>\n\t\t<AsamButton ref=\"ref2\" type=\"default\">保存</AsamButton>\n\t\t<AsamButton type=\"default\" ref=\"ref3\" :icon=\"MoreFilled\" />\n\t</AsamSpace>\n\n\t<AsamTour\n\t\tv-model=\"open\"\n\t\t:mask=\"{\n\t\t\tstyle: {\n\t\t\t\tboxShadow: 'inset 0 0 15px #333'\n\t\t\t},\n\t\t\tcolor: 'rgba(80, 255, 255, .4)'\n\t\t}\"\n\t>\n\t\t<AsamTourStep :target=\"ref1?.$el\" title=\"上传文件\">\n\t\t\t<AsamImage\n\t\t\t\tsrc=\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22120%22%20height%3D%2248%22%20viewBox%3D%220%200%20120%2048%22%3E%3Crect%20width%3D%22120%22%20height%3D%2248%22%20fill%3D%22%23e8edf3%22%2F%3E%3Ctext%20x%3D%2212%22%20y%3D%2231%22%20fill%3D%22%23345%22%20font-size%3D%2224%22%3EASAM%3C%2Ftext%3E%3C%2Fsvg%3E\"\n\t\t\t\talt=\"tour.png\"\n\t\t\t/>\n\t\t\t<div>将文件放在这里。</div>\n\t\t</AsamTourStep>\n\t\t<AsamTourStep\n\t\t\t:target=\"ref2?.$el\"\n\t\t\ttitle=\"保存\"\n\t\t\tdescription=\"保存修改\"\n\t\t\t:mask=\"{\n\t\t\t\tstyle: {\n\t\t\t\t\tboxShadow: 'inset 0 0 15px #fff'\n\t\t\t\t},\n\t\t\t\tcolor: 'rgba(40, 0, 255, .4)'\n\t\t\t}\"\n\t\t/>\n\t\t<AsamTourStep\n\t\t\t:target=\"ref3?.$el\"\n\t\t\ttitle=\"其他操作\"\n\t\t\tdescription=\"点击查看其他内容\"\n\t\t\t:mask=\"false\"\n\t\t/>\n\t</AsamTour>\n</template>\n\n<script lang=\"ts\" setup>\nimport { AsamImage, AsamButton, AsamDivider, AsamSpace, AsamTour, AsamTourStep } from '@asam-ui/ui';\ntype ButtonInstance = InstanceType<typeof AsamButton>;\nimport { ref } from 'vue';\nimport { MoreFilled } from '@asam-ui/icons-vue';\n\nconst ref1 = ref<ButtonInstance>();\nconst ref2 = ref<ButtonInstance>();\nconst ref3 = ref<ButtonInstance>();\n\nconst open = ref(false);\n</script>\n",
