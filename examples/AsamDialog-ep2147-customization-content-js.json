			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamDialog/ep2147-customization-content/js/Demo.vue",
			"sha256": "37e7b569df17e57855e20f242184f7ef441d0848c274a1c963adf42de53bb769",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-e8c9291ec84144989e5aa39e9a402c42748f74941aa2d7a3c5a2791edc8a0aa4.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/e8c9291ec84144989e5aa39e9a402c42748f74941aa2d7a3c5a2791edc8a0aa4.txt\n-->\n<template>\n\t<div class=\"flex flex-wrap gap-1\">\n\t\t<AsamButton class=\"!ml-0\" plain @click=\"dialogTableVisible = true\">\n\t\t\tOpen a Table nested Dialog\n\t\t</AsamButton>\n\n\t\t<AsamButton class=\"!ml-0\" plain @click=\"dialogFormVisible = true\">\n\t\t\tOpen a Form nested Dialog\n\t\t</AsamButton>\n\t</div>\n\n\t<AsamDialog v-model=\"dialogTableVisible\" title=\"Shipping address\" width=\"800\">\n\t\t<AsamTable :data=\"gridData\">\n\t\t\t<AsamTableColumn property=\"date\" label=\"Date\" width=\"150\" />\n\t\t\t<AsamTableColumn property=\"name\" label=\"Name\" width=\"200\" />\n\t\t\t<AsamTableColumn property=\"address\" label=\"Address\" />\n\t\t</AsamTable>\n\t</AsamDialog>\n\n\t<AsamDialog v-model=\"dialogFormVisible\" title=\"Shipping address\" width=\"500\">\n\t\t<AsamBaseForm :model=\"form\">\n\t\t\t<AsamFormItem label=\"Promotion name\" :label-width=\"formLabelWidth\">\n\t\t\t\t<AsamInput\n\t\t\t\t\t:model-value=\"form.name\"\n\t\t\t\t\t@update:model-value=\"form.name = String($event ?? '')\"\n\t\t\t\t\tautocomplete=\"off\"\n\t\t\t\t/>\n\t\t\t</AsamFormItem>\n\t\t\t<AsamFormItem label=\"Zones\" :label-width=\"formLabelWidth\">\n\t\t\t\t<AsamSelect\n\t\t\t\t\t:model-value=\"form.region\"\n\t\t\t\t\t@update:model-value=\"form.region = String($event ?? '')\"\n\t\t\t\t\tplaceholder=\"Please select a zone\"\n\t\t\t\t>\n\t\t\t\t\t<AsamOption label=\"Zone No.1\" value=\"shanghai\" />\n\t\t\t\t\t<AsamOption label=\"Zone No.2\" value=\"beijing\" />\n\t\t\t\t</AsamSelect>\n\t\t\t</AsamFormItem>\n\t\t</AsamBaseForm>\n\t\t<template #footer>\n\t\t\t<div class=\"dialog-footer\">\n\t\t\t\t<AsamButton @click=\"dialogFormVisible = false\">Cancel</AsamButton>\n\t\t\t\t<AsamButton type=\"primary\" @click=\"dialogFormVisible = false\"> Confirm </AsamButton>\n\t\t\t</div>\n\t\t</template>\n\t</AsamDialog>\n</template>\n\n<script setup>\nimport {\n\tAsamBaseForm,\n\tAsamButton,\n\tAsamDialog,\n\tAsamFormItem,\n\tAsamInput,\n\tAsamOption,\n\tAsamSelect,\n\tAsamTable,\n\tAsamTableColumn\n} from '@asam-ui/ui';\nimport { reactive, ref } from 'vue';\nconst dialogTableVisible = ref(false);\nconst dialogFormVisible = ref(false);\nconst formLabelWidth = '140px';\nconst form = reactive({\n\tname: '',\n\tregion: '',\n\tdate1: '',\n\tdate2: '',\n\tdelivery: false,\n\ttype: [],\n\tresource: '',\n\tdesc: ''\n});\nconst gridData = [\n\t{\n\t\tdate: '2016-05-02',\n\t\tname: 'John Smith',\n\t\taddress: 'No.1518,  Jinshajiang Road, Putuo District'\n\t},\n\t{\n\t\tdate: '2016-05-04',\n\t\tname: 'John Smith',\n\t\taddress: 'No.1518,  Jinshajiang Road, Putuo District'\n\t},\n\t{\n\t\tdate: '2016-05-01',\n\t\tname: 'John Smith',\n\t\taddress: 'No.1518,  Jinshajiang Road, Putuo District'\n\t},\n\t{\n\t\tdate: '2016-05-03',\n\t\tname: 'John Smith',\n\t\taddress: 'No.1518,  Jinshajiang Road, Putuo District'\n\t}\n];\n</script>\n",
