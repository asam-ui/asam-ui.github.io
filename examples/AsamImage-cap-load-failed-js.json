			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-bf5a3f0aa10550033a92ae7fa3159780e9efbfe4f521321ec5b8f8c6d7301788.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/bf5a3f0aa10550033a92ae7fa3159780e9efbfe4f521321ec5b8f8c6d7301788.txt\n-->\n<template>\n\t<div class=\"demo-image__error ui032-flex ui032-gap-2\">\n\t\t<AsamImage />\n\t\t<AsamImage>\n\t\t\t<template #error>\n\t\t\t\t<div class=\"image-viewer-slot image-slot\">\n\t\t\t\t\t<AsamIcon><icon-picture /></AsamIcon>\n\t\t\t\t</div>\n\t\t\t</template>\n\t\t</AsamImage>\n\t\t<AsamImage :src=\"url\" :preview-src-list=\"srcList\" show-progress>\n\t\t\t<template #viewer-error=\"{ activeIndex, src }\">\n\t\t\t\t<div class=\"image-slot viewer-error\">\n\t\t\t\t\t<AsamIcon><icon-picture /></AsamIcon>\n\t\t\t\t\t<span>\n\t\t\t\t\t\tviewer-error 插槽，当前索引： {{ activeIndex }}，来源：\n\t\t\t\t\t\t{{ src }}\n\t\t\t\t\t</span>\n\t\t\t\t</div>\n\t\t\t</template>\n\t\t</AsamImage>\n\t\t<AsamButton type=\"default\" @click=\"showPreview = true\"> 受控预览 </AsamButton>\n\n\t\t<AsamImageViewer\n\t\t\tv-if=\"showPreview\"\n\t\t\tshow-progress\n\t\t\t:url-list=\"srcList\"\n\t\t\t@close=\"showPreview = false\"\n\t\t>\n\t\t\t<template #viewer-error=\"{ activeIndex, src }\">\n\t\t\t\t<div class=\"image-slot viewer-error\">\n\t\t\t\t\t<AsamIcon><icon-picture /></AsamIcon>\n\t\t\t\t\t<span>\n\t\t\t\t\t\tviewer-error 插槽，当前索引： {{ activeIndex }}，来源：\n\t\t\t\t\t\t{{ src }}\n\t\t\t\t\t</span>\n\t\t\t\t</div>\n\t\t\t</template>\n\t\t</AsamImageViewer>\n\t</div>\n</template>\n\n<script setup>\ndefineOptions({ name: 'AsamImageCapLoadFailedDemo' });\nimport { AsamImage, AsamIcon, AsamButton, AsamImageViewer } from '@asam-ui/ui';\nimport { ref } from 'vue';\nimport { Picture as IconPicture } from '@asam-ui/icons-vue';\nconst showPreview = ref(false);\nconst srcList = [\n\t'data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22320%22%20height%3D%22180%22%3E%3Crect%20width%3D%22320%22%20height%3D%22180%22%20fill%3D%22%238899aa%22%2F%3E%3Ccircle%20cx%3D%22240%22%20cy%3D%2245%22%20r%3D%2228%22%20fill%3D%22%23fff%22%2F%3E%3Cpath%20d%3D%22M0%20180L100%2060L220%20180%22%20fill%3D%22%2340566c%22%2F%3E%3Ctext%20x%3D%2212%22%20y%3D%2230%22%20fill%3D%22%23fff%22%3EASAM%20%E7%A4%BA%E4%BE%8B%3C%2Ftext%3E%3C%2Fsvg%3E',\n\t'data:image/png;base64,AA=='\n];\nconst url =\n\t'data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22320%22%20height%3D%22180%22%3E%3Crect%20width%3D%22320%22%20height%3D%22180%22%20fill%3D%22%238899aa%22%2F%3E%3Ccircle%20cx%3D%22240%22%20cy%3D%2245%22%20r%3D%2228%22%20fill%3D%22%23fff%22%2F%3E%3Cpath%20d%3D%22M0%20180L100%2060L220%20180%22%20fill%3D%22%2340566c%22%2F%3E%3Ctext%20x%3D%2212%22%20y%3D%2230%22%20fill%3D%22%23fff%22%3EASAM%20%E7%A4%BA%E4%BE%8B%3C%2Ftext%3E%3C%2Fsvg%3E';\n</script>\n\n<style scoped>\n/* stylelint-disable selector-class-pattern -- Existing component and demonstration BEM selectors retain their public names. */\n\n.demo-image__error .el-image {\n\tmax-width: 300px;\n\tmax-height: 200px;\n\twidth: 100%;\n}\n\n.demo-image__error .image-slot {\n\tdisplay: flex;\n\tjustify-content: center;\n\talign-items: center;\n\tflex-direction: column;\n\tfont-size: 30px;\n\theight: 200px;\n\tbackground: #fff;\n}\n\n.demo-image__error .image-slot .el-icon {\n\tfont-size: 30px;\n}\n\n.image-viewer-slot {\n\tbackground: var(--el-fill-color-light);\n}\n\n.viewer-error {\n\tcolor: #000;\n}\n\n/* stylelint-enable selector-class-pattern */\n</style>\n\n<style scoped>\n.ui032-flex {\n\tdisplay: flex;\n}\n\n.ui032-gap-2 {\n\tgap: var(--asam-space-sm);\n}\n</style>\n",
