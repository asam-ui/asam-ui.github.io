			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamCascader/native-fit-input-width/ts/Demo.vue",
			"sha256": "4909dad50feaa854c41b8e6f5fadfd973d5381cccee199a349924add972bb5b7",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\nNotice resource: /licenses/source-notices/0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\n-->\n<template>\n\t<div class=\"flex flex-wrap gap-4 items-center\">\n\t\t<AsamCascader\n\t\t\tvalue-mode=\"native\"\n\t\t\tv-model=\"value\"\n\t\t\t:options=\"options\"\n\t\t\tplaceholder=\"默认展开面板\"\n\t\t\tfilterable\n\t\t/>\n\n\t\t<AsamCascader\n\t\t\tvalue-mode=\"native\"\n\t\t\tv-model=\"value\"\n\t\t\t:options=\"options\"\n\t\t\tplaceholder=\"匹配输入框宽度\"\n\t\t\tfilterable\n\t\t\tfit-input-width\n\t\t/>\n\n\t\t<AsamCascader\n\t\t\tvalue-mode=\"native\"\n\t\t\tv-model=\"value\"\n\t\t\t:options=\"options\"\n\t\t\tplaceholder=\"固定宽度（400px）\"\n\t\t\tfilterable\n\t\t\t:fit-input-width=\"400\"\n\t\t>\n\t\t\t<template #suggestion-item=\"{ item }\">\n\t\t\t\t<div>{{ item.text }} （较长的自定义内容）</div>\n\t\t\t</template>\n\t\t</AsamCascader>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\n\n\nimport { AsamCascader } from '@asam-ui/ui';\nimport type { AsamCascaderNativeProps } from '@asam-ui/ui';\n// Adapted from the fixed upstream MIT example: cascader/fit-input-width.vue\n\nimport { ref } from 'vue';\n\nconst value = ref<AsamCascaderNativeProps['modelValue']>();\nconst options = [\n\t{\n\t\tvalue: 'guide',\n\t\tlabel: '指南',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tvalue: 'disciplines',\n\t\t\t\tlabel: 'Disciplines',\n\t\t\t\tchildren: [\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'consistency',\n\t\t\t\t\t\tlabel: '一致性'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'feedback',\n\t\t\t\t\t\tlabel: '反馈'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'efficiency',\n\t\t\t\t\t\tlabel: '效率'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'controllability',\n\t\t\t\t\t\tlabel: '可控性'\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t},\n\t\t\t{\n\t\t\t\tvalue: 'navigation',\n\t\t\t\tlabel: 'Navigation',\n\t\t\t\tchildren: [\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'side nav',\n\t\t\t\t\t\tlabel: 'Side Navigation'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'top nav',\n\t\t\t\t\t\tlabel: 'Top Navigation'\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t}\n\t\t]\n\t}\n];\n</script>\n\n<style scoped>\n/* Keep layout utilities local so the downloaded SFC needs no CSS preset. */\n.flex {\n\tdisplay: flex;\n}\n.flex-wrap {\n\tflex-wrap: wrap;\n}\n.items-center {\n\talign-items: center;\n}\n.gap-4 {\n\tgap: var(--asam-space-lg);\n}\n</style>\n",
