	"entry": "Demo.vue",
	"files": [
		{
			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamTree/native-filtering/ts/Demo.vue",
			"sha256": "9da1443bf211bad7668c57722623726c10c0049dc730e6af8c32db5d264377d5",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\nNotice resource: /licenses/source-notices/0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\n-->\n<template>\n\t<div class=\"demo-root-layout\">\n\t\t<AsamInput\n\t\t\t:model-value=\"filterText\"\n\t\t\tclass=\"w-60 mb-2\"\n\t\t\tplaceholder=\"筛选关键字\"\n\t\t\t@update:model-value=\"updateFilterText\"\n\t\t/>\n\n\t\t<AsamTree\n\t\t\tref=\"treeRef\"\n\t\t\tstyle=\"max-width: 600px\"\n\t\t\tclass=\"filter-tree\"\n\t\t\t:data=\"data\"\n\t\t\t:props=\"defaultProps\"\n\t\t\tdefault-expand-all\n\t\t\t:filter-node-method=\"filterNode\"\n\t\t/>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\n\n\nimport { AsamInput, AsamTree } from '@asam-ui/ui';\n// Adapted from the fixed upstream MIT example: tree/filtering.vue\n\nimport { ref, watch } from 'vue';\n\nimport type {\n\tAsamInputEmits,\n\tAsamTreeFilterNodeMethodFunction,\n\tAsamTreeInstance\n} from '@asam-ui/ui';\n\ninterface Tree {\n\tid: number;\n\tlabel: string;\n\tchildren?: Tree[];\n}\n\nconst filterText = ref('');\nconst treeRef = ref<AsamTreeInstance>();\n\nconst updateFilterText = (value: AsamInputEmits['update:modelValue'][0]) => {\n\tfilterText.value = String(value);\n};\n\nconst defaultProps = {\n\tchildren: 'children',\n\tlabel: 'label'\n};\n\nwatch(filterText, (val) => {\n\ttreeRef.value!.filter(val);\n});\n\nconst filterNode: AsamTreeFilterNodeMethodFunction = (value: string, data) => {\n\tif (!value) return true;\n\treturn data.label.includes(value);\n};\n\nconst data: Tree[] = [\n\t{\n\t\tid: 1,\n\t\tlabel: '一级节点 1',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tid: 4,\n\t\t\t\tlabel: '二级节点 1-1',\n\t\t\t\tchildren: [\n\t\t\t\t\t{\n\t\t\t\t\t\tid: 9,\n\t\t\t\t\t\tlabel: '三级节点 1-1-1'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tid: 10,\n\t\t\t\t\t\tlabel: '三级节点 1-1-2'\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t}\n\t\t]\n\t},\n\t{\n\t\tid: 2,\n\t\tlabel: '一级节点 2',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tid: 5,\n\t\t\t\tlabel: '二级节点 2-1'\n\t\t\t},\n\t\t\t{\n\t\t\t\tid: 6,\n\t\t\t\tlabel: '二级节点 2-2'\n\t\t\t}\n\t\t]\n\t},\n\t{\n\t\tid: 3,\n\t\tlabel: '一级节点 3',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tid: 7,\n\t\t\t\tlabel: '二级节点 3-1'\n\t\t\t},\n\t\t\t{\n\t\t\t\tid: 8,\n\t\t\t\tlabel: '二级节点 3-2'\n\t\t\t}\n\t\t]\n\t}\n];\n</script>\n\n<style scoped>\n/* Keep layout utilities local so the downloaded SFC needs no CSS preset. */\n.mb-2 {\n\tmargin-bottom: var(--asam-space-sm);\n}\n.w-60 {\n\twidth: calc(var(--asam-space-xs) * 60);\n}\n</style>\n\n<style scoped>\n.demo-root-layout {\n\tdisplay: grid;\n\tgap: var(--asam-space-md);\n\tjustify-items: start;\n}\n.demo-root-layout > :is(p, pre, output) {\n\tmargin-block: 0;\n}\n</style>\n",
