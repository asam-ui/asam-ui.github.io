			"sourcePath": "apps/website/examples/AsamMessage/ep2147-different-types/js/Demo.vue",
			"sha256": "e38eb8c28c7bf90a20968e6c3ffc70a3ea8b7fc76c3cf12498e374d918531de0",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-73bc21643e3fe7ced421d99ccf33eaef8aa8cb4ea349bf2e18f93b746ac971a2.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/73bc21643e3fe7ced421d99ccf33eaef8aa8cb4ea349bf2e18f93b746ac971a2.txt\n-->\n<template>\n\t<div class=\"flex flex-wrap demo-gap\">\n\t\t<AsamButton type=\"primary\" class=\"!ml-0\" :plain=\"true\" @click=\"open5\">主要</AsamButton>\n\t\t<AsamButton type=\"success\" class=\"!ml-0\" :plain=\"true\" @click=\"open2\">成功</AsamButton>\n\t\t<AsamButton type=\"warning\" class=\"!ml-0\" :plain=\"true\" @click=\"open3\">警告</AsamButton>\n\t\t<AsamButton type=\"info\" class=\"!ml-0\" :plain=\"true\" @click=\"open1\">信息</AsamButton>\n\t\t<AsamButton type=\"danger\" class=\"!ml-0\" :plain=\"true\" @click=\"open4\">错误</AsamButton>\n\t</div>\n</template>\n\n<script setup>\nimport { AsamButton, AsamMessage } from '@asam-ui/ui';\nimport { onBeforeUnmount } from 'vue';\nconst open1 = () => {\n\ttrackAsamMessage(AsamMessage('这是一条信息提示。'));\n};\nconst open2 = () => {\n\ttrackAsamMessage(\n\t\tAsamMessage({\n\t\t\tmessage: '操作成功，这是一条成功提示。',\n\t\t\ttype: 'success'\n\t\t})\n\t);\n};\nconst open3 = () => {\n\ttrackAsamMessage(\n\t\tAsamMessage({\n\t\t\tmessage: '请注意，这是一条警告提示。',\n\t\t\ttype: 'warning'\n\t\t})\n\t);\n};\nconst open4 = () => {\n\ttrackAsamMessage(AsamMessage.error('操作失败，这是一条错误提示。'));\n};\nconst open5 = () => {\n\ttrackAsamMessage(AsamMessage.primary('这是一条主要消息。'));\n};\nconst ownedAsamMessage = new Set();\nlet mountedAsamMessage = true;\nconst trackAsamMessage = (handle) => {\n\tif (mountedAsamMessage) ownedAsamMessage.add(handle);\n\telse handle.close();\n\treturn handle;\n};\nonBeforeUnmount(() => {\n\tmountedAsamMessage = false;\n\tfor (const handle of ownedAsamMessage) handle.close();\n\townedAsamMessage.clear();\n});\n</script>\n\n<style scoped>\n/* Keep layout utilities local so the downloaded SFC needs no CSS preset. */\n.flex {\n\tdisplay: flex;\n}\n.flex-wrap {\n\tflex-wrap: wrap;\n}\n.demo-gap {\n\tgap: var(--asam-space-sm);\n}\n</style>\n",
			"originalSourceSha256": "4111c9b3f32386fbd2095d5d14916f362bfe75a15802276f922d44bc1f4b3826",
