			"sourcePath": "apps/website/examples/AsamNotification/ep2147-positioning/js/Demo.vue",
			"sha256": "254608fb6211f5e78314d9a717b7fb235a11f575335f5e588399d62d164dd51a",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-3c29b9bd28f60cbc174132cf112584476530e2ba531460bccabc54ef6f753e7d.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/3c29b9bd28f60cbc174132cf112584476530e2ba531460bccabc54ef6f753e7d.txt\n-->\n<template>\n\t<div class=\"flex flex-wrap gap-1\">\n\t\t<AsamButton type=\"primary\" class=\"!ml-0\" plain @click=\"open1\"> 右上方 </AsamButton>\n\t\t<AsamButton type=\"primary\" class=\"!ml-0\" plain @click=\"open2\"> 右下方 </AsamButton>\n\t\t<AsamButton type=\"primary\" class=\"!ml-0\" plain @click=\"open3\"> 左下方 </AsamButton>\n\t\t<AsamButton type=\"primary\" class=\"!ml-0\" plain @click=\"open4\"> 左上方 </AsamButton>\n\t</div>\n</template>\n\n<script setup>\nimport { AsamButton, AsamNotification } from '@asam-ui/ui';\nimport { onBeforeUnmount } from 'vue';\nconst open1 = () => {\n\ttrackAsamNotification(\n\t\tAsamNotification({\n\t\t\ttitle: '自定义位置',\n\t\t\tmessage: '我位于右上角。'\n\t\t})\n\t);\n};\nconst open2 = () => {\n\ttrackAsamNotification(\n\t\tAsamNotification({\n\t\t\ttitle: '自定义位置',\n\t\t\tmessage: '我位于右下角。',\n\t\t\tposition: 'bottom-right'\n\t\t})\n\t);\n};\nconst open3 = () => {\n\ttrackAsamNotification(\n\t\tAsamNotification({\n\t\t\ttitle: '自定义位置',\n\t\t\tmessage: '我位于左下角。',\n\t\t\tposition: 'bottom-left'\n\t\t})\n\t);\n};\nconst open4 = () => {\n\ttrackAsamNotification(\n\t\tAsamNotification({\n\t\t\ttitle: '自定义位置',\n\t\t\tmessage: '我位于左上角。',\n\t\t\tposition: 'top-left'\n\t\t})\n\t);\n};\nconst ownedAsamNotification = new Set();\nlet mountedAsamNotification = true;\nconst trackAsamNotification = (handle) => {\n\tif (mountedAsamNotification) ownedAsamNotification.add(handle);\n\telse handle.close();\n\treturn handle;\n};\nonBeforeUnmount(() => {\n\tmountedAsamNotification = false;\n\tfor (const handle of ownedAsamNotification) handle.close();\n\townedAsamNotification.clear();\n});\n</script>\n",
