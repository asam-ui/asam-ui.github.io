			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-3c29b9bd28f60cbc174132cf112584476530e2ba531460bccabc54ef6f753e7d.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/3c29b9bd28f60cbc174132cf112584476530e2ba531460bccabc54ef6f753e7d.txt\n-->\n<template>\n\t<div class=\"flex flex-wrap gap-1\">\n\t\t<AsamButton class=\"!ml-0\" plain @click=\"open1\"> Top Right </AsamButton>\n\t\t<AsamButton class=\"!ml-0\" plain @click=\"open2\"> Bottom Right </AsamButton>\n\t\t<AsamButton class=\"!ml-0\" plain @click=\"open3\"> Bottom Left </AsamButton>\n\t\t<AsamButton class=\"!ml-0\" plain @click=\"open4\"> Top Left </AsamButton>\n\t</div>\n</template>\n\n<script setup>\nimport { AsamButton, AsamNotification } from '@asam-ui/ui';\nimport { onBeforeUnmount } from 'vue';\nconst open1 = () => {\n\ttrackAsamNotification(\n\t\tAsamNotification({\n\t\t\ttitle: 'Custom Position',\n\t\t\tmessage: \"I'm at the top right corner\"\n\t\t})\n\t);\n};\nconst open2 = () => {\n\ttrackAsamNotification(\n\t\tAsamNotification({\n\t\t\ttitle: 'Custom Position',\n\t\t\tmessage: \"I'm at the bottom right corner\",\n\t\t\tposition: 'bottom-right'\n\t\t})\n\t);\n};\nconst open3 = () => {\n\ttrackAsamNotification(\n\t\tAsamNotification({\n\t\t\ttitle: 'Custom Position',\n\t\t\tmessage: \"I'm at the bottom left corner\",\n\t\t\tposition: 'bottom-left'\n\t\t})\n\t);\n};\nconst open4 = () => {\n\ttrackAsamNotification(\n\t\tAsamNotification({\n\t\t\ttitle: 'Custom Position',\n\t\t\tmessage: \"I'm at the top left corner\",\n\t\t\tposition: 'top-left'\n\t\t})\n\t);\n};\nconst ownedAsamNotification = new Set();\nlet mountedAsamNotification = true;\nconst trackAsamNotification = (handle) => {\n\tif (mountedAsamNotification) ownedAsamNotification.add(handle);\n\telse handle.close();\n\treturn handle;\n};\nonBeforeUnmount(() => {\n\tmountedAsamNotification = false;\n\tfor (const handle of ownedAsamNotification) handle.close();\n\townedAsamNotification.clear();\n});\n</script>\n",
