			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamMessageBox/ep2147-draggable/js/Demo.vue",
			"sha256": "81e94e82862c89f797d755259b27b7b7c3a34bf1a87660a29898901f2b414dac",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-399986496e94e8a7964b94c5d2b5c41fc124bbd625a79b1da2d3c6263b62f2cd.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/399986496e94e8a7964b94c5d2b5c41fc124bbd625a79b1da2d3c6263b62f2cd.txt\n-->\n<template>\n\t<div class=\"flex flex-wrap gap-1\">\n\t\t<AsamButton class=\"!ml-0\" plain @click=\"open\"> Open a draggable Message Box </AsamButton>\n\t\t<AsamButton class=\"!ml-0\" plain @click=\"open2\">\n\t\t\tOpen a overflow draggable Message Box\n\t\t</AsamButton>\n\t\t<AsamButton class=\"!ml-0\" plain @click=\"open3\">\n\t\t\tOpen a custom dragging style Message Box\n\t\t</AsamButton>\n\t</div>\n</template>\n\n<script setup>\nimport { AsamButton, AsamMessage, AsamMessageBox } from '@asam-ui/ui';\nimport { onBeforeUnmount } from 'vue';\nconst open = () => {\n\tAsamMessageBox.confirm('proxy will permanently delete the file. Continue?', 'Warning', {\n\t\tconfirmButtonText: 'OK',\n\t\tcancelButtonText: 'Cancel',\n\t\ttype: 'warning',\n\t\tdraggable: true\n\t})\n\t\t.then(() => {\n\t\t\ttrackAsamMessage(\n\t\t\t\tAsamMessage({\n\t\t\t\t\ttype: 'success',\n\t\t\t\t\tmessage: 'Delete completed'\n\t\t\t\t})\n\t\t\t);\n\t\t})\n\t\t.catch(() => {\n\t\t\ttrackAsamMessage(\n\t\t\t\tAsamMessage({\n\t\t\t\t\ttype: 'info',\n\t\t\t\t\tmessage: 'Delete canceled'\n\t\t\t\t})\n\t\t\t);\n\t\t});\n};\nconst open2 = () => {\n\tAsamMessageBox.confirm('proxy will permanently delete the file. Continue?', 'Warning', {\n\t\tconfirmButtonText: 'OK',\n\t\tcancelButtonText: 'Cancel',\n\t\ttype: 'warning',\n\t\tdraggable: true,\n\t\toverflow: true\n\t})\n\t\t.then(() => {\n\t\t\ttrackAsamMessage(\n\t\t\t\tAsamMessage({\n\t\t\t\t\ttype: 'success',\n\t\t\t\t\tmessage: 'Delete completed'\n\t\t\t\t})\n\t\t\t);\n\t\t})\n\t\t.catch(() => {\n\t\t\ttrackAsamMessage(\n\t\t\t\tAsamMessage({\n\t\t\t\t\ttype: 'info',\n\t\t\t\t\tmessage: 'Delete canceled'\n\t\t\t\t})\n\t\t\t);\n\t\t});\n};\nconst open3 = () => {\n\tAsamMessageBox.confirm(\n\t\t'This message box has custom dragging styles. Try dragging it to see the effects!',\n\t\t'Custom Dragging Style',\n\t\t{\n\t\t\tconfirmButtonText: 'OK',\n\t\t\tcancelButtonText: 'Cancel',\n\t\t\ttype: 'info',\n\t\t\tdraggable: true,\n\t\t\tcustomClass: 'custom-dragging-message-box'\n\t\t}\n\t)\n\t\t.then(() => {\n\t\t\ttrackAsamMessage(\n\t\t\t\tAsamMessage({\n\t\t\t\t\ttype: 'success',\n\t\t\t\t\tmessage: 'Action completed'\n\t\t\t\t})\n\t\t\t);\n\t\t})\n\t\t.catch(() => {\n\t\t\ttrackAsamMessage(\n\t\t\t\tAsamMessage({\n\t\t\t\t\ttype: 'info',\n\t\t\t\t\tmessage: 'Action canceled'\n\t\t\t\t})\n\t\t\t);\n\t\t});\n};\nconst ownedAsamMessage = new Set();\nlet mountedAsamMessage = true;\nconst trackAsamMessage = (handle) => {\n\tif (mountedAsamMessage) ownedAsamMessage.add(handle);\n\telse handle.close();\n\treturn handle;\n};\nonBeforeUnmount(() => {\n\tmountedAsamMessage = false;\n\tfor (const handle of ownedAsamMessage) handle.close();\n\townedAsamMessage.clear();\n});\n</script>\n\n<style>\n.custom-dragging-message-box.is-dragging {\n\tborder: 2px dashed var(--el-color-primary);\n\topacity: 0.65;\n}\n</style>\n",
