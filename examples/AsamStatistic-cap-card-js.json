			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-ffa0730822219a7699b924be4d84089f009fe4257457ca301564fed6201e5b87.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/ffa0730822219a7699b924be4d84089f009fe4257457ca301564fed6201e5b87.txt\n-->\n<template>\n\t<AsamRow :gutter=\"16\">\n\t\t<AsamCol :xs=\"24\" :sm=\"12\" :md=\"8\" class=\"mb-4\">\n\t\t\t<div class=\"statistic-card\">\n\t\t\t\t<AsamStatistic :value=\"98500\">\n\t\t\t\t\t<template #title>\n\t\t\t\t\t\t<div style=\"display: inline-flex; align-items: center\">\n\t\t\t\t\t\t\t日活跃用户\n\t\t\t\t\t\t\t<AsamTooltip\n\t\t\t\t\t\t\t\teffect=\"dark\"\n\t\t\t\t\t\t\t\tcontent=\"一天内登录产品的用户数量\"\n\t\t\t\t\t\t\t\tplacement=\"top\"\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t<AsamIcon style=\"margin-left: 4px\" :size=\"12\">\n\t\t\t\t\t\t\t\t\t<Warning />\n\t\t\t\t\t\t\t\t</AsamIcon>\n\t\t\t\t\t\t\t</AsamTooltip>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</template>\n\t\t\t\t</AsamStatistic>\n\t\t\t\t<div class=\"statistic-footer\">\n\t\t\t\t\t<div class=\"footer-item\">\n\t\t\t\t\t\t<span>相较昨日</span>\n\t\t\t\t\t\t<span class=\"green\">\n\t\t\t\t\t\t\t24%\n\t\t\t\t\t\t\t<AsamIcon>\n\t\t\t\t\t\t\t\t<CaretTop />\n\t\t\t\t\t\t\t</AsamIcon>\n\t\t\t\t\t\t</span>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</AsamCol>\n\t\t<AsamCol :xs=\"24\" :sm=\"12\" :md=\"8\" class=\"mb-4\">\n\t\t\t<div class=\"statistic-card\">\n\t\t\t\t<AsamStatistic :value=\"693700\">\n\t\t\t\t\t<template #title>\n\t\t\t\t\t\t<div style=\"display: inline-flex; align-items: center\">\n\t\t\t\t\t\t\t月活跃用户\n\t\t\t\t\t\t\t<AsamTooltip\n\t\t\t\t\t\t\t\teffect=\"dark\"\n\t\t\t\t\t\t\t\tcontent=\"一个月内登录产品的用户数量\"\n\t\t\t\t\t\t\t\tplacement=\"top\"\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t<AsamIcon style=\"margin-left: 4px\" :size=\"12\">\n\t\t\t\t\t\t\t\t\t<Warning />\n\t\t\t\t\t\t\t\t</AsamIcon>\n\t\t\t\t\t\t\t</AsamTooltip>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</template>\n\t\t\t\t</AsamStatistic>\n\t\t\t\t<div class=\"statistic-footer\">\n\t\t\t\t\t<div class=\"footer-item\">\n\t\t\t\t\t\t<span>环比</span>\n\t\t\t\t\t\t<span class=\"red\">\n\t\t\t\t\t\t\t12%\n\t\t\t\t\t\t\t<AsamIcon>\n\t\t\t\t\t\t\t\t<CaretBottom />\n\t\t\t\t\t\t\t</AsamIcon>\n\t\t\t\t\t\t</span>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</AsamCol>\n\t\t<AsamCol :xs=\"24\" :sm=\"12\" :md=\"8\" class=\"mb-4\">\n\t\t\t<div class=\"statistic-card\">\n\t\t\t\t<AsamStatistic :value=\"72000\" title=\"今日新增交易\">\n\t\t\t\t\t<template #title>\n\t\t\t\t\t\t<div style=\"display: inline-flex; align-items: center\">今日新增交易</div>\n\t\t\t\t\t</template>\n\t\t\t\t</AsamStatistic>\n\t\t\t\t<div class=\"statistic-footer\">\n\t\t\t\t\t<div class=\"footer-item\">\n\t\t\t\t\t\t<span>相较昨日</span>\n\t\t\t\t\t\t<span class=\"green\">\n\t\t\t\t\t\t\t16%\n\t\t\t\t\t\t\t<AsamIcon>\n\t\t\t\t\t\t\t\t<CaretTop />\n\t\t\t\t\t\t\t</AsamIcon>\n\t\t\t\t\t\t</span>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"footer-item\">\n\t\t\t\t\t\t<AsamIcon :size=\"14\">\n\t\t\t\t\t\t\t<ArrowRight />\n\t\t\t\t\t\t</AsamIcon>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</AsamCol>\n\t</AsamRow>\n</template>\n\n<script setup>\ndefineOptions({ name: 'AsamStatisticCapCardDemo' });\nimport { AsamRow, AsamCol, AsamStatistic, AsamTooltip, AsamIcon } from '@asam-ui/ui';\nimport { ArrowRight, CaretBottom, CaretTop, Warning } from '@asam-ui/icons-vue';\n</script>\n\n<style scoped>\n/* stylelint-disable selector-pseudo-class-no-unknown -- Vue SFC compiler implements :deep and :global selectors. */\n\n:global(h2#card-usage ~ .example .example-showcase) {\n\tbackground-color: var(--el-fill-color) !important;\n}\n\n.el-statistic {\n\t--el-statistic-content-font-size: 28px;\n}\n\n.statistic-card {\n\theight: 100%;\n\tpadding: 20px;\n\tborder-radius: 4px;\n\tbackground-color: var(--el-bg-color-overlay);\n}\n\n.statistic-footer {\n\tdisplay: flex;\n\tjustify-content: space-between;\n\talign-items: center;\n\tflex-wrap: wrap;\n\tfont-size: 12px;\n\tcolor: var(--el-text-color-regular);\n\tmargin-top: 16px;\n}\n\n.statistic-footer .footer-item {\n\tdisplay: flex;\n\tjustify-content: space-between;\n\talign-items: center;\n}\n\n.statistic-footer .footer-item span:last-child {\n\tdisplay: inline-flex;\n\talign-items: center;\n\tmargin-left: 4px;\n}\n\n.green {\n\tcolor: var(--el-color-success);\n}\n\n.red {\n\tcolor: var(--el-color-error);\n}\n\n/* stylelint-enable selector-pseudo-class-no-unknown */\n</style>\n\n<style scoped>\n/* Local styles keep this sample runnable without a website utility-CSS preset. */\n.mb-4 {\n\tmargin-bottom: 1rem;\n}\n</style>\n",
