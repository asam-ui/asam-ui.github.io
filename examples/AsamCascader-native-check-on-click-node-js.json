			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\nNotice resource: /licenses/source-notices/0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\n-->\n<template>\n\t<div class=\"flex flex-col items-center demo-spacing-1\">\n\t\t<AsamSwitch v-model=\"showPrefix\" active-text=\"显示前缀\" inactive-text=\"隐藏前缀\" />\n\t\t<div class=\"flex flex-wrap demo-spacing-2\">\n\t\t\t<div class=\"m-4 demo-spacing-3\">\n\t\t\t\t<p class=\"example-paragraph\">checkStrictly 单选模式</p>\n\t\t\t\t<AsamCascader\n\t\t\t\t\tvalue-mode=\"native\"\n\t\t\t\t\tv-model=\"value\"\n\t\t\t\t\t:options=\"options\"\n\t\t\t\t\t:props=\"props1\"\n\t\t\t\t\tclearable\n\t\t\t\t/>\n\t\t\t</div>\n\t\t\t<div class=\"m-4 demo-spacing-4\">\n\t\t\t\t<p class=\"example-paragraph\">多选模式</p>\n\t\t\t\t<AsamCascader\n\t\t\t\t\tvalue-mode=\"native\"\n\t\t\t\t\tv-model=\"value2\"\n\t\t\t\t\tshow-checked-strategy=\"parent\"\n\t\t\t\t\t:options=\"options\"\n\t\t\t\t\t:props=\"props2\"\n\t\t\t\t\tclearable\n\t\t\t\t/>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</template>\n\n<script setup>\n\n\nimport { AsamSwitch, AsamCascader } from '@asam-ui/ui';\n// Adapted from the fixed upstream MIT example: cascader/check-on-click-node.vue\nimport { computed, ref } from 'vue';\nconst value = ref();\nconst value2 = ref();\nconst showPrefix = ref(true);\nconst props1 = computed(() => ({\n\tshowPrefix: showPrefix.value === true,\n\tcheckStrictly: true,\n\tcheckOnClickNode: true\n}));\nconst props2 = computed(() => ({\n\tshowPrefix: showPrefix.value === true,\n\tmultiple: true,\n\tcheckOnClickNode: true\n}));\nconst options = [\n\t{\n\t\tvalue: 'guide',\n\t\tlabel: '指南',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tvalue: 'disciplines',\n\t\t\t\tlabel: 'Disciplines',\n\t\t\t\tchildren: [\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'consistency',\n\t\t\t\t\t\tlabel: '一致性'\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t},\n\t\t\t{\n\t\t\t\tvalue: 'navigation',\n\t\t\t\tlabel: 'Navigation',\n\t\t\t\tchildren: [\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'side nav',\n\t\t\t\t\t\tlabel: 'Side Navigation'\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t}\n\t\t]\n\t},\n\t{\n\t\tvalue: 'component',\n\t\tlabel: '组件',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tvalue: 'basic',\n\t\t\t\tlabel: 'Basic',\n\t\t\t\tchildren: [\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'layout',\n\t\t\t\t\t\tlabel: 'Layout'\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t},\n\t\t\t{\n\t\t\t\tvalue: 'form',\n\t\t\t\tlabel: 'Form',\n\t\t\t\tchildren: [\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'radio',\n\t\t\t\t\t\tlabel: 'Radio'\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t}\n\t\t]\n\t},\n\t{\n\t\tvalue: 'resource',\n\t\tlabel: '资源',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tvalue: 'axure',\n\t\t\t\tlabel: 'Axure Components'\n\t\t\t}\n\t\t]\n\t}\n];\n</script>\n\n<style scoped>\n/* Keep layout utilities local so the downloaded SFC needs no CSS preset. */\n.flex {\n\tdisplay: flex;\n}\n.flex-wrap {\n\tflex-wrap: wrap;\n}\n.items-center {\n\talign-items: center;\n}\n.m-4 {\n\tmargin: var(--asam-space-lg);\n}\n.flex-col {\n\tflex-direction: column;\n}\n</style>\n\n<style scoped>\n.demo-spacing-1 {\n\tgap: var(--asam-space-md);\n}\n.demo-spacing-2 {\n\tgap: var(--asam-space-md);\n}\n.demo-spacing-3 {\n\tdisplay: grid;\n\tgap: var(--asam-space-md);\n}\n.demo-spacing-4 {\n\tdisplay: grid;\n\tgap: var(--asam-space-md);\n}\n</style>\n\n<style scoped>\np:where(.example-paragraph) {\n\tmargin-block: 16px;\n\tline-height: 1.8;\n\toverflow-wrap: anywhere;\n}\n</style>\n",
