			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-717afcc3b7f857f761848bd9fae8590701e7719552eb4a560c83f44b10afc47b.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/717afcc3b7f857f761848bd9fae8590701e7719552eb4a560c83f44b10afc47b.txt\n-->\n<template>\n\t<AsamDropdown trigger=\"hover\" placement=\"bottom\" :wrap-menu=\"false\" @command=\"handleCommand\">\n\t\t<span class=\"el-dropdown-link\">\n\t\t\t下拉列表<AsamIcon class=\"el-icon--right\"><arrow-down /></AsamIcon>\n\t\t</span>\n\t\t<template #dropdown>\n\t\t\t<AsamDropdownMenu>\n\t\t\t\t<AsamDropdownItem command=\"a\">操作 1</AsamDropdownItem>\n\t\t\t\t<AsamDropdownItem command=\"b\">操作 2</AsamDropdownItem>\n\t\t\t\t<AsamDropdownItem command=\"c\">操作 3</AsamDropdownItem>\n\t\t\t\t<AsamDropdownItem command=\"d\" disabled>操作 4</AsamDropdownItem>\n\t\t\t\t<AsamDropdownItem command=\"e\" divided>操作 5</AsamDropdownItem>\n\t\t\t</AsamDropdownMenu>\n\t\t</template>\n\t</AsamDropdown>\n</template>\n\n<script setup>\nimport {\n\tAsamDropdown,\n\tAsamDropdownItem,\n\tAsamDropdownMenu,\n\tAsamIcon,\n\tAsamMessage\n} from '@asam-ui/ui';\nimport { onBeforeUnmount } from 'vue';\nimport { ArrowDown } from '@asam-ui/icons-vue';\nconst handleCommand = (command) => {\n\ttrackAsamMessage(AsamMessage(`点击的菜单项：${command}`));\n};\nconst ownedAsamMessage = new Set();\nlet mountedAsamMessage = true;\nconst trackAsamMessage = (handle) => {\n\tif (mountedAsamMessage) ownedAsamMessage.add(handle);\n\telse handle.close();\n\treturn handle;\n};\nonBeforeUnmount(() => {\n\tmountedAsamMessage = false;\n\tfor (const handle of ownedAsamMessage) handle.close();\n\townedAsamMessage.clear();\n});\n</script>\n\n<style scoped>\n.example-showcase .el-dropdown-link {\n\tcursor: pointer;\n\tcolor: var(--el-color-primary);\n\tdisplay: flex;\n\talign-items: center;\n}\n</style>\n",
