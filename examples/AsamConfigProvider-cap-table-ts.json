		{
			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamConfigProvider/cap-table/ts/Demo.vue",
			"sha256": "31eb43b8e9ffd011359b2e9c8a1fc26917c76ac67fe25ff05b746416bd6c4dcc",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-bfbcc0eb929e409e6259e9ae3153ebe4e41d337d11a122cc450e9c95dba74df9.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/bfbcc0eb929e409e6259e9ae3153ebe4e41d337d11a122cc450e9c95dba74df9.txt\n-->\n<template>\n\t<div>\n\t\t<div>\n\t\t\t<AsamSwitch\n\t\t\t\t:model-value=\"config.showOverflowTooltip\"\n\t\t\t\tactive-text=\"showOverflowTooltip\"\n\t\t\t\t@update:model-value=\"\n\t\t\t\t\t(value) => {\n\t\t\t\t\t\tif (typeof value === 'boolean') config.showOverflowTooltip = value;\n\t\t\t\t\t}\n\t\t\t\t\"\n\t\t\t/>\n\t\t\t<AsamSelect\n\t\t\t\t:model-value=\"config.tooltipEffect\"\n\t\t\t\tclass=\"ml-5\"\n\t\t\t\tstyle=\"max-width: 150px\"\n\t\t\t\t@update:model-value=\"\n\t\t\t\t\t(value: unknown) => {\n\t\t\t\t\t\tif (value === 'dark' || value === 'light') config.tooltipEffect = value;\n\t\t\t\t\t}\n\t\t\t\t\"\n\t\t\t>\n\t\t\t\t<AsamOption value=\"dark\" label=\"dark\" />\n\t\t\t\t<AsamOption value=\"light\" label=\"light\" />\n\t\t\t</AsamSelect>\n\t\t</div>\n\t\t<AsamDivider />\n\t\t<AsamConfigProvider :table=\"config\">\n\t\t\t<AsamTable :data=\"tableData\" style=\"width: 100%\">\n\t\t\t\t<!-- @vue-generic {User} -->\n\t\t\t\t<AsamTableColumn type=\"selection\" width=\"55\" />\n\t\t\t\t<!-- @vue-generic {User} -->\n\t\t\t\t<AsamTableColumn label=\"日期\" width=\"120\">\n\t\t\t\t\t<template #default=\"scope\">{{ scope.row.date }}</template>\n\t\t\t\t</AsamTableColumn>\n\t\t\t\t<!-- @vue-generic {User} -->\n\t\t\t\t<AsamTableColumn property=\"name\" label=\"姓名\" width=\"120\" />\n\t\t\t\t<!-- @vue-generic {User} -->\n\t\t\t\t<AsamTableColumn property=\"address\" label=\"地址（继承配置提供器）\" width=\"300\" />\n\t\t\t\t<!-- @vue-generic {User} -->\n\t\t\t\t<AsamTableColumn\n\t\t\t\t\tproperty=\"address\"\n\t\t\t\t\tlabel=\"地址（显式设置 false）\"\n\t\t\t\t\t:show-overflow-tooltip=\"false\"\n\t\t\t\t/>\n\t\t\t</AsamTable>\n\t\t</AsamConfigProvider>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\ndefineOptions({ name: 'AsamConfigProviderCapTableDemo' });\nimport {\n\tAsamSwitch,\n\tAsamSelect,\n\tAsamOption,\n\tAsamDivider,\n\tAsamConfigProvider,\n\tAsamTable,\n\tAsamTableColumn\n} from '@asam-ui/ui';\n\nimport { reactive } from 'vue';\n\nimport type { AsamConfigProviderTableConfigContext } from '@asam-ui/ui';\n\nconst config = reactive<AsamConfigProviderTableConfigContext & { showOverflowTooltip: boolean }>({\n\tshowOverflowTooltip: true,\n\ttooltipEffect: 'dark'\n});\n\ninterface User {\n\tdate: string;\n\tname: string;\n\taddress: string;\n}\n\nconst tableData: User[] = [\n\t{\n\t\tdate: '2016-05-04',\n\t\tname: '艾琳娜·库茨纳',\n\t\taddress: '萨尔州南莉莉洛尔贝格路 86c 号'\n\t},\n\t{\n\t\tdate: '2016-05-03',\n\t\tname: '海伦·雅各比',\n\t\taddress: '伊利诺伊州南弗兰克菲尔德 A 街 760 号'\n\t},\n\t{\n\t\tdate: '2016-05-02',\n\t\tname: '布兰登·德克特',\n\t\taddress: '图林根州阿尔特马利纳沙伊德阿诺德路 41a 号'\n\t},\n\t{\n\t\tdate: '2016-05-01',\n\t\tname: '玛吉·史密斯',\n\t\taddress: '爱达荷州西里卡多温莎路 23618 号'\n\t}\n];\n</script>\n\n<style scoped>\n/* Local styles keep this sample runnable without a website utility-CSS preset. */\n.ml-5 {\n\tmargin-left: 1.25rem;\n}\n</style>\n",
