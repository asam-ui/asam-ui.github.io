			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamDrawer/ep2147-basic-usage/ts/Demo.vue",
			"sha256": "2a6d56243cda3796a237eaf501d6f02b2a8f7e4feacaf494757cd0406600efff",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-f353c5b32e4e2002a6fae49f2c13e5ee7acf3149cef89f67e875495d3e29cb80.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/f353c5b32e4e2002a6fae49f2c13e5ee7acf3149cef89f67e875495d3e29cb80.txt\n-->\n<template>\n\t<label\n\t\t>展开方向\n\t\t<AsamSelect :model-value=\"direction\" @change=\"changeDirection\">\n\t\t\t<AsamOption value=\"ltr\" :label=\"'从左展开'\">从左展开</AsamOption>\n\t\t\t<AsamOption value=\"rtl\" :label=\"'从右展开'\">从右展开</AsamOption>\n\t\t\t<AsamOption value=\"ttb\" :label=\"'从上展开'\">从上展开</AsamOption>\n\t\t\t<AsamOption value=\"btt\" :label=\"'从下展开'\">从下展开</AsamOption>\n\t\t</AsamSelect></label\n\t>\n\n\t<AsamButton type=\"default\" style=\"margin-left: 16px\" @click=\"drawer = true\"> 打开 </AsamButton>\n\t<AsamButton type=\"default\" style=\"margin-left: 16px\" @click=\"drawer2 = true\">\n\t\t带底部区域\n\t</AsamButton>\n\n\t<AsamDrawer\n\t\tv-model=\"drawer\"\n\t\ttitle=\"标题示例\"\n\t\t:direction=\"direction\"\n\t\t:before-close=\"handleClose\"\n\t>\n\t\t<span>你好！</span>\n\t</AsamDrawer>\n\t<AsamDrawer v-model=\"drawer2\" :direction=\"direction\">\n\t\t<template #header>\n\t\t\t<h4>通过插槽设置标题</h4>\n\t\t</template>\n\t\t<template #default>\n\t\t\t<div>\n\t\t\t\t<AsamRadioItem v-model=\"radio1\" value=\"Option 1\"> 选项 1 </AsamRadioItem>\n\t\t\t\t<AsamRadioItem v-model=\"radio1\" value=\"Option 2\"> 选项 2 </AsamRadioItem>\n\t\t\t</div>\n\t\t</template>\n\t\t<template #footer>\n\t\t\t<div style=\"flex: auto\">\n\t\t\t\t<AsamButton type=\"default\" @click=\"cancelClick\">取消</AsamButton>\n\t\t\t\t<AsamButton type=\"default\" @click=\"confirmClick\">确认</AsamButton>\n\t\t\t</div>\n\t\t</template>\n\t</AsamDrawer>\n</template>\n\n<script lang=\"ts\" setup>\nimport {\n\tAsamSelect,\n\tAsamOption,\n\tAsamRadioItem,\n\tAsamButton,\n\tAsamDrawer,\n\tAsamMessageBox,\n\ttype AsamDrawerProps as DrawerProps\n} from '@asam-ui/ui';\n\nimport { ref } from 'vue';\n\nconst drawer = ref(false);\nconst drawer2 = ref(false);\nconst direction = ref<DrawerProps['direction']>('rtl');\nconst radio1 = ref('Option 1');\nconst handleClose = (done: () => void) => {\n\tAsamMessageBox.confirm('确定关闭当前窗口吗？')\n\t\t.then(() => {\n\t\t\tdone();\n\t\t})\n\t\t.catch(() => {\n\t\t\t// catch error\n\t\t});\n};\nfunction cancelClick() {\n\tdrawer2.value = false;\n}\nfunction confirmClick() {\n\tAsamMessageBox.confirm(`确认选择${radio1.value === 'Option 1' ? '选项 1' : '选项 2'}吗？`)\n\t\t.then(() => {\n\t\t\tdrawer2.value = false;\n\t\t})\n\t\t.catch(() => {\n\t\t\t// catch error\n\t\t});\n}\n\nconst changeDirection = (value: unknown) => {\n\tif (value === 'ltr' || value === 'rtl' || value === 'ttb' || value === 'btt') {\n\t\tdirection.value = value;\n\t}\n};\n</script>\n",
