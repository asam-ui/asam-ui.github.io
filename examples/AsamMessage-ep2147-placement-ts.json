			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-faa2a8876e351f512f243073599e0464f61e32a08fa1bacee567017e55224847.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/faa2a8876e351f512f243073599e0464f61e32a08fa1bacee567017e55224847.txt\n-->\n<template>\n\t<div class=\"flex flex-wrap gap-1\">\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" :plain=\"true\" @click=\"openMsg()\">\n\t\t\t顶部\n\t\t</AsamButton>\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" :plain=\"true\" @click=\"openMsg('top-left')\">\n\t\t\t左上方\n\t\t</AsamButton>\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" :plain=\"true\" @click=\"openMsg('top-right')\">\n\t\t\t右上方\n\t\t</AsamButton>\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" :plain=\"true\" @click=\"openMsg('bottom')\">\n\t\t\t底部\n\t\t</AsamButton>\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" :plain=\"true\" @click=\"openMsg('bottom-left')\">\n\t\t\t左下方\n\t\t</AsamButton>\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" :plain=\"true\" @click=\"openMsg('bottom-right')\">\n\t\t\t右下方\n\t\t</AsamButton>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\nimport {\n\tAsamButton,\n\tAsamMessage,\n\ttype AsamMessageHandler,\n\ttype AsamMessagePlacement as MessagePlacement,\n\ttype AsamMessageType as MessageType\n} from '@asam-ui/ui';\n\nimport { onBeforeUnmount } from 'vue';\n\nlet topCount = 0;\nlet bottomCount = 0;\nlet topLeftCount = 0;\nlet topRightCount = 0;\nlet bottomLeftCount = 0;\nlet bottomRightCount = 0;\n\nconst openMsg = (placement: MessagePlacement = 'top') => {\n\tlet count = 0;\n\tlet type: MessageType = 'success';\n\n\tswitch (placement) {\n\t\tcase 'top':\n\t\t\tcount = ++topCount;\n\t\t\ttype = 'success';\n\t\t\tbreak;\n\t\tcase 'bottom':\n\t\t\tcount = ++bottomCount;\n\t\t\ttype = 'warning';\n\t\t\tbreak;\n\t\tcase 'top-left':\n\t\t\tcount = ++topLeftCount;\n\t\t\ttype = 'info';\n\t\t\tbreak;\n\t\tcase 'top-right':\n\t\t\tcount = ++topRightCount;\n\t\t\ttype = 'primary';\n\t\t\tbreak;\n\t\tcase 'bottom-left':\n\t\t\tcount = ++bottomLeftCount;\n\t\t\ttype = 'warning';\n\t\t\tbreak;\n\t\tcase 'bottom-right':\n\t\t\tcount = ++bottomRightCount;\n\t\t\ttype = 'error';\n\t\t\tbreak;\n\t}\n\n\ttrackAsamMessage(\n\t\tAsamMessage({\n\t\t\tmessage: `消息位置：${placement}，第 ${count} 条`,\n\t\t\ttype,\n\t\t\tplacement\n\t\t})\n\t);\n};\n\nconst ownedAsamMessage = new Set<AsamMessageHandler>();\nlet mountedAsamMessage = true;\nconst trackAsamMessage = (handle: AsamMessageHandler) => {\n\tif (mountedAsamMessage) ownedAsamMessage.add(handle);\n\telse handle.close();\n\treturn handle;\n};\nonBeforeUnmount(() => {\n\tmountedAsamMessage = false;\n\tfor (const handle of ownedAsamMessage) handle.close();\n\townedAsamMessage.clear();\n});\n</script>\n",
