			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamCollapse/cap-custom-icon-position/ts/Demo.vue",
			"sha256": "efc20ea60d5907af1ebbe2bc018fbb77872da38851495914fc6e8d243764c204",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-38bfdc7eba09301412959751ab1a380b7f58e9f1240659172f7f34e016c873d9.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/38bfdc7eba09301412959751ab1a380b7f58e9f1240659172f7f34e016c873d9.txt\n-->\n<template>\n\t<div class=\"demo-collapse-position\">\n\t\t<div class=\"flex items-center mb-4\">\n\t\t\t<span class=\"mr-4\">展开图标位置： </span>\n\t\t\t<AsamSwitch\n\t\t\t\t:model-value=\"position\"\n\t\t\t\tinactive-value=\"left\"\n\t\t\t\tactive-value=\"right\"\n\t\t\t\tinactive-text=\"left\"\n\t\t\t\tactive-text=\"right\"\n\t\t\t\tclass=\"ui032-position-switch\"\n\t\t\t\t@update:model-value=\"\n\t\t\t\t\t(value) => {\n\t\t\t\t\t\tif (value === 'left' || value === 'right') position = value;\n\t\t\t\t\t}\n\t\t\t\t\"\n\t\t\t/>\n\t\t</div>\n\n\t\t<AsamCollapse :expand-icon-position=\"position\">\n\t\t\t<AsamCollapseItem title=\"一致性\" name=\"1\">\n\t\t\t\t<div>与生活一致：符合实际流程与逻辑，采用用户熟悉的语言和习惯。</div>\n\t\t\t\t<div>界面内部一致：设计风格、图标、文字及元素位置等保持一致。</div>\n\t\t\t</AsamCollapseItem>\n\t\t\t<AsamCollapseItem title=\"反馈\" name=\"2\">\n\t\t\t\t<div>操作反馈：通过样式变化和交互效果，让用户明确感知操作结果。</div>\n\t\t\t\t<div>视觉反馈：通过更新或调整页面元素来反映当前状态。</div>\n\t\t\t</AsamCollapseItem>\n\t\t\t<AsamCollapseItem title=\"效率\" name=\"3\">\n\t\t\t\t<div>简化流程：操作步骤应简单直观。</div>\n\t\t\t\t<div>明确清晰：清楚表达意图，让用户快速理解并作出决定。</div>\n\t\t\t\t<div>易于识别：界面直观清晰，减少用户记忆与回想的负担。</div>\n\t\t\t</AsamCollapseItem>\n\t\t</AsamCollapse>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\ndefineOptions({ name: 'AsamCollapseCapCustomIconPositionDemo' });\nimport { AsamSwitch, AsamCollapse, AsamCollapseItem } from '@asam-ui/ui';\n\nimport { ref } from 'vue';\n\nimport type { AsamCollapseIconPositionType } from '@asam-ui/ui';\n\nconst position = ref<AsamCollapseIconPositionType>('left');\n</script>\n\n<style scoped>\n/* Local styles keep this sample runnable without a website utility-CSS preset. */\n.flex {\n\tdisplay: flex;\n}\n\n.items-center {\n\talign-items: center;\n}\n\n.mb-4 {\n\tmargin-bottom: 1rem;\n}\n\n.mr-4 {\n\tmargin-right: 1rem;\n}\n\n.ui032-position-switch {\n\t--el-switch-off-color: #88b8fe;\n}\n</style>\n",
