	"files": [
		{
			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamDrawer/ep2147-customization-content/ts/Demo.vue",
			"sha256": "f954ccff5b6a04ea781099433d909ba9a830b17fc593fe787ad88c41a10cd255",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-46ad16d3e7f7c90975f78c6ca5b843a3972d472db4ad68cebcb645590fa4031e.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/46ad16d3e7f7c90975f78c6ca5b843a3972d472db4ad68cebcb645590fa4031e.txt\n-->\n<template>\n\t<AsamButton type=\"default\" text @click=\"table = true\"> 打开含嵌套表格的抽屉 </AsamButton>\n\t<AsamButton type=\"default\" text @click=\"dialog = true\"> 打开含嵌套表单的抽屉 </AsamButton>\n\t<AsamDrawer v-model=\"table\" title=\"内部包含嵌套表格。\" direction=\"rtl\" size=\"50%\">\n\t\t<AsamTable :data=\"gridData\">\n\t\t\t<AsamTableColumn property=\"date\" label=\"日期\" width=\"150\" />\n\t\t\t<AsamTableColumn property=\"name\" label=\"姓名\" width=\"200\" />\n\t\t\t<AsamTableColumn property=\"address\" label=\"地址\" />\n\t\t</AsamTable>\n\t</AsamDrawer>\n\n\t<AsamDrawer\n\t\tv-model=\"dialog\"\n\t\ttitle=\"内部包含嵌套表单。\"\n\t\t:before-close=\"handleClose\"\n\t\tdirection=\"ltr\"\n\t\tclass=\"demo-drawer\"\n\t>\n\t\t<div class=\"demo-drawer__content\">\n\t\t\t<AsamBaseForm :model=\"form\">\n\t\t\t\t<AsamFormItem label=\"姓名\" :label-width=\"formLabelWidth\">\n\t\t\t\t\t<AsamInput\n\t\t\t\t\t\t:model-value=\"form.name\"\n\t\t\t\t\t\t@update:model-value=\"form.name = String($event ?? '')\"\n\t\t\t\t\t\tautocomplete=\"off\"\n\t\t\t\t\t/>\n\t\t\t\t</AsamFormItem>\n\t\t\t\t<AsamFormItem label=\"区域\" :label-width=\"formLabelWidth\">\n\t\t\t\t\t<AsamSelect\n\t\t\t\t\t\t:model-value=\"form.region\"\n\t\t\t\t\t\t@update:model-value=\"form.region = String($event ?? '')\"\n\t\t\t\t\t\tplaceholder=\"请选择活动区域\"\n\t\t\t\t\t>\n\t\t\t\t\t\t<AsamOption label=\"区域 1\" value=\"shanghai\" />\n\t\t\t\t\t\t<AsamOption label=\"区域 2\" value=\"beijing\" />\n\t\t\t\t\t</AsamSelect>\n\t\t\t\t</AsamFormItem>\n\t\t\t</AsamBaseForm>\n\t\t\t<div class=\"demo-drawer__footer\">\n\t\t\t\t<AsamButton type=\"default\" @click=\"cancelForm\">取消</AsamButton>\n\t\t\t\t<AsamButton type=\"default\" :loading=\"loading\" @click=\"onClick\">\n\t\t\t\t\t{{ loading ? 'Submitting ...' : 'Submit' }}\n\t\t\t\t</AsamButton>\n\t\t\t</div>\n\t\t</div>\n\t</AsamDrawer>\n</template>\n\n<script lang=\"ts\" setup>\nimport {\n\tAsamBaseForm,\n\tAsamButton,\n\tAsamDrawer,\n\tAsamFormItem,\n\tAsamInput,\n\tAsamMessageBox,\n\tAsamOption,\n\tAsamSelect,\n\tAsamTable,\n\tAsamTableColumn\n} from '@asam-ui/ui';\n\nimport { reactive, ref } from 'vue';\n\nconst formLabelWidth = '80px';\nlet timer: ReturnType<typeof setTimeout> | undefined;\n\nconst table = ref(false);\nconst dialog = ref(false);\nconst loading = ref(false);\n\nconst form = reactive({\n\tname: '',\n\tregion: '',\n\tdate1: '',\n\tdate2: '',\n\tdelivery: false,\n\ttype: [],\n\tresource: '',\n\tdesc: ''\n});\n\nconst gridData = [\n\t{\n\t\tdate: '2016-05-02',\n\t\tname: 'Peter Parker',\n\t\taddress: 'Queens, New York City'\n\t},\n\t{\n\t\tdate: '2016-05-04',\n\t\tname: 'Peter Parker',\n\t\taddress: 'Queens, New York City'\n\t},\n\t{\n\t\tdate: '2016-05-01',\n\t\tname: 'Peter Parker',\n\t\taddress: 'Queens, New York City'\n\t},\n\t{\n\t\tdate: '2016-05-03',\n\t\tname: 'Peter Parker',\n\t\taddress: 'Queens, New York City'\n\t}\n];\n\nconst onClick = () => {\n\tloading.value = true;\n\tsetTimeout(() => {\n\t\tloading.value = false;\n\t\tdialog.value = false;\n\t}, 400);\n};\n\nconst handleClose = (done: () => void) => {\n\tif (loading.value) {\n\t\treturn;\n\t}\n\tAsamMessageBox.confirm('确定提交吗？')\n\t\t.then(() => {\n\t\t\tloading.value = true;\n\t\t\ttimer = setTimeout(() => {\n\t\t\t\tdone();\n\t\t\t\t// 动画关闭需要一定的时间\n\t\t\t\tsetTimeout(() => {\n\t\t\t\t\tloading.value = false;\n\t\t\t\t}, 400);\n\t\t\t}, 2000);\n\t\t})\n\t\t.catch(() => {\n\t\t\t// catch error\n\t\t});\n};\n\nconst cancelForm = () => {\n\tloading.value = false;\n\tdialog.value = false;\n\tclearTimeout(timer);\n};\n</script>\n",
			"originalSourceSha256": "f62c665056c652a46d6a615ec1d164beb467ad2bf7fe50bcff7948425fb18e30",
