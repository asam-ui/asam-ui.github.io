			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamTree/native-checking-tree/js/Demo.vue",
			"sha256": "06ceb5dd205d8ababde0a0d630ef196461f22ec4d214b72092e888423c49997c",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\nNotice resource: /licenses/source-notices/0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\n-->\n<template>\n\t<div class=\"demo-root-layout\">\n\t\t<AsamTree\n\t\t\tref=\"treeRef\"\n\t\t\tstyle=\"max-width: 600px\"\n\t\t\t:data=\"data\"\n\t\t\tshow-checkbox\n\t\t\tdefault-expand-all\n\t\t\tnode-key=\"id\"\n\t\t\thighlight-current\n\t\t\t:props=\"defaultProps\"\n\t\t/>\n\n\t\t<div class=\"flex flex-wrap demo-gap mt-2\">\n\t\t\t<AsamButton type=\"default\" class=\"!ml-0\" @click=\"getCheckedNodes\"\n\t\t\t\t>按节点获取</AsamButton\n\t\t\t>\n\t\t\t<AsamButton type=\"default\" class=\"!ml-0\" @click=\"getCheckedKeys\">按键获取</AsamButton>\n\t\t\t<AsamButton type=\"default\" class=\"!ml-0\" @click=\"setCheckedNodes\"\n\t\t\t\t>按节点设置</AsamButton\n\t\t\t>\n\t\t\t<AsamButton type=\"default\" class=\"!ml-0\" @click=\"setCheckedKeys\">按键设置</AsamButton>\n\t\t\t<AsamButton type=\"default\" class=\"!ml-0\" @click=\"resetChecked\">重置</AsamButton>\n\t\t</div>\n\t</div>\n</template>\n\n<script setup>\n\n\nimport { AsamTree, AsamButton } from '@asam-ui/ui';\n// Adapted from the fixed upstream MIT example: tree/checking-tree.vue\nimport { ref } from 'vue';\nconst treeRef = ref();\nconst getCheckedNodes = () => {\n\tconsole.log(treeRef.value.getCheckedNodes(false, false));\n};\nconst getCheckedKeys = () => {\n\tconsole.log(treeRef.value.getCheckedKeys(false));\n};\nconst setCheckedNodes = () => {\n\ttreeRef.value.setCheckedNodes(\n\t\t[\n\t\t\t{\n\t\t\t\tid: 5,\n\t\t\t\tlabel: '二级节点 2-1'\n\t\t\t},\n\t\t\t{\n\t\t\t\tid: 9,\n\t\t\t\tlabel: '三级节点 1-1-1'\n\t\t\t}\n\t\t],\n\t\tfalse\n\t);\n};\nconst setCheckedKeys = () => {\n\ttreeRef.value.setCheckedKeys([3], false);\n};\nconst resetChecked = () => {\n\ttreeRef.value.setCheckedKeys([], false);\n};\nconst defaultProps = {\n\tchildren: 'children',\n\tlabel: 'label'\n};\nconst data = [\n\t{\n\t\tid: 1,\n\t\tlabel: '一级节点 1',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tid: 4,\n\t\t\t\tlabel: '二级节点 1-1',\n\t\t\t\tchildren: [\n\t\t\t\t\t{\n\t\t\t\t\t\tid: 9,\n\t\t\t\t\t\tlabel: '三级节点 1-1-1'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tid: 10,\n\t\t\t\t\t\tlabel: '三级节点 1-1-2'\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t}\n\t\t]\n\t},\n\t{\n\t\tid: 2,\n\t\tlabel: '一级节点 2',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tid: 5,\n\t\t\t\tlabel: '二级节点 2-1'\n\t\t\t},\n\t\t\t{\n\t\t\t\tid: 6,\n\t\t\t\tlabel: '二级节点 2-2'\n\t\t\t}\n\t\t]\n\t},\n\t{\n\t\tid: 3,\n\t\tlabel: '一级节点 3',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tid: 7,\n\t\t\t\tlabel: '二级节点 3-1'\n\t\t\t},\n\t\t\t{\n\t\t\t\tid: 8,\n\t\t\t\tlabel: '二级节点 3-2'\n\t\t\t}\n\t\t]\n\t}\n];\n</script>\n\n<style scoped>\n/* Keep layout utilities local so the downloaded SFC needs no CSS preset. */\n.flex {\n\tdisplay: flex;\n}\n.flex-wrap {\n\tflex-wrap: wrap;\n}\n.demo-gap {\n\tgap: var(--asam-space-sm);\n}\n.mt-2 {\n\tmargin-top: var(--asam-space-sm);\n}\n</style>\n\n<style scoped>\n.demo-root-layout {\n\tdisplay: grid;\n\tgap: var(--asam-space-md);\n\tjustify-items: start;\n}\n.demo-root-layout > :is(p, pre, output) {\n\tmargin-block: 0;\n}\n</style>\n",
