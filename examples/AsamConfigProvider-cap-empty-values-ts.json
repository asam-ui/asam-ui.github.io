			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-41aef72276b3b88b218121c915596e24ce646ca914ca6dbf16304ae81716bcea.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/41aef72276b3b88b218121c915596e24ce646ca914ca6dbf16304ae81716bcea.txt\n-->\n<template>\n\t<AsamConfigProvider :value-on-clear=\"null\" :empty-values=\"[undefined, null]\">\n\t\t<div class=\"flex flex-wrap gap-4 items-center\">\n\t\t\t<AsamSelect\n\t\t\t\t:model-value=\"value1\"\n\t\t\t\tclearable\n\t\t\t\tplaceholder=\"选择\"\n\t\t\t\tstyle=\"width: 240px\"\n\t\t\t\t@update:model-value=\"\n\t\t\t\t\t(value: unknown) => {\n\t\t\t\t\t\tif (typeof value === 'string' || value === null) value1 = value;\n\t\t\t\t\t}\n\t\t\t\t\"\n\t\t\t\t@change=\"handleChange\"\n\t\t\t>\n\t\t\t\t<AsamOption\n\t\t\t\t\tv-for=\"item in options\"\n\t\t\t\t\t:key=\"item.value\"\n\t\t\t\t\t:label=\"item.label\"\n\t\t\t\t\t:value=\"item.value\"\n\t\t\t\t/>\n\t\t\t</AsamSelect>\n\t\t\t<AsamSelectV2\n\t\t\t\t:model-value=\"value2\"\n\t\t\t\tvalue-mode=\"native\"\n\t\t\t\tclearable\n\t\t\t\tplaceholder=\"选择\"\n\t\t\t\tstyle=\"width: 240px\"\n\t\t\t\t:options=\"options\"\n\t\t\t\t:value-on-clear=\"() => undefined\"\n\t\t\t\t@update:model-value=\"\n\t\t\t\t\t(value: unknown) => {\n\t\t\t\t\t\tif (typeof value === 'string' || value === undefined) value2 = value;\n\t\t\t\t\t}\n\t\t\t\t\"\n\t\t\t\t@change=\"handleChange\"\n\t\t\t/>\n\t\t</div>\n\t</AsamConfigProvider>\n</template>\n\n<script lang=\"ts\" setup>\ndefineOptions({ name: 'AsamConfigProviderCapEmptyValuesDemo' });\nimport { AsamConfigProvider, AsamSelect, AsamOption, AsamSelectV2 } from '@asam-ui/ui';\n\nimport { ref } from 'vue';\nimport { AsamMessage } from '@asam-ui/ui';\n\nconst value1 = ref<string | null>('');\nconst value2 = ref<string | undefined>('');\nconst options = [\n\t{\n\t\tvalue: '',\n\t\tlabel: '全部'\n\t},\n\t{\n\t\tvalue: 'Option1',\n\t\tlabel: '选项 1'\n\t},\n\t{\n\t\tvalue: 'Option2',\n\t\tlabel: '选项 2'\n\t},\n\t{\n\t\tvalue: 'Option3',\n\t\tlabel: '选项 3'\n\t},\n\t{\n\t\tvalue: 'Option4',\n\t\tlabel: '选项 4'\n\t},\n\t{\n\t\tvalue: 'Option5',\n\t\tlabel: '选项 5'\n\t}\n];\n\nconst handleChange = (value: unknown) => {\n\tif (value === undefined || value === null) {\n\t\tAsamMessage.info(`清空后的值为：${value}`);\n\t}\n};\n</script>\n\n<style scoped>\n/* Local styles keep this sample runnable without a website utility-CSS preset. */\n.flex {\n\tdisplay: flex;\n}\n\n.flex-wrap {\n\tflex-wrap: wrap;\n}\n\n.gap-4 {\n\tgap: 1rem;\n}\n\n.items-center {\n\talign-items: center;\n}\n</style>\n",
