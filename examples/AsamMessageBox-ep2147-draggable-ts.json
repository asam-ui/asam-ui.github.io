			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamMessageBox/ep2147-draggable/ts/Demo.vue",
			"sha256": "e276ec2e2191c347da733558547cbbe97801df54d31b1b18a6b0eefd0b056017",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-399986496e94e8a7964b94c5d2b5c41fc124bbd625a79b1da2d3c6263b62f2cd.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/399986496e94e8a7964b94c5d2b5c41fc124bbd625a79b1da2d3c6263b62f2cd.txt\n-->\n<template>\n\t<div class=\"flex flex-wrap gap-1\">\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" plain @click=\"open\"> 打开可拖拽消息框 </AsamButton>\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" plain @click=\"open2\">\n\t\t\t打开允许越界拖拽的消息框\n\t\t</AsamButton>\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" plain @click=\"open3\">\n\t\t\t打开自定义拖拽样式的消息框\n\t\t</AsamButton>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\nimport { AsamButton, AsamMessage, AsamMessageBox, type AsamMessageHandler } from '@asam-ui/ui';\n\nimport { onBeforeUnmount } from 'vue';\n\nconst open = () => {\n\tAsamMessageBox.confirm('此操作将永久删除文件，确定继续吗？', '警告', {\n\t\tconfirmButtonText: '确认',\n\t\tcancelButtonText: '取消',\n\t\ttype: 'warning',\n\t\tdraggable: true\n\t})\n\t\t.then(() => {\n\t\t\ttrackAsamMessage(\n\t\t\t\tAsamMessage({\n\t\t\t\t\ttype: 'success',\n\t\t\t\t\tmessage: '删除成功'\n\t\t\t\t})\n\t\t\t);\n\t\t})\n\t\t.catch(() => {\n\t\t\ttrackAsamMessage(\n\t\t\t\tAsamMessage({\n\t\t\t\t\ttype: 'info',\n\t\t\t\t\tmessage: '已取消删除'\n\t\t\t\t})\n\t\t\t);\n\t\t});\n};\n\nconst open2 = () => {\n\tAsamMessageBox.confirm('此操作将永久删除文件，确定继续吗？', '警告', {\n\t\tconfirmButtonText: '确认',\n\t\tcancelButtonText: '取消',\n\t\ttype: 'warning',\n\t\tdraggable: true,\n\t\toverflow: true\n\t})\n\t\t.then(() => {\n\t\t\ttrackAsamMessage(\n\t\t\t\tAsamMessage({\n\t\t\t\t\ttype: 'success',\n\t\t\t\t\tmessage: '删除成功'\n\t\t\t\t})\n\t\t\t);\n\t\t})\n\t\t.catch(() => {\n\t\t\ttrackAsamMessage(\n\t\t\t\tAsamMessage({\n\t\t\t\t\ttype: 'info',\n\t\t\t\t\tmessage: '已取消删除'\n\t\t\t\t})\n\t\t\t);\n\t\t});\n};\n\nconst open3 = () => {\n\tAsamMessageBox.confirm('此消息框使用自定义拖拽样式，拖动它即可查看效果。', '自定义拖拽样式', {\n\t\tconfirmButtonText: '确认',\n\t\tcancelButtonText: '取消',\n\t\ttype: 'info',\n\t\tdraggable: true,\n\t\tcustomClass: 'custom-dragging-message-box'\n\t})\n\t\t.then(() => {\n\t\t\ttrackAsamMessage(\n\t\t\t\tAsamMessage({\n\t\t\t\t\ttype: 'success',\n\t\t\t\t\tmessage: '操作完成'\n\t\t\t\t})\n\t\t\t);\n\t\t})\n\t\t.catch(() => {\n\t\t\ttrackAsamMessage(\n\t\t\t\tAsamMessage({\n\t\t\t\t\ttype: 'info',\n\t\t\t\t\tmessage: '已取消操作'\n\t\t\t\t})\n\t\t\t);\n\t\t});\n};\n\nconst ownedAsamMessage = new Set<AsamMessageHandler>();\nlet mountedAsamMessage = true;\nconst trackAsamMessage = (handle: AsamMessageHandler) => {\n\tif (mountedAsamMessage) ownedAsamMessage.add(handle);\n\telse handle.close();\n\treturn handle;\n};\nonBeforeUnmount(() => {\n\tmountedAsamMessage = false;\n\tfor (const handle of ownedAsamMessage) handle.close();\n\townedAsamMessage.clear();\n});\n</script>\n\n<style>\n.custom-dragging-message-box.is-dragging {\n\tborder: 2px dashed var(--el-color-primary);\n\topacity: 0.65;\n}\n</style>\n",
