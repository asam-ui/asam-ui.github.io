			"sha256": "1455cb17a596d5559862b6849d0c179408d015f02f3e0eec68a4e3390aeebfc0",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-f75284197908c909e814ff4cfb537557e04896d63b9edd8df332f6f6dbde5d7d.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/f75284197908c909e814ff4cfb537557e04896d63b9edd8df332f6f6dbde5d7d.txt\n-->\n<template>\n\t<div class=\"flex gap-2\">\n\t\t<AsamTag\n\t\t\tv-for=\"tag in dynamicTags\"\n\t\t\t:key=\"tag\"\n\t\t\tclosable\n\t\t\t:disable-transitions=\"false\"\n\t\t\t@close=\"handleClose(tag)\"\n\t\t>\n\t\t\t{{ tag }}\n\t\t</AsamTag>\n\t\t<AsamInput\n\t\t\tv-if=\"inputVisible\"\n\t\t\tref=\"InputRef\"\n\t\t\t:model-value=\"inputValue\"\n\t\t\tclass=\"w-20\"\n\t\t\tsize=\"small\"\n\t\t\tv-bind=\"domEnterAttrs(handleInputConfirm)\"\n\t\t\t@update:model-value=\"\n\t\t\t\t(value) => {\n\t\t\t\t\tif (typeof value === 'string') inputValue = value;\n\t\t\t\t}\n\t\t\t\"\n\t\t\t@blur=\"handleInputConfirm\"\n\t\t/>\n\t\t<!-- prettier-ignore -->\n\t\t<AsamButton type=\"primary\"\n\t\t\tv-else\n\t\t\tclass=\"button-new-tag\"\n\t\t\tsize=\"small\"\n\t\t\t@click=\"showInput\"\n\t\t>\n\t\t\t+ 新建标签\n\t\t</AsamButton>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\nimport type { HTMLAttributes } from 'vue';\ndefineOptions({ name: 'AsamTagCapEditableDemo' });\nimport { AsamTag, AsamInput, AsamButton } from '@asam-ui/ui';\n\nimport { nextTick, ref } from 'vue';\n\nimport type { AsamInputExpose } from '@asam-ui/ui';\n\nconst inputValue = ref('');\nconst dynamicTags = ref(['标签一', '标签二', '标签三']);\nconst inputVisible = ref(false);\nconst InputRef = ref<AsamInputExpose>();\n\nconst handleClose = (tag: string) => {\n\tdynamicTags.value.splice(dynamicTags.value.indexOf(tag), 1);\n};\n\nconst showInput = () => {\n\tinputVisible.value = true;\n\tnextTick(() => {\n\t\tInputRef.value!.input!.focus();\n\t});\n};\n\nconst handleInputConfirm = () => {\n\tif (inputValue.value) {\n\t\tdynamicTags.value.push(inputValue.value);\n\t}\n\tinputVisible.value = false;\n\tinputValue.value = '';\n};\n\nconst domEnterAttrs = (handler: () => void): Pick<HTMLAttributes, 'class' | 'onKeyup'> => ({\n\tclass: 'ui032-enter-input',\n\tonKeyup: (event) => {\n\t\tif (event.key === 'Enter') handler();\n\t}\n});\n</script>\n\n<style scoped>\n/* Local styles keep this sample runnable without a website utility-CSS preset. */\n.flex {\n\tdisplay: flex;\n}\n\n.gap-2 {\n\tgap: 0.5rem;\n}\n\n.w-20 {\n\twidth: 5rem;\n}\n</style>\n",
