			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-c9eaa398cd695f4f4b68c28a983e00a70ae2471bd1645935a77d3ca380256110.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/c9eaa398cd695f4f4b68c28a983e00a70ae2471bd1645935a77d3ca380256110.txt\n-->\n<template>\n\t<div style=\"display: flex; align-items: center\">\n\t\t<AsamPopover placement=\"right\" :width=\"400\" trigger=\"click\">\n\t\t\t<template #reference>\n\t\t\t\t<AsamButton style=\"margin-right: 16px\">Click to activate</AsamButton>\n\t\t\t</template>\n\t\t\t<AsamTable :data=\"gridData\">\n\t\t\t\t<AsamTableColumn width=\"150\" property=\"date\" label=\"date\" />\n\t\t\t\t<AsamTableColumn width=\"100\" property=\"name\" label=\"name\" />\n\t\t\t\t<AsamTableColumn width=\"300\" property=\"address\" label=\"address\" />\n\t\t\t</AsamTable>\n\t\t</AsamPopover>\n\n\t\t<AsamPopover\n\t\t\ttrigger=\"hover\"\n\t\t\t:width=\"300\"\n\t\t\tpopper-style=\"box-shadow: rgb(14 18 22 / 35%) 0px 10px 38px -10px, rgb(14 18 22 / 20%) 0px 10px 20px -15px; padding: 20px;\"\n\t\t>\n\t\t\t<template #reference>\n\t\t\t\t<AsamAvatar\n\t\t\t\t\tsrc=\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22120%22%20height%3D%2248%22%20viewBox%3D%220%200%20120%2048%22%3E%3Crect%20width%3D%22120%22%20height%3D%2248%22%20fill%3D%22%23e8edf3%22%2F%3E%3Ctext%20x%3D%2212%22%20y%3D%2231%22%20fill%3D%22%23345%22%20font-size%3D%2224%22%3EASAM%3C%2Ftext%3E%3C%2Fsvg%3E\"\n\t\t\t\t/>\n\t\t\t</template>\n\t\t\t<template #default>\n\t\t\t\t<div\n\t\t\t\t\tclass=\"demo-rich-conent\"\n\t\t\t\t\tstyle=\"display: flex; gap: 16px; flex-direction: column\"\n\t\t\t\t>\n\t\t\t\t\t<AsamAvatar\n\t\t\t\t\t\t:size=\"60\"\n\t\t\t\t\t\tsrc=\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22120%22%20height%3D%2248%22%20viewBox%3D%220%200%20120%2048%22%3E%3Crect%20width%3D%22120%22%20height%3D%2248%22%20fill%3D%22%23e8edf3%22%2F%3E%3Ctext%20x%3D%2212%22%20y%3D%2231%22%20fill%3D%22%23345%22%20font-size%3D%2224%22%3EASAM%3C%2Ftext%3E%3C%2Fsvg%3E\"\n\t\t\t\t\t\tstyle=\"margin-bottom: 8px\"\n\t\t\t\t\t/>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p class=\"demo-rich-content__name\" style=\"margin: 0; font-weight: 500\">\n\t\t\t\t\t\t\tASAM UI\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<p\n\t\t\t\t\t\t\tclass=\"demo-rich-content__mention\"\n\t\t\t\t\t\t\tstyle=\"margin: 0; font-size: 14px; color: var(--el-color-info)\"\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t@asam-ui\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<p class=\"demo-rich-content__desc\" style=\"margin: 0\">\n\t\t\t\t\t\tASAM UI, a Vue 3 based component library for developers, designers and\n\t\t\t\t\t\tproduct managers\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t</template>\n\t\t</AsamPopover>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\nimport { AsamAvatar, AsamButton, AsamPopover, AsamTable, AsamTableColumn } from '@asam-ui/ui';\n\nconst gridData = [\n\t{\n\t\tdate: '2016-05-02',\n\t\tname: 'Jack',\n\t\taddress: 'New York City'\n\t},\n\t{\n\t\tdate: '2016-05-04',\n\t\tname: 'Jack',\n\t\taddress: 'New York City'\n\t},\n\t{\n\t\tdate: '2016-05-01',\n\t\tname: 'Jack',\n\t\taddress: 'New York City'\n\t},\n\t{\n\t\tdate: '2016-05-03',\n\t\tname: 'Jack',\n\t\taddress: 'New York City'\n\t}\n];\n</script>\n",
