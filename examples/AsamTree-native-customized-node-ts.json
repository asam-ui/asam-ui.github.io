	"entry": "Demo.vue",
	"files": [
		{
			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamTree/native-customized-node/ts/Demo.vue",
			"sha256": "91f4a186d8d9e66e7c31593589448e9b19a46fad667d6ce91e0bc8cfbc56f0c0",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\nNotice resource: /licenses/source-notices/0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\n-->\n<template>\n\t<div class=\"custom-tree-container\">\n\t\t<p class=\"example-paragraph\">使用 render-content</p>\n\t\t<AsamTree\n\t\t\tref=\"treeRef1\"\n\t\t\tstyle=\"max-width: 600px\"\n\t\t\t:data=\"dataSource\"\n\t\t\tshow-checkbox\n\t\t\tnode-key=\"id\"\n\t\t\tdefault-expand-all\n\t\t\t:expand-on-click-node=\"false\"\n\t\t\t:render-content=\"renderContent\"\n\t\t/>\n\t\t<p class=\"example-paragraph\">使用作用域插槽</p>\n\t\t<AsamTree\n\t\t\tref=\"treeRef2\"\n\t\t\tstyle=\"max-width: 600px\"\n\t\t\t:data=\"dataSource\"\n\t\t\tshow-checkbox\n\t\t\tnode-key=\"id\"\n\t\t\tdefault-expand-all\n\t\t\t:expand-on-click-node=\"false\"\n\t\t>\n\t\t\t<template #default=\"{ node, data }\">\n\t\t\t\t<div class=\"custom-tree-node\">\n\t\t\t\t\t<span>{{ node.label }}</span>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<AsamButton type=\"default\" link @click=\"append(data)\"> 追加 </AsamButton>\n\t\t\t\t\t\t<AsamButton\n\t\t\t\t\t\t\tstyle=\"margin-left: 4px\"\n\t\t\t\t\t\t\ttype=\"default\"\n\t\t\t\t\t\t\tlink\n\t\t\t\t\t\t\t@click=\"remove(node, data)\"\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t删除\n\t\t\t\t\t\t</AsamButton>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</template>\n\t\t</AsamTree>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\n\n\nimport { AsamTree, AsamButton } from '@asam-ui/ui';\n// Adapted from the fixed upstream MIT example: tree/customized-node.vue\n\nimport { ref } from 'vue';\n\nimport type {\n\tAsamTreeRenderContentContext,\n\tAsamTreeRenderContentFunction,\n\tAsamTreeInstance\n} from '@asam-ui/ui';\n\ninterface Tree {\n\tid: number;\n\tlabel: string;\n\tchildren?: Tree[];\n}\ntype Node = AsamTreeRenderContentContext['node'];\ntype Data = AsamTreeRenderContentContext['data'];\n\nlet id = 1000;\nconst treeRef1 = ref<AsamTreeInstance>();\nconst treeRef2 = ref<AsamTreeInstance>();\n\nconst append = (data: Data) => {\n\tconst newChild = { id: id++, label: 'testtest', children: [] };\n\ttreeRef1.value?.append(newChild, data);\n\ttreeRef2.value?.append(newChild, data);\n};\n\nconst remove = (node: Node, data: Data) => {\n\ttreeRef1.value?.remove(data);\n\ttreeRef2.value?.remove(data);\n};\n\nconst renderContent: AsamTreeRenderContentFunction = (h, { node, data }) => {\n\treturn h(\n\t\t'div',\n\t\t{\n\t\t\tclass: 'custom-tree-node'\n\t\t},\n\t\t[\n\t\t\th('span', null, node.label),\n\t\t\th('div', null, [\n\t\t\t\th(\n\t\t\t\t\tAsamButton,\n\t\t\t\t\t{\n\t\t\t\t\t\ttype: 'default',\n\t\t\t\t\t\tlink: true,\n\t\t\t\t\t\tonClick: () => append(data)\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tdefault: () => '添加'\n\t\t\t\t\t}\n\t\t\t\t),\n\t\t\t\th(\n\t\t\t\t\tAsamButton,\n\t\t\t\t\t{\n\t\t\t\t\t\ttype: 'danger',\n\t\t\t\t\t\tlink: true,\n\t\t\t\t\t\tstyle: 'margin-left: 4px',\n\t\t\t\t\t\tonClick: () => remove(node, data)\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tdefault: () => '删除'\n\t\t\t\t\t}\n\t\t\t\t)\n\t\t\t])\n\t\t]\n\t);\n};\n\nconst dataSource = ref<Tree[]>([\n\t{\n\t\tid: 1,\n\t\tlabel: '一级节点 1',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tid: 4,\n\t\t\t\tlabel: '二级节点 1-1',\n\t\t\t\tchildren: [\n\t\t\t\t\t{\n\t\t\t\t\t\tid: 9,\n\t\t\t\t\t\tlabel: '三级节点 1-1-1'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tid: 10,\n\t\t\t\t\t\tlabel: '三级节点 1-1-2'\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t}\n\t\t]\n\t},\n\t{\n\t\tid: 2,\n\t\tlabel: '一级节点 2',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tid: 5,\n\t\t\t\tlabel: '二级节点 2-1'\n\t\t\t},\n\t\t\t{\n\t\t\t\tid: 6,\n\t\t\t\tlabel: '二级节点 2-2'\n\t\t\t}\n\t\t]\n\t},\n\t{\n\t\tid: 3,\n\t\tlabel: '一级节点 3',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tid: 7,\n\t\t\t\tlabel: '二级节点 3-1'\n\t\t\t},\n\t\t\t{\n\t\t\t\tid: 8,\n\t\t\t\tlabel: '二级节点 3-2'\n\t\t\t}\n\t\t]\n\t}\n]);\n</script>\n\n<style>\n.custom-tree-node {\n\tflex: 1;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tfont-size: 14px;\n\tpadding-right: 8px;\n}\n</style>\n\n<style scoped>\np:where(.example-paragraph) {\n\tmargin-block: 16px;\n\tline-height: 1.8;\n\toverflow-wrap: anywhere;\n}\n</style>\n",
			"originalSourceSha256": "40044db4dc3bfbf50eee935fcbd5108450837c48e06d618eb68d7efe8c5cc5e0",
