\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'color',\n\t\t\t\t\t\tlabel: '颜色'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'typography',\n\t\t\t\t\t\tlabel: 'Typography'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'icon',\n\t\t\t\t\t\tlabel: 'Icon'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'button',\n\t\t\t\t\t\tlabel: '按钮'\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t},\n\t\t\t{\n\t\t\t\tvalue: 'form',\n\t\t\t\tlabel: 'Form',\n\t\t\t\tchildren: [\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'radio',\n\t\t\t\t\t\tlabel: 'Radio'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'checkbox',\n\t\t\t\t\t\tlabel: 'Checkbox'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'input',\n\t\t\t\t\t\tlabel: 'Input'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'input-number',\n\t\t\t\t\t\tlabel: 'InputNumber'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'select',\n\t\t\t\t\t\tlabel: '选择'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'cascader',\n\t\t\t\t\t\tlabel: 'Cascader'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'switch',\n\t\t\t\t\t\tlabel: 'Switch'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'slider',\n\t\t\t\t\t\tlabel: 'Slider'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'time-picker',\n\t\t\t\t\t\tlabel: 'TimePicker'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'date-picker',\n\t\t\t\t\t\tlabel: 'DatePicker'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'datetime-picker',\n\t\t\t\t\t\tlabel: 'DateTimePicker'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'upload',\n\t\t\t\t\t\tlabel: '上传'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'rate',\n\t\t\t\t\t\tlabel: '评分'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'form',\n\t\t\t\t\t\tlabel: 'Form'\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t},\n\t\t\t{\n\t\t\t\tvalue: 'data',\n\t\t\t\tlabel: 'Data',\n\t\t\t\tchildren: [\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'table',\n\t\t\t\t\t\tlabel: 'Table'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'tag',\n\t\t\t\t\t\tlabel: '标签'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tvalue: 'progress',\n\t\t\t\