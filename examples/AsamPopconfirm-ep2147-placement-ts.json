\t</template>\n\t\t\t</AsamPopconfirm>\n\t\t</div>\n\t\t<div class=\"row\">\n\t\t\t<AsamPopconfirm class=\"box-item\" title=\"左下方显示提示\" placement=\"left-end\">\n\t\t\t\t<template #reference>\n\t\t\t\t\t<AsamButton type=\"primary\">left-end</AsamButton>\n\t\t\t\t</template>\n\t\t\t</AsamPopconfirm>\n\t\t\t<AsamPopconfirm class=\"box-item\" title=\"右下方显示提示\" placement=\"right-end\">\n\t\t\t\t<template #reference>\n\t\t\t\t\t<AsamButton type=\"primary\">right-end</AsamButton>\n\t\t\t\t</template>\n\t\t\t</AsamPopconfirm>\n\t\t</div>\n\t\t<div class=\"row center\">\n\t\t\t<AsamPopconfirm class=\"box-item\" title=\"左下方显示提示\" placement=\"bottom-start\">\n\t\t\t\t<template #reference>\n\t\t\t\t\t<AsamButton type=\"primary\">bottom-start</AsamButton></template\n\t\t\t\t>\n\t\t\t</AsamPopconfirm>\n\t\t\t<AsamPopconfirm class=\"box-item\" title=\"底部居中显示提示\" placement=\"bottom\">\n\t\t\t\t<template #reference> <AsamButton type=\"primary\">bottom</AsamButton></template>\n\t\t\t</AsamPopconfirm>\n\t\t\t<AsamPopconfirm class=\"box-item\" title=\"右下方显示提示\" placement=\"bottom-end\">\n\t\t\t\t<template #reference>\n\t\t\t\t\t<AsamButton type=\"primary\">bottom-end</AsamButton>\n\t\t\t\t</template>\n\t\t\t</AsamPopconfirm>\n\t\t</div>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\nimport { AsamButton, AsamPopconfirm } from '@asam-ui/ui';\n</script>\n\n<style>\n.popconfirm-base-box {\n\twidth: 600px;\n}\n\n.popconfirm-base-box .row {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n}\n\n.popconfirm-base-box .center {\n\tjustify-content: center;\n}\n\n.popconfirm-base-box .box-item {\n\twidth: 110px;\n\tmargin-top: 10px;\n}\n</style>\n",
