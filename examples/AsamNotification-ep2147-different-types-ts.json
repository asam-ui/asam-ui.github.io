			"sha256": "b1e61735698011bbfe2fab8a81f1ab9b65d986b8d4bce6defe695e6e9a88488e",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-2f65c97b05fcce070133920e3a98c550ff1326d44aa7f7c8a77a56f811e568d4.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/2f65c97b05fcce070133920e3a98c550ff1326d44aa7f7c8a77a56f811e568d4.txt\n-->\n<template>\n\t<div class=\"flex flex-wrap demo-gap\">\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" @click=\"open5\">主要</AsamButton>\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" @click=\"open1\">成功</AsamButton>\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" @click=\"open2\">警告</AsamButton>\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" @click=\"open3\">信息</AsamButton>\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" @click=\"open4\">错误</AsamButton>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\nimport { AsamButton, AsamNotification, type AsamNotificationHandle } from '@asam-ui/ui';\n\nimport { onBeforeUnmount } from 'vue';\n\nconst open1 = () => {\n\ttrackAsamNotification(\n\t\tAsamNotification({\n\t\t\ttitle: '成功',\n\t\t\tmessage: '这是一条成功消息。',\n\t\t\ttype: 'success'\n\t\t})\n\t);\n};\n\nconst open2 = () => {\n\ttrackAsamNotification(\n\t\tAsamNotification({\n\t\t\ttitle: '警告',\n\t\t\tmessage: '这是一条警告消息。',\n\t\t\ttype: 'warning'\n\t\t})\n\t);\n};\n\nconst open3 = () => {\n\ttrackAsamNotification(\n\t\tAsamNotification.info({\n\t\t\ttitle: '信息',\n\t\t\tmessage: '这是一条信息提示。'\n\t\t})\n\t);\n};\n\nconst open4 = () => {\n\ttrackAsamNotification(\n\t\tAsamNotification.error({\n\t\t\ttitle: '错误',\n\t\t\tmessage: '这是一条错误消息。'\n\t\t})\n\t);\n};\n\nconst open5 = () => {\n\ttrackAsamNotification(\n\t\tAsamNotification({\n\t\t\ttitle: '主要',\n\t\t\tmessage: '这是一条主要消息。',\n\t\t\ttype: 'primary'\n\t\t})\n\t);\n};\n\nconst ownedAsamNotification = new Set<AsamNotificationHandle>();\nlet mountedAsamNotification = true;\nconst trackAsamNotification = (handle: AsamNotificationHandle) => {\n\tif (mountedAsamNotification) ownedAsamNotification.add(handle);\n\telse handle.close();\n\treturn handle;\n};\nonBeforeUnmount(() => {\n\tmountedAsamNotification = false;\n\tfor (const handle of ownedAsamNotification) handle.close();\n\townedAsamNotification.clear();\n});\n</script>\n\n<style scoped>\n/* Keep layout utilities local so the downloaded SFC needs no CSS preset. */\n.flex {\n\tdisplay: flex;\n}\n.flex-wrap {\n\tflex-wrap: wrap;\n}\n.demo-gap {\n\tgap: var(--asam-space-sm);\n}\n</style>\n",
