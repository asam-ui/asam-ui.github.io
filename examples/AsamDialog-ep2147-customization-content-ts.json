			"name": "Demo.vue",
			"sourcePath": "apps/website/examples/AsamDialog/ep2147-customization-content/ts/Demo.vue",
			"sha256": "0789692673eabfb30296923dc6e2858d1c7fc5b806c3fcf5207d0105f35f6442",
			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-e8c9291ec84144989e5aa39e9a402c42748f74941aa2d7a3c5a2791edc8a0aa4.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/e8c9291ec84144989e5aa39e9a402c42748f74941aa2d7a3c5a2791edc8a0aa4.txt\n-->\n<template>\n\t<div class=\"flex flex-wrap gap-1\">\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" plain @click=\"dialogTableVisible = true\">\n\t\t\t打开含嵌套表格的对话框\n\t\t</AsamButton>\n\n\t\t<AsamButton type=\"default\" class=\"!ml-0\" plain @click=\"dialogFormVisible = true\">\n\t\t\t打开含嵌套表单的对话框\n\t\t</AsamButton>\n\t</div>\n\n\t<AsamDialog v-model=\"dialogTableVisible\" title=\"收货地址\" width=\"800\">\n\t\t<AsamTable :data=\"gridData\">\n\t\t\t<AsamTableColumn property=\"date\" label=\"日期\" width=\"150\" />\n\t\t\t<AsamTableColumn property=\"name\" label=\"姓名\" width=\"200\" />\n\t\t\t<AsamTableColumn property=\"address\" label=\"地址\" />\n\t\t</AsamTable>\n\t</AsamDialog>\n\n\t<AsamDialog v-model=\"dialogFormVisible\" title=\"收货地址\" width=\"500\">\n\t\t<AsamBaseForm :model=\"form\">\n\t\t\t<AsamFormItem label=\"活动名称\" :label-width=\"formLabelWidth\">\n\t\t\t\t<AsamInput\n\t\t\t\t\t:model-value=\"form.name\"\n\t\t\t\t\t@update:model-value=\"form.name = String($event ?? '')\"\n\t\t\t\t\tautocomplete=\"off\"\n\t\t\t\t/>\n\t\t\t</AsamFormItem>\n\t\t\t<AsamFormItem label=\"区域\" :label-width=\"formLabelWidth\">\n\t\t\t\t<AsamSelect\n\t\t\t\t\t:model-value=\"form.region\"\n\t\t\t\t\t@update:model-value=\"form.region = String($event ?? '')\"\n\t\t\t\t\tplaceholder=\"请选择区域\"\n\t\t\t\t>\n\t\t\t\t\t<AsamOption label=\"区域 1\" value=\"shanghai\" />\n\t\t\t\t\t<AsamOption label=\"区域 2\" value=\"beijing\" />\n\t\t\t\t</AsamSelect>\n\t\t\t</AsamFormItem>\n\t\t</AsamBaseForm>\n\t\t<template #footer>\n\t\t\t<div class=\"dialog-footer\">\n\t\t\t\t<AsamButton type=\"default\" @click=\"dialogFormVisible = false\">取消</AsamButton>\n\t\t\t\t<AsamButton type=\"default\" @click=\"dialogFormVisible = false\"> 确认 </AsamButton>\n\t\t\t</div>\n\t\t</template>\n\t</AsamDialog>\n</template>\n\n<script lang=\"ts\" setup>\nimport {\n\tAsamBaseForm,\n\tAsamButton,\n\tAsamDialog,\n\tAsamFormItem,\n\tAsamInput,\n\tAsamOption,\n\tAsamSelect,\n\tAsamTable,\n\tAsamTableColumn\n} from '@asam-ui/ui';\n\nimport { reactive, ref } from 'vue';\n\nconst dialogTableVisible = ref(false);\nconst dialogFormVisible = ref(false);\nconst formLabelWidth = '140px';\n\nconst form = reactive({\n\tname: '',\n\tregion: '',\n\tdate1: '',\n\tdate2: '',\n\tdelivery: false,\n\ttype: [],\n\tresource: '',\n\tdesc: ''\n});\n\nconst gridData = [\n\t{\n\t\tdate: '2016-05-02',\n\t\tname: '约翰·史密斯',\n\t\taddress: '普陀区金沙江路 1518 号'\n\t},\n\t{\n\t\tdate: '2016-05-04',\n\t\tname: '约翰·史密斯',\n\t\taddress: '普陀区金沙江路 1518 号'\n\t},\n\t{\n\t\tdate: '2016-05-01',\n\t\tname: '约翰·史密斯',\n\t\taddress: '普陀区金沙江路 1518 号'\n\t},\n\t{\n\t\tdate: '2016-05-03',\n\t\tname: '约翰·史密斯',\n\t\taddress: '普陀区金沙江路 1518 号'\n\t}\n];\n</script>\n",
