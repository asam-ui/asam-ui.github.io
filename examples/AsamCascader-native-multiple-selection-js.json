			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\nNotice resource: /licenses/source-notices/0790118bb4d66681db1d63181f72ef68e632d632f6db0373ef87cf328561af27.txt\n-->\n<template>\n\t<div class=\"m-4\">\n\t\t<p class=\"example-paragraph\">显示全部标签（默认）</p>\n\t\t<AsamCascader value-mode=\"native\" :options=\"options\" :props=\"props\" clearable />\n\t</div>\n\t<div class=\"m-4\">\n\t\t<p class=\"example-paragraph\">折叠标签</p>\n\t\t<AsamCascader\n\t\t\tvalue-mode=\"native\"\n\t\t\t:options=\"options\"\n\t\t\t:props=\"props\"\n\t\t\tcollapse-tags\n\t\t\tclearable\n\t\t/>\n\t</div>\n\t<div class=\"m-4\">\n\t\t<p class=\"example-paragraph\">折叠标签提示</p>\n\t\t<AsamCascader\n\t\t\tvalue-mode=\"native\"\n\t\t\t:options=\"options\"\n\t\t\t:props=\"props\"\n\t\t\tcollapse-tags\n\t\t\tcollapse-tags-tooltip\n\t\t\tclearable\n\t\t/>\n\t</div>\n\t<div class=\"m-4\">\n\t\t<p class=\"example-paragraph\">最多显示的折叠标签数</p>\n\t\t<AsamCascader\n\t\t\tvalue-mode=\"native\"\n\t\t\t:options=\"options\"\n\t\t\t:props=\"props\"\n\t\t\tcollapse-tags\n\t\t\tcollapse-tags-tooltip\n\t\t\t:max-collapse-tags=\"3\"\n\t\t\tclearable\n\t\t/>\n\t</div>\n</template>\n\n<script setup>\n\n\nimport { AsamCascader } from '@asam-ui/ui';\n// Adapted from the fixed upstream MIT example: cascader/multiple-selection.vue\nconst props = { multiple: true };\nconst options = [\n\t{\n\t\tvalue: 1,\n\t\tlabel: 'Asia',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tvalue: 2,\n\t\t\t\tlabel: 'China',\n\t\t\t\tchildren: [\n\t\t\t\t\t{ value: 3, label: 'Beijing' },\n\t\t\t\t\t{ value: 4, label: 'Shanghai' },\n\t\t\t\t\t{ value: 5, label: 'Hangzhou' }\n\t\t\t\t]\n\t\t\t},\n\t\t\t{\n\t\t\t\tvalue: 6,\n\t\t\t\tlabel: 'Japan',\n\t\t\t\tchildren: [\n\t\t\t\t\t{ value: 7, label: 'Tokyo' },\n\t\t\t\t\t{ value: 8, label: 'Osaka' },\n\t\t\t\t\t{ value: 9, label: 'Kyoto' }\n\t\t\t\t]\n\t\t\t},\n\t\t\t{\n\t\t\t\tvalue: 10,\n\t\t\t\tlabel: 'Korea',\n\t\t\t\tchildren: [\n\t\t\t\t\t{ value: 11, label: 'Seoul' },\n\t\t\t\t\t{ value: 12, label: 'Busan' },\n\t\t\t\t\t{ value: 13, label: 'Taegu' }\n\t\t\t\t]\n\t\t\t}\n\t\t]\n\t},\n\t{\n\t\tvalue: 14,\n\t\tlabel: 'Europe',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tvalue: 15,\n\t\t\t\tlabel: 'France',\n\t\t\t\tchildren: [\n\t\t\t\t\t{ value: 16, label: 'Paris' },\n\t\t\t\t\t{ value: 17, label: 'Marseille' },\n\t\t\t\t\t{ value: 18, label: 'Lyon' }\n\t\t\t\t]\n\t\t\t},\n\t\t\t{\n\t\t\t\tvalue: 19,\n\t\t\t\tlabel: 'UK',\n\t\t\t\tchildren: [\n\t\t\t\t\t{ value: 20, label: 'London' },\n\t\t\t\t\t{ value: 21, label: 'Birmingham' },\n\t\t\t\t\t{ value: 22, label: 'Manchester' }\n\t\t\t\t]\n\t\t\t}\n\t\t]\n\t},\n\t{\n\t\tvalue: 23,\n\t\tlabel: 'North America',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tvalue: 24,\n\t\t\t\tlabel: 'US',\n\t\t\t\tchildren: [\n\t\t\t\t\t{ value: 25, label: 'New York' },\n\t\t\t\t\t{ value: 26, label: '洛杉矶' },\n\t\t\t\t\t{ value: 27, label: 'Washington' }\n\t\t\t\t]\n\t\t\t},\n\t\t\t{\n\t\t\t\tvalue: 28,\n\t\t\t\tlabel: 'Canada',\n\t\t\t\tchildren: [\n\t\t\t\t\t{ value: 29, label: 'Toronto' },\n\t\t\t\t\t{ value: 30, label: 'Montreal' },\n\t\t\t\t\t{ value: 31, label: 'Ottawa' }\n\t\t\t\t]\n\t\t\t}\n\t\t]\n\t}\n];\n</script>\n\n<style scoped>\n/* Keep layout utilities local so the downloaded SFC needs no CSS preset. */\n.m-4 {\n\tmargin: var(--asam-space-lg);\n}\n</style>\n\n<style scoped>\np:where(.example-paragraph) {\n\tmargin-block: 16px;\n\tline-height: 1.8;\n\toverflow-wrap: anywhere;\n}\n</style>\n",
