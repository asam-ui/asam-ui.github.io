			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-376ec04aaefa0458a8e95fd8697cd628eb4e27c534071e7c88e63524806a41d0.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/376ec04aaefa0458a8e95fd8697cd628eb4e27c534071e7c88e63524806a41d0.txt\n-->\n<template>\n\t<div class=\"demo-root-layout\">\n\t\t<AsamRadioGroup\n\t\t\t:model-value=\"size\"\n\t\t\tv-bind=\"{ 'aria-label': 'size control' }\"\n\t\t\tclass=\"mb-4\"\n\t\t\t@update:model-value=\"updatesize\"\n\t\t>\n\t\t\t<AsamRadioButton value=\"large\">large</AsamRadioButton>\n\t\t\t<AsamRadioButton value=\"default\">default</AsamRadioButton>\n\t\t\t<AsamRadioButton value=\"small\">small</AsamRadioButton>\n\t\t</AsamRadioGroup>\n\t\t<div class=\"demo-date-picker demo-layout-1\">\n\t\t\t<div class=\"block\">\n\t\t\t\t<span class=\"demonstration\">默认</span>\n\t\t\t\t<AsamDatePicker\n\t\t\t\t\tv-model=\"value1\"\n\t\t\t\t\tvalue-format=\"\"\n\t\t\t\t\ttype=\"date\"\n\t\t\t\t\tplaceholder=\"选择日期\"\n\t\t\t\t\t:size=\"size\"\n\t\t\t\t/>\n\t\t\t</div>\n\t\t\t<div class=\"block\">\n\t\t\t\t<span class=\"demonstration\">带快捷选项的选择器</span>\n\t\t\t\t<AsamDatePicker\n\t\t\t\t\tv-model=\"value2\"\n\t\t\t\t\tvalue-format=\"\"\n\t\t\t\t\ttype=\"date\"\n\t\t\t\t\tplaceholder=\"选择日期\"\n\t\t\t\t\t:disabled-date=\"disabledDate\"\n\t\t\t\t\t:shortcuts=\"shortcuts\"\n\t\t\t\t\t:size=\"size\"\n\t\t\t\t/>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</template>\n\n<script lang=\"ts\" setup>\nimport type { AsamDateValue } from '@asam-ui/ui';\nimport { AsamRadioGroup, AsamRadioButton, AsamDatePicker } from '@asam-ui/ui';\ndefineOptions({ name: 'AsamDatePickerofficialdatepickerenterdateExample' });\n\nimport { ref } from 'vue';\n\nconst size = ref<'default' | 'large' | 'small'>('default');\n\nconst value1 = ref<AsamDateValue>('');\nconst value2 = ref<AsamDateValue>('');\n\nconst shortcuts = [\n\t{\n\t\ttext: 'Today',\n\t\tvalue: new Date()\n\t},\n\t{\n\t\ttext: 'Yesterday',\n\t\tvalue: () => {\n\t\t\tconst date = new Date();\n\t\t\tdate.setTime(date.getTime() - 3600 * 1000 * 24);\n\t\t\treturn date;\n\t\t}\n\t},\n\t{\n\t\ttext: '一周前',\n\t\tvalue: () => {\n\t\t\tconst date = new Date();\n\t\t\tdate.setTime(date.getTime() - 3600 * 1000 * 24 * 7);\n\t\t\treturn date;\n\t\t}\n\t}\n];\n\nconst disabledDate = (time: Date) => {\n\treturn time.getTime() > Date.now();\n};\nfunction updatesize(value: unknown) {\n\tif (value === 'large' || value === 'default' || value === 'small') size.value = value;\n}\n</script>\n\n<style scoped>\n/* stylelint-disable selector-pseudo-class-no-unknown, selector-class-pattern, no-descending-specificity -- Vue deep/native BEM selectors and equivalent media selector groups retained from the fixed official example. */\n.demo-date-picker {\n\tdisplay: flex;\n\twidth: 100%;\n\tpadding: 0;\n\tflex-wrap: wrap;\n}\n\n.demo-date-picker .block {\n\tpadding: 1.5rem 0;\n\ttext-align: center;\n\tborder-right: solid 1px var(--el-border-color);\n\tflex: 1;\n\tmin-width: 300px;\n}\n\n.demo-date-picker .block:last-child {\n\tborder-right: none;\n}\n\n.demo-date-picker .demonstration {\n\tdisplay: block;\n\tcolor: var(--el-text-color-secondary);\n\tfont-size: 14px;\n\tmargin-bottom: 1rem;\n}\n\n@media screen and (width <= 768px) {\n\t.demo-date-picker .block {\n\t\tflex: 0 0 100%;\n\t\tpadding: 1rem 0;\n\t\tmin-width: auto;\n\t\tborder-right: none;\n\t\tborder-bottom: solid 1px var(--el-border-color);\n\t}\n\n\t.demo-date-picker .block:last-child {\n\t\tborder-bottom: none;\n\t}\n}\n</style>\n\n<style scoped>\n/* Keep layout utilities local so the downloaded SFC needs no CSS preset. */\n.mb-4 {\n\tmargin-bottom: var(--asam-space-lg);\n}\n</style>\n\n<style scoped>\n.demo-layout-1 {\n\tgap: var(--asam-space-md);\n}\n</style>\n\n<style scoped>\n.demo-root-layout {\n\tdisplay: flex;\n\tgap: var(--asam-space-md);\n\tflex-wrap: wrap;\n\talign-items: center;\n}\n.demo-root-layout > :is(p, pre, output) {\n\tmargin-block: 0;\n}\n</style>\n",
