			"source": "<!--\nSPDX-License-Identifier: MIT\nComplete attribution and permission: LICENSE-9c23b9f2ce5f295e46458e26e3c7efdf21c1d65d7197288102547cd3724813cd.txt\nIncluded in the source bundle; notice resource: /licenses/source-notices/9c23b9f2ce5f295e46458e26e3c7efdf21c1d65d7197288102547cd3724813cd.txt\n-->\n<template>\n\t<AsamRadioGroup\n\t\t:model-value=\"size\"\n\t\t@update:model-value=\"\n\t\t\t(value) => {\n\t\t\t\tif (\n\t\t\t\t\tvalue === 'small' ||\n\t\t\t\t\tvalue === 'default' ||\n\t\t\t\t\tvalue === 'big' ||\n\t\t\t\t\tvalue === 'large'\n\t\t\t\t)\n\t\t\t\t\tsize = value;\n\t\t\t}\n\t\t\"\n\t>\n\t\t<AsamRadioItem value=\"large\">大尺寸</AsamRadioItem>\n\t\t<AsamRadioItem value=\"default\">默认</AsamRadioItem>\n\t\t<AsamRadioItem value=\"small\">小尺寸</AsamRadioItem>\n\t</AsamRadioGroup>\n\n\t<!-- prettier-ignore -->\n\t<AsamDescriptions\n\t\tclass=\"margin-top\"\n\t\ttitle=\"带边框\"\n\t\t:column=\"3\"\n\t\t:size=\"size\"\n\t\tborder\n\t>\n\t\t<template #extra>\n\t\t\t<AsamButton type=\"default\">操作</AsamButton>\n\t\t</template>\n\t\t<AsamDescriptionsItem>\n\t\t\t<template #label>\n\t\t\t\t<div class=\"cell-item\">\n\t\t\t\t\t<AsamIcon :style=\"iconStyle\">\n\t\t\t\t\t\t<user />\n\t\t\t\t\t</AsamIcon>\n\t\t\t\t\t用户名\n\t\t\t\t</div>\n\t\t\t</template>\n\t\t\tkooriookami\n\t\t</AsamDescriptionsItem>\n\t\t<AsamDescriptionsItem>\n\t\t\t<template #label>\n\t\t\t\t<div class=\"cell-item\">\n\t\t\t\t\t<AsamIcon :style=\"iconStyle\">\n\t\t\t\t\t\t<iphone />\n\t\t\t\t\t</AsamIcon>\n\t\t\t\t\t电话\n\t\t\t\t</div>\n\t\t\t</template>\n\t\t\t18100000000\n\t\t</AsamDescriptionsItem>\n\t\t<AsamDescriptionsItem>\n\t\t\t<template #label>\n\t\t\t\t<div class=\"cell-item\">\n\t\t\t\t\t<AsamIcon :style=\"iconStyle\">\n\t\t\t\t\t\t<location />\n\t\t\t\t\t</AsamIcon>\n\t\t\t\t\t地点\n\t\t\t\t</div>\n\t\t\t</template>\n\t\t\t苏州\n\t\t</AsamDescriptionsItem>\n\t\t<AsamDescriptionsItem>\n\t\t\t<template #label>\n\t\t\t\t<div class=\"cell-item\">\n\t\t\t\t\t<AsamIcon :style=\"iconStyle\">\n\t\t\t\t\t\t<tickets />\n\t\t\t\t\t</AsamIcon>\n\t\t\t\t\t备注\n\t\t\t\t</div>\n\t\t\t</template>\n\t\t\t<AsamTag size=\"small\">学校</AsamTag>\n\t\t</AsamDescriptionsItem>\n\t\t<AsamDescriptionsItem>\n\t\t\t<template #label>\n\t\t\t\t<div class=\"cell-item\">\n\t\t\t\t\t<AsamIcon :style=\"iconStyle\">\n\t\t\t\t\t\t<office-building />\n\t\t\t\t\t</AsamIcon>\n\t\t\t\t\t地址\n\t\t\t\t</div>\n\t\t\t</template>\n\t\t\t江苏省苏州市吴中区吴中大道 1188 号\n\t\t</AsamDescriptionsItem>\n\t</AsamDescriptions>\n\n\t<AsamDescriptions\n\t\tclass=\"margin-top\"\n\t\ttitle=\"无边框\"\n\t\t:column=\"3\"\n\t\t:size=\"size\"\n\t\t:style=\"blockMargin\"\n\t>\n\t\t<template #extra>\n\t\t\t<AsamButton type=\"default\">操作</AsamButton>\n\t\t</template>\n\t\t<AsamDescriptionsItem label=\"用户名\">kooriookami</AsamDescriptionsItem>\n\t\t<AsamDescriptionsItem label=\"电话\">18100000000</AsamDescriptionsItem>\n\t\t<AsamDescriptionsItem label=\"地点\">苏州</AsamDescriptionsItem>\n\t\t<AsamDescriptionsItem label=\"备注\">\n\t\t\t<AsamTag size=\"small\">学校</AsamTag>\n\t\t</AsamDescriptionsItem>\n\t\t<AsamDescriptionsItem label=\"地址\">\n\t\t\t江苏省苏州市吴中区吴中大道 1188 号\n\t\t</AsamDescriptionsItem>\n\t</AsamDescriptions>\n</template>\n\n<script setup>\ndefineOptions({ name: 'AsamDescriptionsCapSizesDemo' });\nimport {\n\tAsamRadioGroup,\n\tAsamRadioItem,\n\tAsamDescriptions,\n\tAsamButton,\n\tAsamDescriptionsItem,\n\tAsamIcon,\n\tAsamTag\n} from '@asam-ui/ui';\nimport { computed, ref } from 'vue';\nimport { Iphone, Location, OfficeBuilding, Tickets, User } from '@asam-ui/icons-vue';\nconst size = ref('default');\nconst iconStyle = computed(() => {\n\tconst marginMap = {\n\t\tlarge: '8px',\n\t\tdefault: '6px',\n\t\tbig: '4px',\n\t\tsmall: '4px'\n\t};\n\treturn {\n\t\tmarginRight: marginMap[size.value] || marginMap.default\n\t};\n});\nconst blockMargin = computed(() => {\n\tconst marginMap = {\n\t\tlarge: '32px',\n\t\tdefault: '28px',\n\t\tbig: '24px',\n\t\tsmall: '24px'\n\t};\n\treturn {\n\t\tmarginTop: marginMap[size.value] || marginMap.default\n\t};\n});\n</script>\n\n<style scoped>\n.el-descriptions {\n\tmargin-top: 20px;\n}\n\n.cell-item {\n\tdisplay: flex;\n\talign-items: center;\n}\n\n.margin-top {\n\tmargin-top: 20px;\n}\n</style>\n",
