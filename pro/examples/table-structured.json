	"schemaVersion": 1,
	"entry": "tests/v2/table-structured/Example.vue",
	"bootstrap": "tests/v2/table-structured/Example.vue",
	"files": [
		{
			"path": "tests/v2/table-structured/Example.vue",
			"source": "<template>\n\t<main>\n\t\t<h1>结构表格工作台</h1>\n\t\t<p>已加载叶节点与明确全量范围分别汇总；金额规则由此示例宿主提供。</p>\n\t\t<Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t<label\n\t\t\t\t\t\t><span>尺寸</span\n\t\t\t\t\t\t><AsamSelect v-model=\"size\"\n\t\t\t\t\t\t\t><AsamOption\n\t\t\t\t\t\t\t\tv-for=\"s in sizes\"\n\t\t\t\t\t\t\t\t:key=\"s\"\n\t\t\t\t\t\t\t\t:value=\"String(s).trim()\"\n\t\t\t\t\t\t\t\t:label=\"String(s).trim()\"\n\t\t\t\t\t\t\t\t>{{ s }}</AsamOption\n\t\t\t\t\t\t\t></AsamSelect\n\t\t\t\t\t\t></label\n\t\t\t\t\t>\n\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t></Teleport\n\t\t><AsamButton @click=\"dark = !dark\" type=\"primary\">切换明暗</AsamButton\n\t\t><AsamButton @click=\"scope += '-new'\" type=\"primary\">切换 scope</AsamButton\n\t\t><AsamButton @click=\"lazy.refresh()\" type=\"primary\">刷新懒树</AsamButton\n\t\t><AsamButton @click=\"reversed = !reversed\" type=\"primary\">重排行与合并规则恢复</AsamButton\n\t\t><AsamButton @click=\"badSummary = !badSummary\" type=\"primary\">汇总异常与恢复</AsamButton\n\t\t><AsamButton @click=\"invalidMoney = !invalidMoney\" type=\"primary\">非法金额与恢复</AsamButton\n\t\t><AsamButton @click=\"badForest = !badForest\" type=\"primary\">树非法与恢复</AsamButton>\n\t\t<h2>已物化树 · 三层 · 数字0和字符串0</h2>\n\t\t<AsamStructuredTable\n\t\t\tmode=\"tree\"\n\t\t\t:controller=\"tree\"\n\t\t\t:columns=\"columns\"\n\t\t\t:size=\"size\"\n\t\t\t:summary=\"leaves\"\n\t\t\t:on-expand=\"observe\"\n\t\t/>\n\t\t<h2>懒树 · 成功 / 空 / 失败重试 / 收拢缓存</h2>\n\t\t<AsamStructuredTable\n\t\t\tmode=\"lazy-tree\"\n\t\t\t:controller=\"lazy\"\n\t\t\t:columns=\"columns\"\n\t\t\t:size=\"size\"\n\t\t\t:summary=\"leaves\"\n\t\t\t:on-expand=\"observe\"\n\t\t/>\n\t\t<p role=\"status\">{{ lastEvent }}；真实加载次数 {{ calls }}</p>\n\t\t<h2>平面 · 矩形合并 + 局部汇总</h2>\n\t\t<AsamStructuredTable\n\t\t\tmode=\"flat\"\n\t\t\t:controller=\"flat\"\n\t\t\t:columns=\"columns\"\n\t\t\t:size=\"size\"\n\t\t\t:spans=\"spans\"\n\t\t\t:summary=\"local\"\n\t\t/>\n\t\t<h2>平面 · 明确全量汇总</h2>\n\t\t<AsamStructuredTable\n\t\t\tmode=\"flat\"\n\t\t\t:controller=\"flat\"\n\t\t\t:columns=\"columns\"\n\t\t\t:size=\"size\"\n\t\t\t:summary=\"full\"\n\t\t/>\n\t\t<h2>平面 · 行合并 / 列合并</h2>\n\t\t<AsamStructuredTable\n\t\t\tmode=\"flat\"\n\t\t\t:controller=\"flat\"\n\t\t\t:columns=\"columns\"\n\t\t\t:size=\"size\"\n\t\t\t:spans=\"separateSpans\"\n\t\t/><StateCases />\n\t</main>\n</template>\n\n<script setup lang=\"ts\">\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\n\nimport { AsamSelect, AsamOption } from '@asam-ui/ui';\n\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { computed, ref, shallowRef, watchEffect } from 'vue';\nimport StateCases from './StateCases.vue';\nimport { AsamStructuredTable, useAsamStructuredTable } from '@asam-ui/pro/components';\nimport type {\n\tAsamStructuredColumn,\n\tAsamStructuredSummary,\n\tAsamStructuredSpanPlan\n} from '@asam-ui/pro/components';\nimport type { AsamControlSize } from '@asam-ui/ui';\nimport { createAsamTheme, toAsamCssVariables } from '@asam-ui/ui';\ndefineOptions({ name: 'StructuredTableExample' });\n\ninterface Row {\n\tid: string | number;\n\tname: string;\n\tnote: string;\n\tcategory?: string;\n\tamount: string | null;\n\tchildren?: readonly Row[];\n\tbranch?: boolean;\n}\nconst sizes = ['large', 'big', 'default', 'small'] as const;\nconst size = ref<AsamControlSize>('default');\nconst dark = ref(false);\nwatchEffect(() => {\n\tdocument.documentElement.classList.toggle('dark', dark.value);\n\tconst theme = createAsamTheme(\n\t\tdark.value\n\t\t\t? {\n\t\t\t\t\tcolor: {\n\t\t\t\t\t\tsurface: '#182235',\n\t\t\t\t\t\tsurfacePage: '#101827',\n\t\t\t\t\t\tsurfaceMuted: '#26354c',\n\t\t\t\t\t\tsurfaceSoft: '#223147',\n\t\t\t\t\t\ttextPrimary: '#e5edf8',\n\t\t\t\t\t\ttextRegular: '#cbd7e8',\n\t\t\t\t\t\ttextSecondary: '#9bacc6',\n\t\t\t\t\t\tborder: '#3b4d66',\n\t\t\t\t\t\tdivider: '#31435d'\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t: {}\n\t);\n\tfor (const [key, value] of Object.entries(toAsamCssVariables(theme)))\n\t\tdocument.documentElement.style.setProperty(key, value);\n});\nconst scope = ref('example');\nconst columns: readonly AsamStructuredColumn<Row>[] = [\n\t{ key: 'name', label: '名称', width: 180, fixed: 'left' },\n\t{ key: 'note', label: '说明' },\n\t{ key: 'category', label: '分类', width: 160 },\n\t{ key: 'amount', label: '金额', width: 100, align: 'right', fixed: 'right' }\n];\nconst treeRows = shallowRef<readonly Row[]>([\n\t{\n\t\tid: 0,\n\t\tname: '数字0父节点',\n\t\tnote: '完整只读树',\n\t\tamount: '100',\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tid: '0',\n\t\t\t\tname: '字符串0子节点',\n\t\t\t\tnote: '与数字0独立',\n\t\t\t\tamount: '10',\n\t\t\t\tchildren: [\n\t\t\t\t\t{ id: 'leaf', name: '第三层叶节点', note: '只累计叶节点', amount: '0.10' }\n\t\t\t\t]\n\t\t\t},\n\t\t\t{ id: 'sibling', name: '同胞叶节点', note: '负数', amount: '-0.20' }\n\t\t]\n\t},\n\t{\n\t\tid: 'second',\n\t\tname: '另一父节点',\n\t\tnote: '零',\n\t\tamount: '0',\n\t\tchildren: [{ id: 'other', name: '另一个叶节点', note: '负零', amount: '-0.00' }]\n\t}\n]);\nconst badForest = ref(false);\nconst tree = useAsamStructuredTable<Row>({\n\trows: () => (badForest.value ? [...treeRows.value, treeRows.value[0]] : treeRows.value),\n\tscope,\n\tmode: 'tree',\n\trowKey: 'id',\n\tinitialExpandedKeys: [0, '0', 'second']\n});\nconst lazyRows: readonly Row[] = [\n\t{\n\t\tid: 'success',\n\t\tname: '成功父节点',\n\t\tnote: '慢请求期间可收拢或切scope',\n\t\tamount: null,\n\t\tbranch: true\n\t},\n\t{ id: 'empty', name: '空叶父节点', note: '空数组成功', amount: null, branch: true },\n\t{ id: 'retry', name: '失败父节点', note: '首次失败后点击重试', amount: null, branch: true }\n];\nconst calls = ref(0);\nconst attempts = new Map<string, number>();\nconst lazy = useAsamStructuredTable<Row>({\n\trows: lazyRows,\n\tscope,\n\tmode: 'lazy-tree',\n\trowKey: 'id',\n\thasChildren: (r) => Boolean(r.branch),\n\tloader: async (parent, context) => {\n\t\tcalls.value++;\n\t\tconst key = `${context.scope}:${parent.id}`;\n\t\tconst attempt = (attempts.get(key) ?? 0) + 1;\n\t\tattempts.set(key, attempt);\n\t\tawait new Promise((resolve) => setTimeout(resolve, 450));\n\t\tif (parent.id === 'retry' && attempt === 1) throw new Error('示例网络失败，请重试');\n\t\tif (parent.id === 'empty') return [];\n\t\treturn [\n\t\t\t{\n\t\t\t\tid: `${parent.id}-child`,\n\t\t\t\tname: `${parent.name}的叶`,\n\t\t\t\tnote: '宿主注入结果',\n\t\t\t\tamount: '0.20'\n\t\t\t}\n\t\t];\n\t}\n});\nconst baseRows: readonly Row[] = [\n\t{\n\t\tid: 1,\n\t\tname: '项目甲',\n\t\tnote: '矩形合并的长内容：说明与分类共用区域，可横向滚动查看',\n\t\tamount: '0.10'\n\t},\n\t{ id: 2, name: '被覆盖名称', note: '被覆盖说明', amount: '0.20' },\n\t{ id: 3, name: '负数', note: '真实值', amount: '-0.10' },\n\t{ id: 4, name: '零与空值', note: '空不参与', amount: null },\n\t{ id: 5, name: '空字符串', note: '按宿主规则计零', amount: '' }\n];\nconst reversed = ref(false);\nconst invalidMoney = ref(false);\nconst flatRows = computed(() => {\n\tconst rows = invalidMoney.value\n\t\t? baseRows.map((row) => (row.id === 3 ? { ...row, amount: '非法' } : row))\n\t\t: baseRows;\n\treturn reversed.value ? [...rows].reverse() : rows;\n});\nconst flat = useAsamStructuredTable<Row>({ rows: flatRows, scope, mode: 'flat', rowKey: 'id' });\nconst spans: AsamStructuredSpanPlan = {\n\trowKeys: baseRows.map((r) => r.id),\n\tcolumnKeys: columns.map((c) => c.key),\n\tregions: [{ row: 0, column: 1, rowspan: 2, colspan: 2 }]\n};\nconst separateSpans: AsamStructuredSpanPlan = {\n\t...spans,\n\tregions: [\n\t\t{ row: 0, column: 0, rowspan: 2, colspan: 1 },\n\t\t{ row: 2, column: 1, rowspan: 1, colspan: 2 }\n\t]\n};\n/** 示例宿主采用十进制字符串转整数分；拒绝超出两位与非法输入，不承诺通用财务规则。 */\nfunction cents(value: string | null): number {\n\tif (value === null || value === '') return 0;\n\tif (!/^-?\\d+(\\.\\d{1,2})?$/.test(value)) throw new TypeError('示例仅接受两位小数字符串');\n\tconst [integer, fraction = ''] = value.replace('-', '').split('.');\n\tconst result =\n\t\t(Number(integer) * 100 + Number(fraction.padEnd(2, '0'))) *\n\t\t(value.startsWith('-') ? -1 : 1);\n\tif (!Number.isSafeInteger(result)) throw new TypeError('金额超出示例精度预算');\n\treturn result;\n}\nconst badSummary = ref(false);\nconst calculate = (rows: readonly Row[], column: AsamStructuredColumn<Row>) => {\n\tif (badSummary.value) throw new TypeError('示例汇总错误');\n\treturn column.key === 'amount' ? rows.reduce((sum, r) => sum + cents(r.amount), 0) / 100 : null;\n};\nconst format = (value: number) => value.toFixed(2);\nconst leaves: AsamStructuredSummary<Row> = {\n\tkind: 'local',\n\trange: 'loaded-leaves',\n\tlabel: '已加载叶',\n\tcalculate,\n\tformat\n};\nconst local: AsamStructuredSummary<Row> = {\n\tkind: 'local',\n\trange: 'all-loaded',\n\tlabel: '当前范围',\n\tcalculate,\n\tformat\n};\nconst full = computed<AsamStructuredSummary<Row>>(() => ({\n\tkind: 'full',\n\tscope: scope.value,\n\tcompleteRows: [...baseRows, { id: 6, name: '范围外', note: '全量已知', amount: '1.00' }],\n\tlabel: '明确全量',\n\tcalculate,\n\tformat\n}));\nconst lastEvent = ref('等待展开事件');\nfunction observe(row: Row, expanded: boolean) {\n\tlastEvent.value = `原始行 ${typeof row.id}:${row.id} ${expanded ? '展开' : '收拢'}`;\n}\n</script>\n\n<style>\nbody {\n\tmargin: 0;\n\tbackground: var(--el-bg-color-page);\n\tcolor: var(--el-text-color-primary);\n\tfont-family: sans-serif;\n}\nmain {\n\tmax-width: 1180px;\n\tmargin: auto;\n\tpadding: 24px;\n}\nh2 {\n\tmargin-top: 32px;\n}\nbutton:not([class*='el-']),\nselect:not([class*='el-']) {\n\tmargin: 6px;\n}\nbutton:not([class*='el-']):focus-visible,\nselect:not([class*='el-']):focus-visible {\n\toutline: 2px solid var(--el-color-primary);\n\toutline-offset: 2px;\n}\n.asam-structured-table {\n\tmargin: 16px 0;\n}\n@media (max-width: 500px) {\n\tmain {\n\t\tpadding: 12px;\n\t}\n}\n</style>\n"
		},
		{
			"path": "tests/v2/table-structured/StateCases.vue",
			"source": "<template>\n\t<section aria-label=\"结构表格状态示例\">\n\t\t<h2>disabled / readonly：组件读取边界</h2>\n\t\t<p>readonly 允许读取；disabled 阻止组件新意图。宿主按钮仍由宿主负责。</p>\n\t\t<div data-case=\"bare-disabled\">\n\t\t\t<AsamStructuredTable\n\t\t\t\tdisabled\n\t\t\t\tmode=\"tree\"\n\t\t\t\t:controller=\"bareDisabled\"\n\t\t\t\t:columns=\"columns\"\n\t\t\t/>\n\t\t</div>\n\t\t<div data-case=\"bare-readonly\">\n\t\t\t<AsamStructuredTable\n\t\t\t\treadonly\n\t\t\t\tmode=\"lazy-tree\"\n\t\t\t\t:controller=\"bareReadonly\"\n\t\t\t\t:columns=\"columns\"\n\t\t\t/>\n\t\t</div>\n\t\t<div data-case=\"omitted\">\n\t\t\t<AsamStructuredTable mode=\"lazy-tree\" :controller=\"omitted\" :columns=\"columns\" />\n\t\t</div>\n\t\t<label><AsamCheckboxItem v-model=\"disabled\" data-state=\"disabled\" />disabled</label\n\t\t><label><AsamCheckboxItem v-model=\"readonly\" data-state=\"readonly\" />readonly</label\n\t\t><AsamButton data-action=\"expand\" @click=\"api?.expand('native', true)\" type=\"primary\"\n\t\t\t>ref 展开</AsamButton\n\t\t><AsamButton data-action=\"collapse\" @click=\"api?.expand('native', false)\" type=\"primary\">\n\t\t\tref 收拢 </AsamButton\n\t\t><AsamButton data-action=\"lazy\" @click=\"api?.expand('pending', true)\" type=\"primary\"\n\t\t\t>ref 懒展开</AsamButton\n\t\t><AsamButton data-action=\"retry\" @click=\"api?.retry('failure')\" type=\"primary\"\n\t\t\t>ref 重试</AsamButton\n\t\t><AsamButton data-action=\"refresh\" @click=\"api?.refresh()\" type=\"primary\"\n\t\t\t>ref 刷新</AsamButton\n\t\t><AsamButton data-action=\"layout\" @click=\"api?.doLayout()\" type=\"primary\"\n\t\t\t>ref 排版</AsamButton\n\t\t><AsamButton data-action=\"finish\" @click=\"finishPending()\" type=\"primary\"\n\t\t\t>宿主完成在途读取</AsamButton\n\t\t><AsamButton data-action=\"scope\" @click=\"scope += '-next'\" type=\"primary\"\n\t\t\t>宿主切换 scope</AsamButton\n\t\t><AsamButton\n\t\t\tdata-action=\"delete\"\n\t\t\t@click=\"rows = rows.filter((row) => row.id !== 'pending')\"\n\t\t\ttype=\"primary\"\n\t\t>\n\t\t\t宿主删除父行 </AsamButton\n\t\t><AsamButton data-action=\"host-load\" @click=\"void dynamic.load('pending')\" type=\"primary\">\n\t\t\t宿主直接读取 </AsamButton\n\t\t><Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t<AsamButton data-action=\"mount\" @click=\"shown = !shown\" type=\"primary\"\n\t\t\t\t\t\t>挂载 / 卸载视图</AsamButton\n\t\t\t\t\t>\n\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t></Teleport\n\t\t>\n\t\t<div data-case=\"bound\">\n\t\t\t<AsamStructuredTable\n\t\t\t\tv-if=\"shown\"\n\t\t\t\tref=\"api\"\n\t\t\t\tmode=\"lazy-tree\"\n\t\t\t\t:disabled=\"disabled\"\n\t\t\t\t:readonly=\"readonly\"\n\t\t\t\t:controller=\"dynamic\"\n\t\t\t\t:columns=\"columns\"\n\t\t\t\t:on-expand=\"observe\"\n\t\t\t\t><template #cell=\"{ row }\"\n\t\t\t\t\t>{{ row.name }}\n\t\t\t\t\t<AsamButton\n\t\t\t\t\t\tv-if=\"row.id === 'native'\"\n\t\t\t\t\t\tdata-action=\"slot\"\n\t\t\t\t\t\t@click=\"slotActions++\"\n\t\t\t\t\t\ttype=\"primary\"\n\t\t\t\t\t>\n\t\t\t\t\t\t宿主 slot 动作\n\t\t\t\t\t</AsamButton></template\n\t\t\t\t></AsamStructuredTable\n\t\t\t>\n\t\t</div>\n\t\t<div data-case=\"peer\">\n\t\t\t<AsamStructuredTable\n\t\t\t\treadonly\n\t\t\t\tmode=\"lazy-tree\"\n\t\t\t\t:controller=\"dynamic\"\n\t\t\t\t:columns=\"columns\"\n\t\t\t/>\n\t\t</div>\n\t</section>\n</template>\n\n<script setup lang=\"ts\">\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\n\nimport { AsamCheckboxItem } from '@asam-ui/ui';\n\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { computed, ref, shallowRef } from 'vue';\nimport { AsamStructuredTable, useAsamStructuredTable } from '@asam-ui/pro/components';\nimport type { AsamStructuredColumn, AsamStructuredTableExpose } from '@asam-ui/pro/components';\n\ninterface Row {\n\tid: string;\n\tname: string;\n\tchildren?: readonly Row[];\n\tbranch?: boolean;\n}\nconst columns: readonly AsamStructuredColumn<Row>[] = [{ key: 'name', label: '名称' }];\nconst initial: readonly Row[] = Object.freeze([\n\tObject.freeze({\n\t\tid: 'native',\n\t\tname: '已加载父行',\n\t\tchildren: Object.freeze([Object.freeze({ id: 'child', name: '已加载子行' })])\n\t}),\n\tObject.freeze({ id: 'pending', name: '在途父行', branch: true }),\n\tObject.freeze({ id: 'failure', name: '失败父行', branch: true })\n]);\nconst original = JSON.stringify(initial);\nconst rows = shallowRef(initial);\nconst scope = ref('state-scope');\nconst disabled = ref(true);\nconst readonly = ref(true);\nconst shown = ref(true);\nconst api = shallowRef<AsamStructuredTableExpose>();\nconst calls = ref<{ id: string; scope: string; aborted: boolean }[]>([]);\nconst events = ref<{ id: string; expanded: boolean; original: boolean }[]>([]);\nconst slotActions = ref(0);\nconst resolvers: (() => void)[] = [];\nlet failures = 0;\nconst resultLabel = '读取结果-normal';\nconst dynamic = useAsamStructuredTable<Row>({\n\trows,\n\tscope,\n\tmode: 'lazy-tree',\n\trowKey: 'id',\n\tinitialExpandedKeys: ['native'],\n\thasChildren: (row) => Boolean(row.branch || row.children?.length),\n\tloader: async (parent, context) => {\n\t\tconst record = { id: parent.id, scope: context.scope, aborted: context.signal.aborted };\n\t\tcalls.value.push(record);\n\t\tcontext.signal.addEventListener('abort', () => {\n\t\t\trecord.aborted = true;\n\t\t});\n\t\tif (parent.id === 'failure' && failures++ === 0) throw Error('可恢复读取失败');\n\t\tif (parent.id === 'pending') await new Promise<void>((resolve) => resolvers.push(resolve));\n\t\treturn [{ id: parent.id + '-result', name: resultLabel }];\n\t}\n});\nfunction finishPending() {\n\tfor (const resolve of resolvers.splice(0)) resolve();\n}\nfunction observe(row: Row, expanded: boolean) {\n\tevents.value.push({ id: row.id, expanded, original: initial.includes(row) });\n}\nconst simpleCalls = ref({ readonly: 0, omitted: 0 });\nlet readonlyFailures = 0;\nconst bareDisabled = useAsamStructuredTable<Row>({\n\trows: initial.slice(0, 1),\n\tscope: 'bare-disabled',\n\tmode: 'tree',\n\trowKey: 'id',\n\tinitialExpandedKeys: ['native']\n});\nconst bareReadonly = useAsamStructuredTable<Row>({\n\trows: [{ id: 'read', name: '只读读取父行', branch: true }],\n\tscope: 'bare-readonly',\n\tmode: 'lazy-tree',\n\trowKey: 'id',\n\thasChildren: (row) => Boolean(row.branch),\n\tloader: async () => {\n\t\tsimpleCalls.value.readonly++;\n\t\tif (readonlyFailures++ === 0) throw Error('只读可重试');\n\t\treturn [{ id: 'read-child', name: resultLabel }];\n\t}\n});\nconst omitted = useAsamStructuredTable<Row>({\n\trows: [{ id: 'omit', name: '默认读取父行', branch: true }],\n\tscope: 'omitted',\n\tmode: 'lazy-tree',\n\trowKey: 'id',\n\thasChildren: (row) => Boolean(row.branch),\n\tloader: async () => {\n\t\tsimpleCalls.value.omitted++;\n\t\treturn [{ id: 'omit-child', name: resultLabel }];\n\t}\n});\nconst receipt = computed(() => ({\n\tdisabled: disabled.value,\n\treadonly: readonly.value,\n\tcalls: calls.value,\n\texpanded: dynamic.expandedKeys.value,\n\tgeneration: dynamic.generation.value,\n\tloads: [...dynamic.loads.value],\n\tevents: events.value,\n\tsimpleCalls: simpleCalls.value,\n\tunchanged: JSON.stringify(initial) === original,\n\tslotActions: slotActions.value,\n\texposed: api.value ? Object.keys(api.value).sort() : []\n}));\n</script>\n"
		}
	]
}
