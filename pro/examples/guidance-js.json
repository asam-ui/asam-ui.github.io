	"schemaVersion": 1,
	"entry": "tests/v2/guidance/Example.vue",
	"language": "js",
	"files": [
		{
			"path": "tests/v2/guidance/Example.vue",
			"source": "<template>\n\t<main :class=\"{ dark }\">\n\t\t<h1>通知、帮助与引导</h1>\n\t\t<Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t<label\n\t\t\t\t\t\t>尺寸\n\t\t\t\t\t\t<AsamSelect v-model=\"size\"\n\t\t\t\t\t\t\t><AsamOption value=\"small\" label=\"small\">small</AsamOption\n\t\t\t\t\t\t\t><AsamOption value=\"default\" label=\"default\">default</AsamOption\n\t\t\t\t\t\t\t><AsamOption value=\"big\" label=\"big\">big</AsamOption\n\t\t\t\t\t\t\t><AsamOption value=\"large\" label=\"large\">large</AsamOption></AsamSelect\n\t\t\t\t\t\t></label\n\t\t\t\t\t>\n\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t></Teleport\n\t\t><AsamButton\n\t\t\t@click=\"dark = !dark\"\n\t\t\t:data-preview-color-mode=\"dark ? 'dark' : 'light'\"\n\t\t\ttype=\"primary\"\n\t\t\t>切换主题</AsamButton\n\t\t><AsamButton @click=\"disabled = !disabled\" type=\"primary\">切换禁用</AsamButton\n\t\t><AsamButton @click=\"readonly = !readonly\" type=\"primary\">切换只读</AsamButton\n\t\t><AsamNotificationPanel\n\t\t\tref=\"notifications\"\n\t\t\tv-model:category=\"category\"\n\t\t\t:items=\"items\"\n\t\t\t:categories=\"categories\"\n\t\t\t:size=\"size\"\n\t\t\t:disabled=\"disabled\"\n\t\t\t:readonly=\"readonly\"\n\t\t\t:operate=\"operate\"\n\t\t\t@result=\"onResult\"\n\t\t/>\n\t\t<p>成功操作 {{ results }}</p>\n\t\t<AsamButton @click=\"fail = !fail\" type=\"primary\">切换失败</AsamButton\n\t\t><AsamNotificationMenu\n\t\t\tv-model=\"menu\"\n\t\t\tv-model:category=\"category\"\n\t\t\t:items=\"items\"\n\t\t\t:categories=\"categories\"\n\t\t/><AsamButton id=\"help-trigger\" @click=\"help = true\" type=\"primary\">打开帮助</AsamButton\n\t\t><AsamButton @click=\"contextKey = contextKey === 'a' ? 'b' : 'a'\" type=\"primary\"\n\t\t\t>切换帮助上下文</AsamButton\n\t\t><AsamHelpPanel\n\t\t\tref=\"helpPanel\"\n\t\t\tv-model=\"help\"\n\t\t\t:context-key=\"contextKey\"\n\t\t\t:load=\"loadHelp\"\n\t\t\t:size=\"size\"\n\t\t/><AsamButton\n\t\t\tid=\"tour-trigger\"\n\t\t\t@click=\"\n\t\t\t\tcurrent = 0;\n\t\t\t\ttour = true;\n\t\t\t\"\n\t\t\ttype=\"primary\"\n\t\t>\n\t\t\t开始引导 </AsamButton\n\t\t><AsamButton id=\"target-a\" type=\"primary\">目标一</AsamButton\n\t\t><AsamButton v-if=\"targetVisible\" id=\"target-b\" type=\"primary\">目标二</AsamButton\n\t\t><AsamButton @click=\"targetVisible = !targetVisible\" type=\"primary\">切换目标</AsamButton\n\t\t><AsamGuidedTour\n\t\t\tref=\"tourRef\"\n\t\t\tv-model=\"tour\"\n\t\t\tv-model:current=\"current\"\n\t\t\t:steps=\"steps\"\n\t\t\t:size=\"size\"\n\t\t\t@exit=\"exitReason = $event\"\n\t\t/>\n\t\t<p>退出原因 {{ exitReason }}</p>\n\t\t<AsamNotificationPanel label=\"远程通知\" :load=\"loadNotifications\" />\n\t</main>\n</template>\n\n<script setup>\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\nimport { AsamSelect, AsamOption } from '@asam-ui/ui';\nimport { AsamButton } from '@asam-ui/ui';\nimport { ref } from 'vue';\nimport {\n\tAsamNotificationPanel,\n\tAsamNotificationMenu,\n\tAsamHelpPanel,\n\tAsamGuidedTour\n} from '@asam-ui/pro/components';\nconst size = ref('default');\nconst dark = ref(false),\n\tdisabled = ref(false),\n\treadonly = ref(false),\n\tfail = ref(false);\nconst menu = ref(false),\n\thelp = ref(false),\n\ttour = ref(false),\n\ttargetVisible = ref(true);\nconst category = ref(null),\n\tcontextKey = ref('a'),\n\tcurrent = ref(0),\n\tresults = ref(0),\n\texitReason = ref('');\nconst notifications = ref();\nconst helpPanel = ref();\nconst tourRef = ref();\nconst categories = [\n\t{ key: 'system', label: '系统' },\n\t{ key: 'task', label: '任务' }\n];\nconst items = ref([\n\t{ key: 0, title: '系统通知', category: 'system', unread: true },\n\t{ key: '', title: '任务提醒', description: '可修改的宿主数据', category: 'task', unread: true }\n]);\nconst operate = async () => {\n\tawait new Promise((resolve) => setTimeout(resolve, 60));\n\tif (fail.value) throw Error('确定性操作失败');\n};\nfunction onResult({ keys, action }) {\n\tresults.value++;\n\tif (action !== 'activate')\n\t\titems.value = items.value.map((item) =>\n\t\t\tkeys.includes(item.key) ? { ...item, unread: false } : item\n\t\t);\n}\nconst loadHelp = async (key) => {\n\tawait new Promise((resolve) => setTimeout(resolve, key === 'a' ? 100 : 20));\n\tif (fail.value) throw Error('确定性帮助失败');\n\treturn { title: `帮助 ${key}`, text: '这是纯文本帮助，HTML 标签不会执行。', href: '/help' };\n};\nconst loadNotifications = async () => {\n\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\tif (fail.value) throw Error('确定性加载失败');\n\treturn { items: [], unreadTotal: 0 };\n};\nconst steps = [\n\t{ key: 'a', title: '第一步', description: '查看第一个目标', target: '#target-a' },\n\t{\n\t\tkey: 'b',\n\t\ttitle: '第二步',\n\t\tdescription: '查看第二个目标',\n\t\ttarget: () => document.querySelector('#target-b')\n\t}\n];\n</script>\n\n<style>\nmain {\n\tpadding: 20px;\n\tmax-width: 880px;\n\tmargin: auto;\n}\nmain.dark {\n\t--asam-color-text-primary: #eee;\n\t--el-text-color-primary: #eee;\n\t--el-border-color: #666;\n\tcolor: #eee;\n\tbackground: #222;\n}\n</style>\n"
		}
	]
}
