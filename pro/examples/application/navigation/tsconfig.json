{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"types": ["vite/client", "node"],
		"lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
		"noEmit": true
	},
	"include": ["src/**/*.ts", "src/**/*.vue", "main.ts", "vite.config.ts"]
}
