	"schemaVersion": 1,
	"entry": "tests/v2/text/Example.vue",
	"bootstrap": "tests/v2/text/Example.vue",
	"files": [
		{
			"path": "tests/v2/text/Example.vue",
			"source": "<template>\n\t<main style=\"max-width: 52rem; margin: auto; padding: 1rem\">\n\t\t<h1>文本、标签、提及与验证码</h1>\n\t\t<!-- eslint-disable-next-line vue/html-self-closing -- 与项目Prettier的Vue输出一致。 --><label\n\t\t\t>发送目标<AsamInput v-model=\"target\" aria-label=\"发送目标\" /></label\n\t\t><AsamButton @click=\"fail = !fail\" type=\"primary\">切换模拟失败</AsamButton\n\t\t><AsamButton @click=\"disabled = !disabled\" type=\"primary\">切换禁用</AsamButton\n\t\t><AsamButton @click=\"readOnly = !readOnly\" type=\"primary\">切换只读</AsamButton\n\t\t><AsamButton @click=\"mounted = !mounted\" type=\"primary\">切换挂载</AsamButton\n\t\t><AsamButton\n\t\t\t@click=\"dark = !dark\"\n\t\t\t:data-preview-color-mode=\"dark ? 'dark' : 'light'\"\n\t\t\ttype=\"primary\"\n\t\t\t>切换主题</AsamButton\n\t\t><AsamButton @click=\"submit\" type=\"primary\">校验提交</AsamButton\n\t\t><AsamButton\n\t\t\t@click=\"\n\t\t\t\tresult = transformAsamFields(\n\t\t\t\t\tfields,\n\t\t\t\t\tmodel,\n\t\t\t\t\t'query',\n\t\t\t\t\tfields.map((f) => f.key)\n\t\t\t\t)\n\t\t\t\"\n\t\t\ttype=\"primary\"\n\t\t>\n\t\t\t生成查询 </AsamButton\n\t\t><AsamForm\n\t\t\tv-if=\"mounted\"\n\t\t\tref=\"form\"\n\t\t\tv-model=\"model\"\n\t\t\t:schema=\"schema.schema\"\n\t\t\t:registry=\"schema.registry\"\n\t\t\t:disabled=\"disabled\"\n\t\t/>\n\t\t<section v-for=\"mode in ['query', 'detail'] as const\" :key=\"mode\">\n\t\t\t<h2>{{ mode }}</h2>\n\t\t\t<AsamField\n\t\t\t\tv-for=\"field in fields\"\n\t\t\t\t:key=\"field.key\"\n\t\t\t\t:field=\"field\"\n\t\t\t\t:mode=\"mode\"\n\t\t\t\t:model-value=\"model[field.key]\"\n\t\t\t\t:disabled=\"disabled\"\n\t\t\t\t@update:model-value=\"model[field.key] = $event\"\n\t\t\t/>\n\t\t</section>\n\t\t<output aria-label=\"服务调用\">{{ calls }}</output>\n\t</main>\n</template>\n<script setup lang=\"ts\">\nimport { AsamInput } from '@asam-ui/ui';\n\nimport { AsamButton } from '@asam-ui/ui';\n\ndefineOptions({ name: 'AsamTextFieldExample' });\nimport { ref, watch } from 'vue';\nimport { AsamForm } from '@asam-ui/ui';\nimport type { AsamFormExpose } from '@asam-ui/ui';\nimport {\n\tAsamField,\n\tcreateAsamPasswordField,\n\tcreateAsamTagField,\n\tcreateAsamMentionField,\n\tcreateAsamCaptchaField,\n\tcreateAsamFieldModel,\n\tcreateAsamFieldSchema,\n\ttransformAsamFields\n} from '@asam-ui/pro/components';\nconst target = ref('demo');\nconst fail = ref(true);\nconst calls = ref(0);\nconst disabled = ref(false);\nconst mounted = ref(true);\nconst dark = ref(false);\nconst readOnly = ref(false);\nconst modes = {\n\tedit: {\n\t\tget readonly() {\n\t\t\treturn readOnly.value;\n\t\t}\n\t}\n};\nwatch(dark, (value) => document.documentElement.classList.toggle('dark', value));\nconst choices = () => [\n\t{ value: 'alice', label: 'Alice' },\n\t{ value: 'bob', label: 'Bob', disabled: true }\n];\nconst fields = [\n\tcreateAsamPasswordField({ key: 'password', label: '密码', modes }),\n\tcreateAsamTagField({\n\t\tkey: 'tags',\n\t\tlabel: '标签',\n\t\tmodes,\n\t\tcandidates: choices,\n\t\tdefaultValue: () => []\n\t}),\n\tcreateAsamMentionField({ key: 'mention', label: '提及', modes, candidates: choices }),\n\tcreateAsamCaptchaField({\n\t\tkey: 'code',\n\t\tlabel: '验证码',\n\t\tmodes,\n\t\ttarget: () => target.value,\n\t\tcooldownSeconds: 2,\n\t\tservice: async ({ signal }) => {\n\t\t\tcalls.value++;\n\t\t\tawait new Promise((resolve) => setTimeout(resolve, 100));\n\t\t\tif (signal.aborted) throw Error('cancelled');\n\t\t\tif (fail.value) throw Error('模拟失败');\n\t\t}\n\t}),\n\t{ key: 'text', label: '文本', kind: 'text' as const },\n\t{ key: 'textarea', label: '多行', kind: 'textarea' as const }\n];\nconst schema = createAsamFieldSchema(fields, 'edit');\nconst model = ref(\n\tcreateAsamFieldModel(\n\t\tfields,\n\t\t{ password: 'secret', mention: '', code: '', text: '', textarea: '' },\n\t\t'create'\n\t)\n);\nconst result = ref<unknown>();\nconst form = ref<AsamFormExpose>();\nasync function submit() {\n\tawait form.value?.validate();\n\tresult.value = transformAsamFields(\n\t\tfields,\n\t\tmodel.value,\n\t\t'submit',\n\t\tfields.map((f) => f.key)\n\t);\n}\n</script>\n\n<style scoped>\npre {\n\twhite-space: pre-wrap;\n\toverflow-wrap: anywhere;\n}\n</style>\n"
		}
	]
}
