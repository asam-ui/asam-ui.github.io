			"path": "tests/v2/table-virtual/Example.vue",
			"source": "<template>\n\t<AsamApplicationProvider :config=\"{ size, colorMode: dark ? 'dark' : 'light' }\"\n\t\t><main class=\"demo\">\n\t\t\t<h1>已加载数据虚拟表格</h1>\n\t\t\t<div class=\"controls\">\n\t\t\t\t<label\n\t\t\t\t\t>数据量<AsamSelect v-model.number=\"count\" aria-label=\"数据量\"\n\t\t\t\t\t\t><AsamOption label=\"10000\" :value=\"10000\">10000</AsamOption\n\t\t\t\t\t\t><AsamOption label=\"50000\" :value=\"50000\">50000</AsamOption></AsamSelect\n\t\t\t\t\t></label\n\t\t\t\t><Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t\t\t<label\n\t\t\t\t\t\t\t\t>尺寸<AsamSelect v-model=\"size\" aria-label=\"尺寸\"\n\t\t\t\t\t\t\t\t\t><AsamOption\n\t\t\t\t\t\t\t\t\t\tv-for=\"s in sizes\"\n\t\t\t\t\t\t\t\t\t\t:key=\"s\"\n\t\t\t\t\t\t\t\t\t\t:value=\"String(s).trim()\"\n\t\t\t\t\t\t\t\t\t\t:label=\"String(s).trim()\"\n\t\t\t\t\t\t\t\t\t\t>{{ s }}</AsamOption\n\t\t\t\t\t\t\t\t\t></AsamSelect\n\t\t\t\t\t\t\t\t></label\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t\t\t></Teleport\n\t\t\t\t><label v-show=\"!websitePreviewControls\"\n\t\t\t\t\t><span\n\t\t\t\t\t\tv-show=\"!websitePreviewControls\"\n\t\t\t\t\t\tdata-preview-theme-control\n\t\t\t\t\t\t:data-preview-value=\"dark\"\n\t\t\t\t\t\tv-on=\"{ 'asam-preview-theme': websitePreviewTheme0 }\"\n\t\t\t\t\t\t><AsamCheckboxItem v-model=\"dark\" /></span\n\t\t\t\t\t>暗色</label\n\t\t\t\t><label><AsamCheckboxItem v-model=\"disabled\" />禁用</label\n\t\t\t\t><label><AsamCheckboxItem v-model=\"readonly\" />只读排序</label\n\t\t\t\t><label>稳定键<AsamInput v-model=\"target\" aria-label=\"稳定键\" /></label\n\t\t\t\t><AsamButton @click=\"table?.focusKey(Number(target))\" type=\"primary\"\n\t\t\t\t\t>定位数字键</AsamButton\n\t\t\t\t><AsamButton @click=\"table?.focusKey(target)\" type=\"primary\"\n\t\t\t\t\t>定位字符串键</AsamButton\n\t\t\t\t><AsamButton @click=\"table?.scrollToLeft(1100)\" type=\"primary\">横向末端</AsamButton\n\t\t\t\t><AsamButton @click=\"table?.scrollToLeft(0)\" type=\"primary\">横向开头</AsamButton\n\t\t\t\t><AsamButton @click=\"status = 'loading'\" type=\"primary\">加载</AsamButton\n\t\t\t\t><AsamButton @click=\"status = 'empty'\" type=\"primary\">空数据</AsamButton\n\t\t\t\t><AsamButton @click=\"status = 'error'\" type=\"primary\">失败</AsamButton\n\t\t\t\t><AsamButton @click=\"status = 'ready'\" type=\"primary\">恢复</AsamButton\n\t\t\t\t><AsamButton @click=\"scope++\" type=\"primary\">切换代次</AsamButton\n\t\t\t\t><AsamButton @click=\"mounted = !mounted\" type=\"primary\">挂载切换</AsamButton>\n\t\t\t</div>\n\t\t\t<p>\n\t\t\t\t宿主已物化\n\t\t\t\t{{ count }} 条，12列；方向键、Home/End、PageUp/PageDown导航。长文本悬停可读。\n\t\t\t</p>\n\t\t\t<AsamProVirtualTable\n\t\t\t\tv-if=\"mounted\"\n\t\t\t\tref=\"table\"\n\t\t\t\t:rows=\"visibleRows\"\n\t\t\t\trow-key=\"id\"\n\t\t\t\t:columns=\"columns\"\n\t\t\t\t:width=\"width\"\n\t\t\t\t:height=\"400\"\n\t\t\t\t:scope=\"scope\"\n\t\t\t\t:mode=\"mode\"\n\t\t\t\t:disabled=\"disabled\"\n\t\t\t\t:readonly=\"readonly\"\n\t\t\t\t:loading=\"status === 'loading'\"\n\t\t\t\t:error=\"status === 'error' ? '合成读取失败' : undefined\"\n\t\t\t\t:sort=\"sort\"\n\t\t\t\tlabel=\"大数据表格\"\n\t\t\t\t@sort-change=\"sortRows\"\n\t\t\t\t@focus-change=\"onFocus\"\n\t\t\t\t@retry=\"status = 'ready'\"\n\t\t\t/><output aria-label=\"当前焦点\">{{ focus }}</output>\n\t\t\t<h2>独立实例</h2>\n\t\t\t<AsamProVirtualTable\n\t\t\t\tref=\"second\"\n\t\t\t\t:rows=\"rows.slice(0, 20)\"\n\t\t\t\trow-key=\"id\"\n\t\t\t\t:columns=\"columns\"\n\t\t\t\t:width=\"width\"\n\t\t\t\t:height=\"160\"\n\t\t\t\tlabel=\"第二表格\"\n\t\t\t/>\n\t\t\t<h2>List 当前页适配</h2>\n\t\t\t<p>当前页最多100条，本例默认10条，不代表全量 {{ count }} 条；不参与全量性能采样。</p>\n\t\t\t<AsamButton @click=\"controller.setPage(2)\" type=\"primary\">第二页</AsamButton\n\t\t\t><AsamButton @click=\"controller.refresh()\" type=\"primary\">刷新当前页</AsamButton\n\t\t\t><AsamProVirtualTable\n\t\t\t\tref=\"pageTable\"\n\t\t\t\t:controller=\"controller\"\n\t\t\t\t:columns=\"columns\"\n\t\t\t\t:width=\"width\"\n\t\t\t\t:height=\"160\"\n\t\t\t\tlabel=\"当前页表格\"\n\t\t\t/></main\n\t></AsamApplicationProvider>\n</template>\n<script setup lang=\"ts\">\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\nfunction websitePreviewTheme0(event: CustomEvent<'light' | 'dark'>) {\n\tdark.value = event.detail === 'dark';\n}\n\nimport { AsamSelect, AsamOption, AsamCheckboxItem, AsamInput } from '@asam-ui/ui';\n\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { computed, h, onBeforeUnmount, onMounted, ref, shallowRef, watch } from 'vue';\nimport {\n\tAsamApplicationProvider,\n\tAsamProVirtualTable,\n\tuseAsamListController\n} from '@asam-ui/pro/components';\nimport type {\n\tAsamListSort,\n\tAsamVirtualColumn,\n\tAsamVirtualFocus,\n\tAsamVirtualSortIntent,\n\tAsamVirtualTableExpose\n} from '@asam-ui/pro/components';\nimport type { AsamControlSize } from '@asam-ui/ui';\nimport { createAsamDataRuntime } from '@asam-ui/ui';\ntype Row = {\n\tid: string | number;\n\tname: string;\n\tc2: string;\n\tc3: string;\n\tc4: string;\n\tc5: string;\n\tc6: string;\n\tc7: string;\n\tc8: string;\n\tc9: string;\n\tc10: string;\n\tc11: string;\n};\nconst sizes: AsamControlSize[] = ['small', 'default', 'big', 'large'];\nconst count = ref(10000),\n\tsize = ref<AsamControlSize>('default'),\n\tdark = ref(false),\n\tdisabled = ref(false),\n\treadonly = ref(false),\n\tmounted = ref(true);\nconst target = ref('0'),\n\tscope = ref(0),\n\tfocus = ref(''),\n\twidth = ref(1000),\n\tstatus = ref('ready');\nconst table = shallowRef<AsamVirtualTableExpose>(),\n\tsecond = shallowRef<AsamVirtualTableExpose>();\nconst pageTable = shallowRef<AsamVirtualTableExpose>();\nconst rows = shallowRef<Row[]>([]),\n\tsort = shallowRef<AsamListSort | null>({ field: 'id', order: 'ascending' });\nconst lastSortIntent = shallowRef<AsamVirtualSortIntent>();\nconst mode = ref<'flat-fixed'>('flat-fixed');\nfunction generate() {\n\trows.value = Array.from({ length: count.value }, (_, i) => ({\n\t\tid: i === 1 ? '0' : i === 0 ? 0 : i,\n\t\tname: `记录${i} — 长内容可通过标题读取`,\n\t\tc2: `部门${i % 9}`,\n\t\tc3: `状态${i % 3}`,\n\t\tc4: `列4-${i}`,\n\t\tc5: `列5-${i}`,\n\t\tc6: `列6-${i}`,\n\t\tc7: `列7-${i}`,\n\t\tc8: `列8-${i}`,\n\t\tc9: `列9-${i}`,\n\t\tc10: `列10-${i}`,\n\t\tc11: `末列-${i}`\n\t}));\n}\nwatch(count, generate, { immediate: true });\nconst visibleRows = computed(() => (status.value === 'empty' ? [] : rows.value));\nconst rowReference = ref(false);\nfunction onFocus(event: AsamVirtualFocus<Row>) {\n\tfocus.value = `${typeof event.key}:${event.key}`;\n\trowReference.value = rows.value.includes(event.row);\n}\nconst columns: AsamVirtualColumn<Row>[] = [\n\t{ key: 'id', label: '编号', width: 100, fixed: 'left', sortable: true },\n\t{ key: 'name', label: '名称', width: 220, render: (row) => h('strong', `原行:${row.name}`) },\n\t...(['c2', 'c3', 'c4', 'c5', 'c6', 'c7', 'c8', 'c9', 'c10'] as const).map((key) => ({\n\t\tkey,\n\t\tlabel: key,\n\t\twidth: 130\n\t})),\n\t{ key: 'c11', label: '末列', width: 140, fixed: 'right' }\n];\nfunction sortRows(intent: AsamVirtualSortIntent) {\n\tlastSortIntent.value = intent;\n\tif (!intent.order) return;\n\tsort.value = { field: intent.key, order: intent.order };\n\trows.value = [...rows.value].sort(\n\t\t(a, b) => (Number(a.id) - Number(b.id)) * (intent.order === 'ascending' ? 1 : -1)\n\t);\n}\nconst runtime = createAsamDataRuntime({ scope: 'virtual-example' });\nconst controller = useAsamListController<Row>({\n\truntime,\n\tfields: [],\n\tinitial: {},\n\trowKey: 'id',\n\timmediate: false,\n\tapi: async (request) => ({\n\t\tlist: rows.value.slice(\n\t\t\t(request.currentPage - 1) * request.pageSize,\n\t\t\trequest.currentPage * request.pageSize\n\t\t),\n\t\ttotal: rows.value.length\n\t})\n});\nconst resize = () => {\n\twidth.value = Math.min(1100, window.innerWidth - 40);\n};\nonMounted(() => {\n\tresize();\n\twindow.addEventListener('resize', resize);\n\tvoid controller.submit();\n});\nonBeforeUnmount(() => window.removeEventListener('resize', resize));\n// 示例测试接口只观察真实组件公开方法与宿主状态，不替代UI键盘与DOM断言。\ndefineExpose({\n\ttable,\n\tsecond,\n\trows,\n\tcount,\n\tsize,\n\tscope,\n\tstatus,\n\tmounted,\n\tcontroller,\n\truntime,\n\tcolumns,\n\tsortRows,\n\tdisabled,\n\twidth,\n\treadonly,\n\tsort,\n\tlastSortIntent,\n\tmode,\n\trowReference,\n\tpageTable\n});\n</script>\n<style scoped>\nbutton:not([class*='el-']),\ninput:not([class*='el-']),\nselect:not([class*='el-']) {\n\tfont: inherit;\n}\n\n.demo {\n\tpadding: 20px;\n\tmax-width: 1140px;\n\tmargin: auto;\n\tbox-sizing: border-box;\n\tcolor: var(--el-text-color-primary);\n\tbackground: var(--el-bg-color);\n}\n\n.controls {\n\tdisplay: flex;\n\tflex-wrap: wrap;\n\tgap: var(--asam-space-2, 8px);\n\talign-items: center;\n}\n\n.controls label {\n\tdisplay: flex;\n\tgap: 4px;\n\talign-items: center;\n}\n\n.controls input:not([class*='el-']):not([type='checkbox']) {\n\twidth: 75px;\n}\n</style>\n"
		}
	]
}
