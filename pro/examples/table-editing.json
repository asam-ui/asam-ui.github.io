{
	"schemaVersion": 1,
	"entry": "tests/v2/table-editing/examples/EditingExample.vue",
	"bootstrap": "tests/v2/table-editing/examples/EditingExample.vue",
	"files": [
		{
			"path": "tests/v2/table-editing/examples/EditingExample.vue",
			"source": "<template>\n\t<main>\n\t\t<h1>当前页资料编辑</h1>\n\t\t<Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t<label\n\t\t\t\t\t\t>尺寸\n\t\t\t\t\t\t<AsamSelect v-model=\"size\" aria-label=\"尺寸\"\n\t\t\t\t\t\t\t><AsamOption\n\t\t\t\t\t\t\t\tv-for=\"s in ['small', 'default', 'big', 'large']\"\n\t\t\t\t\t\t\t\t:key=\"s\"\n\t\t\t\t\t\t\t\t:value=\"String(s).trim()\"\n\t\t\t\t\t\t\t\t:label=\"String(s).trim()\"\n\t\t\t\t\t\t\t\t>{{ s }}</AsamOption\n\t\t\t\t\t\t\t></AsamSelect\n\t\t\t\t\t\t></label\n\t\t\t\t\t>\n\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t></Teleport\n\t\t><label><AsamCheckboxItem v-model=\"allowed\" />允许写入</label\n\t\t><label><AsamCheckboxItem v-model=\"reject\" />下次明确失败</label\n\t\t><label><AsamCheckboxItem v-model=\"unknown\" />下次结果未知</label\n\t\t><Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t<label><AsamCheckboxItem v-model=\"inheritSize\" />继承provider尺寸</label>\n\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t></Teleport\n\t\t><label v-show=\"!websitePreviewControls\"\n\t\t\t><span\n\t\t\t\tv-show=\"!websitePreviewControls\"\n\t\t\t\tdata-preview-theme-control\n\t\t\t\t:data-preview-value=\"dark\"\n\t\t\t\tv-on=\"{ 'asam-preview-theme': websitePreviewTheme0 }\"\n\t\t\t\t><AsamCheckboxItem v-model=\"dark\" /></span\n\t\t\t>暗色主题</label\n\t\t><AsamConfigProvider :size=\"inheritSize ? size : 'large'\"\n\t\t\t><AsamSortableTable\n\t\t\t\tref=\"table\"\n\t\t\t\t:controller=\"editing\"\n\t\t\t\t:columns=\"columns\"\n\t\t\t\t:operation-id=\"operationId\"\n\t\t\t\t:batch-patch=\"{ name: '批量名称' }\"\n\t\t\t\t:size=\"inheritSize ? undefined : size\"\n\t\t\t\t><template #toolbar><span aria-label=\"工具栏插槽\">当前页操作</span></template\n\t\t\t\t><template #empty\n\t\t\t\t\t><span aria-label=\"空状态插槽\">暂无数据</span></template\n\t\t\t\t></AsamSortableTable\n\t\t\t></AsamConfigProvider\n\t\t><AsamButton @click=\"editing.navigate(() => list.setPage(2))\" type=\"primary\"\n\t\t\t>下一页</AsamButton\n\t\t><AsamButton @click=\"newIntent()\" type=\"primary\">开始新操作标识</AsamButton\n\t\t><AsamButton @click=\"table?.cancel()\" type=\"primary\">退出编辑</AsamButton\n\t\t><AsamButton\n\t\t\tv-for=\"state in ['正常', '加载', '空', '读取失败'] as const\"\n\t\t\t:key=\"state\"\n\t\t\t@click=\"\n\t\t\t\treadState = state;\n\t\t\t\tediting.navigate(() => list.refresh());\n\t\t\t\"\n\t\t\ttype=\"primary\"\n\t\t\t>{{ state }}读取 </AsamButton\n\t\t><output aria-label=\"写入次数\">{{ calls }}</output>\n\t\t<details>\n\t\t\t<summary>既有组件组合</summary>\n\t\t\t<label\n\t\t\t\t>独立字段\n\t\t\t\t<AsamField v-model=\"compatibilityValue\" :field=\"compatibilityField\" /></label\n\t\t\t><AsamProTable :controller=\"list\" :columns=\"columns\" /><AsamButton\n\t\t\t\t@click=\"\n\t\t\t\t\tlegacy.open({ mode: 'edit', id: 99, operationId: `compatibility:${revision}` })\n\t\t\t\t\"\n\t\t\t\ttype=\"primary\"\n\t\t\t>\n\t\t\t\t打开原编辑器 </AsamButton\n\t\t\t><AsamFormDialog :controller=\"legacy\" title=\"原编辑器兼容\" /><output\n\t\t\t\taria-label=\"原编辑器结果\"\n\t\t\t\t>{{ legacyModel.name }}</output\n\t\t\t>\n\t\t</details>\n\t</main>\n</template>\n<script setup lang=\"ts\">\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\nfunction websitePreviewTheme0(event: CustomEvent<'light' | 'dark'>) {\n\tdark.value = event.detail === 'dark';\n}\n\nimport { AsamSelect, AsamOption, AsamCheckboxItem } from '@asam-ui/ui';\n\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { getCurrentInstance, onBeforeUnmount, ref, watch } from 'vue';\nimport { applyAsamTheme, createAsamTheme, defaultAsamTheme } from '@asam-ui/ui/tokens';\nimport {\n\tgetAsamDataRuntime,\n\tcreateAsamDataRuntime,\n\tdefineAsamOptions,\n\tAsamConfigProvider\n} from '@asam-ui/ui';\nimport type { AsamControlSize, AsamRowKey } from '@asam-ui/ui';\nimport {\n\tAsamSortableTable,\n\tAsamField,\n\tAsamProTable,\n\tAsamFormDialog,\n\tuseAsamEditor,\n\tcreateAsamWriteCoordinator,\n\tdefineAsamFields,\n\tuseAsamListController,\n\tuseAsamTableEditing\n} from '@asam-ui/pro/components';\nimport type {\n\tAsamListColumn,\n\tAsamTableEditMode,\n\tAsamSortableTableExpose\n} from '@asam-ui/pro/components';\nconst table = ref<AsamSortableTableExpose>();\ninterface Row {\n\tid: number;\n\tname: string;\n\tenabled: boolean;\n}\nconst records: Row[] = [\n\t{ id: 0, name: '资料甲', enabled: false },\n\t{ id: 1, name: '资料乙', enabled: true },\n\t{ id: 2, name: '资料丙', enabled: false }\n];\nconst readState = ref<'正常' | '加载' | '空' | '读取失败'>('正常');\nconst dark = ref(false);\nwatch(\n\tdark,\n\t(value) => {\n\t\tapplyAsamTheme(\n\t\t\tvalue\n\t\t\t\t? createAsamTheme({\n\t\t\t\t\t\tcolor: {\n\t\t\t\t\t\t\tsurface: '#18212d',\n\t\t\t\t\t\t\tsurfacePage: '#101820',\n\t\t\t\t\t\t\tsurfaceMuted: '#243244',\n\t\t\t\t\t\t\tsurfaceSoft: '#243244',\n\t\t\t\t\t\t\tsurfaceInfo: '#243244',\n\t\t\t\t\t\t\tsurfaceSuccess: '#243a35',\n\t\t\t\t\t\t\ttextPrimary: '#f1f5f9',\n\t\t\t\t\t\t\ttextRegular: '#d1dce8',\n\t\t\t\t\t\t\ttextSecondary: '#a9bbce',\n\t\t\t\t\t\t\tborder: '#40556e',\n\t\t\t\t\t\t\tdivider: '#40556e',\n\t\t\t\t\t\t\tdialogTitle: '#f1f5f9'\n\t\t\t\t\t\t}\n\t\t\t\t\t})\n\t\t\t\t: defaultAsamTheme\n\t\t);\n\t\tdocument.documentElement.classList.toggle('dark', value);\n\t\tdocument.body.style.background = 'var(--asam-color-surface-page)';\n\t\tdocument.body.style.color = 'var(--asam-color-text-primary)';\n\t},\n\t{ immediate: true }\n);\nconst fields = defineAsamFields([\n\t{\n\t\tkey: 'name',\n\t\tkind: 'text',\n\t\tlabel: '名称',\n\t\tsubmit: (value: string | null) => value?.trim(),\n\t\tmodes: {\n\t\t\tedit: {\n\t\t\t\trules: [\n\t\t\t\t\t{ required: true, message: '名称不能为空' },\n\t\t\t\t\t{ min: 2, message: '至少两个字符' }\n\t\t\t\t]\n\t\t\t}\n\t\t}\n\t},\n\t{\n\t\tkey: 'enabled',\n\t\tkind: 'single',\n\t\tlabel: '启用',\n\t\tsource: defineAsamOptions().static({\n\t\t\toptions: [\n\t\t\t\t{ label: '是', value: true },\n\t\t\t\t{ label: '否', value: false }\n\t\t\t]\n\t\t})\n\t}\n]);\nconst runtime = getAsamDataRuntime(getCurrentInstance()!.appContext.app);\nconst coordinator = createAsamWriteCoordinator();\nconst allowed = ref(true),\n\treject = ref(false),\n\tunknown = ref(false),\n\tcalls = ref(0),\n\tsize = ref<AsamControlSize>('default');\nconst inheritSize = ref(true);\nlet revision = 1;\nconst operationId = (mode: AsamTableEditMode, key: AsamRowKey, field?: string) =>\n\t`${revision}:${mode}:${typeof key}:${key}:${field ?? ''}`;\nconst newIntent = () => {\n\trevision++;\n};\nconst list = useAsamListController<Row>({\n\tfields: [],\n\tinitial: {},\n\trowKey: 'id',\n\truntime,\n\tapi: async () => {\n\t\tif (readState.value === '加载') await new Promise((resolve) => setTimeout(resolve, 500));\n\t\tif (readState.value === '读取失败') throw new Error('模拟读取失败');\n\t\tconst rows = readState.value === '空' ? [] : records.map((r) => ({ ...r }));\n\t\treturn { list: rows, total: rows.length };\n\t}\n});\nconst editing = useAsamTableEditing({\n\tlist,\n\tfields,\n\truntime,\n\tcoordinator,\n\tcanWrite: () => allowed.value,\n\tconfirmDiscard: async () => window.confirm('丢弃尚未发送的草稿？已发送操作仍须核实。'),\n\tsave: async (payload, operation) => {\n\t\tcalls.value++;\n\t\tif (unknown.value) {\n\t\t\tunknown.value = false;\n\t\t\treturn { status: 'unknown', message: '连接断开，先核实结果' };\n\t\t}\n\t\tif (reject.value) {\n\t\t\treject.value = false;\n\t\t\treturn { status: 'failure', message: '服务明确拒绝，可修改并重试' };\n\t\t}\n\t\tconst row = records.find((r) => r.id === operation.target.id);\n\t\tif (row) Object.assign(row, payload);\n\t\treturn { status: 'success' };\n\t},\n\tverify: async () => ({ status: 'not-applied' }),\n\tsaveOrder: async ({ next }) => {\n\t\tcalls.value++;\n\t\tif (reject.value) {\n\t\t\treject.value = false;\n\t\t\treturn { status: 'failure', message: '顺序保存被拒绝，投影已恢复' };\n\t\t}\n\t\tif (unknown.value) {\n\t\t\tunknown.value = false;\n\t\t\treturn { status: 'unknown', message: '顺序结果未知' };\n\t\t}\n\t\tconst snapshot = new Map(records.map((r) => [r.id, r]));\n\t\trecords.splice(0, records.length, ...next.map((id) => snapshot.get(Number(id))!));\n\t\treturn { status: 'success' };\n\t},\n\tverifyOrder: async () => ({ status: 'not-applied' })\n});\nconst columns: readonly AsamListColumn<Row>[] = [\n\t{ key: 'id', label: '编号' },\n\t{ key: 'name', label: '名称' },\n\t{ key: 'enabled', label: '启用' }\n];\nonBeforeUnmount(editing.dispose);\nconst compatibilityValue = ref<unknown>('独立字段');\nconst compatibilityField = defineAsamFields([\n\t{ key: 'compatibility', kind: 'text', label: '独立字段' }\n])[0];\nconst legacyModel = ref({ name: '原编辑器记录', enabled: true });\nconst legacyRuntime = createAsamDataRuntime();\nlegacyRuntime.setScope('compatibility-record');\nconst legacy = useAsamEditor({\n\tfields,\n\truntime: legacyRuntime,\n\tcoordinator,\n\tcanWrite: () => allowed.value,\n\tload: async () => ({ ...legacyModel.value }),\n\tsave: async (payload) => {\n\t\tObject.assign(legacyModel.value, payload);\n\t\treturn { status: 'success' };\n\t},\n\tconfirmDiscard: async () => window.confirm('丢弃原编辑器草稿？')\n});\n</script>\n<style scoped>\nmain {\n\tmax-width: 100%;\n\tmin-width: 0;\n\tpadding: var(--asam-space-4, 16px);\n\tcolor: var(--el-text-color-primary);\n\tbackground: var(--el-bg-color);\n}\nlabel {\n\tdisplay: inline-flex;\n\talign-items: center;\n\tgap: var(--asam-space-2, 8px);\n\tmargin: var(--asam-space-2, 8px);\n}\n</style>\n"
		}
	]
}
