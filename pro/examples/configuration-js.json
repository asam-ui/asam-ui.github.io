	"language": "js",
	"files": [
		{
			"path": "tests/v2/configuration/Example.vue",
			"source": "<template>\n\t<h1>应用配置与前端权限</h1>\n\t<AsamButton @click=\"allowed = !allowed\" type=\"primary\">切换权限</AsamButton\n\t><AsamButton\n\t\t@click=\"mode = mode === 'light' ? 'dark' : 'light'\"\n\t\t:data-preview-color-mode=\"mode\"\n\t\ttype=\"primary\"\n\t\t>切换主题</AsamButton\n\t><AsamButton @click=\"mounted = !mounted\" type=\"primary\">切换挂载</AsamButton\n\t><AsamSelect v-model=\"source\" aria-label=\"权限来源\"\n\t\t><AsamOption value=\"boolean\" label=\"boolean\">boolean</AsamOption\n\t\t><AsamOption value=\"pending\" label=\"pending\">pending</AsamOption\n\t\t><AsamOption value=\"error\" label=\"error\">error</AsamOption\n\t\t><AsamOption value=\"throw\" label=\"throw\">throw</AsamOption></AsamSelect\n\t><AsamButton @click=\"english = !english\" type=\"primary\">切换语言</AsamButton\n\t><AsamSelect v-model=\"size\" aria-label=\"尺寸\"\n\t\t><AsamOption\n\t\t\tv-for=\"s in sizes\"\n\t\t\t:key=\"s\"\n\t\t\t:value=\"String(s).trim()\"\n\t\t\t:label=\"String(s).trim()\"\n\t\t\t>{{ s }}</AsamOption\n\t\t></AsamSelect\n\t><AsamApplicationProvider\n\t\tv-if=\"mounted\"\n\t\t:config=\"{\n\t\t\tsize,\n\t\t\tcolorMode: mode,\n\t\t\tpermission: { check },\n\t\t\tbase: { locale: english ? en : zh }\n\t\t}\"\n\t\t><section data-testid=\"outer\">\n\t\t\t<AsamButton type=\"primary\">继承尺寸</AsamButton\n\t\t\t><AsamButton size=\"small\" type=\"primary\">局部尺寸</AsamButton\n\t\t\t><AsamPagination :total=\"20\" layout=\"total\" /><AsamPermission permission=\"edit\"\n\t\t\t\t><AsamButton @click=\"count++\" type=\"primary\">保护操作</AsamButton\n\t\t\t\t><template #fallback=\"state\"\n\t\t\t\t\t><span>{{ state.status }}</span></template\n\t\t\t\t></AsamPermission\n\t\t\t><AsamPermission permission=\"edit\" mode=\"disable\"\n\t\t\t\t><AsamButton @click=\"count++\" type=\"primary\">禁用操作</AsamButton\n\t\t\t\t><a href=\"#target\">禁用链接</a></AsamPermission\n\t\t\t><AsamApplicationProvider :config=\"{ size: 'small', colorMode: 'light' }\"\n\t\t\t\t><section data-testid=\"inner\">\n\t\t\t\t\t<AsamButton type=\"primary\">嵌套尺寸</AsamButton>\n\t\t\t\t</section></AsamApplicationProvider\n\t\t\t>\n\t\t</section></AsamApplicationProvider\n\t><AsamApplicationProvider\n\t\t><section data-testid=\"independent\">\n\t\t\t<AsamButton type=\"primary\">独立根</AsamButton>\n\t\t</section></AsamApplicationProvider\n\t>\n</template>\n<script setup>\nimport { AsamSelect, AsamOption } from '@asam-ui/ui';\nimport { ref } from 'vue';\nimport { AsamButton, AsamPagination, asamControlSizes } from '@asam-ui/ui';\nimport en from 'element-plus/es/locale/lang/en.mjs';\nimport zh from 'element-plus/es/locale/lang/zh-cn.mjs';\nimport { AsamApplicationProvider, AsamPermission } from '@asam-ui/pro/components';\nconst size = ref('big');\nconst mode = ref('light');\nconst allowed = ref(false),\n\tcount = ref(0),\n\tmounted = ref(true);\nconst sizes = asamControlSizes;\nconst source = ref('boolean'),\n\tenglish = ref(true);\nconst check = () => {\n\tif (source.value === 'throw') throw new Error('Application error');\n\tif (source.value === 'pending' || source.value === 'error') return source.value;\n\treturn allowed.value;\n};\n</script>\n"
		}
	]
}
