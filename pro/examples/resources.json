{
	"schemaVersion": 1,
	"entry": "tests/v2/resources/Example.vue",
	"bootstrap": "website-hosts/resources.ts",
	"files": [
		{
			"path": "tests/v2/resources/Example.vue",
			"source": "<template>\n\t<main :class=\"{ dark }\">\n\t\t<h1>上传资源字段</h1>\n\t\t<AsamButton\n\t\t\t@click=\"dark = !dark\"\n\t\t\t:data-preview-color-mode=\"dark ? 'dark' : 'light'\"\n\t\t\ttype=\"primary\"\n\t\t\t>切换主题</AsamButton\n\t\t><AsamButton @click=\"mode = mode === 'edit' ? 'detail' : 'edit'\" type=\"primary\"\n\t\t\t>切换详情</AsamButton\n\t\t><AsamButton @click=\"disabled = !disabled\" type=\"primary\">切换禁用</AsamButton\n\t\t><AsamButton @click=\"hidden = !hidden\" type=\"primary\">切换隐藏</AsamButton\n\t\t><AsamButton @click=\"mounted = !mounted\" type=\"primary\">切换挂载</AsamButton\n\t\t><AsamButton @click=\"failure = !failure\" type=\"primary\">切换上传失败</AsamButton\n\t\t><AsamButton @click=\"model = [0]\" type=\"primary\">外部换值</AsamButton\n\t\t><AsamButton @click=\"fieldRef?.focus()\" type=\"primary\">聚焦上传</AsamButton\n\t\t><AsamResourceField\n\t\t\tv-if=\"mounted\"\n\t\t\tref=\"fieldRef\"\n\t\t\tv-model=\"model\"\n\t\t\t:services=\"services\"\n\t\t\tmultiple\n\t\t\tdrag\n\t\t\taccept=\".txt,.png\"\n\t\t\t:max-size-bytes=\"1000\"\n\t\t\t:limit=\"3\"\n\t\t\t:mode=\"mode\"\n\t\t\t:disabled=\"disabled\"\n\t\t\t:hidden=\"hidden\"\n\t\t\tlabel=\"附件\"\n\t\t\t@state=\"state = $event\"\n\t\t\t><template #tip\n\t\t\t\t><p>每个文件最多 1000 字节，最多 3 个；仅本地确定性 mock。</p></template\n\t\t\t></AsamResourceField\n\t\t>\n\t\t<p role=\"status\">{{ state?.pending ? '正在传输' : '传输空闲' }}</p>\n\t\t<h2>四档尺寸与单值</h2>\n\t\t<AsamResourceField\n\t\t\tv-for=\"size in sizes\"\n\t\t\t:key=\"size\"\n\t\t\t:size=\"size\"\n\t\t\t:label=\"size\"\n\t\t\t:services=\"services\"\n\t\t/>\n\t\t<h2>公共 Form/schema</h2>\n\t\t<AsamForm\n\t\t\tv-model=\"formModel\"\n\t\t\t:schema=\"schema.schema\"\n\t\t\t:registry=\"schema.registry\"\n\t\t/><AsamField\n\t\t\t:field=\"field\"\n\t\t\t:model-value=\"formModel.files\"\n\t\t\tmode=\"query\"\n\t\t\t@update:model-value=\"formModel.files = $event\"\n\t\t/><AsamField :field=\"field\" :model-value=\"formModel.files\" mode=\"detail\" /><AsamButton\n\t\t\t@click=\"submit\"\n\t\t\ttype=\"primary\"\n\t\t\t>提交表单</AsamButton\n\t\t><output aria-label=\"提交\">{{ result }}</output\n\t\t><RefreshProbe /><HiddenProbe />\n\t</main>\n</template>\n\n<script setup lang=\"ts\">\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { ref, shallowRef } from 'vue';\nimport RefreshProbe from './RefreshProbe.vue';\nimport HiddenProbe from './HiddenProbe.vue';\nimport { AsamForm } from '@asam-ui/ui';\nimport {\n\tAsamField,\n\tAsamResourceField,\n\tcreateAsamResourceField,\n\tcreateAsamFieldSchema,\n\ttransformAsamFields\n} from '@asam-ui/pro/components';\nimport type {\n\tAsamResourceValue,\n\tAsamResourceState,\n\tAsamResourceServices,\n\tAsamResourceFieldExpose\n} from '@asam-ui/pro/components';\nconst sizes = ['large', 'big', 'default', 'small'] as const;\nconst model = ref<AsamResourceValue>([0]);\nconst fieldRef = shallowRef<InstanceType<typeof AsamResourceField>>();\nconst state = shallowRef<AsamResourceState>();\nconst mode = ref<'edit' | 'detail'>('edit');\nconst dark = ref(false),\n\tdisabled = ref(false),\n\thidden = ref(false),\n\tmounted = ref(true),\n\tfailure = ref(false);\nlet sequence = 0;\nconst services: AsamResourceServices = {\n\tasync upload({ file, progress, signal }) {\n\t\tprogress(25);\n\t\tawait new Promise<void>((resolve, reject) => {\n\t\t\tconst timer = setTimeout(resolve, 150);\n\t\t\tsignal.addEventListener(\n\t\t\t\t'abort',\n\t\t\t\t() => {\n\t\t\t\t\tclearTimeout(timer);\n\t\t\t\t\treject(new Error('取消'));\n\t\t\t\t},\n\t\t\t\t{ once: true }\n\t\t\t);\n\t\t});\n\t\tif (failure.value) throw new Error('mock上传失败');\n\t\tprogress(100);\n\t\treturn { id: `mock-${++sequence}`, name: file.name, size: file.size, url: '/mock.txt' };\n\t},\n\tasync resolve(ids) {\n\t\treturn ids.map((id) => ({ id, name: `已有资源 ${id}`, url: '/mock.txt' }));\n\t},\n\tasync delete() {\n\t\tawait Promise.resolve();\n\t}\n};\nconst formState = shallowRef<AsamResourceState>();\nconst field = createAsamResourceField({\n\tkey: 'files',\n\tlabel: '表单附件',\n\tmultiple: true,\n\tservices,\n\tonState: (value) => {\n\t\tformState.value = value;\n\t},\n\tgetState: () => formState.value\n});\nconst schema = createAsamFieldSchema([field], 'edit');\nconst formModel = ref<Record<string, unknown>>({ files: [] });\nconst result = ref('');\nfunction submit() {\n\tresult.value = JSON.stringify(\n\t\ttransformAsamFields([field], formModel.value, 'submit', ['files'])\n\t);\n}\n</script>\n\n<style scoped>\nmain {\n\tpadding: 16px;\n\tmax-width: 900px;\n\tmargin: auto;\n\tcolor: var(--el-text-color-primary);\n\tbackground: var(--el-bg-color);\n}\nmain.dark {\n\t--asam-color-primary: #8ab4f8;\n\t--asam-color-text-primary: #eee;\n\t--asam-color-text-regular: #eee;\n\t--asam-color-text-secondary: #ddd;\n\t--asam-color-surface: #202124;\n\t--asam-color-surface-muted: #30343b;\n\t--asam-color-surface-soft: #3e434d;\n\t--asam-color-border: #777;\n\t--el-bg-color: #202124;\n\t--el-text-color-primary: #eee;\n\t--el-text-color-regular: #eee;\n\t--el-text-color-secondary: #ddd;\n\t--el-fill-color-blank: #202124;\n\t--el-border-color: #777;\n}\noutput {\n\tdisplay: block;\n\toverflow-wrap: anywhere;\n}\nbutton:not([class*='el-']) {\n\tmargin: 4px;\n}\n</style>\n"
		},
		{
			"path": "tests/v2/resources/HiddenProbe.vue",
			"source": "<template>\n\t<section>\n\t\t<h2>资源字段隐藏边界</h2>\n\t\t<AsamResourceField\n\t\t\tv-if=\"mounted\"\n\t\t\tref=\"control\"\n\t\t\t:model-value=\"value\"\n\t\t\t:hidden=\"hidden\"\n\t\t\t:services=\"services\"\n\t\t/><AsamResourceField\n\t\t\tv-if=\"otherMounted\"\n\t\t\tref=\"other\"\n\t\t\t:model-value=\"100\"\n\t\t\t:services=\"otherServices\"\n\t\t/><AsamButton native-type=\"button\" @click=\"run\" type=\"primary\">验证隐藏边界</AsamButton\n\t\t><output aria-label=\"隐藏验证\">{{ result }}</output>\n\t</section>\n</template>\n\n<script setup lang=\"ts\">\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { nextTick, ref, shallowRef } from 'vue';\nimport { AsamResourceField } from '@asam-ui/pro/components';\nimport type { AsamResource, AsamResourceServices } from '@asam-ui/pro/components';\nconst control = shallowRef<InstanceType<typeof AsamResourceField>>();\nconst other = shallowRef<InstanceType<typeof AsamResourceField>>();\nconst value = ref(0),\n\thidden = ref(true),\n\tmounted = ref(true),\n\totherMounted = ref(false);\nconst result = ref('');\nconst calls: { id: string | number; signal: AbortSignal; service: string }[] = [];\nconst releases: (() => void)[] = [];\nlet hold = false;\nconst servicesFor = (service: string): AsamResourceServices => ({\n\tupload: async () => ({ id: 99, name: 'mock' }),\n\tresolve: async (ids, signal) => {\n\t\tcalls.push({ id: ids[0], signal, service });\n\t\tif (hold)\n\t\t\tawait new Promise<void>((resolve) => {\n\t\t\t\treleases.push(resolve);\n\t\t\t});\n\t\treturn ids.map((id) => ({ id, name: `${service}:${id}` }));\n\t}\n});\nconst services = shallowRef(servicesFor('first'));\nconst otherServices = servicesFor('other');\nconst ready = async () => {\n\tawait nextTick();\n\tawait new Promise((resolve) => setTimeout(resolve, 0));\n\tawait nextTick();\n};\nconst check = (ok: unknown, message: string) => {\n\tif (!ok) throw new Error(message);\n};\nasync function run() {\n\tconst checks: string[] = [];\n\ttry {\n\t\tawait ready();\n\t\tcheck(calls.length === 0, '初始hidden不解析');\n\t\tvalue.value = 1;\n\t\tawait ready();\n\t\tawait control.value!.refresh();\n\t\tawait ready();\n\t\tcheck(\n\t\t\tcalls.length === 0 && control.value!.getState().value === 1,\n\t\t\t'hidden换值保值且ref不解析'\n\t\t);\n\t\tchecks.push('初始隐藏/换值保值/直ref守卫');\n\t\tservices.value = servicesFor('replacement');\n\t\tawait ready();\n\t\tawait control.value!.refresh();\n\t\tcheck(calls.length === 0, 'hidden更换服务不解析');\n\t\tchecks.push('隐藏更换服务');\n\t\thidden.value = false;\n\t\tawait ready();\n\t\tcheck(\n\t\t\tcalls.length === 1 && calls[0].id === 1 && calls[0].service === 'replacement',\n\t\t\t'显示只解析最新ID一次'\n\t\t);\n\t\thidden.value = true;\n\t\tawait ready();\n\t\tvalue.value = 2;\n\t\tawait ready();\n\t\tvalue.value = 3;\n\t\tawait ready();\n\t\tawait control.value!.refresh();\n\t\tcheck(\n\t\t\tcalls.length === 1 && control.value!.getState().value === 3,\n\t\t\t'再次隐藏多次换值不解析'\n\t\t);\n\t\thidden.value = false;\n\t\tvalue.value = 4;\n\t\tawait ready();\n\t\tcheck(calls.length === 2 && calls[1].id === 4, '同轮显示与换值只解析最新ID一次');\n\t\tchecks.push('再次隐藏/多次换值/同轮显示一次解析');\n\t\thold = true;\n\t\tconst pending = control.value!.refresh();\n\t\tawait ready();\n\t\tconst own = calls.at(-1)!;\n\t\totherMounted.value = true;\n\t\tawait ready();\n\t\tconst independent = calls.at(-1)!;\n\t\tcheck(independent.service === 'other', '第二实例已启动');\n\t\thidden.value = true;\n\t\tawait ready();\n\t\tawait pending;\n\t\tcheck(own.signal.aborted && !independent.signal.aborted, '隐藏只取消自身请求');\n\t\tconst count = calls.length;\n\t\tvalue.value = 5;\n\t\tawait ready();\n\t\tawait control.value!.refresh();\n\t\tcheck(\n\t\t\tcalls.length === count && control.value!.getState().value === 5,\n\t\t\t'取消后隐藏换值不重启'\n\t\t);\n\t\tfor (const release of releases.splice(0)) release();\n\t\tawait ready();\n\t\tcheck(\n\t\t\tcontrol.value!.getState().value === 5 && !control.value!.getState().pending,\n\t\t\t'晚到不能覆盖隐藏最新模型'\n\t\t);\n\t\tcheck(\n\t\t\t(other.value!.getState().resources[0] as AsamResource).id === 100,\n\t\t\t'其他实例正常完成'\n\t\t);\n\t\tchecks.push('隐藏取消/晚到隔离/多实例');\n\t\thold = false;\n\t\thidden.value = false;\n\t\tawait ready();\n\t\tcheck(calls.at(-1)!.id === 5, '恢复显示解析最新隐藏值');\n\t\thold = true;\n\t\tconst unmounting = control.value!.refresh();\n\t\tawait ready();\n\t\tconst last = calls.at(-1)!;\n\t\tmounted.value = false;\n\t\tawait ready();\n\t\tawait unmounting;\n\t\tcheck(last.signal.aborted, '卸载取消自身解析');\n\t\tfor (const release of releases.splice(0)) release();\n\t\tawait ready();\n\t\tcheck(\n\t\t\tother.value!.getState().value === 100 && !other.value!.getState().pending,\n\t\t\t'卸载不伤其他实例'\n\t\t);\n\t\tchecks.push('显示恢复/卸载清理');\n\t\totherMounted.value = false;\n\t\tresult.value = JSON.stringify({ status: 'PASS', checks });\n\t} catch (error) {\n\t\tfor (const release of releases.splice(0)) release();\n\t\tresult.value = JSON.stringify({ status: 'FAIL', error: String(error), checks });\n\t}\n}\n</script>\n\n<style scoped>\noutput {\n\tdisplay: block;\n\toverflow-wrap: anywhere;\n}\n</style>\n"
		},
		{
			"path": "tests/v2/resources/RefreshProbe.vue",
			"source": "<template>\n\t<section>\n\t\t<h2>公开 AsamField ref 验证</h2>\n\t\t<AsamField\n\t\t\tv-if=\"mounted\"\n\t\t\tref=\"fieldRef\"\n\t\t\t:field=\"field\"\n\t\t\t:model-value=\"value\"\n\t\t\t:mode=\"mode\"\n\t\t\t:active=\"active\"\n\t\t/><AsamButton native-type=\"button\" @click=\"run\" type=\"primary\">验证共享刷新</AsamButton\n\t\t><output aria-label=\"刷新验证\">{{ result }}</output>\n\t</section>\n</template>\n\n<script setup lang=\"ts\">\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { defineComponent, h, nextTick, ref, shallowRef } from 'vue';\nimport { defineAsamControl } from '@asam-ui/ui';\nimport { AsamField, createAsamResourceField } from '@asam-ui/pro/components';\nimport type {\n\tAsamFieldDefinition,\n\tAsamFieldExpose,\n\tAsamResourceState\n} from '@asam-ui/pro/components';\nconst fieldRef = shallowRef<AsamFieldExpose>();\nconst mode = ref<'edit' | 'detail'>('edit'),\n\tactive = ref(true),\n\tmounted = ref(true);\nconst value = ref<unknown>(0),\n\tresult = ref('');\nlet calls = 0,\n\tsuccessorCalls = 0,\n\thold = false;\nlet release: (() => void) | undefined;\nlet state: AsamResourceState | undefined;\nconst tick = () => new Promise<void>((resolve) => setTimeout(resolve, 0));\nconst check = (ok: unknown, label: string) => {\n\tif (!ok) throw new Error(label);\n};\nconst initial = createAsamResourceField({\n\tkey: 'probe',\n\tlabel: '刷新资源',\n\tservices: {\n\t\tupload: async () => ({ id: 1, name: 'file' }),\n\t\tresolve: async (ids) => {\n\t\t\tcalls++;\n\t\t\tif (hold)\n\t\t\t\tawait new Promise<void>((resolve) => {\n\t\t\t\t\trelease = resolve;\n\t\t\t\t});\n\t\t\treturn ids.map((id) => ({ id, name: `已刷新 ${calls}` }));\n\t\t}\n\t},\n\tonState: (next) => {\n\t\tstate = next;\n\t}\n});\nconst field = shallowRef<AsamFieldDefinition>(initial);\nasync function ready() {\n\tawait nextTick();\n\tawait tick();\n\tawait nextTick();\n}\nasync function run() {\n\tconst checks: string[] = [];\n\ttry {\n\t\tawait ready();\n\t\tconst before = calls;\n\t\thold = true;\n\t\tlet finished = false;\n\t\tconst pending = fieldRef.value!.refresh().then((value) => {\n\t\t\tcheck(value === undefined, '公开返回值');\n\t\t\tfinished = true;\n\t\t});\n\t\tawait ready();\n\t\tcheck(calls === before + 1 && !finished, '真实资源ref一次转发并等待');\n\t\trelease!();\n\t\tawait pending;\n\t\tcheck(!state?.pending && state?.resources[0].name.startsWith('已刷新'), '真实解析结果');\n\t\tchecks.push('资源ref转发/等待/void结果');\n\t\tconst switching = fieldRef.value!.refresh();\n\t\tawait ready();\n\t\tconst successor = createAsamResourceField({\n\t\t\tkey: 'probe',\n\t\t\tlabel: '后继资源',\n\t\t\tservices: {\n\t\t\t\tupload: async () => ({ id: 1, name: 'file' }),\n\t\t\t\tresolve: async (ids) => {\n\t\t\t\t\tsuccessorCalls++;\n\t\t\t\t\treturn ids.map((id) => ({ id, name: '后继' }));\n\t\t\t\t}\n\t\t\t}\n\t\t});\n\t\tfield.value = successor;\n\t\tawait ready();\n\t\trelease?.();\n\t\tawait switching;\n\t\tawait ready();\n\t\tcheck(successorCalls === 1, '旧refresh不得续刷后继');\n\t\tchecks.push('等待中切字段/卸载旧请求');\n\t\tfor (const boundary of ['hidden', 'detail', 'readonly', 'inactive']) {\n\t\t\tfield.value =\n\t\t\t\tboundary === 'hidden'\n\t\t\t\t\t? { ...successor, modes: { edit: { hidden: true } } }\n\t\t\t\t\t: boundary === 'readonly'\n\t\t\t\t\t\t? { ...successor, modes: { edit: { readonly: true } } }\n\t\t\t\t\t\t: successor;\n\t\t\tmode.value = boundary === 'detail' ? 'detail' : 'edit';\n\t\t\tactive.value = boundary !== 'inactive';\n\t\t\tawait ready();\n\t\t\tconst n = successorCalls;\n\t\t\tawait fieldRef.value!.refresh();\n\t\t\tcheck(successorCalls === n, boundary);\n\t\t\tchecks.push(boundary);\n\t\t}\n\t\tactive.value = true;\n\t\tmode.value = 'edit';\n\t\tfield.value = initial;\n\t\thold = false;\n\t\tawait ready();\n\t\thold = true;\n\t\tconst clearing = fieldRef.value!.refresh();\n\t\tawait ready();\n\t\tconst count = calls;\n\t\tvalue.value = null;\n\t\tawait ready();\n\t\trelease?.();\n\t\tawait clearing;\n\t\tcheck(calls === count && state?.value === null, '清空取消解析');\n\t\tchecks.push('清空取消/晚到隔离');\n\t\tvalue.value = 0;\n\t\thold = false;\n\t\tawait ready();\n\t\thold = true;\n\t\tconst unmounting = fieldRef.value!.refresh();\n\t\tawait ready();\n\t\tmounted.value = false;\n\t\tawait ready();\n\t\trelease?.();\n\t\tawait unmounting;\n\t\tchecks.push('pending卸载');\n\t\tmounted.value = true;\n\t\tvalue.value = 0;\n\t\tfor (const kind of ['sync', 'reject', 'value', 'none']) {\n\t\t\tfield.value = {\n\t\t\t\t...initial,\n\t\t\t\tcontrol: defineAsamControl<unknown, object>({\n\t\t\t\t\temptyValue: () => null,\n\t\t\t\t\tsourceKinds: [],\n\t\t\t\t\tcomponent: defineComponent({\n\t\t\t\t\t\tsetup(_, { expose }) {\n\t\t\t\t\t\t\tif (kind !== 'none')\n\t\t\t\t\t\t\t\texpose({\n\t\t\t\t\t\t\t\t\trefresh: () => {\n\t\t\t\t\t\t\t\t\t\tif (kind === 'sync') throw new Error('同步异常');\n\t\t\t\t\t\t\t\t\t\tif (kind === 'value') return { privateResult: true };\n\t\t\t\t\t\t\t\t\t\treturn Promise.reject(new Error('异步拒绝'));\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t});\n\t\t\t\t\t\t\treturn () => h('span', '公开控件');\n\t\t\t\t\t\t}\n\t\t\t\t\t})\n\t\t\t\t})\n\t\t\t};\n\t\t\tawait ready();\n\t\t\tlet caught = false;\n\t\t\ttry {\n\t\t\t\tconst output = await fieldRef.value!.refresh();\n\t\t\t\tcheck(output === undefined, '无方法void');\n\t\t\t} catch (error) {\n\t\t\t\tcaught = String(error).includes(kind === 'sync' ? '同步异常' : '异步拒绝');\n\t\t\t}\n\t\t\tcheck(kind === 'none' || kind === 'value' ? !caught : caught, kind);\n\t\t\tchecks.push(kind);\n\t\t}\n\t\tfield.value = { key: 'plain', label: '原生文本', kind: 'text' };\n\t\tvalue.value = '';\n\t\tawait ready();\n\t\tconst n = calls;\n\t\tawait fieldRef.value!.refresh();\n\t\tcheck(calls === n, '内置不调用资源服务');\n\t\tchecks.push('内置字段原有刷新分支');\n\t\tresult.value = JSON.stringify({ status: 'PASS', checks });\n\t} catch (error) {\n\t\tresult.value = JSON.stringify({ status: 'FAIL', error: String(error), checks });\n\t}\n}\n</script>\n\n<style scoped>\noutput {\n\tdisplay: block;\n\toverflow-wrap: anywhere;\n}\n</style>\n"
		},
		{
			"path": "tests/v2/resources/main.ts",
			"source": "import { createApp } from 'vue';\nimport ElementPlus from 'element-plus';\nimport 'element-plus/dist/index.css';\nimport '@asam-ui/ui/style.css';\nimport '@asam-ui/pro/style.css';\nimport Example from './Example.vue';\ncreateApp(Example).use(ElementPlus).mount('#app');\n"
		},
		{
			"path": "website-hosts/resources.ts",
			"source": "import { createApp as createOwnerApp } from 'vue';\nimport { AsamI18nKey } from '@asam-ui/ui/i18n';\nimport type { AsamI18n } from '@asam-ui/ui/i18n';\nimport { createApp } from 'vue';\nimport ElementPlus from 'element-plus';\nimport 'element-plus/dist/index.css';\nimport '@asam-ui/ui/style.css';\nimport '@asam-ui/pro/style.css';\nimport Example from '../tests/v2/resources/Example.vue';\nexport async function mountWebsiteExample(\n\telement: Element,\n\tonError: (error: unknown) => void,\n\ti18n?: AsamI18n\n) {\n\tconst apps: ReturnType<typeof createOwnerApp>[] = [];\n\tconst createApp: typeof createOwnerApp = (...args) => {\n\t\tconst app = createOwnerApp(...args);\n\t\tif (i18n) app.provide(AsamI18nKey, i18n);\n\t\tapp.config.errorHandler = onError;\n\t\tapps.push(app);\n\t\treturn app;\n\t};\n\n\tcreateApp(Example).use(ElementPlus).mount(element);\n\n\treturn () => {\n\t\tfor (const app of apps.reverse()) app.unmount();\n\t};\n}\n"
		}
	]
}
