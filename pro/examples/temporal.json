	"schemaVersion": 1,
	"entry": "tests/v2/temporal/Example.vue",
	"bootstrap": "tests/v2/temporal/Example.vue",
	"files": [
		{
			"path": "tests/v2/temporal/Example.vue",
			"source": "<template>\n\t<main :style=\"{ '--asam-space-sm': '12px' }\">\n\t\t<h1>日期时间与各粒度范围</h1>\n\t\t<section aria-label=\"直接控件契约\">\n\t\t\t<AsamButton @click=\"directRef?.focus()\" type=\"primary\">直接聚焦</AsamButton\n\t\t\t><AsamButton @click=\"directRef?.handleOpen()\" type=\"primary\">直接展开</AsamButton\n\t\t\t><AsamButton @click=\"directRef?.handleClose()\" type=\"primary\">直接关闭</AsamButton\n\t\t\t><component\n\t\t\t\t:is=\"direct.control.component\"\n\t\t\t\tref=\"directRef\"\n\t\t\t\tv-model=\"directValue\"\n\t\t\t\taria-label=\"直接月份\"\n\t\t\t\t:disabled=\"disabled\"\n\t\t\t\t@change=\"nativeChanges++\"\n\t\t\t\t@focus=\"nativeFocus++\"\n\t\t\t\t><template #prev-year><span>自定义上一年</span></template></component\n\t\t\t><output aria-label=\"直接事件\"\n\t\t\t\t>{{ nativeChanges }}:{{ nativeFocus }}:{{ directValue }}</output\n\t\t\t>\n\t\t</section>\n\t\t<p>日历字符串与瞬时分离；ISO 周从周一开始。两个公开选择器保留单端范围。</p>\n\t\t<AsamButton @click=\"disabled = !disabled\" type=\"primary\">切换禁用</AsamButton\n\t\t><AsamButton @click=\"readonly = !readonly\" type=\"primary\">切换只读</AsamButton\n\t\t><AsamButton @click=\"visible = !visible\" type=\"primary\">切换挂载</AsamButton\n\t\t><AsamButton @click=\"reset\" type=\"primary\">重置</AsamButton\n\t\t><AsamButton @click=\"clear\" type=\"primary\">全部清空</AsamButton\n\t\t><Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t<label\n\t\t\t\t\t\t>尺寸<AsamSelect v-model=\"size\" aria-label=\"尺寸\"\n\t\t\t\t\t\t\t><AsamOption\n\t\t\t\t\t\t\t\tv-for=\"item in ['small', 'default', 'big', 'large']\"\n\t\t\t\t\t\t\t\t:key=\"item\"\n\t\t\t\t\t\t\t\t:value=\"String(item).trim()\"\n\t\t\t\t\t\t\t\t:label=\"String(item).trim()\"\n\t\t\t\t\t\t\t\t>{{ item }}</AsamOption\n\t\t\t\t\t\t\t></AsamSelect\n\t\t\t\t\t\t></label\n\t\t\t\t\t>\n\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t></Teleport\n\t\t><template v-if=\"visible\"\n\t\t\t><section v-for=\"mode in ['query', 'edit', 'detail'] as const\" :key=\"mode\">\n\t\t\t\t<h2>{{ mode }}</h2>\n\t\t\t\t<AsamForm\n\t\t\t\t\tv-if=\"mode !== 'detail'\"\n\t\t\t\t\tv-model=\"model\"\n\t\t\t\t\t:schema=\"adapters[mode].schema\"\n\t\t\t\t\t:registry=\"adapters[mode].registry\"\n\t\t\t\t\t:disabled=\"disabled\"\n\t\t\t\t\t:inline=\"false\"\n\t\t\t\t\t:show-search=\"false\"\n\t\t\t\t\t:show-reset=\"false\"\n\t\t\t\t\t:label-width=\"100\"\n\t\t\t\t/>\n\t\t\t\t<p v-for=\"field in mode === 'detail' ? definitions : []\" :key=\"field.key\">\n\t\t\t\t\t{{ field.label }}：<AsamField\n\t\t\t\t\t\t:field=\"field\"\n\t\t\t\t\t\t:model-value=\"model[field.key]\"\n\t\t\t\t\t\tmode=\"detail\"\n\t\t\t\t\t/>\n\t\t\t\t</p></section></template\n\t\t><AsamButton @click=\"convert('query')\" type=\"primary\">生成查询</AsamButton\n\t\t><AsamButton @click=\"convert('submit')\" type=\"primary\">校验提交</AsamButton>\n\t\t<pre aria-label=\"结果\">{{ output }}</pre>\n\t</main>\n</template>\n<script setup lang=\"ts\">\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\n\nimport { AsamSelect, AsamOption } from '@asam-ui/ui';\n\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { computed, ref, shallowRef } from 'vue';\nimport { AsamForm } from '@asam-ui/ui';\nimport type { AsamControlSize } from '@asam-ui/ui';\nimport {\n\tAsamField,\n\tcreateAsamFieldModel,\n\tclearAsamFieldValue,\n\tcreateAsamFieldSchema,\n\ttransformAsamFields\n} from '@asam-ui/pro/components';\nimport { createAsamTemporalField } from '@asam-ui/pro/components';\nimport type { AsamTemporalKind } from '@asam-ui/pro/components';\nimport type { AsamTemporalControlExpose } from '@asam-ui/pro/components';\nconst direct = createAsamTemporalField({ key: 'direct', label: '直接月份', kind: 'month' });\nconst directValue = ref('2024-12');\nconst directRef = shallowRef<AsamTemporalControlExpose>();\nconst nativeChanges = ref(0);\nconst nativeFocus = ref(0);\nconst size = ref<AsamControlSize>('default');\nconst disabled = ref(false);\nconst readonly = ref(false);\nconst visible = ref(true);\nconst kinds: AsamTemporalKind[] = ['date', 'time', 'datetime', 'week', 'month', 'quarter', 'year'];\nconst initial = [\n\t'2024-02-29',\n\t'13:30:00',\n\t'2024-02-29T00:00:00.000Z',\n\t'2025-W01',\n\t'2024-12',\n\t'2024-Q4',\n\t'2024'\n];\nconst definitions = computed(() =>\n\tkinds.flatMap((kind, i) =>\n\t\t[false, true].map((range) =>\n\t\t\tcreateAsamTemporalField({\n\t\t\t\tkey: `${kind}${range ? 'Range' : ''}`,\n\t\t\t\tlabel: `${kind}${range ? '范围' : ''}`,\n\t\t\t\tkind,\n\t\t\t\trange,\n\t\t\t\tdefaultValue: () => (range ? { start: initial[i], end: null } : initial[i]),\n\t\t\t\tmodes: {\n\t\t\t\t\tquery: {\n\t\t\t\t\t\treadonly: readonly.value,\n\t\t\t\t\t\tcomponentProps: { size: size.value, defaultValue: new Date(2025, 0, 1) }\n\t\t\t\t\t},\n\t\t\t\t\tedit: {\n\t\t\t\t\t\treadonly: readonly.value,\n\t\t\t\t\t\tcomponentProps: { size: size.value, defaultValue: new Date(2025, 0, 1) }\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t})\n\t\t)\n\t)\n);\nconst model = ref(createAsamFieldModel(definitions.value, {}, 'create'));\nconst output = ref('');\nconst adapters = computed(() => ({\n\tquery: createAsamFieldSchema(definitions.value, 'query'),\n\tedit: createAsamFieldSchema(definitions.value, 'edit')\n}));\nfunction reset() {\n\tmodel.value = createAsamFieldModel(definitions.value, {}, 'create');\n}\nfunction clear() {\n\tmodel.value = Object.fromEntries(\n\t\tdefinitions.value.map((field) => [field.key, clearAsamFieldValue(field)])\n\t);\n}\nfunction convert(target: 'query' | 'submit') {\n\toutput.value = JSON.stringify(\n\t\ttransformAsamFields(\n\t\t\tdefinitions.value,\n\t\t\tmodel.value,\n\t\t\ttarget,\n\t\t\tdefinitions.value.map((field) => field.key)\n\t\t)\n\t);\n}\n</script>\n<style scoped>\nmain {\n\tmax-width: 64rem;\n\tmargin: auto;\n\tpadding: 1rem;\n\tfont-family: sans-serif;\n}\n\nsection {\n\tborder-top: 1px solid var(--asam-border-color, #ccc);\n\tpadding-top: 1rem;\n}\n\npre {\n\twhite-space: pre-wrap;\n\toverflow-wrap: anywhere;\n}\n\nbutton:not([class*='el-']),\nselect:not([class*='el-']) {\n\tmargin: 0.25rem;\n}\n</style>\n"
		}
	]
}
