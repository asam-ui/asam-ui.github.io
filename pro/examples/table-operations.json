	"schemaVersion": 1,
	"entry": "tests/v2/table-operations/Example.vue",
	"bootstrap": "website-hosts/table-operations.ts",
	"files": [
		{
			"path": "tests/v2/table-operations/Example.vue",
			"source": "<template>\n\t<AsamApplicationProvider :config=\"{ size, colorMode: dark ? 'dark' : 'light' }\"\n\t\t><main class=\"demo\">\n\t\t\t<h1>跨页操作与列偏好</h1>\n\t\t\t<div class=\"controls\">\n\t\t\t\t<label>名称查询<AsamInput v-model=\"query\" aria-label=\"名称查询\" /></label\n\t\t\t\t><AsamButton @click=\"search\" type=\"primary\">查询</AsamButton\n\t\t\t\t><label\n\t\t\t\t\t><AsamCheckboxItem v-model=\"permission\" aria-label=\"允许操作\" />允许操作</label\n\t\t\t\t><label><AsamCheckboxItem v-model=\"recover\" aria-label=\"失败恢复\" />失败恢复</label\n\t\t\t\t><label\n\t\t\t\t\t><AsamCheckboxItem v-model=\"readError\" aria-label=\"读取失败\" />读取失败</label\n\t\t\t\t><label\n\t\t\t\t\t><AsamCheckboxItem v-model=\"unknown\" aria-label=\"不确定结果\" />不确定结果</label\n\t\t\t\t><label v-show=\"!websitePreviewControls\"\n\t\t\t\t\t><span\n\t\t\t\t\t\tv-show=\"!websitePreviewControls\"\n\t\t\t\t\t\tdata-preview-theme-control\n\t\t\t\t\t\t:data-preview-value=\"dark\"\n\t\t\t\t\t\tv-on=\"{ 'asam-preview-theme': websitePreviewTheme0 }\"\n\t\t\t\t\t\t><AsamCheckboxItem v-model=\"dark\" aria-label=\"暗色\" /></span\n\t\t\t\t\t>暗色</label\n\t\t\t\t><Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t\t\t<label\n\t\t\t\t\t\t\t\t>尺寸<AsamSelect v-model=\"size\" aria-label=\"尺寸\"\n\t\t\t\t\t\t\t\t\t><AsamOption\n\t\t\t\t\t\t\t\t\t\tv-for=\"value in sizes\"\n\t\t\t\t\t\t\t\t\t\t:key=\"value\"\n\t\t\t\t\t\t\t\t\t\t:value=\"String(value).trim()\"\n\t\t\t\t\t\t\t\t\t\t:label=\"String(value).trim()\"\n\t\t\t\t\t\t\t\t\t\t>{{ value }}</AsamOption\n\t\t\t\t\t\t\t\t\t></AsamSelect\n\t\t\t\t\t\t\t\t></label\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t\t\t></Teleport\n\t\t\t\t><AsamButton\n\t\t\t\t\t@click=\"\n\t\t\t\t\t\truntime.setScope('next');\n\t\t\t\t\t\tcontroller.resumeScope({ q: '' });\n\t\t\t\t\t\tcontroller.submit();\n\t\t\t\t\t\"\n\t\t\t\t\ttype=\"primary\"\n\t\t\t\t>\n\t\t\t\t\t切换范围 </AsamButton\n\t\t\t\t><AsamButton @click=\"mounted = !mounted\" type=\"primary\">挂载切换</AsamButton>\n\t\t\t</div>\n\t\t\t<AsamOperationsTable\n\t\t\t\tv-if=\"mounted\"\n\t\t\t\t:controller=\"controller\"\n\t\t\t\t:selection=\"selection\"\n\t\t\t\t:coordinator=\"coordinator\"\n\t\t\t\t:preferences=\"preferences\"\n\t\t\t\t:operations=\"operations\"\n\t\t\t\t:operation-id=\"operationId\"\n\t\t\t\t:row-actions=\"rowActions\"\n\t\t\t\t:actions=\"actions\"\n\t\t\t\t><template #toolbar\n\t\t\t\t\t><span>仅处理已选有限稳定键</span></template\n\t\t\t\t></AsamOperationsTable\n\t\t\t>\n\t\t\t<p role=\"status\">{{ message }}</p>\n\t\t\t<output aria-label=\"发送次数\">{{ sends }}</output>\n\t\t\t<dialog ref=\"dialog\" aria-label=\"确认操作\">\n\t\t\t\t<p>{{ confirmation }}</p>\n\t\t\t\t<AsamButton @click=\"answer(true)\" type=\"primary\">确认合法目标</AsamButton\n\t\t\t\t><AsamButton @click=\"answer(false)\" type=\"primary\">取消操作</AsamButton>\n\t\t\t</dialog>\n\t\t</main></AsamApplicationProvider\n\t>\n</template>\n<script setup lang=\"ts\">\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\nfunction websitePreviewTheme0(event: CustomEvent<'light' | 'dark'>) {\n\tdark.value = event.detail === 'dark';\n}\n\nimport { AsamInput, AsamCheckboxItem, AsamSelect, AsamOption } from '@asam-ui/ui';\n\nimport { onBeforeUnmount, onMounted, ref } from 'vue';\nimport { AsamButton, createAsamDataRuntime } from '@asam-ui/ui';\nimport type { AsamControlSize } from '@asam-ui/ui';\nimport {\n\tAsamApplicationProvider,\n\tAsamOperationsTable,\n\tcreateAsamTableOperationCoordinator,\n\tuseAsamColumnPreferences,\n\tuseAsamCrossPageSelection,\n\tuseAsamListController\n} from '@asam-ui/pro/components';\nimport type {\n\tAsamColumnPreferenceDocument,\n\tAsamListAction,\n\tAsamTargetResult,\n\tAsamTableOperation\n} from '@asam-ui/pro/components';\n\ntype Row = { id: number; name: string; status: string; version: string };\nconst sizes: AsamControlSize[] = ['large', 'big', 'default', 'small'];\nconst size = ref<AsamControlSize>('default'),\n\tpermission = ref(true),\n\trecover = ref(false),\n\treadError = ref(false),\n\tunknown = ref(false),\n\tdark = ref(false),\n\tmounted = ref(true);\nconst query = ref(''),\n\tsends = ref(0),\n\tmessage = ref(''),\n\tdialog = ref<HTMLDialogElement>(),\n\tconfirmation = ref('');\nconst runtime = createAsamDataRuntime({ scope: 'demo:user-a' });\nconst database: Row[] = Array.from({ length: 24 }, (_, index) => ({\n\tid: index,\n\tname: `记录${index}`,\n\tstatus: '待处理',\n\tversion: '1'\n}));\nconst controller = useAsamListController<Row>({\n\tfields: [{ key: 'q', kind: 'text', label: '名称' }],\n\tinitial: { q: '' },\n\trowKey: 'id',\n\truntime,\n\timmediate: false,\n\tapi: async (request, context) => {\n\t\tawait new Promise((resolve) => setTimeout(resolve, 80));\n\t\tif (context.signal.aborted) throw new Error('读取已取消');\n\t\tif (readError.value) throw new Error('示例读取失败');\n\t\tconst filtered = database.filter((row) => row.name.includes(String(request.query.q ?? '')));\n\t\tif (request.sort)\n\t\t\tfiltered.sort((a, b) => (a.id - b.id) * (request.sort?.order === 'ascending' ? 1 : -1));\n\t\treturn {\n\t\t\tlist: filtered\n\t\t\t\t.slice(\n\t\t\t\t\t(request.currentPage - 1) * request.pageSize,\n\t\t\t\t\trequest.currentPage * request.pageSize\n\t\t\t\t)\n\t\t\t\t.map((row) => ({ ...row })),\n\t\t\ttotal: filtered.length\n\t\t};\n\t}\n});\nconst selection = useAsamCrossPageSelection({\n\tcontroller,\n\tdataset: () => runtime.scope,\n\tselectionLimit: 1000\n});\n// 业务应用可把此对象提升到页面store，在组件重挂后继续核实同一操作。\nconst coordinator = createAsamTableOperationCoordinator();\nconst storage = new Map<string, AsamColumnPreferenceDocument>();\nconst preferences = useAsamColumnPreferences<Row>({\n\tcolumns: [\n\t\t{\n\t\t\tkey: 'id',\n\t\t\tlabel: '编号',\n\t\t\trequired: true,\n\t\t\tmovable: false,\n\t\t\twidth: 100,\n\t\t\tminWidth: 70,\n\t\t\tmaxWidth: 250,\n\t\t\tsortable: true\n\t\t},\n\t\t{ key: 'name', label: '名称', width: 180 },\n\t\t{ key: 'status', label: '状态', width: 160 }\n\t],\n\tscope: () => {\n\t\tvoid controller.session.value;\n\t\treturn { application: 'example', principal: runtime.scope, table: 'records', version: '1' };\n\t},\n\tadapter: {\n\t\tload: async (scope) => storage.get(JSON.stringify(scope)),\n\t\tsave: async (scope, document) => {\n\t\t\tstorage.set(JSON.stringify(scope), document);\n\t\t},\n\t\treset: async (scope) => {\n\t\t\tstorage.delete(JSON.stringify(scope));\n\t\t}\n\t}\n});\nlet respond: ((value: boolean) => void) | undefined;\nfunction answer(value: boolean) {\n\tdialog.value?.close();\n\trespond?.(value);\n\trespond = undefined;\n}\n// 合成服务端操作记录：模拟写成功但响应丢失，再按operationId核实。\nconst remoteWrites = new Map<string, AsamTargetResult>();\nconst remoteKey = (operationId: string, key: string | number) =>\n\t`${operationId}:${typeof key}:${key}`;\nconst operations: readonly AsamTableOperation[] = [\n\t{\n\t\tid: 'approve',\n\t\tlabel: '处理',\n\t\tbusyKey: 'write',\n\t\tenabled: () => permission.value,\n\t\tallowed: () => permission.value,\n\t\tresolve: async (keys) =>\n\t\t\tkeys.map((key) => {\n\t\t\t\tconst row = database.find((item) => item.id === key);\n\t\t\t\treturn row\n\t\t\t\t\t? { key, target: { key, version: row.version, payload: { name: row.name } } }\n\t\t\t\t\t: { key, reason: '记录已删除' };\n\t\t\t}),\n\t\tconfirm: async (snapshot) => {\n\t\t\tconfirmation.value = `范围${snapshot.context.scope}；合法${snapshot.targets.length}条；拒绝${snapshot.rejected.length}条：${snapshot.rejected.map((item) => item.reason).join('、')}；键${snapshot.targets.map((item) => item.key).join('、')}`;\n\t\t\tdialog.value?.showModal();\n\t\t\treturn new Promise((resolve) => {\n\t\t\t\trespond = resolve;\n\t\t\t});\n\t\t},\n\t\texecute: async (target, snapshot) => {\n\t\t\tsends.value++;\n\t\t\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\t\t\tif (target.key === 1 && !recover.value)\n\t\t\t\treturn {\n\t\t\t\t\tkey: target.key,\n\t\t\t\t\tstatus: 'failure',\n\t\t\t\t\tmessage: '明确业务拒绝，启用失败恢复后重试'\n\t\t\t\t};\n\t\t\tconst row = database.find((item) => item.id === target.key)!;\n\t\t\trow.status = '已处理';\n\t\t\trow.version = String(Number(row.version) + 1);\n\t\t\tconst result: AsamTargetResult = { key: target.key, status: 'success' };\n\t\t\tremoteWrites.set(remoteKey(snapshot.operationId, target.key), result);\n\t\t\tif (unknown.value) throw new Error('合成服务端已写入，响应丢失');\n\t\t\treturn result;\n\t\t},\n\t\tverify: async (target, snapshot) =>\n\t\t\tunknown.value\n\t\t\t\t? { key: target.key, status: 'unknown', message: '核实通路仍不可用' }\n\t\t\t\t: (remoteWrites.get(remoteKey(snapshot.operationId, target.key)) ?? {\n\t\t\t\t\t\tkey: target.key,\n\t\t\t\t\t\tstatus: 'unknown',\n\t\t\t\t\t\tmessage: '没有可确认的服务端记录'\n\t\t\t\t\t}),\n\t\tnotify: (record) => {\n\t\t\tmessage.value = `${record.snapshot.operationId}本轮完成；记录含逐目标状态`;\n\t\t}\n\t}\n];\n// 新ID只代表新意图。共享coordinator按scope/busyKey/目标键拒绝未决写入重放，\n// 表格据此禁用冲突入口并引导原记录verify；其他目标保持可操作。\nlet sequence = 0;\nconst operationId = () => `example-${++sequence}`;\nconst rowActions: readonly AsamListAction<Row>[] = [\n\t{\n\t\tid: 'inspect',\n\t\tlabel: '查看',\n\t\trun: async ({ row }) => {\n\t\t\tmessage.value = row?.name ?? '';\n\t\t}\n\t}\n];\nconst actions: readonly AsamListAction<Row>[] = [\n\t{\n\t\tid: 'help',\n\t\tlabel: '说明',\n\t\tscope: 'independent',\n\t\trun: async () => {\n\t\t\tmessage.value = '有限跨页键；不代表服务端所有匹配';\n\t\t}\n\t}\n];\nasync function search() {\n\tcontroller.setDraft({ q: query.value });\n\tawait controller.submit();\n}\n\nonMounted(() => {\n\tvoid controller.submit();\n\tvoid preferences.load();\n\tdialog.value?.addEventListener('cancel', () => answer(false));\n});\nonBeforeUnmount(() => answer(false));\n</script>\n<style scoped>\n.demo {\n\tmax-width: 100%;\n\tpadding: var(--asam-space-4, 16px);\n\tcolor: var(--asam-color-text-primary);\n}\n.controls {\n\tdisplay: flex;\n\tflex-wrap: wrap;\n\tgap: var(--asam-space-2, 8px);\n\tmargin-bottom: var(--asam-space-4, 16px);\n}\ninput:not([class*='el-']) {\n\tmax-width: 100%;\n}\ndialog {\n\tmax-width: min(90vw, 600px);\n\toverflow-wrap: anywhere;\n}\n</style>\n"
		},
		{
			"path": "tests/v2/table-operations/main.ts",
			"source": "import { createApp } from 'vue';\nimport ElementPlus from 'element-plus';\nimport 'element-plus/dist/index.css';\nimport '@asam-ui/ui/style.css';\nimport '@asam-ui/pro/style.css';\nimport Example from './Example.vue';\ncreateApp(Example).use(ElementPlus).mount('#app');\n"
		},
		{
			"path": "website-hosts/table-operations.ts",
			"source": "import { createApp as createOwnerApp } from 'vue';\nimport { AsamI18nKey } from '@asam-ui/ui/i18n';\nimport type { AsamI18n } from '@asam-ui/ui/i18n';\nimport { createApp } from 'vue';\nimport ElementPlus from 'element-plus';\nimport 'element-plus/dist/index.css';\nimport '@asam-ui/ui/style.css';\nimport '@asam-ui/pro/style.css';\nimport Example from '../tests/v2/table-operations/Example.vue';\nexport async function mountWebsiteExample(\n\telement: Element,\n\tonError: (error: unknown) => void,\n\ti18n?: AsamI18n\n) {\n\tconst apps: ReturnType<typeof createOwnerApp>[] = [];\n\tconst createApp: typeof createOwnerApp = (...args) => {\n\t\tconst app = createOwnerApp(...args);\n\t\tif (i18n) app.provide(AsamI18nKey, i18n);\n\t\tapp.config.errorHandler = onError;\n\t\tapps.push(app);\n\t\treturn app;\n\t};\n\n\tcreateApp(Example).use(ElementPlus).mount(element);\n\n\treturn () => {\n\t\tfor (const app of apps.reverse()) app.unmount();\n\t};\n}\n"
		}
	]
}
