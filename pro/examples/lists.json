	"schemaVersion": 1,
	"entry": "tests/v2/lists/src/App.vue",
	"bootstrap": "tests/v2/lists/src/App.vue",
	"files": [
		{
			"path": "tests/v2/lists/src/App.vue",
			"source": "<template>\n\t<main>\n\t\t<h1>高级列表与受控任务卡</h1>\n\t\t<div class=\"controls\">\n\t\t\t<div class=\"control\">\n\t\t\t\t<Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t\t\t<label for=\"list-size\">尺寸</label>\n\t\t\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t\t\t></Teleport\n\t\t\t\t><AsamSelect id=\"list-size\" v-model=\"size\"\n\t\t\t\t\t><AsamOption\n\t\t\t\t\t\tv-for=\"value in sizes\"\n\t\t\t\t\t\t:key=\"value\"\n\t\t\t\t\t\t:value=\"String(value).trim()\"\n\t\t\t\t\t\t:label=\"String(value).trim()\"\n\t\t\t\t\t\t>{{ value }}</AsamOption\n\t\t\t\t\t></AsamSelect\n\t\t\t\t>\n\t\t\t</div>\n\t\t\t<div class=\"control\">\n\t\t\t\t<label v-show=\"!websitePreviewControls\" for=\"dark\">暗色</label\n\t\t\t\t><AsamCheckboxItem id=\"dark\" v-model=\"dark\" />\n\t\t\t</div>\n\t\t\t<div class=\"control\">\n\t\t\t\t<label for=\"readonly\">只读</label\n\t\t\t\t><AsamCheckboxItem id=\"readonly\" v-model=\"readonly\" />\n\t\t\t</div>\n\t\t\t<div class=\"control\">\n\t\t\t\t<label for=\"disabled\">禁用</label\n\t\t\t\t><AsamCheckboxItem id=\"disabled\" v-model=\"disabled\" />\n\t\t\t</div>\n\t\t\t<div class=\"control\">\n\t\t\t\t<label for=\"permission\">前端权限</label\n\t\t\t\t><AsamCheckboxItem id=\"permission\" v-model=\"permitted\" />\n\t\t\t</div>\n\t\t\t<AsamButton @click=\"layout = layout === 'list' ? 'grid' : 'list'\" type=\"primary\">\n\t\t\t\t切换列表网格 </AsamButton\n\t\t\t><AsamButton\n\t\t\t\t@click=\"\n\t\t\t\t\tmode = 'error';\n\t\t\t\t\tcontroller.refresh();\n\t\t\t\t\"\n\t\t\t\ttype=\"primary\"\n\t\t\t>\n\t\t\t\t模拟读取失败 </AsamButton\n\t\t\t><AsamButton @click=\"mode = 'ready'\" type=\"primary\">恢复读取服务</AsamButton\n\t\t\t><AsamButton\n\t\t\t\t@click=\"\n\t\t\t\t\tmode = 'empty';\n\t\t\t\t\tcontroller.refresh();\n\t\t\t\t\"\n\t\t\t\ttype=\"primary\"\n\t\t\t>\n\t\t\t\t模拟空数据 </AsamButton\n\t\t\t><AsamButton\n\t\t\t\t@click=\"\n\t\t\t\t\tmode = 'slow';\n\t\t\t\t\tcontroller.refresh();\n\t\t\t\t\"\n\t\t\t\ttype=\"primary\"\n\t\t\t>\n\t\t\t\t模拟慢刷新 </AsamButton\n\t\t\t><AsamButton @click=\"runtime.setScope(`scope-${++scopeNumber}`)\" type=\"primary\"\n\t\t\t\t>失效范围</AsamButton\n\t\t\t><AsamButton\n\t\t\t\t@click=\"\n\t\t\t\t\tcontroller.resumeScope({ q: '' });\n\t\t\t\t\tmode = 'ready';\n\t\t\t\t\tcontroller.submit();\n\t\t\t\t\"\n\t\t\t\ttype=\"primary\"\n\t\t\t>\n\t\t\t\t恢复范围\n\t\t\t</AsamButton>\n\t\t</div>\n\t\t<AsamSearchForm :controller=\"controller\" :size=\"size\" /><AsamProList\n\t\t\t:controller=\"controller\"\n\t\t\t:content=\"content\"\n\t\t\tlabel=\"记录列表\"\n\t\t\t:layout=\"layout\"\n\t\t\t:size=\"size\"\n\t\t\t:min-width=\"minWidth\"\n\t\t\tselectable\n\t\t\t:actions=\"actions\"\n\t\t\t:row-actions=\"rowActions\"\n\t\t\t:readonly=\"readonly\"\n\t\t\t:disabled=\"disabled\"\n\t\t\t:sorts=\"sorts\"\n\t\t\t><template #content=\"{ row }\"\n\t\t\t\t><small>宿主字段：{{ row.team }}</small></template\n\t\t\t></AsamProList\n\t\t>\n\t\t<details @toggle=\"showShared = ($event.target as HTMLDetailsElement).open\">\n\t\t\t<summary>同一controller第二视图</summary>\n\t\t\t<AsamCardList\n\t\t\t\tv-if=\"showShared\"\n\t\t\t\t:controller=\"controller\"\n\t\t\t\t:content=\"content\"\n\t\t\t\tlabel=\"共享卡片视图\"\n\t\t\t\tselectable\n\t\t\t\t:readonly=\"readonly\"\n\t\t\t\t:disabled=\"disabled\"\n\t\t\t/>\n\t\t</details>\n\t\t<section aria-label=\"两种宿主任务状态\" class=\"tasks\">\n\t\t\t<AsamProTaskCard\n\t\t\t\t:title=\"longTaskTitle ? '<b>长任务标题</b>'.repeat(18) : '发布素材准备'\"\n\t\t\t\tdescription=\"由宿主注入任务字段；点击操作不会触发打开。\"\n\t\t\t\t:status=\"deliveryStates[delivery]\"\n\t\t\t\t:state=\"taskState\"\n\t\t\t\t:size=\"size\"\n\t\t\t\t:progress=\"progress\"\n\t\t\t\t:meta=\"taskMeta\"\n\t\t\t\t:assignees=\"[{ id: 1, name: '林岚', src: '/missing-avatar.png' }]\"\n\t\t\t\t:actions=\"taskActions\"\n\t\t\t\t:disabled=\"disabled\"\n\t\t\t\t:readonly=\"readonly\"\n\t\t\t\topen-label=\"打开详情\"\n\t\t\t\t@open=\"opened++\"\n\t\t\t\t@action=\"taskAction\"\n\t\t\t\t@retry=\"taskState = 'ready'\"\n\t\t\t\t><template #extra><span>素材项目</span></template></AsamProTaskCard\n\t\t\t><AsamProTaskCard\n\t\t\t\ttitle=\"设备检修单\"\n\t\t\t\t:status=\"serviceStates[service]\"\n\t\t\t\t:meta=\"[\n\t\t\t\t\t{ label: '设备', value: '合成设备-07' },\n\t\t\t\t\t{ label: '截止', value: null }\n\t\t\t\t]\"\n\t\t\t\t:progress=\"null\"\n\t\t\t\t:actions=\"[{ id: 'inspect', label: '登记检查', disabled: service === 90 }]\"\n\t\t\t\t:readonly=\"readonly\"\n\t\t\t\t:disabled=\"disabled\"\n\t\t\t\t@action=\"service = 90\"\n\t\t\t/>\n\t\t</section>\n\t\t<div class=\"controls\">\n\t\t\t<div class=\"control\">\n\t\t\t\t<label for=\"long-task-title\">长任务标题</label\n\t\t\t\t><AsamCheckboxItem id=\"long-task-title\" v-model=\"longTaskTitle\" />\n\t\t\t</div>\n\t\t\t<div class=\"control\">\n\t\t\t\t<label for=\"task-state\">任务展示状态</label\n\t\t\t\t><AsamSelect id=\"task-state\" v-model=\"taskState\"\n\t\t\t\t\t><AsamOption\n\t\t\t\t\t\tv-for=\"state in ['ready', 'loading', 'empty', 'error']\"\n\t\t\t\t\t\t:key=\"state\"\n\t\t\t\t\t\t:value=\"String(state).trim()\"\n\t\t\t\t\t\t:label=\"String(state).trim()\"\n\t\t\t\t\t\t>{{ state }}</AsamOption\n\t\t\t\t\t></AsamSelect\n\t\t\t\t>\n\t\t\t</div>\n\t\t\t<AsamButton\n\t\t\t\t@click=\"\n\t\t\t\t\tdelivery = 'draft';\n\t\t\t\t\tservice = 10;\n\t\t\t\t\ttaskState = 'ready';\n\t\t\t\t\"\n\t\t\t\ttype=\"primary\"\n\t\t\t>\n\t\t\t\t重置任务\n\t\t\t</AsamButton>\n\t\t</div>\n\t</main>\n</template>\n<script setup lang=\"ts\">\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\n\nimport { AsamSelect, AsamOption, AsamCheckboxItem } from '@asam-ui/ui';\n\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { computed, ref, watch, nextTick } from 'vue';\nimport { createAsamDataRuntime, provideAsamControlSize } from '@asam-ui/ui';\nimport type { AsamControlSize } from '@asam-ui/ui';\nimport { applyAsamTheme, createAsamTheme, defaultAsamTheme } from '@asam-ui/ui/tokens';\nimport {\n\tAsamSearchForm,\n\tAsamProList,\n\tAsamCardList,\n\tAsamProTaskCard,\n\tuseAsamListController\n} from '@asam-ui/pro/components';\nimport type {\n\tAsamListContent,\n\tAsamListAction,\n\tAsamListSort,\n\tAsamTaskAction,\n\tAsamTaskStatus\n} from '@asam-ui/pro/components';\ninterface Row {\n\tid: number;\n\tname: string;\n\tteam: string;\n\tdescription: string;\n}\nconst sizes: AsamControlSize[] = ['large', 'big', 'default', 'small'];\nconst size = ref<AsamControlSize>('default'),\n\tdark = ref(false),\n\treadonly = ref(false),\n\tdisabled = ref(false),\n\tpermitted = ref(true);\nprovideAsamControlSize('provider', size);\nconst layout = ref<'list' | 'grid'>(\n\tnew URLSearchParams(location.search).get('layout') === 'grid' ? 'grid' : 'list'\n);\nconst showShared = ref(false);\nconst minWidth = 280;\nconst mode = ref('ready'),\n\tcalls = ref(0),\n\tactionLog = ref<string[]>([]);\nconst scopeNumber = ref(0);\nconst runtime = createAsamDataRuntime({ scope: 'lists-demo' });\nconst records: Row[] = Array.from({ length: 100 }, (_, index) => ({\n\tid: index + 1,\n\tname: `记录 ${index + 1}${index === 0 ? ' · 长标题测试需要保持完整可读'.repeat(4) : ''}`,\n\tteam: index % 2 ? '甲组' : '乙组',\n\tdescription: '可复用业务说明，不绑定具体接口。'.repeat(index === 0 ? 7 : 1)\n}));\nconst controller = useAsamListController<Row>({\n\truntime,\n\tfields: [{ key: 'q', kind: 'text', label: '名称' }],\n\tinitial: { q: '' },\n\trowKey: 'id',\n\tpageSize: 100,\n\tapi: async (request) => {\n\t\tcalls.value++;\n\t\tconst current = mode.value;\n\t\tawait new Promise((resolve) => setTimeout(resolve, current === 'slow' ? 600 : 20));\n\t\tif (current === 'error') throw new Error('模拟读取失败，请恢复服务后重试');\n\t\tlet result =\n\t\t\tcurrent === 'empty'\n\t\t\t\t? []\n\t\t\t\t: records.filter((row) => row.name.includes(String(request.query.q ?? '')));\n\t\tif (request.sort)\n\t\t\tresult = [...result].sort(\n\t\t\t\t(a, b) => (a.id - b.id) * (request.sort?.order === 'descending' ? -1 : 1)\n\t\t\t);\n\t\treturn {\n\t\t\tlist: result.slice(\n\t\t\t\t(request.currentPage - 1) * request.pageSize,\n\t\t\t\trequest.currentPage * request.pageSize\n\t\t\t),\n\t\t\ttotal: result.length\n\t\t};\n\t}\n});\nconst content = (row: Row): AsamListContent => ({\n\ttitle: row.name,\n\tdescription: row.description,\n\tmeta: [\n\t\t{ label: '编号', value: row.id },\n\t\t{ label: '团队', value: row.team }\n\t],\n\tcover: row.id === 1 ? { src: '/missing-cover.png', alt: '封面加载失败回退' } : undefined\n});\nconst sorts: readonly { label: string; value: AsamListSort | null }[] = [\n\t{ label: '默认顺序', value: null },\n\t{ label: '编号降序', value: { field: 'id', order: 'descending' } }\n];\nconst actions: AsamListAction<Row>[] = [\n\t{\n\t\tid: 'independent',\n\t\tlabel: '独立操作',\n\t\tscope: 'independent',\n\t\trun: async () => {\n\t\t\tactionLog.value.push('independent');\n\t\t}\n\t},\n\t{\n\t\tid: 'selection',\n\t\tlabel: '处理已选',\n\t\tscope: 'selection',\n\t\trun: async ({ selected }) => {\n\t\t\tactionLog.value.push(`selected:${selected.length}`);\n\t\t}\n\t}\n];\nlet actionFailed = false;\nconst rowActions = computed<AsamListAction<Row>[]>(() => [\n\t{\n\t\tid: 'inspect',\n\t\tlabel: '查看记录',\n\t\tvisible: () => permitted.value,\n\t\tenabled: (row) => !!row && row.id !== 2,\n\t\trun: async ({ row, scope, epoch }) => {\n\t\t\tconst intent = controller.intent.value;\n\t\t\tawait new Promise((resolve) => setTimeout(resolve, 150));\n\t\t\tif (\n\t\t\t\truntime.scope === scope &&\n\t\t\t\truntime.epoch === epoch &&\n\t\t\t\tcontroller.intent.value === intent\n\t\t\t)\n\t\t\t\tactionLog.value.push(`inspect:${row?.id}`);\n\t\t}\n\t},\n\t{\n\t\tid: 'fail',\n\t\tlabel: '失败与重试',\n\t\trun: async () => {\n\t\t\tif (!actionFailed) {\n\t\t\t\tactionFailed = true;\n\t\t\t\tthrow new Error('模拟操作失败，可再次执行');\n\t\t\t}\n\t\t\tactionLog.value.push('retry-success');\n\t\t}\n\t},\n\t{\n\t\tid: 'late-fail',\n\t\tlabel: '延迟失败',\n\t\trun: async () => {\n\t\t\tawait new Promise((resolve) => setTimeout(resolve, 250));\n\t\t\tthrow new Error('过期动作错误');\n\t\t}\n\t}\n]);\nconst deliveryStates: Record<'draft' | 'released', AsamTaskStatus> = {\n\tdraft: { label: '待审素材', tone: 'warning' },\n\treleased: { label: '已交付素材', tone: 'success', completed: true }\n};\nconst serviceStates: Record<number, AsamTaskStatus> = {\n\t10: { label: '等待检修', tone: 'info' },\n\t90: { label: '检查已登记', tone: 'neutral', completed: true }\n};\nconst delivery = ref<'draft' | 'released'>('draft'),\n\tservice = ref(10),\n\ttaskState = ref<'ready' | 'loading' | 'empty' | 'error'>('ready'),\n\topened = ref(0),\n\ttaskEvents = ref<string[]>([]),\n\ttaskBusy = ref(false);\nconst longTaskTitle = ref(false);\nconst progress = computed(() => (delivery.value === 'released' ? 100 : 25));\nconst taskMeta = computed(() => [\n\t{ label: '优先级', value: '高' },\n\t{ label: '计划日期', value: '2026-10-20' }\n]);\nconst taskActions = computed<AsamTaskAction[]>(() => [\n\t{\n\t\tid: 'release',\n\t\tlabel: '交付素材',\n\t\tvisible: permitted.value,\n\t\tbusy: taskBusy.value,\n\t\tdisabled: delivery.value === 'released'\n\t}\n]);\nasync function taskAction(id: string) {\n\tif (taskBusy.value) return;\n\ttaskBusy.value = true;\n\ttaskEvents.value.push(id);\n\tawait new Promise((resolve) => setTimeout(resolve, 150));\n\tdelivery.value = 'released';\n\ttaskBusy.value = false;\n}\nwatch(\n\tdark,\n\t(value) => {\n\t\tapplyAsamTheme(\n\t\t\tvalue\n\t\t\t\t? createAsamTheme({\n\t\t\t\t\t\tcolor: {\n\t\t\t\t\t\t\tsurface: '#18212d',\n\t\t\t\t\t\t\tsurfacePage: '#101820',\n\t\t\t\t\t\t\tsurfaceMuted: '#243244',\n\t\t\t\t\t\t\tsurfaceSoft: '#243244',\n\t\t\t\t\t\t\ttextPrimary: '#edf1f5',\n\t\t\t\t\t\t\ttextRegular: '#d2d9e2',\n\t\t\t\t\t\t\ttextSecondary: '#b3bfcc'\n\t\t\t\t\t\t}\n\t\t\t\t\t})\n\t\t\t\t: defaultAsamTheme\n\t\t);\n\t\tdocument.documentElement.classList.toggle('dark', value);\n\t},\n\t{ immediate: true }\n);\nwatch(controller.resultReady, async (ready) => {\n\tif (ready) {\n\t\tawait nextTick();\n\t\tdocument.documentElement.dataset.interactive = 'true';\n\t\tperformance.mark('lists-interactive');\n\t}\n});\n</script>\n<style>\nbody {\n\tmargin: 0;\n\tbackground: var(--el-bg-color-page);\n\tcolor: var(--el-text-color-primary);\n\tfont-family: sans-serif;\n}\n\n.control {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: var(--asam-space-1, 4px);\n}\n\nmain {\n\tpadding: 16px;\n\tmax-width: 1248px;\n\tmargin: auto;\n}\n\n.controls,\n.tasks {\n\tdisplay: flex;\n\tflex-wrap: wrap;\n\tgap: 12px;\n\tmargin-bottom: 16px;\n}\n\n.tasks > * {\n\tflex: 1 1 280px;\n\tmin-width: 0;\n}\n\noutput {\n\tdisplay: block;\n\twhite-space: pre-wrap;\n\toverflow-wrap: anywhere;\n}\n</style>\n"
		}
	]
}
