	"files": [
		{
			"path": "tests/v2/form-flows/app/App.vue",
			"source": "<template>\n\t<AsamApplicationProvider :config=\"{ size, colorMode: dark ? 'dark' : 'light' }\"\n\t\t><main :class=\"{ dark: dark }\">\n\t\t\t<h1 tabindex=\"-1\">表单流程验证</h1>\n\t\t\t<label><AsamCheckboxItem v-model=\"disabled\" />全局禁用</label\n\t\t\t><label><AsamCheckboxItem v-model=\"readonly\" />全局只读</label\n\t\t\t><Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t\t<label\n\t\t\t\t\t\t\t>尺寸<AsamSelect v-model=\"size\" aria-label=\"尺寸\"\n\t\t\t\t\t\t\t\t><AsamOption value=\"small\" label=\"small\">small</AsamOption\n\t\t\t\t\t\t\t\t><AsamOption value=\"default\" label=\"default\">default</AsamOption\n\t\t\t\t\t\t\t\t><AsamOption value=\"big\" label=\"big\">big</AsamOption\n\t\t\t\t\t\t\t\t><AsamOption value=\"large\" label=\"large\"\n\t\t\t\t\t\t\t\t\t>large</AsamOption\n\t\t\t\t\t\t\t\t></AsamSelect\n\t\t\t\t\t\t\t></label\n\t\t\t\t\t\t>\n\t\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t\t></Teleport\n\t\t\t><label v-show=\"!websitePreviewControls\"\n\t\t\t\t><span\n\t\t\t\t\tv-show=\"!websitePreviewControls\"\n\t\t\t\t\tdata-preview-theme-control\n\t\t\t\t\t:data-preview-value=\"dark\"\n\t\t\t\t\tv-on=\"{ 'asam-preview-theme': websitePreviewTheme0 }\"\n\t\t\t\t\t><AsamCheckboxItem v-model=\"dark\" /></span\n\t\t\t\t>暗色</label\n\t\t\t><AsamButton @click=\"mounted = !mounted\" type=\"primary\">挂载切换</AsamButton\n\t\t\t><label\n\t\t\t\t>实例数<AsamSelect v-model.number=\"copies\" aria-label=\"实例数\"\n\t\t\t\t\t><AsamOption label=\"1\" :value=\"1\">1</AsamOption\n\t\t\t\t\t><AsamOption label=\"2\" :value=\"2\">2</AsamOption></AsamSelect\n\t\t\t\t></label\n\t\t\t><template v-if=\"mounted\"\n\t\t\t\t><div v-for=\"instance in copies\" :key=\"instance\">\n\t\t\t\t\t<section aria-label=\"筛选示例\">\n\t\t\t\t\t\t<FilterExample :size=\"size\" :disabled=\"disabled\" :readonly=\"readonly\" />\n\t\t\t\t\t</section>\n\t\t\t\t\t<section aria-label=\"抽屉示例\">\n\t\t\t\t\t\t<DrawerExample :size=\"size\" :disabled=\"disabled\" :readonly=\"readonly\" />\n\t\t\t\t\t</section>\n\t\t\t\t\t<section aria-label=\"分步示例\">\n\t\t\t\t\t\t<StepsExample :size=\"size\" :disabled=\"disabled\" :readonly=\"readonly\" />\n\t\t\t\t\t</section>\n\t\t\t\t\t<section aria-label=\"登录示例\">\n\t\t\t\t\t\t<LoginExample :size=\"size\" :disabled=\"disabled\" :readonly=\"readonly\" />\n\t\t\t\t\t</section></div></template\n\t\t\t><OverlayThemes /><FilterSlots /><FocusLifecycle /></main\n\t></AsamApplicationProvider>\n</template>\n<script setup lang=\"ts\">\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\nfunction websitePreviewTheme0(event: CustomEvent<'light' | 'dark'>) {\n\tdark.value = event.detail === 'dark';\n}\n\nimport { AsamCheckboxItem, AsamSelect, AsamOption } from '@asam-ui/ui';\n\nimport { AsamButton } from '@asam-ui/ui';\n\nimport FilterExample from '../examples/FilterExample.vue';\nimport DrawerExample from '../examples/DrawerExample.vue';\nimport StepsExample from '../examples/StepsExample.vue';\nimport LoginExample from '../examples/LoginExample.vue';\n\nimport OverlayThemes from './OverlayThemes.vue';\nimport FilterSlots from './FilterSlots.vue';\nimport FocusLifecycle from './FocusLifecycle.vue';\nimport { ref } from 'vue';\nimport type { AsamFlowSize } from '@asam-ui/pro/components';\nimport { AsamApplicationProvider } from '@asam-ui/pro/components';\nconst size = ref<AsamFlowSize>('default');\nconst dark = ref(false);\nconst mounted = ref(true);\nconst copies = ref(1);\nconst disabled = ref(false);\nconst readonly = ref(false);\n</script>\n<style>\nbody {\n\tmargin: 0;\n\tfont-family: system-ui, sans-serif;\n}\nmain {\n\tpadding: 16px;\n}\nsection {\n\tmin-width: 0;\n}\n</style>\n"
		},
		{
			"path": "tests/v2/form-flows/app/FilterSlots.vue",
			"source": "<template>\n\t<section aria-label=\"筛选插槽夹具\">\n\t\t<label><AsamCheckboxItem v-model=\"disabled\" />插槽禁用</label\n\t\t><label><AsamCheckboxItem v-model=\"readonly\" />插槽只读</label\n\t\t><label><AsamCheckboxItem v-model=\"nested\" />嵌套触发内容</label\n\t\t><AsamFilterPopover\n\t\t\tref=\"filter\"\n\t\t\tv-model=\"model\"\n\t\t\ttitle=\"插槽筛选\"\n\t\t\t:fields=\"fields\"\n\t\t\t:disabled=\"disabled\"\n\t\t\t:readonly=\"readonly\"\n\t\t\t:validate=\"validate\"\n\t\t\t@apply=\"queries++\"\n\t\t\t@cancel=\"cancels++\"\n\t\t\t><template #trigger=\"{ open, count }\"\n\t\t\t\t><AsamButton v-if=\"nested\" @click=\"open\" type=\"primary\"\n\t\t\t\t\t><span>自定义筛选入口 {{ count }}</span></AsamButton\n\t\t\t\t><AsamButton v-else @click=\"open\" type=\"primary\"\n\t\t\t\t\t>自定义筛选入口 {{ count }}</AsamButton\n\t\t\t\t></template\n\t\t\t><template #default=\"{ model: draft, update }\"\n\t\t\t\t><label\n\t\t\t\t\t>插槽名称<AsamInput\n\t\t\t\t\t\t:model-value=\"String(draft.name ?? '')\"\n\t\t\t\t\t\t@input=\"edit($event, update)\" /></label></template\n\t\t\t><template #actions=\"{ submit, cancel, clear, reset }\"\n\t\t\t\t><AsamButton @click=\"filter?.open()\" type=\"primary\">重复调用open</AsamButton\n\t\t\t\t><AsamButton @click=\"submit\" type=\"primary\">插槽应用</AsamButton\n\t\t\t\t><AsamButton @click=\"cancel\" type=\"primary\">插槽取消</AsamButton\n\t\t\t\t><AsamButton @click=\"clear\" type=\"primary\">插槽清空</AsamButton\n\t\t\t\t><AsamButton @click=\"reset\" type=\"primary\">插槽重置</AsamButton></template\n\t\t\t></AsamFilterPopover\n\t\t>\n\t</section>\n</template>\n<script setup lang=\"ts\">\nimport { AsamCheckboxItem, AsamInput } from '@asam-ui/ui';\n\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { ref } from 'vue';\nimport { AsamFilterPopover, defineAsamFields } from '@asam-ui/pro/components';\nimport type { AsamFieldModel } from '@asam-ui/pro/components';\nconst fields = defineAsamFields([{ key: 'name', kind: 'text', label: '插槽名称' }]);\nconst filter = ref<InstanceType<typeof AsamFilterPopover>>();\nconst model = ref<AsamFieldModel>({ name: 'seed' });\nconst disabled = ref(false);\nconst readonly = ref(false);\nconst nested = ref(false);\nconst queries = ref(0);\nconst cancels = ref(0);\nasync function validate(value: Readonly<AsamFieldModel>) {\n\treturn value.name === 'bad' ? [{ key: 'name', message: '插槽校验失败' }] : [];\n}\nfunction edit(value: string | number, update: (key: string, value: unknown) => void) {\n\tupdate('name', String(value));\n}\n</script>\n"
		},
		{
			"path": "tests/v2/form-flows/app/FocusLifecycle.vue",
			"source": "<template>\n\t<section aria-label=\"焦点生命周期夹具\">\n\t\t<h2 ref=\"fallback\" tabindex=\"-1\">焦点回退位置</h2>\n\t\t<AsamButton @click=\"cycle(false)\" type=\"primary\">快速开启取消</AsamButton\n\t\t><AsamButton @click=\"cycle(true)\" type=\"primary\">稳定开启取消</AsamButton\n\t\t><AsamFilterPopover\n\t\t\tref=\"filter\"\n\t\t\tv-model=\"model\"\n\t\t\ttitle=\"焦点筛选\"\n\t\t\t:fields=\"fields\"\n\t\t\t:fallback-focus=\"() => fallback ?? null\"\n\t\t\t:validate=\"validate\"\n\t\t\t@apply=\"applies++\"\n\t\t\t@cancel=\"cancels++\"\n\t\t\t@before-enter=\"record('before-enter')\"\n\t\t\t@after-enter=\"record('after-enter')\"\n\t\t\t@before-leave=\"record('before-leave')\"\n\t\t\t@after-leave=\"record('after-leave')\"\n\t\t\t@update:visible=\"record(`visible:${$event}`)\"\n\t\t/>\n\t</section>\n\t<section aria-label=\"登录代次夹具\">\n\t\t<AsamLoginForm\n\t\t\tref=\"login\"\n\t\t\ttitle=\"登录代次\"\n\t\t\t:fields=\"loginFields\"\n\t\t\t:model-value=\"loginModel\"\n\t\t\t:validate=\"loginValidate\"\n\t\t\t:authenticate=\"loginAuthenticate\"\n\t\t\t@success=\"loginSuccesses++\"\n\t\t\t@failure=\"onLoginFailure\"\n\t\t\t@cancel=\"loginCancels++\"\n\t\t/><AsamButton ref=\"loginCallbackTarget\" type=\"primary\">回调焦点</AsamButton>\n\t</section>\n</template>\n<script setup lang=\"ts\">\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { createApp, h, nextTick, onBeforeUnmount, onMounted, ref, shallowRef } from 'vue';\nimport { AsamFilterPopover, AsamLoginForm, defineAsamFields } from '@asam-ui/pro/components';\nimport type { AsamEditIssue, AsamFieldModel, AsamLoginResult } from '@asam-ui/pro/components';\nconst filter = ref<InstanceType<typeof AsamFilterPopover>>();\nconst fallback = ref<HTMLElement>();\nconst fields = defineAsamFields([{ key: 'name', kind: 'text', label: '焦点字段' }]);\nconst rounds = ref(0);\nconst immediate = ref(false);\nconst model = ref<AsamFieldModel>({ name: 'seed' });\nconst applies = ref(0);\nconst cancels = ref(0);\nconst deferred = ref(false);\nlet release: (() => void) | undefined;\nasync function validate(value: Readonly<AsamFieldModel>) {\n\tif (!deferred.value)\n\t\treturn value.name === 'bad' ? [{ key: 'name', message: '当前校验失败' }] : [];\n\treturn new Promise<readonly { key: string; message: string }[]>((resolve) => {\n\t\trelease = () => resolve([{ key: 'name', message: '旧校验失败' }]);\n\t});\n}\nconst lifecycle: { event: string; at: number; tag?: string; id?: string; text?: string }[] = [];\nfunction record(event: string) {\n\tlifecycle.push({\n\t\tevent,\n\t\tat: performance.now(),\n\t\ttag: document.activeElement?.tagName,\n\t\tid: document.activeElement?.id,\n\t\ttext: document.activeElement?.textContent?.slice(0, 20)\n\t});\n}\nonMounted(() => {\n\tObject.assign(window, {\n\t\tv2Focus: {\n\t\t\tfilter,\n\t\t\tfallback,\n\t\t\tlifecycle,\n\t\t\tdeferred,\n\t\t\trelease: () => release?.(),\n\t\t\tready: () => !!release\n\t\t}\n\t});\n\tObject.assign(window, {\n\t\tv2Login: {\n\t\t\tlogin,\n\t\t\tready: () => !!loginRelease,\n\t\t\tarm(phase: 'validation' | 'authentication') {\n\t\t\t\tloginPhase = phase;\n\t\t\t\tloginRelease = undefined;\n\t\t\t},\n\t\t\trelease: (outcome: 'success' | 'failure' | 'throw') => loginRelease?.(outcome),\n\t\t\tsetOutcome(outcome: 'success' | 'failure' | 'throw') {\n\t\t\t\tcurrentOutcome = outcome;\n\t\t\t},\n\t\t\tcallbackReset() {\n\t\t\t\tresetInFailure = true;\n\t\t\t},\n\t\t\tasync restart(kind: string) {\n\t\t\t\tloginPhase = 'none';\n\t\t\t\tif (kind === 'cancel/reset') {\n\t\t\t\t\tlogin.value?.cancel();\n\t\t\t\t\tlogin.value?.reset();\n\t\t\t\t} else if (kind === 'model') loginModel.value = { account: 'replacement' };\n\t\t\t\telse if (kind === 'fields') loginFields.value = makeLoginFields();\n\t\t\t\telse login.value?.reset();\n\t\t\t\tawait nextTick();\n\t\t\t}\n\t\t}\n\t});\n});\nonBeforeUnmount(() => {\n\tReflect.deleteProperty(window, 'v2Focus');\n\tReflect.deleteProperty(window, 'v2Login');\n});\nasync function cycle(stable: boolean) {\n\tconst host = document.createElement('div');\n\tconst trigger = createApp({\n\t\trender: () => h(AsamButton, { 'aria-label': '焦点生命周期探针' })\n\t});\n\tdocument.body.append(host);\n\ttrigger.mount(host);\n\ttry {\n\t\thost.querySelector('button')?.focus();\n\t\tawait filter.value?.open();\n\t\t// 仅正对照等待稳定；快速路径无延时。\n\t\tif (stable) await new Promise((done) => setTimeout(done, 400));\n\t} finally {\n\t\ttrigger.unmount();\n\t\thost.remove();\n\t}\n\tfilter.value?.cancel();\n\timmediate.value = document.activeElement === fallback.value;\n\trounds.value++;\n}\nconst login = ref<InstanceType<typeof AsamLoginForm>>();\nconst makeLoginFields = () =>\n\tdefineAsamFields([{ key: 'account', kind: 'text', label: '代次账号' }]);\nconst loginFields = shallowRef(makeLoginFields());\nconst loginModel = ref<AsamFieldModel>({ account: 'seed' });\nconst loginSuccesses = ref(0),\n\tloginFailures = ref(0),\n\tloginAuths = ref(0),\n\tloginCancels = ref(0);\nlet loginPhase: 'none' | 'validation' | 'authentication' = 'none';\nlet currentOutcome: 'success' | 'failure' | 'throw' = 'success';\nlet loginRelease: ((outcome: 'success' | 'failure' | 'throw') => void) | undefined;\nconst loginCallbackTarget = ref<InstanceType<typeof AsamButton>>();\nlet resetInFailure = false;\nfunction onLoginFailure() {\n\tloginFailures.value++;\n\tif (resetInFailure) {\n\t\tlogin.value?.reset();\n\t\tloginCallbackTarget.value?.ref?.focus();\n\t}\n}\nasync function loginValidate(model: Readonly<AsamFieldModel>): Promise<readonly AsamEditIssue[]> {\n\tif (loginPhase === 'validation')\n\t\treturn new Promise((resolve) => {\n\t\t\tloginRelease = () => resolve([{ key: 'account', message: '登录旧校验错误' }]);\n\t\t});\n\treturn model.account === 'bad' ? [{ key: 'account', message: '登录当前校验错误' }] : [];\n}\nasync function loginAuthenticate(): Promise<AsamLoginResult> {\n\tloginAuths.value++;\n\tif (loginPhase === 'authentication')\n\t\treturn new Promise((resolve, reject) => {\n\t\t\tloginRelease = (outcome) =>\n\t\t\t\toutcome === 'throw'\n\t\t\t\t\t? reject(new Error('登录旧认证异常'))\n\t\t\t\t\t: resolve({ success: outcome === 'success', message: '登录旧认证失败' });\n\t\t});\n\tif (currentOutcome === 'throw') throw new Error('登录当前认证异常');\n\treturn { success: currentOutcome === 'success', message: '登录当前认证失败' };\n}\n</script>\n"
		},
		{
			"path": "tests/v2/form-flows/app/OverlayThemes.vue",
			"source": "<template>\n\t<section aria-label=\"双Provider弹层\">\n\t\t<AsamButton @click=\"openBoth\" type=\"primary\">打开两个作用域筛选</AsamButton\n\t\t><AsamButton @click=\"mounted = !mounted\" type=\"primary\">挂载主题夹具</AsamButton\n\t\t><template v-if=\"mounted\"\n\t\t\t><AsamApplicationProvider\n\t\t\t\t:config=\"{\n\t\t\t\t\tsize: 'default',\n\t\t\t\t\tcolorMode: leftDark ? 'dark' : 'light',\n\t\t\t\t\ttheme: { color: { surface: leftDark ? '#16251c' : '#fff8eb' } }\n\t\t\t\t}\"\n\t\t\t\t><section aria-label=\"左侧Provider\">\n\t\t\t\t\t<AsamFilterPopover\n\t\t\t\t\t\tref=\"left\"\n\t\t\t\t\t\ttitle=\"左侧筛选\"\n\t\t\t\t\t\t:size=\"leftSize\"\n\t\t\t\t\t\t:fields=\"fields\"\n\t\t\t\t\t\t:model-value=\"model\"\n\t\t\t\t\t\t><template #title\n\t\t\t\t\t\t\t><AsamButton @click=\"leftDark = !leftDark\" type=\"primary\"\n\t\t\t\t\t\t\t\t>切换左侧主题</AsamButton\n\t\t\t\t\t\t\t><AsamButton\n\t\t\t\t\t\t\t\t@click=\"leftSize = leftSize === 'small' ? 'large' : 'small'\"\n\t\t\t\t\t\t\t\ttype=\"primary\"\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t切换左侧尺寸\n\t\t\t\t\t\t\t</AsamButton></template\n\t\t\t\t\t\t></AsamFilterPopover\n\t\t\t\t\t>\n\t\t\t\t</section></AsamApplicationProvider\n\t\t\t><AsamApplicationProvider\n\t\t\t\t:config=\"{\n\t\t\t\t\tsize: 'small',\n\t\t\t\t\tcolorMode: 'dark',\n\t\t\t\t\ttheme: { color: { surface: '#17202a' } }\n\t\t\t\t}\"\n\t\t\t\t><section aria-label=\"右侧Provider\">\n\t\t\t\t\t<AsamFilterPopover\n\t\t\t\t\t\tref=\"right\"\n\t\t\t\t\t\ttitle=\"右侧筛选\"\n\t\t\t\t\t\tsize=\"large\"\n\t\t\t\t\t\t:fields=\"fields\"\n\t\t\t\t\t\t:model-value=\"model\"\n\t\t\t\t\t/></section></AsamApplicationProvider\n\t\t></template>\n\t\t<section aria-label=\"独立尺寸步骤\">\n\t\t\t<AsamStepsForm\n\t\t\t\tsize=\"large\"\n\t\t\t\t:fields=\"[]\"\n\t\t\t\t:steps=\"[{ id: 'only', title: '本地large', keys: [] }]\"\n\t\t\t\t:model-value=\"{}\"\n\t\t\t\t:submit-action=\"async () => {}\"\n\t\t\t/>\n\t\t</section>\n\t</section>\n</template>\n<script setup lang=\"ts\">\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { nextTick, ref } from 'vue';\nimport {\n\tAsamApplicationProvider,\n\tAsamFilterPopover,\n\tAsamStepsForm,\n\tdefineAsamFields\n} from '@asam-ui/pro/components';\nimport type { AsamFlowSize } from '@asam-ui/pro/components';\nconst left = ref<InstanceType<typeof AsamFilterPopover>>();\nconst right = ref<InstanceType<typeof AsamFilterPopover>>();\nconst leftDark = ref(false);\nconst leftSize = ref<AsamFlowSize>('small');\nconst mounted = ref(true);\nconst fields = defineAsamFields([{ key: 'name', kind: 'text', label: '主题字段' }]);\nconst model = { name: '' };\nasync function openBoth() {\n\tawait nextTick();\n\tawait left.value?.open();\n\tawait right.value?.open();\n}\n</script>\n"
		},
		{
			"path": "tests/v2/form-flows/examples/DrawerExample.vue",
			"source": "<template>\n\t<AsamButton @click=\"open\" type=\"primary\">打开抽屉</AsamButton\n\t><Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t<label><AsamCheckboxItem v-model=\"loadFailure\" />模拟加载失败</label>\n\t\t\t</section></WebsiteAsamConfigProvider\n\t\t></Teleport\n\t><label><AsamCheckboxItem v-model=\"canWrite\" />允许编辑</label\n\t><label\n\t\t>保存结果<AsamSelect v-model=\"outcome\"\n\t\t\t><AsamOption value=\"success\" label=\"success\">success</AsamOption\n\t\t\t><AsamOption value=\"failure\" label=\"failure\">failure</AsamOption\n\t\t\t><AsamOption value=\"unknown\" label=\"unknown\">unknown</AsamOption></AsamSelect\n\t\t></label\n\t><AsamFormDrawer :size=\"size\" :controller=\"editor\" title=\"编辑演示资料\"\n\t\t><template #unknown-help><p>请先核实；关闭不会撤销写入。</p></template\n\t\t><template #append\n\t\t\t><label><AsamCheckboxItem v-model=\"loadFailure\" />保持加载失败</label></template\n\t\t></AsamFormDrawer\n\t><output role=\"status\">已交付 {{ saved }} 次成功结果</output>\n</template>\n<script setup lang=\"ts\">\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\n\nimport { AsamCheckboxItem, AsamSelect, AsamOption } from '@asam-ui/ui';\n\nimport type { AsamFlowSize } from '@asam-ui/pro/components';\nconst props = withDefaults(\n\tdefineProps<{ size?: AsamFlowSize; disabled?: boolean; readonly?: boolean }>(),\n\t{ size: 'default' }\n);\nimport { onBeforeUnmount, ref } from 'vue';\nimport { AsamButton, createAsamDataRuntime } from '@asam-ui/ui';\nimport {\n\tAsamFormDrawer,\n\tuseAsamEditor,\n\tcreateAsamWriteCoordinator,\n\tdefineAsamFields\n} from '@asam-ui/pro/components';\nconst saved = ref(0);\nconst loadFailure = ref(false);\nconst canWrite = ref(true);\nconst outcome = ref<'success' | 'failure' | 'unknown'>('success');\nlet sequence = 0;\nconst runtime = createAsamDataRuntime({ scope: 'flow-drawer-example' });\nconst fields = defineAsamFields([\n\t{\n\t\tkey: 'name',\n\t\tkind: 'text',\n\t\tlabel: '名称',\n\t\tmodes: { edit: { rules: [{ required: true, message: '请填写名称' }] } }\n\t}\n]);\nconst editor = useAsamEditor({\n\tfields,\n\truntime,\n\tcoordinator: createAsamWriteCoordinator(),\n\tcanWrite: () => canWrite.value && !props.disabled && !props.readonly,\n\tload: async () => {\n\t\tif (loadFailure.value) throw new Error('演示加载失败');\n\t\treturn { name: '示例资料' };\n\t},\n\tsave: async () =>\n\t\toutcome.value === 'success'\n\t\t\t? { status: 'success' }\n\t\t\t: { status: outcome.value, message: '注入演示结果' },\n\tverify: async () => ({ status: 'success' }),\n\tconfirmDiscard: async () => window.confirm('放弃本次修改？'),\n\tonSaved: () => {\n\t\tsaved.value++;\n\t}\n});\nfunction open() {\n\tvoid editor.open({ mode: 'edit', id: 1, operationId: `demo-${++sequence}` });\n}\nonBeforeUnmount(() => {\n\teditor.dispose();\n\truntime.invalidate();\n});\n</script>\n"
		},
		{
			"path": "tests/v2/form-flows/examples/FilterExample.vue",
			"source": "<template>\n\t<AsamFilterPopover\n\t\t:size=\"size\"\n\t\t:disabled=\"disabled\"\n\t\t:readonly=\"readonly\"\n\t\tref=\"filter\"\n\t\tv-model=\"applied\"\n\t\t:fields=\"fields\"\n\t\t:validate=\"validate\"\n\t\t@apply=\"query = $event\"\n\t\t><template #title><h3>筛选目录</h3></template></AsamFilterPopover\n\t><output aria-label=\"查询结果\">{{ query }}</output>\n</template>\n<script setup lang=\"ts\">\nimport type { AsamFlowSize } from '@asam-ui/pro/components';\nwithDefaults(defineProps<{ size?: AsamFlowSize; disabled?: boolean; readonly?: boolean }>(), {\n\tsize: 'default'\n});\nimport { ref } from 'vue';\nimport { AsamFilterPopover, defineAsamFields } from '@asam-ui/pro/components';\nimport type { AsamFieldModel, AsamFlowValidator } from '@asam-ui/pro/components';\nconst filter = ref<InstanceType<typeof AsamFilterPopover>>();\nconst fields = defineAsamFields([\n\t{ key: 'name', label: '名称', kind: 'text', query: (value) => value?.trim() }\n]);\nconst applied = ref<AsamFieldModel>({ name: '' });\nconst query = ref<AsamFieldModel>({});\nconst validate: AsamFlowValidator = async (model, keys, context) => {\n\tawait new Promise((resolve) => setTimeout(resolve, 30));\n\treturn context.signal.aborted || !keys.includes('name') || model.name !== '无效'\n\t\t? []\n\t\t: [{ key: 'name', message: '请输入有效名称' }];\n};\n</script>\n"
		},
		{
			"path": "tests/v2/form-flows/examples/LoginExample.vue",
			"source": "<template>\n\t<AsamLoginPage\n\t\t><template #brand>演示工作区</template\n\t\t><AsamLoginForm\n\t\t\tref=\"login\"\n\t\t\t:size=\"size\"\n\t\t\t:disabled=\"disabled\"\n\t\t\t:readonly=\"readonly\"\n\t\t\t:fields=\"fields\"\n\t\t\t:model-value=\"initial\"\n\t\t\t:authenticate=\"authenticate\"\n\t\t\t@success=\"signedIn = true\"\n\t\t\t><template #auxiliary=\"{ reset, cancel }\"\n\t\t\t\t><AsamButton native-type=\"button\" @click=\"reset\" type=\"primary\">重新填写</AsamButton\n\t\t\t\t><AsamButton native-type=\"button\" @click=\"cancel\" type=\"primary\"\n\t\t\t\t\t>取消登录</AsamButton\n\t\t\t\t><Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t\t\t<label><AsamCheckboxItem v-model=\"rejectLogin\" />模拟认证失败</label>\n\t\t\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t\t\t></Teleport\n\t\t\t\t></template\n\t\t\t></AsamLoginForm\n\t\t><template #footer\n\t\t\t><p>{{ signedIn ? '本地演示完成' : '仅本地注入，不连接身份服务' }}</p></template\n\t\t></AsamLoginPage\n\t>\n</template>\n<script setup lang=\"ts\">\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\n\nimport { AsamCheckboxItem } from '@asam-ui/ui';\n\nimport { AsamButton } from '@asam-ui/ui';\n\nimport type { AsamFlowSize } from '@asam-ui/pro/components';\nwithDefaults(defineProps<{ size?: AsamFlowSize; disabled?: boolean; readonly?: boolean }>(), {\n\tsize: 'default'\n});\nimport { ref } from 'vue';\nimport {\n\tAsamLoginForm,\n\tAsamLoginPage,\n\tdefineAsamFields,\n\tcreateAsamPasswordField\n} from '@asam-ui/pro/components';\nimport type { AsamFieldModel, AsamFlowContext, AsamLoginResult } from '@asam-ui/pro/components';\nconst login = ref<InstanceType<typeof AsamLoginForm>>();\nconst signedIn = ref(false);\nconst rejectLogin = ref(false);\nconst initial: AsamFieldModel = { account: '', password: '' };\nconst fields = defineAsamFields([\n\t{\n\t\tkey: 'account',\n\t\tlabel: '演示账号',\n\t\tkind: 'text',\n\t\tmodes: { edit: { rules: [{ required: true, message: '请填写账号' }] } }\n\t},\n\tcreateAsamPasswordField({ key: 'password', label: '演示密码' })\n]);\nasync function authenticate(\n\t_credentials: Readonly<AsamFieldModel>,\n\tcontext: AsamFlowContext\n): Promise<AsamLoginResult> {\n\tawait new Promise((resolve) => setTimeout(resolve, 50));\n\treturn { success: !context.signal.aborted && !rejectLogin.value, message: '演示认证失败' };\n}\n</script>\n"
		},
		{
			"path": "tests/v2/form-flows/examples/StepsExample.vue",
			"source": "<template>\n\t<AsamStepsForm\n\t\t:size=\"size\"\n\t\t:disabled=\"disabled\"\n\t\t:readonly=\"readonly\"\n\t\tref=\"stepsForm\"\n\t\tv-model=\"model\"\n\t\t:fields=\"fields\"\n\t\t:steps=\"steps\"\n\t\t:submit-action=\"finish\"\n\t\t@finish=\"finished = true\"\n\t/><output role=\"status\">{{ finished ? '流程已提交' : '填写中' }}</output>\n</template>\n<script setup lang=\"ts\">\nimport type { AsamFlowSize } from '@asam-ui/pro/components';\nwithDefaults(defineProps<{ size?: AsamFlowSize; disabled?: boolean; readonly?: boolean }>(), {\n\tsize: 'default'\n});\nimport { ref } from 'vue';\nimport { AsamStepsForm, defineAsamFields } from '@asam-ui/pro/components';\nimport type { AsamFieldModel, AsamFormStep, AsamFlowContext } from '@asam-ui/pro/components';\nconst stepsForm = ref<InstanceType<typeof AsamStepsForm>>();\nconst model = ref<AsamFieldModel>({ name: '', note: '' });\nconst finished = ref(false);\nconst fields = defineAsamFields([\n\t{\n\t\tkey: 'name',\n\t\tkind: 'text',\n\t\tlabel: '姓名',\n\t\tmodes: { edit: { rules: [{ required: true, message: '请填写姓名' }] } }\n\t},\n\t{ key: 'note', kind: 'textarea', label: '备注' }\n]);\nconst steps: readonly AsamFormStep[] = [\n\t{ id: 'identity', title: '身份', keys: ['name'] },\n\t{ id: 'notes', title: '备注', keys: ['note'] }\n];\nasync function finish(_payload: Readonly<AsamFieldModel>, context: AsamFlowContext) {\n\tawait new Promise((resolve) => setTimeout(resolve, 30));\n\tif (context.signal.aborted) throw new Error('操作已取消');\n}\n</script>\n"
		}
	]
}
