			"path": "tests/v2/form-schema/Example.vue",
			"source": "<template>\n\t<AsamApplicationProvider :config=\"{ colorMode: dark ? 'dark' : 'light', size }\"\n\t\t><main class=\"example\">\n\t\t\t<h1>团队申请</h1>\n\t\t\t<Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t\t<label\n\t\t\t\t\t\t\t><span>尺寸</span\n\t\t\t\t\t\t\t><AsamSelect v-model=\"size\"\n\t\t\t\t\t\t\t\t><AsamOption\n\t\t\t\t\t\t\t\t\tv-for=\"sizeOption in sizes\"\n\t\t\t\t\t\t\t\t\t:key=\"sizeOption\"\n\t\t\t\t\t\t\t\t\t:value=\"String(sizeOption).trim()\"\n\t\t\t\t\t\t\t\t\t:label=\"String(sizeOption).trim()\"\n\t\t\t\t\t\t\t\t\t>{{ sizeOption }}</AsamOption\n\t\t\t\t\t\t\t\t></AsamSelect\n\t\t\t\t\t\t\t></label\n\t\t\t\t\t\t>\n\t\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t\t></Teleport\n\t\t\t><label v-show=\"!websitePreviewControls\"\n\t\t\t\t><span\n\t\t\t\t\tv-show=\"!websitePreviewControls\"\n\t\t\t\t\tdata-preview-theme-control\n\t\t\t\t\t:data-preview-value=\"dark\"\n\t\t\t\t\tv-on=\"{ 'asam-preview-theme': websitePreviewTheme0 }\"\n\t\t\t\t\t><AsamCheckboxItem v-model=\"dark\" /></span\n\t\t\t\t>深色</label\n\t\t\t><label><AsamCheckboxItem v-model=\"readonly\" />只读</label\n\t\t\t><label><AsamCheckboxItem v-model=\"formDisabled\" />禁用</label\n\t\t\t><AsamButton @click=\"narrow = !narrow\" type=\"primary\">切换窄容器</AsamButton\n\t\t\t><AsamButton @click=\"reopen\" type=\"primary\">取消并重开</AsamButton\n\t\t\t><AsamButton @click=\"changedRequirement = !changedRequirement\" type=\"primary\">\n\t\t\t\t修改需求：姓名至少三字\n\t\t\t</AsamButton>\n\t\t\t<div :style=\"{ maxWidth: narrow ? '360px' : '1100px' }\">\n\t\t\t\t<AsamSchemaForm\n\t\t\t\t\tv-model=\"model\"\n\t\t\t\t\t:schema=\"schema\"\n\t\t\t\t\t:session=\"session\"\n\t\t\t\t\t:size=\"size\"\n\t\t\t\t\t:readonly=\"readonly\"\n\t\t\t\t\t:disabled=\"formDisabled\"\n\t\t\t\t\t@submit=\"saved = JSON.stringify($event)\"\n\t\t\t\t\t><template #actions=\"{ submit }\"\n\t\t\t\t\t\t><AsamButton @click=\"submit\" type=\"primary\"\n\t\t\t\t\t\t\t>验证并保存</AsamButton\n\t\t\t\t\t\t></template\n\t\t\t\t\t></AsamSchemaForm\n\t\t\t\t>\n\t\t\t</div>\n\t\t\t<output aria-label=\"保存结果\">{{ saved }}</output>\n\t\t</main></AsamApplicationProvider\n\t>\n</template>\n\n<script setup lang=\"ts\">\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\nfunction websitePreviewTheme0(event: CustomEvent<'light' | 'dark'>) {\n\tdark.value = event.detail === 'dark';\n}\n\nimport { AsamSelect, AsamOption, AsamCheckboxItem } from '@asam-ui/ui';\n\nimport { computed, defineComponent, h, ref } from 'vue';\nimport type { PropType } from 'vue';\nimport {\n\tAsamButton,\n\tAsamInput,\n\tasamFormControls,\n\tdefineAsamControl,\n\tdefineAsamOptions\n} from '@asam-ui/ui';\nimport type { AsamControlSize } from '@asam-ui/ui';\nimport {\n\tAsamApplicationProvider,\n\tAsamField,\n\tAsamSchemaForm,\n\tcreateAsamNestedSchema\n} from '@asam-ui/pro/components';\nimport type { AsamSchemaNode } from '@asam-ui/pro/components';\n\ndefineOptions({ name: 'FormSchemaExample' });\n\ninterface Contact {\n\tphone: string;\n\textension: string;\n}\ninterface Member {\n\tid: number;\n\tname: string;\n\tteam: string;\n\trole: string | null;\n\taliases: { id: number; value: string }[];\n}\ntype Model = { title: string; hideContact: boolean; contact: Contact; members: Member[] };\nconst baseline = (): Model => ({\n\ttitle: '示例团队',\n\thideContact: false,\n\tcontact: { phone: '', extension: '' },\n\tmembers: [{ id: 0, name: '', team: 'A', role: null, aliases: [{ id: 0, value: '别名' }] }]\n});\nconst model = ref(baseline());\nconst saved = ref('');\nconst session = ref(0);\nconst narrow = ref(false);\nconst readonly = ref(false);\nconst formDisabled = ref(false);\nconst dark = ref(false);\nconst sizes: AsamControlSize[] = ['large', 'big', 'default', 'small'];\nconst size = ref<AsamControlSize>('default');\nconst changedRequirement = ref(false);\nfunction reopen() {\n\tmodel.value = baseline();\n\tsession.value++;\n}\nconst isString = (value: unknown): value is string => typeof value === 'string';\nconst isContact = (value: unknown): value is Contact =>\n\t!!value &&\n\ttypeof value === 'object' &&\n\t'phone' in value &&\n\ttypeof value.phone === 'string' &&\n\t'extension' in value &&\n\ttypeof value.extension === 'string';\nconst ContactInput = defineComponent({\n\tprops: { modelValue: { type: Object as PropType<Contact>, required: true }, disabled: Boolean },\n\temits: { 'update:modelValue': (value: Contact) => isContact(value) },\n\tsetup(props, { emit }) {\n\t\treturn () =>\n\t\t\th('div', { class: 'contact-input' }, [\n\t\t\t\th(AsamInput, {\n\t\t\t\t\tmodelValue: props.modelValue.phone,\n\t\t\t\t\tdisabled: props.disabled,\n\t\t\t\t\t'aria-label': '电话号码',\n\t\t\t\t\tvalidateEvent: false,\n\t\t\t\t\t'onUpdate:modelValue': (value: string | number) => {\n\t\t\t\t\t\tif (typeof value === 'string')\n\t\t\t\t\t\t\temit('update:modelValue', { ...props.modelValue, phone: value });\n\t\t\t\t\t}\n\t\t\t\t}),\n\t\t\t\th(AsamInput, {\n\t\t\t\t\tmodelValue: props.modelValue.extension,\n\t\t\t\t\tdisabled: props.disabled,\n\t\t\t\t\t'aria-label': '分机号',\n\t\t\t\t\tvalidateEvent: false,\n\t\t\t\t\t'onUpdate:modelValue': (value: string | number) => {\n\t\t\t\t\t\tif (typeof value === 'string')\n\t\t\t\t\t\t\temit('update:modelValue', { ...props.modelValue, extension: value });\n\t\t\t\t\t}\n\t\t\t\t})\n\t\t\t]);\n\t}\n});\nconst ContactControl = defineAsamControl<Contact, { disabled?: boolean }>({\n\tcomponent: ContactInput,\n\temptyValue: () => ({ phone: '', extension: '' }),\n\tsourceKinds: []\n});\nconst ContactDisplay = defineComponent({\n\tprops: { value: { type: Object as PropType<Contact>, required: true } },\n\tsetup(props) {\n\t\treturn () =>\n\t\t\th(\n\t\t\t\t'strong',\n\t\t\t\t{ 'data-contact-display': '' },\n\t\t\t\t`${props.value.phone || '未填写电话'} / 分机 ${props.value.extension || '未填写'}`\n\t\t\t);\n\t}\n});\n// 将已验 AsamField 通过公开注册入口接入嵌套层，复用其字段输入协议。\nconst MemberNameControl = defineAsamControl<string, { disabled?: boolean; active?: boolean }>({\n\tcomponent: defineComponent({\n\t\tinheritAttrs: false,\n\t\tprops: {\n\t\t\tmodelValue: { type: String, default: '' },\n\t\t\tdisabled: Boolean,\n\t\t\tactive: { type: Boolean, default: true }\n\t\t},\n\t\temits: { 'update:modelValue': isString },\n\t\tsetup(props, { attrs, emit }) {\n\t\t\treturn () =>\n\t\t\t\th(AsamField, {\n\t\t\t\t\t...attrs,\n\t\t\t\t\tfield: { key: 'name', label: '成员姓名', kind: 'text' },\n\t\t\t\t\tmodelValue: props.modelValue,\n\t\t\t\t\tdisabled: props.disabled,\n\t\t\t\t\tactive: props.active,\n\t\t\t\t\t'onUpdate:modelValue': (value: unknown) => {\n\t\t\t\t\t\tif (isString(value)) emit('update:modelValue', value);\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t}\n\t}),\n\temptyValue: () => '',\n\tsourceKinds: []\n});\nconst root = createAsamNestedSchema<Model>();\nconst member = createAsamNestedSchema<Member>();\nconst alias = createAsamNestedSchema<{ id: number; value: string }>();\nlet nextKey = 1;\nconst options = defineAsamOptions<string, { value: string; label: string }>();\nconst schema = computed<readonly AsamSchemaNode[]>(() => [\n\t{\n\t\tkind: 'group',\n\t\tid: 'base',\n\t\tlabel: '基本资料',\n\t\tcollapsible: true,\n\t\tcollapsed: true,\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tkind: 'grid',\n\t\t\t\tid: 'base-grid',\n\t\t\t\tcolumns: 2,\n\t\t\t\tchildren: [\n\t\t\t\t\troot.field({\n\t\t\t\t\t\tid: 'title',\n\t\t\t\t\t\tpath: ['title'],\n\t\t\t\t\t\tlabel: '申请标题',\n\t\t\t\t\t\tcontrol: asamFormControls.Input,\n\t\t\t\t\t\tcomponentProps: {},\n\t\t\t\t\t\tisValue: isString,\n\t\t\t\t\t\tinput: (value) => value,\n\t\t\t\t\t\toutput: (value) => value,\n\t\t\t\t\t\tclearValue: () => '',\n\t\t\t\t\t\tformat: (value) => value,\n\t\t\t\t\t\trules: [{ required: true, message: '请填写申请标题' }]\n\t\t\t\t\t}),\n\t\t\t\t\troot.field({\n\t\t\t\t\t\tid: 'hide-contact',\n\t\t\t\t\t\tpath: ['hideContact'],\n\t\t\t\t\t\tlabel: '暂不填写电话',\n\t\t\t\t\t\tcontrol: asamFormControls.Switch,\n\t\t\t\t\t\tcomponentProps: {},\n\t\t\t\t\t\tisValue: (value): value is boolean => typeof value === 'boolean',\n\t\t\t\t\t\tinput: (value) => value,\n\t\t\t\t\t\toutput: (value) => value,\n\t\t\t\t\t\tclearValue: () => false,\n\t\t\t\t\t\tformat: (value) => (value ? '是' : '否')\n\t\t\t\t\t})\n\t\t\t\t]\n\t\t\t},\n\t\t\troot.field({\n\t\t\t\tid: 'contact',\n\t\t\t\tpath: ['contact'],\n\t\t\t\tlabel: '电话及分机（组合字段）',\n\t\t\t\tcontrol: ContactControl,\n\t\t\t\tdisplay: ContactDisplay,\n\t\t\t\tcomponentProps: {},\n\t\t\t\tisValue: isContact,\n\t\t\t\tinput: (value) => value,\n\t\t\t\toutput: (value) => value,\n\t\t\t\tclearValue: () => ({ phone: '', extension: '' }),\n\t\t\t\tformat: (value) => `${value.phone} 转 ${value.extension}`,\n\t\t\t\tdependsOn: [{ id: 'hide-contact', scope: 'root' }],\n\t\t\t\thidden: (context) => context.get({ id: 'hide-contact', scope: 'root' }) === true,\n\t\t\t\tvalidate: (value) =>\n\t\t\t\t\t!isContact(value) || !value.phone || !value.extension\n\t\t\t\t\t\t? '电话和分机须完整填写'\n\t\t\t\t\t\t: undefined\n\t\t\t})\n\t\t]\n\t},\n\t{\n\t\tkind: 'array',\n\t\tid: 'members',\n\t\tpath: ['members'],\n\t\trowKey: ['id'],\n\t\tlabel: '团队成员',\n\t\tmin: 1,\n\t\tmax: 5,\n\t\tcreateRow: () => ({ id: nextKey++, name: '', team: 'A', role: null, aliases: [] }),\n\t\tchildren: [\n\t\t\t{\n\t\t\t\tkind: 'grid',\n\t\t\t\tid: 'member-grid',\n\t\t\t\tcolumns: 2,\n\t\t\t\tchildren: [\n\t\t\t\t\tmember.field({\n\t\t\t\t\t\tid: 'name',\n\t\t\t\t\t\tpath: ['name'],\n\t\t\t\t\t\tlabel: '成员姓名',\n\t\t\t\t\t\tcontrol: MemberNameControl,\n\t\t\t\t\t\tcomponentProps: {},\n\t\t\t\t\t\tisValue: isString,\n\t\t\t\t\t\tinput: (value) => value,\n\t\t\t\t\t\toutput: (value) => value,\n\t\t\t\t\t\tclearValue: () => '',\n\t\t\t\t\t\tformat: (value) => value,\n\t\t\t\t\t\trules: [\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\trequired: true,\n\t\t\t\t\t\t\t\tmin: changedRequirement.value ? 3 : 1,\n\t\t\t\t\t\t\t\tmessage: changedRequirement.value ? '姓名至少三字' : '请填写姓名'\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t]\n\t\t\t\t\t}),\n\t\t\t\t\tmember.field({\n\t\t\t\t\t\tid: 'team',\n\t\t\t\t\t\tpath: ['team'],\n\t\t\t\t\t\tlabel: '团队（输入 slow 可观察晚到隔离）',\n\t\t\t\t\t\tcontrol: asamFormControls.Input,\n\t\t\t\t\t\tcomponentProps: {},\n\t\t\t\t\t\tisValue: isString,\n\t\t\t\t\t\tinput: (value) => value,\n\t\t\t\t\t\toutput: (value) => value,\n\t\t\t\t\t\tclearValue: () => '',\n\t\t\t\t\t\tformat: (value) => value\n\t\t\t\t\t}),\n\t\t\t\t\tmember.field({\n\t\t\t\t\t\tid: 'role',\n\t\t\t\t\t\tpath: ['role'],\n\t\t\t\t\t\tlabel: '角色',\n\t\t\t\t\t\tcontrol: asamFormControls.RemoteSelectString,\n\t\t\t\t\t\tcomponentProps: { teleported: false },\n\t\t\t\t\t\tisValue: (value): value is string | null =>\n\t\t\t\t\t\t\tvalue === null || typeof value === 'string',\n\t\t\t\t\t\tinput: (value) => value,\n\t\t\t\t\t\toutput: (value) => value,\n\t\t\t\t\t\tclearValue: () => null,\n\t\t\t\t\t\tformat: (value) => value ?? '未选',\n\t\t\t\t\t\tdependsOn: [{ id: 'team' }],\n\t\t\t\t\t\tresolveDataSource: (context) => {\n\t\t\t\t\t\t\tconst team = String(context.get({ id: 'team' }));\n\t\t\t\t\t\t\treturn options.api({\n\t\t\t\t\t\t\t\tapi: async () => {\n\t\t\t\t\t\t\t\t\tawait new Promise((resolve) =>\n\t\t\t\t\t\t\t\t\t\tsetTimeout(resolve, team === 'slow' ? 800 : 30)\n\t\t\t\t\t\t\t\t\t);\n\t\t\t\t\t\t\t\t\tif (team === 'error') throw new Error('模拟可恢复错误');\n\t\t\t\t\t\t\t\t\treturn team === 'empty'\n\t\t\t\t\t\t\t\t\t\t? []\n\t\t\t\t\t\t\t\t\t\t: [{ value: team, label: `${team} 负责人` }];\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\tparams: {},\n\t\t\t\t\t\t\t\ttransform: (response) => response,\n\t\t\t\t\t\t\t\tfieldNames: { value: 'value', label: 'label' }\n\t\t\t\t\t\t\t});\n\t\t\t\t\t\t}\n\t\t\t\t\t})\n\t\t\t\t]\n\t\t\t},\n\t\t\t{\n\t\t\t\tkind: 'array',\n\t\t\t\tid: 'aliases',\n\t\t\t\tpath: ['aliases'],\n\t\t\t\trowKey: ['id'],\n\t\t\t\tlabel: '成员别名',\n\t\t\t\tcreateRow: () => ({ id: nextKey++, value: '' }),\n\t\t\t\tchildren: [\n\t\t\t\t\talias.field({\n\t\t\t\t\t\tid: 'alias',\n\t\t\t\t\t\tpath: ['value'],\n\t\t\t\t\t\tlabel: '别名',\n\t\t\t\t\t\tcontrol: asamFormControls.Input,\n\t\t\t\t\t\tcomponentProps: {},\n\t\t\t\t\t\tisValue: isString,\n\t\t\t\t\t\tinput: (value) => value,\n\t\t\t\t\t\toutput: (value) => value,\n\t\t\t\t\t\tclearValue: () => '',\n\t\t\t\t\t\tformat: (value) => value,\n\t\t\t\t\t\trules: [{ required: true, message: '请填写别名' }]\n\t\t\t\t\t})\n\t\t\t\t]\n\t\t\t}\n\t\t]\n\t}\n]);\n</script>\n\n<style scoped>\n.example {\n\tpadding: 24px;\n\tbackground: var(--el-bg-color);\n\tcolor: var(--el-text-color-primary);\n}\n\n.contact-input {\n\tdisplay: flex;\n\tflex-wrap: wrap;\n\tgap: 8px;\n}\n</style>\n"
		}
	]
}
