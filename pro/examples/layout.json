	"schemaVersion": 1,
	"entry": "tests/v2/layout/Example.vue",
	"bootstrap": "tests/v2/layout/Example.vue",
	"files": [
		{
			"path": "tests/v2/layout/DensityProbe.vue",
			"source": "<template>\n\t<section data-density-probe style=\"height: 360px; max-width: 640px\">\n\t\t<AsamButton\n\t\t\t@click=\"density = density === 'compact' ? 'spacious' : 'compact'\"\n\t\t\ttype=\"primary\"\n\t\t>\n\t\t\t切换父级密度 </AsamButton\n\t\t><AsamAdminLayout :settings=\"{ density }\"\n\t\t\t><AsamContentGrid data-explicit-density density=\"comfortable\"\n\t\t\t\t><span>显式适中 A</span><span>显式适中 B</span></AsamContentGrid\n\t\t\t><AsamContentGrid data-inherited-density\n\t\t\t\t><span>继承父级 A</span><span>继承父级 B</span></AsamContentGrid\n\t\t\t>\n\t\t\t<div data-nested-layout style=\"height: 100px\">\n\t\t\t\t<AsamAdminLayout>嵌套默认布局</AsamAdminLayout>\n\t\t\t</div></AsamAdminLayout\n\t\t>\n\t</section>\n</template>\n<script setup lang=\"ts\">\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { ref } from 'vue';\nimport { AsamAdminLayout, AsamContentGrid } from '@asam-ui/pro/components';\nimport type { AsamLayoutDensity } from '@asam-ui/pro/components';\nconst density = ref<AsamLayoutDensity>('compact');\n</script>\n"
		},
		{
			"path": "tests/v2/layout/Example.vue",
			"source": "<template>\n\t<div class=\"demo\" :class=\"{ dark }\" :style=\"{ width: `${width}px` }\">\n\t\t<AsamAdminLayout v-model:settings=\"settings\" :size=\"size\" @state-change=\"state = $event\"\n\t\t\t><template #header\n\t\t\t\t><strong>项目工作台</strong\n\t\t\t\t><AsamButton @click=\"open = true\" type=\"primary\">设置</AsamButton></template\n\t\t\t><template #navigation><a href=\"#content-input\">内容</a></template\n\t\t\t><template #sidebar\n\t\t\t\t><nav>\n\t\t\t\t\t<a href=\"#content-input\">项目概览</a>\n\t\t\t\t\t<p>应用注入导航</p>\n\t\t\t\t</nav></template\n\t\t\t><AsamPageContainer\n\t\t\t\ttitle=\"项目概览\"\n\t\t\t\tdescription=\"页面标题、导航与操作区\"\n\t\t\t\t:status=\"status\"\n\t\t\t\t@retry=\"status = 'ready'\"\n\t\t\t\t><template #navigation><a href=\"#\">首页</a> / 项目</template\n\t\t\t\t><template #actions\n\t\t\t\t\t><AsamButton @click=\"saved++\" type=\"primary\">新建</AsamButton></template\n\t\t\t\t><label>项目名称<AsamInput id=\"content-input\" v-model=\"name\" /></label\n\t\t\t\t><AsamContentGrid :columns=\"3\" :density=\"settings.density\"\n\t\t\t\t\t><article v-for=\"n in 6\" :key=\"n\">\n\t\t\t\t\t\t内容 {{ n }}\n\t\t\t\t\t\t<p>可换行的说明和详情</p>\n\t\t\t\t\t</article></AsamContentGrid\n\t\t\t\t>\n\t\t\t\t<div class=\"long-content\">\n\t\t\t\t\t<label>末尾字段<AsamInput v-model=\"end\" /></label>\n\t\t\t\t</div>\n\t\t\t\t<AsamActionBar :fixed=\"settings.fixedActions\"\n\t\t\t\t\t><AsamButton @click=\"saved++\" type=\"primary\">保存 {{ saved }}</AsamButton\n\t\t\t\t\t><AsamButton @click=\"status = 'error'\" type=\"primary\"\n\t\t\t\t\t\t>模拟错误</AsamButton\n\t\t\t\t\t></AsamActionBar\n\t\t\t\t></AsamPageContainer\n\t\t\t><template #footer\n\t\t\t\t><AsamFooter label=\"全局页脚\">\n\t\t\t\t\tASAM UI · <a href=\"#content-input\">帮助</a></AsamFooter\n\t\t\t\t></template\n\t\t\t></AsamAdminLayout\n\t\t><AsamLayoutSettings\n\t\t\tv-model=\"settings\"\n\t\t\tv-model:open=\"open\"\n\t\t\t:live=\"live\"\n\t\t\t@preview=\"preview = $event\"\n\t\t/>\n\t</div>\n\t<Probe /><DensityProbe /><ReentryProbe /><Teleport\n\t\tto=\"#preview-settings-extra\"\n\t\t:disabled=\"!websitePreviewControls\"\n\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t<div class=\"demo-controls\">\n\t\t\t\t\t<label>宽度<AsamInputNumber v-model.number=\"width\" /></label\n\t\t\t\t\t><label\n\t\t\t\t\t\t>尺寸<AsamSelect v-model=\"size\" aria-label=\"尺寸\"\n\t\t\t\t\t\t\t><AsamOption\n\t\t\t\t\t\t\t\tv-for=\"s in ['large', 'big', 'default', 'small']\"\n\t\t\t\t\t\t\t\t:key=\"s\"\n\t\t\t\t\t\t\t\t:value=\"String(s).trim()\"\n\t\t\t\t\t\t\t\t:label=\"String(s).trim()\"\n\t\t\t\t\t\t\t\t>{{ s }}</AsamOption\n\t\t\t\t\t\t\t></AsamSelect\n\t\t\t\t\t\t></label\n\t\t\t\t\t><label v-show=\"!websitePreviewControls\"\n\t\t\t\t\t\t><span\n\t\t\t\t\t\t\tv-show=\"!websitePreviewControls\"\n\t\t\t\t\t\t\tdata-preview-theme-control\n\t\t\t\t\t\t\t:data-preview-value=\"dark\"\n\t\t\t\t\t\t\tv-on=\"{ 'asam-preview-theme': websitePreviewTheme0 }\"\n\t\t\t\t\t\t\t><AsamCheckboxItem v-model=\"dark\" border /></span\n\t\t\t\t\t\t>暗色</label\n\t\t\t\t\t><AsamCheckboxItem v-model=\"live\" border>实时应用</AsamCheckboxItem>\n\t\t\t\t\t<div class=\"preview-choice-field\">\n\t\t\t\t\t\t<span>页面状态</span\n\t\t\t\t\t\t><WebsiteAsamRadioGroup\n\t\t\t\t\t\t\tv-model=\"status\"\n\t\t\t\t\t\t\taria-label=\"页面状态\"\n\t\t\t\t\t\t\tclass=\"preview-choice-grid\"\n\t\t\t\t\t\t\t><WebsiteAsamRadioItem\n\t\t\t\t\t\t\t\tv-for=\"s in ['ready', 'loading', 'empty', 'error']\"\n\t\t\t\t\t\t\t\t:key=\"s\"\n\t\t\t\t\t\t\t\t:value=\"String(s).trim()\"\n\t\t\t\t\t\t\t\tborder\n\t\t\t\t\t\t\t\t>{{ String(s).trim() }}</WebsiteAsamRadioItem\n\t\t\t\t\t\t\t></WebsiteAsamRadioGroup\n\t\t\t\t\t\t>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</section></WebsiteAsamConfigProvider\n\t\t></Teleport\n\t>\n</template>\n<script setup lang=\"ts\">\nimport {\n\tAsamRadioGroup as WebsiteAsamRadioGroup,\n\tAsamRadioItem as WebsiteAsamRadioItem,\n\tAsamConfigProvider as WebsiteAsamConfigProvider\n} from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\nfunction websitePreviewTheme0(event: CustomEvent<'light' | 'dark'>) {\n\tdark.value = event.detail === 'dark';\n}\n\nimport { AsamInput, AsamInputNumber, AsamSelect, AsamOption, AsamCheckboxItem } from '@asam-ui/ui';\n\nimport { ref, watch, onBeforeUnmount } from 'vue';\nimport Probe from './Probe.vue';\nimport DensityProbe from './DensityProbe.vue';\nimport ReentryProbe from './ReentryProbe.vue';\nimport {\n\tAsamAdminLayout,\n\tAsamPageContainer,\n\tAsamFooter,\n\tAsamActionBar,\n\tAsamContentGrid,\n\tAsamLayoutSettings,\n\tresolveAsamLayoutSettings\n} from '@asam-ui/pro/components';\nimport type { AsamLayoutState, AsamPageContainerProps } from '@asam-ui/pro/components';\nimport type { AsamControlSize } from '@asam-ui/ui';\nimport { AsamButton } from '@asam-ui/ui';\nimport { applyAsamTheme, createAsamTheme, defaultAsamTheme } from '@asam-ui/ui';\nconst settings = ref(resolveAsamLayoutSettings());\nconst preview = ref(resolveAsamLayoutSettings());\nconst state = ref<AsamLayoutState>();\nconst status = ref<AsamPageContainerProps['status']>('ready');\nconst open = ref(false),\n\tlive = ref(false),\n\tdark = ref(false);\nconst width = ref(1280),\n\tsize = ref<AsamControlSize>('default');\nconst name = ref(''),\n\tend = ref(''),\n\tsaved = ref(0);\nconst previousRootStyle = document.documentElement.getAttribute('style');\nwatch(\n\tdark,\n\t(value) =>\n\t\tapplyAsamTheme(\n\t\t\tvalue\n\t\t\t\t? createAsamTheme({\n\t\t\t\t\t\tcolor: {\n\t\t\t\t\t\t\tsurface: '#20242d',\n\t\t\t\t\t\t\tsurfacePage: '#161a22',\n\t\t\t\t\t\t\tsurfaceMuted: '#292f3b',\n\t\t\t\t\t\t\ttextPrimary: '#f1f3f7',\n\t\t\t\t\t\t\ttextRegular: '#d4d9e2',\n\t\t\t\t\t\t\ttextSecondary: '#b7bfcc',\n\t\t\t\t\t\t\tborder: '#414b5e',\n\t\t\t\t\t\t\tdivider: '#414b5e'\n\t\t\t\t\t\t}\n\t\t\t\t\t})\n\t\t\t\t: defaultAsamTheme\n\t\t),\n\t{ immediate: true }\n);\nonBeforeUnmount(() => {\n\tif (previousRootStyle === null) document.documentElement.removeAttribute('style');\n\telse document.documentElement.setAttribute('style', previousRootStyle);\n});\n</script>\n<style>\nbody {\n\tmargin: 0;\n\tfont-family: sans-serif;\n}\n.demo {\n\tmax-width: 100%;\n\theight: 680px;\n}\n.demo article {\n\tpadding: 16px;\n\tborder: 1px solid var(--el-border-color);\n\tbackground: var(--el-bg-color);\n}\n.long-content {\n\theight: 800px;\n\tdisplay: flex;\n\talign-items: end;\n}\n.demo-controls {\n\tdisplay: grid;\n\tgap: 12px;\n\tpadding: 16px;\n}\nbutton:not([class*='el-']),\ninput:not([class*='el-']),\nselect:not([class*='el-']) {\n\tfont: inherit;\n\tmin-height: 32px;\n}\noutput {\n\toverflow-wrap: anywhere;\n}\n</style>\n"
		},
		{
			"path": "tests/v2/layout/Probe.vue",
			"source": "<template>\n\t<section data-probe>\n\t\t<AsamButton @click=\"mounted = !mounted\" type=\"primary\">切换隔离实例</AsamButton\n\t\t><AsamButton @click=\"open = true\" type=\"primary\">隔离设置</AsamButton\n\t\t><AsamButton\n\t\t\t@click=\"other = resolveAsamLayoutSettings({ density: 'spacious' })\"\n\t\t\ttype=\"primary\"\n\t\t>\n\t\t\t外部覆盖 </AsamButton\n\t\t><label><AsamCheckboxItem v-model=\"readonly\" />隔离只读</label\n\t\t><label><AsamCheckboxItem v-model=\"disabled\" />隔离禁用</label>\n\t\t<div\n\t\t\tv-if=\"mounted\"\n\t\t\tdata-observed-probe\n\t\t\tstyle=\"height: 180px; width: 400px; max-width: 100%\"\n\t\t>\n\t\t\t<AsamAdminLayout :settings=\"other\" :readonly=\"readonly\" :disabled=\"disabled\"\n\t\t\t\t><template #sidebar>独立侧栏</template\n\t\t\t\t><AsamInput aria-label=\"隔离输入\" /><AsamActionBar>\n\t\t\t\t\t独立操作\n\t\t\t\t</AsamActionBar></AsamAdminLayout\n\t\t\t>\n\t\t</div>\n\t\t<AsamLayoutSettings\n\t\t\tv-model=\"other\"\n\t\t\tv-model:open=\"open\"\n\t\t\t:readonly=\"readonly\"\n\t\t\t:disabled=\"disabled\"\n\t\t\t:live=\"true\"\n\t\t\tlabel=\"隔离设置\"\n\t\t/>\n\t</section>\n</template>\n<script setup lang=\"ts\">\nimport { AsamCheckboxItem, AsamInput } from '@asam-ui/ui';\n\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { ref } from 'vue';\nimport {\n\tAsamAdminLayout,\n\tAsamActionBar,\n\tAsamLayoutSettings,\n\tresolveAsamLayoutSettings\n} from '@asam-ui/pro/components';\nconst mounted = ref(true),\n\topen = ref(false),\n\treadonly = ref(false),\n\tdisabled = ref(false);\nconst other = ref(resolveAsamLayoutSettings());\n</script>\n"
		},
		{
			"path": "tests/v2/layout/ReentryProbe.vue",
			"source": "<template>\n\t<section data-reentry-probe>\n\t\t<label\n\t\t\t><span>回调模式</span\n\t\t\t><AsamSelect v-model=\"mode\" aria-label=\"回调模式\"\n\t\t\t\t><AsamOption label=\"更新并关闭\" value=\"update-close\">更新并关闭</AsamOption\n\t\t\t\t><AsamOption label=\"仅更新\" value=\"update\">仅更新</AsamOption\n\t\t\t\t><AsamOption label=\"预览中取消\" value=\"cancel\">预览中取消</AsamOption\n\t\t\t\t><AsamOption label=\"取消中更新\" value=\"cancel-callback\"\n\t\t\t\t\t>取消中更新</AsamOption\n\t\t\t\t></AsamSelect\n\t\t\t></label\n\t\t><AsamButton @click=\"start\" type=\"primary\">重入测试</AsamButton\n\t\t><AsamLayoutSettings\n\t\t\tref=\"panel\"\n\t\t\t:model-value=\"model\"\n\t\t\t:open=\"open\"\n\t\t\t:live=\"true\"\n\t\t\tlabel=\"回调设置\"\n\t\t\t@update:model-value=\"updated\"\n\t\t\t@update:open=\"open = $event\"\n\t\t\t@preview=\"preview\"\n\t\t\t@cancel=\"cancelled\"\n\t\t/>\n\t</section>\n</template>\n<script setup lang=\"ts\">\nimport { AsamSelect, AsamOption } from '@asam-ui/ui';\n\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { ref } from 'vue';\nimport { AsamLayoutSettings, resolveAsamLayoutSettings } from '@asam-ui/pro/components';\nimport type {\n\tAsamLayoutSettingsExpose,\n\tAsamLayoutSettingsValue as Settings\n} from '@asam-ui/pro/components';\nconst mode = ref('update-close'),\n\topen = ref(false);\nconst model = ref(resolveAsamLayoutSettings());\nconst updates = ref<string[]>([]);\nconst panel = ref<AsamLayoutSettingsExpose>();\nfunction start() {\n\tmodel.value = resolveAsamLayoutSettings();\n\tupdates.value = [];\n\topen.value = true;\n}\nfunction updated(value: Settings) {\n\tupdates.value.push(value.density);\n\tmodel.value = value;\n}\nfunction preview(value: Settings) {\n\tif (value.density !== 'compact' || mode.value === 'cancel-callback') return;\n\tif (mode.value === 'cancel') {\n\t\tpanel.value?.cancel();\n\t\treturn;\n\t}\n\tmodel.value = resolveAsamLayoutSettings({ density: 'spacious' });\n\tif (mode.value === 'update-close') open.value = false;\n}\nfunction cancelled() {\n\tif (mode.value === 'cancel' || mode.value === 'cancel-callback') {\n\t\tmodel.value = resolveAsamLayoutSettings({ density: 'spacious' });\n\t\topen.value = false;\n\t}\n}\n</script>\n"
		}
	]
}
