			"path": "tests/v2/editors/EditorsExample.vue",
			"source": "<template>\n\t<AsamApplicationProvider :config=\"{ colorMode: dark ? 'dark' : 'light', size }\"\n\t\t><main>\n\t\t\t<h1>内容字段编辑与保存</h1>\n\t\t\t<AsamButton native-type=\"button\" @click=\"dark = !dark\" type=\"primary\">明暗</AsamButton\n\t\t\t><AsamButton\n\t\t\t\tnative-type=\"button\"\n\t\t\t\t@click=\"mode = mode === 'detail' ? 'edit' : 'detail'\"\n\t\t\t\ttype=\"primary\"\n\t\t\t>\n\t\t\t\t编辑/详情 </AsamButton\n\t\t\t><label\n\t\t\t\t>字段模式<AsamSelect v-model=\"mode\" aria-label=\"字段模式\"\n\t\t\t\t\t><AsamOption value=\"edit\" label=\"edit\">edit</AsamOption\n\t\t\t\t\t><AsamOption value=\"detail\" label=\"detail\">detail</AsamOption\n\t\t\t\t\t><AsamOption value=\"query\" label=\"query\">query</AsamOption></AsamSelect\n\t\t\t\t></label\n\t\t\t><AsamButton\n\t\t\t\tnative-type=\"button\"\n\t\t\t\t@click=\"\n\t\t\t\t\tsession++;\n\t\t\t\t\tmodel = createAsamFieldModel(fields, saved, 'edit');\n\t\t\t\t\"\n\t\t\t\ttype=\"primary\"\n\t\t\t>\n\t\t\t\t保存后重载/新会话 </AsamButton\n\t\t\t><Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t\t<label\n\t\t\t\t\t\t\t>尺寸<AsamSelect v-model=\"size\" aria-label=\"尺寸\"\n\t\t\t\t\t\t\t\t><AsamOption value=\"small\" label=\"small\">small</AsamOption\n\t\t\t\t\t\t\t\t><AsamOption value=\"default\" label=\"default\">default</AsamOption\n\t\t\t\t\t\t\t\t><AsamOption value=\"big\" label=\"big\">big</AsamOption\n\t\t\t\t\t\t\t\t><AsamOption value=\"large\" label=\"large\"\n\t\t\t\t\t\t\t\t\t>large</AsamOption\n\t\t\t\t\t\t\t\t></AsamSelect\n\t\t\t\t\t\t\t></label\n\t\t\t\t\t\t>\n\t\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t\t></Teleport\n\t\t\t><AsamForm\n\t\t\t\tref=\"form\"\n\t\t\t\tv-model=\"model\"\n\t\t\t\t:schema=\"binding.schema\"\n\t\t\t\t:registry=\"binding.registry\"\n\t\t\t\t:size=\"size\"\n\t\t\t\t:inline=\"false\"\n\t\t\t\tlabel-position=\"top\"\n\t\t\t\t:show-search=\"false\"\n\t\t\t\t:show-reset=\"false\"\n\t\t\t\t><template #field-rich=\"scope\"\n\t\t\t\t\t><AsamField\n\t\t\t\t\t\t:field=\"fields[0]!\"\n\t\t\t\t\t\t:model-value=\"scope.value\"\n\t\t\t\t\t\t:mode=\"mode\"\n\t\t\t\t\t\t:session=\"session\"\n\t\t\t\t\t\t:active=\"active\"\n\t\t\t\t\t\t:size=\"size\"\n\t\t\t\t\t\t@update:model-value=\"scope.updateValue\" /></template\n\t\t\t\t><template #field-markdown=\"scope\"\n\t\t\t\t\t><AsamField\n\t\t\t\t\t\t:field=\"fields[1]!\"\n\t\t\t\t\t\t:model-value=\"scope.value\"\n\t\t\t\t\t\t:mode=\"mode\"\n\t\t\t\t\t\t:session=\"session\"\n\t\t\t\t\t\t:active=\"active\"\n\t\t\t\t\t\t:size=\"size\"\n\t\t\t\t\t\t@update:model-value=\"scope.updateValue\" /></template></AsamForm\n\t\t\t><AsamButton native-type=\"button\" @click=\"submit\" type=\"primary\">校验并保存</AsamButton\n\t\t\t><AsamButton\n\t\t\t\tnative-type=\"button\"\n\t\t\t\t@click=\"query = transformAsamFields(fields, model, 'query', ['rich', 'markdown'])\"\n\t\t\t\ttype=\"primary\"\n\t\t\t>\n\t\t\t\t生成查询原值 </AsamButton\n\t\t\t><AsamButton native-type=\"button\" @click=\"session++\" type=\"primary\"\n\t\t\t\t>同值切会话</AsamButton\n\t\t\t><AsamButton native-type=\"button\" @click=\"active = !active\" type=\"primary\"\n\t\t\t\t>切换活动</AsamButton\n\t\t\t>\n\t\t\t<p role=\"status\">{{ status }}</p>\n\t\t\t<h2>另一实例（独立会话）</h2>\n\t\t\t<AsamContentEditor\n\t\t\t\tv-model=\"other\"\n\t\t\t\tkind=\"markdown\"\n\t\t\t\tlabel=\"独立草稿\"\n\t\t\t\tsession=\"other\"\n\t\t\t\t:size=\"size\"\n\t\t\t/></main\n\t></AsamApplicationProvider>\n</template>\n\n<script setup lang=\"ts\">\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\n\nimport { AsamSelect, AsamOption } from '@asam-ui/ui';\n\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { computed, ref, shallowRef } from 'vue';\nimport { AsamForm } from '@asam-ui/ui';\nimport type { AsamControlSize, AsamFormExpose } from '@asam-ui/ui';\nimport {\n\tAsamContentEditor,\n\tAsamApplicationProvider,\n\tAsamField,\n\tcreateAsamFieldModel,\n\tcreateAsamFieldSchema,\n\tcreateAsamRichTextField,\n\tcreateAsamMarkdownField,\n\ttransformAsamFields,\n\tcloneAsamEditorValue,\n\tisEmptyAsamEditorValue\n} from '@asam-ui/pro/components';\nimport type {\n\tAsamFieldMode,\n\tAsamFieldModel,\n\tAsamResourceServices,\n\tAsamEditorFieldValue,\n\tAsamFieldTransformResult\n} from '@asam-ui/pro/components';\n\nconst dark = ref(false);\nconst size = ref<AsamControlSize>('default');\nconst mode = ref<AsamFieldMode>('edit');\nconst session = ref(1);\nconst active = ref(true);\nconst form = shallowRef<AsamFormExpose>();\nconst status = ref('');\nconst query = ref<AsamFieldTransformResult>();\n// 确定性宿主服务；不创建 objectURL，不调用真实后端，不执行远端删除。\nconst services: AsamResourceServices = {\n\tupload: ({ file, signal, progress }) =>\n\t\tnew Promise((resolve, reject) => {\n\t\t\tconst timer = setTimeout(() => {\n\t\t\t\tif (signal.aborted && !file.name.includes('late')) return;\n\t\t\t\tprogress(100);\n\t\t\t\tif (file.name.includes('fail')) reject(new Error('示例上传失败，请选择其他文件'));\n\t\t\t\telse\n\t\t\t\t\tresolve({\n\t\t\t\t\t\tid: file.name,\n\t\t\t\t\t\tname: file.name,\n\t\t\t\t\t\turl: new URL('/fixture.svg', location.origin).href,\n\t\t\t\t\t\tsize: file.size,\n\t\t\t\t\t\tmimeType: file.type\n\t\t\t\t\t});\n\t\t\t}, 800);\n\t\t\tprogress(20);\n\t\t\t// late 文件用于模拟服务忽略取消后的未知晚到；普通文件遵守 signal。\n\t\t\tif (!file.name.includes('late'))\n\t\t\t\tsignal.addEventListener(\n\t\t\t\t\t'abort',\n\t\t\t\t\t() => {\n\t\t\t\t\t\tclearTimeout(timer);\n\t\t\t\t\t\treject(new Error('已取消'));\n\t\t\t\t\t},\n\t\t\t\t\t{ once: true }\n\t\t\t\t);\n\t\t})\n};\nconst fields = [\n\tcreateAsamRichTextField({\n\t\tkey: 'rich',\n\t\tlabel: '富文本',\n\t\tservices,\n\t\tmaxLength: 20000,\n\t\tmodes: {\n\t\t\tedit: {\n\t\t\t\trules: [\n\t\t\t\t\t{\n\t\t\t\t\t\tvalidator: (_rule, value, callback) => {\n\t\t\t\t\t\t\ttry {\n\t\t\t\t\t\t\t\tcallback(\n\t\t\t\t\t\t\t\t\tisEmptyAsamEditorValue(cloneAsamEditorValue('richtext', value))\n\t\t\t\t\t\t\t\t\t\t? new Error('请输入正文')\n\t\t\t\t\t\t\t\t\t\t: undefined\n\t\t\t\t\t\t\t\t);\n\t\t\t\t\t\t\t} catch {\n\t\t\t\t\t\t\t\tcallback(new Error('正文模型无效'));\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t}\n\t\t}\n\t}),\n\tcreateAsamMarkdownField({ key: 'markdown', label: 'Markdown', services, maxLength: 20000 })\n];\nconst saved = ref<AsamFieldModel>({\n\trich: {\n\t\ttype: 'doc',\n\t\tcontent: [\n\t\t\t{ type: 'heading', attrs: { level: 2 }, content: [{ type: 'text', text: '项目说明' }] },\n\t\t\t{ type: 'paragraph', content: [{ type: 'text', text: '可编辑正文' }] }\n\t\t]\n\t},\n\tmarkdown:\n\t\t'# 标题\\n\\n**加粗** 与 _斜体_\\n\\n- 列表\\n\\n> 引用\\n\\n[链接](https://example.com)\\n\\n`行内代码`\\n\\n```js\\nconst 中文 = \"hello\";\\n```\\n\\n<script>alert(1)<\\/script>\\n\\n[恶意](javascript:alert(1))'\n});\nconst model = ref(createAsamFieldModel(fields, saved.value, 'edit'));\nconst other = ref<AsamEditorFieldValue>('另一个实例保留原文\\n未知 :::syntax');\nconst binding = computed(() => createAsamFieldSchema(fields, mode.value));\nasync function submit() {\n\ttry {\n\t\tawait form.value?.validate();\n\t\tconst result = transformAsamFields(fields, model.value, 'submit', ['rich', 'markdown']);\n\t\tif (result.status === 'error') {\n\t\t\tstatus.value = result.issues.map((issue) => issue.message).join('；');\n\t\t\treturn;\n\t\t}\n\t\tsaved.value = result.data;\n\t\tstatus.value = '已保存原始 JSON 与 Markdown';\n\t} catch {\n\t\tstatus.value = '校验未通过';\n\t}\n}\n</script>\n\n<style scoped>\nmain {\n\tmax-width: 72rem;\n\tpadding: 1rem;\n\tmargin: auto;\n\tcolor: var(--el-text-color-primary);\n\tbackground: var(--el-bg-color);\n}\npre {\n\toverflow: auto;\n\tmax-width: 100%;\n}\nbutton:not([class*='el-']),\nselect:not([class*='el-']) {\n\tmargin: 0.25rem;\n}\n</style>\n"
		}
	]
}
