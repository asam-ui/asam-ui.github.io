	"schemaVersion": 1,
	"entry": "tests/v2/numeric/Example.vue",
	"bootstrap": "tests/v2/numeric/Example.vue",
	"files": [
		{
			"path": "tests/v2/numeric/Example.vue",
			"source": "<template>\n\t<main>\n\t\t<h1>数值、区间与金额</h1>\n\t\t<p>金额输入和存储均为 CNY 分；详情格式为元。区间允许单端，查询和提交使用同一校验。</p>\n\t\t<AsamButton @click=\"disabled = !disabled\" type=\"primary\">切换禁用</AsamButton\n\t\t><AsamButton @click=\"readonly = !readonly\" type=\"primary\">切换只读</AsamButton\n\t\t><AsamButton @click=\"visible = !visible\" type=\"primary\">切换挂载</AsamButton\n\t\t><AsamButton @click=\"focus\" type=\"primary\">聚焦数量</AsamButton\n\t\t><AsamButton @click=\"reset\" type=\"primary\">重置</AsamButton\n\t\t><Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t<label\n\t\t\t\t\t\t>尺寸\n\t\t\t\t\t\t<AsamSelect v-model=\"size\" aria-label=\"尺寸\"\n\t\t\t\t\t\t\t><AsamOption\n\t\t\t\t\t\t\t\tv-for=\"item in ['small', 'default', 'big', 'large']\"\n\t\t\t\t\t\t\t\t:key=\"item\"\n\t\t\t\t\t\t\t\t:value=\"String(item).trim()\"\n\t\t\t\t\t\t\t\t:label=\"String(item).trim()\"\n\t\t\t\t\t\t\t\t>{{ item }}</AsamOption\n\t\t\t\t\t\t\t></AsamSelect\n\t\t\t\t\t\t></label\n\t\t\t\t\t>\n\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t></Teleport\n\t\t><template v-if=\"visible\"\n\t\t\t><section v-for=\"mode in ['query', 'edit', 'detail'] as const\" :key=\"mode\">\n\t\t\t\t<h2>{{ mode }}</h2>\n\t\t\t\t<AsamForm\n\t\t\t\t\tv-if=\"mode !== 'detail'\"\n\t\t\t\t\t:ref=\"mode === 'edit' ? bindForm : undefined\"\n\t\t\t\t\tv-model=\"model\"\n\t\t\t\t\t:schema=\"adapters[mode].schema\"\n\t\t\t\t\t:registry=\"adapters[mode].registry\"\n\t\t\t\t\t:disabled=\"disabled\"\n\t\t\t\t/><template v-else\n\t\t\t\t\t><p v-for=\"field in definitions\" :key=\"field.key\">\n\t\t\t\t\t\t{{ field.label }}：<AsamField\n\t\t\t\t\t\t\t:field=\"field\"\n\t\t\t\t\t\t\t:model-value=\"model[field.key]\"\n\t\t\t\t\t\t\tmode=\"detail\"\n\t\t\t\t\t\t/></p\n\t\t\t\t></template></section></template\n\t\t><AsamButton @click=\"convert('query')\" type=\"primary\">生成查询</AsamButton\n\t\t><AsamButton @click=\"submit\" type=\"primary\">校验提交</AsamButton>\n\t\t<pre aria-label=\"结果\" role=\"status\">{{ output }}</pre>\n\t</main>\n</template>\n<script setup lang=\"ts\">\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\n\nimport { AsamSelect, AsamOption } from '@asam-ui/ui';\n\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { computed, ref, shallowRef } from 'vue';\nimport type { ComponentPublicInstance } from 'vue';\nimport { AsamForm } from '@asam-ui/ui';\nimport type { AsamFormExpose, AsamControlSize } from '@asam-ui/ui';\nimport {\n\tAsamField,\n\tcreateAsamNumberField,\n\tcreateAsamNumberRangeField,\n\tcreateAsamMoneyField,\n\tcreateAsamFieldSchema,\n\ttransformAsamFields\n} from '@asam-ui/pro/components';\nimport type { AsamFieldModel } from '@asam-ui/pro/components';\nconst disabled = ref(false);\nconst readonly = ref(false);\nconst visible = ref(true);\nconst size = ref<AsamControlSize>('default');\nconst form = shallowRef<AsamFormExpose>();\nfunction bindForm(instance: Element | ComponentPublicInstance | null) {\n\tform.value = instance as unknown as AsamFormExpose;\n}\nconst definitions = computed(() => {\n\tconst modes = {\n\t\tquery: { readonly: readonly.value, componentProps: { size: size.value } },\n\t\tedit: { readonly: readonly.value, componentProps: { size: size.value } }\n\t};\n\treturn [\n\t\tcreateAsamNumberField({\n\t\t\tkey: 'count',\n\t\t\tlabel: '数量',\n\t\t\tprecision: 2,\n\t\t\tmin: 0,\n\t\t\tmax: 100,\n\t\t\tmodes\n\t\t}),\n\t\tcreateAsamNumberRangeField({ key: 'range', label: '区间', precision: 2, modes }),\n\t\tcreateAsamMoneyField({\n\t\t\tkey: 'price',\n\t\t\tlabel: '金额 CNY 分',\n\t\t\tcurrency: 'CNY',\n\t\t\tstorageUnit: 'minor',\n\t\t\tprecision: 2,\n\t\t\tmodes\n\t\t})\n\t];\n});\nconst adapters = computed(() => ({\n\tquery: createAsamFieldSchema(definitions.value, 'query'),\n\tedit: createAsamFieldSchema(definitions.value, 'edit')\n}));\nconst model = ref<AsamFieldModel>({ count: 0, range: { start: null, end: 10 }, price: 123 });\nconst output = ref('');\nfunction convert(target: 'query' | 'submit') {\n\toutput.value = JSON.stringify(\n\t\ttransformAsamFields(definitions.value, model.value, target, ['count', 'range', 'price'])\n\t);\n}\nasync function submit() {\n\ttry {\n\t\tawait form.value?.validate();\n\t\tconvert('submit');\n\t} catch {\n\t\toutput.value = '校验失败';\n\t}\n}\nfunction focus() {\n\tdocument\n\t\t.querySelector<HTMLInputElement>('[data-mode=\"edit\"][data-field=\"count\"] input')\n\t\t?.focus();\n}\nfunction reset() {\n\tmodel.value = { count: 0, range: { start: null, end: 10 }, price: 123 };\n\toutput.value = '';\n}\n</script>\n<style scoped>\nmain {\n\tmax-width: 64rem;\n\tmargin: auto;\n\tpadding: 1rem;\n\tfont-family: sans-serif;\n}\n\nsection {\n\tmargin-block: 1.5rem;\n}\n\nbutton:not([class*='el-']) {\n\tmargin: 0.25rem;\n}\n\npre {\n\twhite-space: pre-wrap;\n\toverflow-wrap: anywhere;\n}\n</style>\n"
		}
	]
}
