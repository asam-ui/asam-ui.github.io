	"files": [
		{
			"path": "tests/v2/cards/src/App.vue",
			"source": "<template>\n\t<main>\n\t\t<h1>展示组件参考示例</h1>\n\t\t<p>同一个公开入口组合内容分组、统计、数值、动画、趋势和成员说明。</p>\n\t\t<Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t<nav aria-label=\"示例操作\">\n\t\t\t\t\t\t<AsamButton @click=\"value += 100\" type=\"primary\">增加数值</AsamButton\n\t\t\t\t\t\t><AsamButton @click=\"burst\" type=\"primary\">连续更新</AsamButton\n\t\t\t\t\t\t><AsamButton\n\t\t\t\t\t\t\t@click=\"\n\t\t\t\t\t\t\t\tstatus =\n\t\t\t\t\t\t\t\t\tstatus === 'ready'\n\t\t\t\t\t\t\t\t\t\t? 'loading'\n\t\t\t\t\t\t\t\t\t\t: status === 'loading'\n\t\t\t\t\t\t\t\t\t\t\t? 'empty'\n\t\t\t\t\t\t\t\t\t\t\t: status === 'empty'\n\t\t\t\t\t\t\t\t\t\t\t\t? 'error'\n\t\t\t\t\t\t\t\t\t\t\t\t: 'ready'\n\t\t\t\t\t\t\t\"\n\t\t\t\t\t\t\ttype=\"primary\"\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t切换状态 </AsamButton\n\t\t\t\t\t\t><WebsiteAsamCheckboxItem\n\t\t\t\t\t\t\tborder\n\t\t\t\t\t\t\t:model-value=\"visible\"\n\t\t\t\t\t\t\t@update:model-value=\"visible = $event === true\"\n\t\t\t\t\t\t\t>挂载切换</WebsiteAsamCheckboxItem\n\t\t\t\t\t\t><AsamButton @click=\"max = max === 2 ? 0 : 2\" type=\"primary\"\n\t\t\t\t\t\t\t>切换溢出</AsamButton\n\t\t\t\t\t\t><AsamButton\n\t\t\t\t\t\t\t@click=\"dark = !dark\"\n\t\t\t\t\t\t\t:data-preview-color-mode=\"dark ? 'dark' : 'light'\"\n\t\t\t\t\t\t\ttype=\"primary\"\n\t\t\t\t\t\t\t>切换主题</AsamButton\n\t\t\t\t\t\t><AsamButton @click=\"number?.finish()\" type=\"primary\">立即完成</AsamButton>\n\t\t\t\t\t</nav>\n\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t></Teleport\n\t\t><AsamCardGroup label=\"指标分组\"\n\t\t\t><AsamStatisticCard\n\t\t\t\tlabel=\"示例指标\"\n\t\t\t\t:value=\"value\"\n\t\t\t\tunit=\"项\"\n\t\t\t\thelper=\"通用示例数据，非真实业务\"\n\t\t\t\t:status=\"status\"\n\t\t\t\tanimated\n\t\t\t\t:trend=\"{\n\t\t\t\t\tdirection: 'up',\n\t\t\t\t\ttone: 'positive',\n\t\t\t\t\tvalue: 12.5,\n\t\t\t\t\tsuffix: '%',\n\t\t\t\t\tprecision: 1\n\t\t\t\t}\"\n\t\t\t\t><template #extra><span>本周</span></template\n\t\t\t\t><template #footer>数据由宿主传入</template></AsamStatisticCard\n\t\t\t><AsamDisplayCard title=\"格式与缺省\" description=\"不自动换算单位\" :status=\"status\"\n\t\t\t\t><p>\n\t\t\t\t\t数值：<AsamNumberDisplay\n\t\t\t\t\t\t:value=\"12345.678\"\n\t\t\t\t\t\t:precision=\"2\"\n\t\t\t\t\t\tprefix=\"¥\"\n\t\t\t\t\t\tunit=\"元\"\n\t\t\t\t\t/>\n\t\t\t\t</p>\n\t\t\t\t<p>缺省：<AsamNumberDisplay :value=\"null\" unit=\"元\" /></p>\n\t\t\t\t<p>\n\t\t\t\t\t独立动画：<AsamCountTo\n\t\t\t\t\t\tv-if=\"visible\"\n\t\t\t\t\t\tref=\"number\"\n\t\t\t\t\t\t:value=\"value\"\n\t\t\t\t\t\t:duration=\"200\"\n\t\t\t\t\t\t@finish=\"finished++\"\n\t\t\t\t\t/>\n\t\t\t\t</p>\n\t\t\t\t<p>\n\t\t\t\t\t完成事件：<output aria-label=\"完成事件\">{{ finished }}</output>\n\t\t\t\t</p></AsamDisplayCard\n\t\t\t><AsamDisplayCard title=\"趋势与成员\" :status=\"status\"\n\t\t\t\t><p>\n\t\t\t\t\t<AsamTrend\n\t\t\t\t\t\tdirection=\"down\"\n\t\t\t\t\t\ttone=\"positive\"\n\t\t\t\t\t\t:value=\"-3\"\n\t\t\t\t\t\tunit=\"ms\"\n\t\t\t\t\t\tlabel=\"耗时下降\"\n\t\t\t\t\t/>\n\t\t\t\t</p>\n\t\t\t\t<p><AsamTrend direction=\"flat\" :value=\"0\" /></p>\n\t\t\t\t<AsamProAvatarGroup\n\t\t\t\t\tv-bind=\"{ items: members, max, status }\"\n\t\t\t\t\tlabel=\"协作成员\" /></AsamDisplayCard\n\t\t\t><AsamDisplayCard title=\"空成员与图片回退\"\n\t\t\t\t><AsamProAvatarGroup :items=\"[]\" label=\"空成员\" /><AsamProAvatarGroup\n\t\t\t\t\t:items=\"[\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tid: 1,\n\t\t\t\t\t\t\tname: '失效头像',\n\t\t\t\t\t\t\tsrc: '/missing-avatar.png',\n\t\t\t\t\t\t\tdescription: '回退姓名'\n\t\t\t\t\t\t}\n\t\t\t\t\t]\"\n\t\t\t\t\tlabel=\"图片失败\" /></AsamDisplayCard\n\t\t></AsamCardGroup>\n\t</main>\n</template>\n<script setup>\nimport {\n\tAsamCheckboxItem as WebsiteAsamCheckboxItem,\n\tAsamConfigProvider as WebsiteAsamConfigProvider\n} from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\nimport { AsamButton } from '@asam-ui/ui';\nimport { ref, watch } from 'vue';\nimport {\n\tAsamCountTo,\n\tAsamCardGroup,\n\tAsamDisplayCard,\n\tAsamNumberDisplay,\n\tAsamProAvatarGroup,\n\tAsamStatisticCard,\n\tAsamTrend\n} from '@asam-ui/pro/components';\nconst value = ref(1200);\nconst visible = ref(true);\nconst finished = ref(0);\nconst max = ref(2);\nconst dark = ref(false);\nconst number = ref();\nconst status = ref('ready');\nconst members = [\n\t{ id: 0, name: '林一', description: '设计' },\n\t{ id: 1, name: '李二', description: '开发' },\n\t{ id: 2, name: '王三', description: '测试' },\n\t{ id: 3, name: '赵四', description: '验收' }\n];\nfunction burst() {\n\tfor (let i = 0; i < 100; i++) value.value += 1;\n}\nwatch(dark, (value) => document.documentElement.classList.toggle('dark', value));\n</script>\n<style>\n/* 宿主示例同时提供ASAM语义tokens；仅切换EP的dark类不会重定义ASAM基础色。 */\nhtml.dark {\n\t--asam-color-surface: #1d1e1f;\n\t--asam-color-surface-page: #141414;\n\t--asam-color-text-primary: #e5eaf3;\n\t--asam-color-text-regular: #cfd3dc;\n\t--asam-color-text-secondary: #a3a6ad;\n}\n\nbody {\n\tmargin: 0;\n\tbackground: var(--el-bg-color-page);\n\tcolor: var(--el-text-color-primary);\n\tfont-family: sans-serif;\n}\n\nmain {\n\tpadding: 24px;\n\tmax-width: 1280px;\n\tmargin: auto;\n}\n\nnav {\n\tdisplay: flex;\n\tgap: 8px;\n\tflex-wrap: wrap;\n\tmargin-bottom: 24px;\n}\n\nbutton:not([class*='el-']) {\n\tpadding: 8px;\n}\n</style>\n"
		}
	]
}
