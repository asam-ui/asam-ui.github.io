	"schemaVersion": 1,
	"entry": "tests/v2/choice/Example.vue",
	"language": "js",
	"files": [
		{
			"path": "tests/v2/choice/Example.vue",
			"source": "<template>\n\t<main>\n\t\t<h1>偏好与卡片筛选</h1>\n\t\t<AsamButton @click=\"disabled = !disabled\" type=\"primary\">切换禁用</AsamButton\n\t\t><AsamButton @click=\"readOnly = !readOnly\" type=\"primary\">切换只读</AsamButton\n\t\t><AsamButton @click=\"hidden = !hidden\" type=\"primary\">切换隐藏</AsamButton\n\t\t><AsamButton @click=\"mounted = !mounted\" type=\"primary\">切换挂载</AsamButton\n\t\t><AsamButton @click=\"optionsMissing = !optionsMissing\" type=\"primary\">切换空选项</AsamButton\n\t\t><AsamButton\n\t\t\t@click=\"dark = !dark\"\n\t\t\t:data-preview-color-mode=\"dark ? 'dark' : 'light'\"\n\t\t\ttype=\"primary\"\n\t\t\t>切换主题</AsamButton\n\t\t><AsamButton @click=\"showForm = !showForm\" type=\"primary\">切换表单</AsamButton\n\t\t><AsamButton @click=\"groupRef?.focus()\" type=\"primary\">聚焦独立卡片</AsamButton\n\t\t><AsamButton @click=\"groupRef?.clear()\" type=\"primary\">通过ref清空独立卡片</AsamButton\n\t\t><AsamButton @click=\"model.slider = model.slider === 'bad' ? 0 : 'bad'\" type=\"primary\">\n\t\t\t切换错误恢复 </AsamButton\n\t\t><AsamButton\n\t\t\t@click=\"\n\t\t\t\tresult = transformAsamFields(\n\t\t\t\t\tfields,\n\t\t\t\t\tmodel,\n\t\t\t\t\t'submit',\n\t\t\t\t\tfields.map((field) => field.key)\n\t\t\t\t)\n\t\t\t\"\n\t\t\ttype=\"primary\"\n\t\t>\n\t\t\t转换提交 </AsamButton\n\t\t><Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t<label\n\t\t\t\t\t\t>尺寸<AsamSelect v-model=\"size\" aria-label=\"尺寸\"\n\t\t\t\t\t\t\t><AsamOption value=\"large\" label=\"large\">large</AsamOption\n\t\t\t\t\t\t\t><AsamOption value=\"big\" label=\"big\">big</AsamOption\n\t\t\t\t\t\t\t><AsamOption value=\"default\" label=\"default\">default</AsamOption\n\t\t\t\t\t\t\t><AsamOption value=\"small\" label=\"small\">small</AsamOption></AsamSelect\n\t\t\t\t\t\t></label\n\t\t\t\t\t>\n\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t></Teleport\n\t\t><label\n\t\t\t>模式<AsamSelect v-model=\"mode\" aria-label=\"模式\"\n\t\t\t\t><AsamOption value=\"query\" label=\"query\">query</AsamOption\n\t\t\t\t><AsamOption value=\"edit\" label=\"edit\">edit</AsamOption\n\t\t\t\t><AsamOption value=\"detail\" label=\"detail\">detail</AsamOption></AsamSelect\n\t\t\t></label\n\t\t>\n\t\t<section v-for=\"field in mounted ? fields : []\" :key=\"field.key\">\n\t\t\t<h2>{{ field.label }}</h2>\n\t\t\t<AsamField\n\t\t\t\tv-model=\"model[field.key]\"\n\t\t\t\t:field=\"field\"\n\t\t\t\t:mode=\"mode\"\n\t\t\t\t:disabled=\"disabled\"\n\t\t\t/>\n\t\t</section>\n\t\t<AsamChoiceGroup\n\t\t\tv-if=\"mounted\"\n\t\t\tref=\"groupRef\"\n\t\t\tv-model=\"selected\"\n\t\t\tlabel=\"独立卡片\"\n\t\t\t:options=\"options()\"\n\t\t\tmultiple\n\t\t\t:disabled=\"disabled\"\n\t\t\t:readonly=\"readOnly\"\n\t\t\t:size=\"size\"\n\t\t\t><template #content=\"{ option }\"\n\t\t\t\t><AsamButton native-type=\"button\" @click=\"message = option.label\" type=\"primary\">\n\t\t\t\t\t了解{{ option.label }}</AsamButton\n\t\t\t\t><AsamChoiceGroup\n\t\t\t\t\tv-if=\"option.value === 0\"\n\t\t\t\t\tv-model=\"nested\"\n\t\t\t\t\tlabel=\"嵌套单选\"\n\t\t\t\t\t:options=\"choices\" /></template></AsamChoiceGroup\n\t\t><output>{{ message }}</output\n\t\t><AsamChoiceCard\n\t\t\tv-model=\"subscription\"\n\t\t\tlabel=\"订阅通知\"\n\t\t\t:disabled=\"disabled\"\n\t\t\t:readonly=\"readOnly\"\n\t\t\t:size=\"size\"\n\t\t>\n\t\t\t可修改的独立卡片正文 </AsamChoiceCard\n\t\t><AsamForm\n\t\t\tv-if=\"showForm\"\n\t\t\tv-model=\"model\"\n\t\t\t:schema=\"schema.schema\"\n\t\t\t:registry=\"schema.registry\"\n\t\t\t:disabled=\"disabled\"\n\t\t/>\n\t\t<pre aria-label=\"提交结果\">{{ result }}</pre>\n\t</main>\n</template>\n\n<script setup>\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\nimport { AsamSelect, AsamOption } from '@asam-ui/ui';\nimport { AsamButton } from '@asam-ui/ui';\nimport { computed, ref, watch } from 'vue';\nimport { AsamForm, applyAsamTheme, createAsamTheme } from '@asam-ui/ui';\nimport {\n\tAsamField,\n\tAsamChoiceGroup,\n\tAsamChoiceCard,\n\tcreateAsamSwitchField,\n\tcreateAsamSliderField,\n\tcreateAsamRateField,\n\tcreateAsamColorField,\n\tcreateAsamSegmentedField,\n\tcreateAsamTagFilterField,\n\tcreateAsamCardField,\n\tcreateAsamFieldModel\n} from '@asam-ui/pro/components';\nimport { createAsamFieldSchema, transformAsamFields } from '@asam-ui/pro/components';\nconst disabled = ref(false),\n\treadOnly = ref(false),\n\thidden = ref(false),\n\tmounted = ref(true),\n\toptionsMissing = ref(false),\n\tdark = ref(false),\n\tshowForm = ref(false);\nconst size = ref('default');\nconst result = ref();\nwatch(\n\tdark,\n\t(value) =>\n\t\tapplyAsamTheme(\n\t\t\tcreateAsamTheme(\n\t\t\t\tvalue\n\t\t\t\t\t? {\n\t\t\t\t\t\t\tcolor: {\n\t\t\t\t\t\t\t\tprimary: '#85a5ff',\n\t\t\t\t\t\t\t\tprimaryHover: '#adc6ff',\n\t\t\t\t\t\t\t\tprimaryActive: '#597ef7',\n\t\t\t\t\t\t\t\tsurface: '#202530',\n\t\t\t\t\t\t\t\tsurfacePage: '#171b23',\n\t\t\t\t\t\t\t\tsurfaceMuted: '#252e3e',\n\t\t\t\t\t\t\t\tsurfaceSoft: '#252e3e',\n\t\t\t\t\t\t\t\ttextPrimary: '#f2f4f8',\n\t\t\t\t\t\t\t\ttextRegular: '#e1e7f0',\n\t\t\t\t\t\t\t\ttextSecondary: '#bdc8d8',\n\t\t\t\t\t\t\t\tborder: '#58677f'\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t: {}\n\t\t\t)\n\t\t),\n\t{ immediate: true }\n);\nconst choices = [\n\t{ value: 0, label: '零' },\n\t{ value: false, label: '否' },\n\t{ value: '', label: '空串' },\n\t{ value: 'blocked', label: '禁用', disabled: true }\n];\nconst options = () => (optionsMissing.value ? [] : choices);\nconst fields = [\n\tcreateAsamSwitchField({\n\t\tkey: 'enabled',\n\t\tlabel: '开关',\n\t\tactiveValue: 0,\n\t\tinactiveValue: '',\n\t\tdefaultValue: () => ''\n\t}),\n\tcreateAsamSliderField({\n\t\tkey: 'slider',\n\t\tlabel: '滑块',\n\t\tinputProps: { min: 0, max: 10, step: 2 }\n\t}),\n\tcreateAsamSliderField({\n\t\tkey: 'range',\n\t\tlabel: '范围滑块',\n\t\trange: true,\n\t\tdefaultValue: () => [0, 4]\n\t}),\n\tcreateAsamRateField({\n\t\tkey: 'rating',\n\t\tlabel: '评分',\n\t\tinputProps: { allowHalf: true, clearable: true }\n\t}),\n\tcreateAsamColorField({\n\t\tkey: 'color',\n\t\tlabel: '颜色',\n\t\tinputProps: { showAlpha: true, colorFormat: 'hex' }\n\t}),\n\tcreateAsamSegmentedField({ key: 'segment', label: '分段', options }),\n\tcreateAsamTagFilterField({ key: 'tags', label: '标签筛选', options, defaultValue: () => [] }),\n\tcreateAsamCardField({ key: 'card', label: '单选卡片', options }),\n\tcreateAsamCardField({\n\t\tkey: 'cards',\n\t\tlabel: '多选卡片',\n\t\toptions,\n\t\tmultiple: true,\n\t\tdefaultValue: () => []\n\t})\n].map((field) => ({\n\t...field,\n\tmodes: {\n\t\tedit: {\n\t\t\tget readonly() {\n\t\t\t\treturn readOnly.value;\n\t\t\t},\n\t\t\tget hidden() {\n\t\t\t\treturn hidden.value;\n\t\t\t},\n\t\t\tget componentProps() {\n\t\t\t\treturn { size: size.value };\n\t\t\t}\n\t\t},\n\t\tquery: {\n\t\t\tget readonly() {\n\t\t\t\treturn readOnly.value;\n\t\t\t},\n\t\t\tget hidden() {\n\t\t\t\treturn hidden.value;\n\t\t\t},\n\t\t\tget componentProps() {\n\t\t\t\treturn { size: size.value };\n\t\t\t}\n\t\t},\n\t\tdetail: {\n\t\t\tget hidden() {\n\t\t\t\treturn hidden.value;\n\t\t\t}\n\t\t}\n\t}\n}));\nconst model = ref(createAsamFieldModel(fields, {}, 'create'));\nconst schema = computed(() => createAsamFieldSchema(fields, mode.value));\nconst mode = ref('edit');\nconst selected = ref([]);\nconst nested = ref(null);\nconst message = ref('');\nconst subscription = ref(false);\nconst groupRef = ref();\n</script>\n\n<style scoped>\n:global(body) {\n\tbackground: var(--asam-color-surface-page);\n\tcolor: var(--asam-color-text-primary);\n}\nmain {\n\tmax-width: 56rem;\n\tmargin: auto;\n\tpadding: 1rem;\n}\nsection {\n\tmin-width: 0;\n\tmargin-block: 1rem;\n}\npre {\n\twhite-space: pre-wrap;\n\toverflow-wrap: anywhere;\n}\n</style>\n"
		}
	]
}
