			"path": "tests/v2/text-time/Example.vue",
			"source": "<template>\n\t<main>\n\t\t<h1>文本与时间</h1>\n\t\t<AsamButton\n\t\t\t@click=\"toggleTheme\"\n\t\t\t:data-preview-color-mode=\"dark ? 'dark' : 'light'\"\n\t\t\ttype=\"primary\"\n\t\t\t>切换主题</AsamButton\n\t\t><AsamButton @click=\"mounted = !mounted\" type=\"primary\">挂载切换</AsamButton\n\t\t><AsamButton @click=\"deadline = Date.now() + 1200\" type=\"primary\">重置倒计时</AsamButton\n\t\t><AsamButton\n\t\t\t@click=\"\n\t\t\t\treenter = true;\n\t\t\t\tfinishes = 0;\n\t\t\t\tdeadline = Date.now() + 150;\n\t\t\t\"\n\t\t\ttype=\"primary\"\n\t\t>\n\t\t\t结束回调重置 </AsamButton\n\t\t><AsamButton @click=\"clock += 10000\" type=\"primary\">时钟前进</AsamButton\n\t\t><AsamButton @click=\"clock -= 10000\" type=\"primary\">时钟回拨</AsamButton\n\t\t><AsamButton @click=\"disabled = !disabled\" type=\"primary\">禁用日历</AsamButton\n\t\t><AsamButton @click=\"readonly = !readonly\" type=\"primary\">只读日历</AsamButton\n\t\t><AsamButton @click=\"invalid = !invalid\" type=\"primary\">无效时间</AsamButton\n\t\t><label>文本<AsamTextarea v-model=\"text\" /></label\n\t\t><label>宽度<AsamSlider v-model.number=\"width\" :min=\"60\" :max=\"900\" /></label\n\t\t><label>行数<AsamInputNumber v-model.number=\"lines\" :min=\"1\" :max=\"5\" /></label\n\t\t><Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t<label\n\t\t\t\t\t\t>尺寸<AsamSelect v-model=\"size\"\n\t\t\t\t\t\t\t><AsamOption\n\t\t\t\t\t\t\t\tv-for=\"item in ['large', 'big', 'default', 'small']\"\n\t\t\t\t\t\t\t\t:key=\"item\"\n\t\t\t\t\t\t\t\t:value=\"String(item).trim()\"\n\t\t\t\t\t\t\t\t:label=\"String(item).trim()\"\n\t\t\t\t\t\t\t\t>{{ item }}</AsamOption\n\t\t\t\t\t\t\t></AsamSelect\n\t\t\t\t\t\t></label\n\t\t\t\t\t>\n\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t></Teleport\n\t\t><AsamConfigProvider :size=\"size\"\n\t\t\t><div v-if=\"mounted\" class=\"display-examples\">\n\t\t\t\t<AsamProCountdown\n\t\t\t\t\t:value=\"invalid ? NaN : deadline\"\n\t\t\t\t\t:interval=\"100\"\n\t\t\t\t\t@finish=\"onFinish\"\n\t\t\t\t/><output aria-label=\"结束次数\">{{ finishes }}</output\n\t\t\t\t><AsamRelativeTime\n\t\t\t\t\t:value=\"invalid ? null : relative\"\n\t\t\t\t\t:now=\"() => clock\"\n\t\t\t\t\t:interval=\"100\"\n\t\t\t\t\tlocale=\"en\"\n\t\t\t\t\tnumeric=\"always\"\n\t\t\t\t/>\n\t\t\t\t<div :style=\"{ width: `${width}px`, maxWidth: '100%' }\">\n\t\t\t\t\t<AsamTextEllipsis :text=\"text\" :lines=\"lines\" />\n\t\t\t\t</div>\n\t\t\t\t<AsamWordCount :text=\"text\" :max=\"10\" /><AsamProCalendar\n\t\t\t\t\tv-model=\"date\"\n\t\t\t\t\t:disabled=\"disabled\"\n\t\t\t\t\t:readonly=\"readonly\"\n\t\t\t\t\t:default-value=\"new Date(2026, 9, 17)\"\n\t\t\t\t\t><template #date-cell=\"{ data }\"\n\t\t\t\t\t\t><span :data-date=\"data.day\"\n\t\t\t\t\t\t\t>{{ Number(data.day.slice(-2))\n\t\t\t\t\t\t\t}}<abbr v-if=\"data.day.endsWith('-17')\" title=\"示例内容\">●</abbr></span\n\t\t\t\t\t\t></template\n\t\t\t\t\t></AsamProCalendar\n\t\t\t\t><output aria-label=\"所选日期\">{{ date.getDate() }}</output>\n\t\t\t</div></AsamConfigProvider\n\t\t>\n\t</main>\n</template>\n<script setup>\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\nimport { AsamTextarea, AsamSlider, AsamInputNumber, AsamSelect, AsamOption } from '@asam-ui/ui';\nimport { AsamButton } from '@asam-ui/ui';\nimport { ref } from 'vue';\nimport { AsamConfigProvider } from '@asam-ui/ui';\nimport {\n\tAsamProCountdown,\n\tAsamRelativeTime,\n\tAsamTextEllipsis,\n\tAsamWordCount,\n\tAsamProCalendar\n} from '@asam-ui/pro/components';\nconst dark = ref(false),\n\tmounted = ref(true),\n\tdisabled = ref(false),\n\treadonly = ref(false),\n\tinvalid = ref(false);\nfunction toggleTheme() {\n\tdark.value = !dark.value;\n\tdocument.documentElement.classList.toggle('dark', dark.value);\n}\nconst clock = ref(Date.now());\nconst relative = clock.value - 60000;\nconst deadline = ref(Date.now() + 1200);\nconst finishes = ref(0),\n\twidth = ref(180),\n\tlines = ref(2);\nconst reenter = ref(false);\nconst size = ref('default');\nfunction onFinish() {\n\tfinishes.value++;\n\tif (reenter.value && finishes.value === 1) deadline.value = Date.now() + 150;\n}\nconst text = ref(\n\t'这是一个用于验证多行截断、完整内容和容器尺寸变化的示例文本。👨‍👩‍👧‍👦 é 触屏与键盘均可以展开全文。'\n);\nconst date = ref(new Date(2026, 9, 17));\n</script>\n<style>\nbody {\n\tmargin: 0;\n\tfont-family: sans-serif;\n}\nmain {\n\tpadding: 24px;\n\tcolor: var(--el-text-color-primary);\n\tbackground: var(--el-bg-color);\n\tmin-height: 100%;\n}\nbutton:not([class*='el-']) {\n\tmargin: 4px;\n}\ntextarea:not([class*='el-']) {\n\tdisplay: block;\n\twidth: min(500px, 90%);\n}\n.display-examples {\n\tdisplay: grid;\n\tgap: 16px;\n\tmargin-top: 16px;\n}\n.asam-pro-calendar {\n\tmax-width: 800px;\n}\n</style>\n"
		}
	]
