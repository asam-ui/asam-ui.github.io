	"entry": "tests/v2/table-transfer/Example.vue",
	"bootstrap": "tests/v2/table-transfer/Example.vue",
	"files": [
		{
			"path": "tests/v2/table-transfer/Example.vue",
			"source": "<template>\n\t<main :data-ready=\"list.resultReady.value\">\n\t\t<header>\n\t\t\t<h1>资料交换工作台</h1>\n\t\t\t<p>\n\t\t\t\t合成数据，可替换字段与宿主服务。当前 {{ list.page.data.value.list.length }} / 全量\n\t\t\t\t{{ records.length }} 行。\n\t\t\t</p>\n\t\t</header>\n\t\t<section aria-label=\"宿主配置\" class=\"host-controls\">\n\t\t\t<Teleport to=\"#preview-settings-extra\" :disabled=\"!websitePreviewControls\"\n\t\t\t\t><WebsiteAsamConfigProvider size=\"default\"\n\t\t\t\t\t><section class=\"preview-control-group\">\n\t\t\t\t\t\t<label\n\t\t\t\t\t\t\t>控件尺寸<AsamSelect v-model=\"size\"\n\t\t\t\t\t\t\t\t><AsamOption label=\"40\" value=\"large\">40</AsamOption\n\t\t\t\t\t\t\t\t><AsamOption label=\"36\" value=\"big\">36</AsamOption\n\t\t\t\t\t\t\t\t><AsamOption label=\"32\" value=\"default\">32</AsamOption\n\t\t\t\t\t\t\t\t><AsamOption label=\"28\" value=\"small\">28</AsamOption></AsamSelect\n\t\t\t\t\t\t\t></label\n\t\t\t\t\t\t>\n\t\t\t\t\t</section></WebsiteAsamConfigProvider\n\t\t\t\t></Teleport\n\t\t\t><label><AsamCheckboxItem v-model=\"disabled\" />禁用</label\n\t\t\t><label><AsamCheckboxItem v-model=\"readonly\" />只读</label\n\t\t\t><label\n\t\t\t\t>合成服务结果<AsamSelect v-model=\"service\"\n\t\t\t\t\t><AsamOption label=\"成功\" value=\"success\">成功</AsamOption\n\t\t\t\t\t><AsamOption label=\"第二行未应用\" value=\"partial\">第二行未应用</AsamOption\n\t\t\t\t\t><AsamOption label=\"首行已写但返回未知\" value=\"unknown\"\n\t\t\t\t\t\t>首行已写但返回未知</AsamOption\n\t\t\t\t\t><AsamOption label=\"已写后刷新失败\" value=\"refresh-failure\"\n\t\t\t\t\t\t>已写后刷新失败</AsamOption\n\t\t\t\t\t></AsamSelect\n\t\t\t\t></label\n\t\t\t><label\n\t\t\t\t>打印方向<AsamSelect v-model=\"orientation\"\n\t\t\t\t\t><AsamOption label=\"纵向\" value=\"portrait\">纵向</AsamOption\n\t\t\t\t\t><AsamOption label=\"横向\" value=\"landscape\">横向</AsamOption></AsamSelect\n\t\t\t\t></label\n\t\t\t><AsamButton :size=\"size\" :disabled=\"disabled\" @click=\"sample\" type=\"primary\">\n\t\t\t\t填充 100 行 × 10 字段 TSV </AsamButton\n\t\t\t><AsamButton :size=\"size\" :disabled=\"disabled\" @click=\"invalid\" type=\"primary\"\n\t\t\t\t>填充字段错误</AsamButton\n\t\t\t><AsamButton :size=\"size\" :disabled=\"disabled\" @click=\"clearSelection\" type=\"primary\">\n\t\t\t\t清空所选 </AsamButton\n\t\t\t><AsamButton :size=\"size\" :disabled=\"disabled\" @click=\"select\" type=\"primary\">\n\t\t\t\t选中数值0及字符串0\n\t\t\t</AsamButton>\n\t\t</section>\n\t\t<p role=\"status\" aria-label=\"服务调用\">\n\t\t\t写服务 {{ calls }} 次 / 核实 {{ verifies }} 次 / 刷新 {{ refreshes }} 次\n\t\t</p>\n\t\t<p>\n\t\t\t{{ variant.serviceName }} · 名称 DTO：{{ variant.dtoName }} · 空值协议：{{\n\t\t\t\tvariant.nullToken\n\t\t\t}}\n\t\t</p>\n\t\t<AsamTableTransfer\n\t\t\t:controller=\"controller\"\n\t\t\t:fields=\"modes.fields\"\n\t\t\t:disabled=\"disabled\"\n\t\t\t:readonly=\"readonly\"\n\t\t\t:size=\"size\"\n\t\t\t:title=\"variant.printTitle\"\n\t\t\t:print-orientation=\"orientation\"\n\t\t/>\n\t\t<section aria-label=\"宿主原列表\">\n\t\t\t<h2>宿主当前列表（与传输草稿独立）</h2>\n\t\t\t<div class=\"list-scroll\">\n\t\t\t\t<table>\n\t\t\t\t\t<thead>\n\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t<th>typed key</th>\n\t\t\t\t\t\t\t<th>名称</th>\n\t\t\t\t\t\t\t<th>启用</th>\n\t\t\t\t\t\t</tr>\n\t\t\t\t\t</thead>\n\t\t\t\t\t<tbody>\n\t\t\t\t\t\t<tr\n\t\t\t\t\t\t\tv-for=\"row in list.page.data.value.list\"\n\t\t\t\t\t\t\t:key=\"`${typeof row.id}:${row.id}`\"\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t<td>{{ typeof row.id }}:{{ row.id }}</td>\n\t\t\t\t\t\t\t<td>{{ row.name }}</td>\n\t\t\t\t\t\t\t<td>{{ row.enabled }}</td>\n\t\t\t\t\t\t</tr>\n\t\t\t\t\t</tbody>\n\t\t\t\t</table>\n\t\t\t</div>\n\t\t</section>\n\t</main>\n</template>\n<script setup lang=\"ts\">\nimport { AsamConfigProvider as WebsiteAsamConfigProvider } from '@asam-ui/ui';\nconst websitePreviewControls =\n\ttypeof document !== 'undefined' && !!document.getElementById('preview-settings-extra');\n\nimport { AsamSelect, AsamOption, AsamCheckboxItem } from '@asam-ui/ui';\n\nimport { onBeforeUnmount, ref } from 'vue';\nimport { AsamButton, createAsamDataRuntime } from '@asam-ui/ui';\nimport type { AsamControlSize, AsamRowKey } from '@asam-ui/ui';\nimport {\n\tAsamTableTransfer,\n\tuseAsamTableTransfer,\n\tcreateAsamFieldModes,\n\tuseAsamListController,\n\tuseAsamTableEditing,\n\tcreateAsamWriteCoordinator,\n\tserializeAsamTransferText,\n\tcreateAsamTransferEditingGate\n} from '@asam-ui/pro/components';\nimport type { AsamFieldDefinition, AsamTransferWriteResult } from '@asam-ui/pro/components';\nimport { variant } from './Variant';\ninterface Row {\n\tid: AsamRowKey;\n\tname: string;\n\tenabled: boolean;\n\tf1: string;\n\tf2: string;\n\tf3: string;\n\tf4: string;\n\tf5: string;\n\tf6: string;\n\tf7: string;\n\tsecret: string;\n}\nconst disabled = ref(false),\n\treadonly = ref(false),\n\tsize = ref<AsamControlSize>('default'),\n\torientation = ref<'portrait' | 'landscape'>(variant.orientation),\n\tservice = ref('success');\nconst calls = ref(0),\n\tverifies = ref(0),\n\trefreshes = ref(0);\nconst records: Row[] = Array.from({ length: 100 }, (_, i) => ({\n\tid: i === 1 ? '0' : i,\n\tname: `记录 ${i + 1}`,\n\tenabled: i % 2 === 0,\n\tf1: '中文',\n\tf2: '逗号,Tab\\t',\n\tf3: '双引号\"',\n\tf4: '长文\\n第二行',\n\tf5: i === 0 ? '=SUM(1,2)' : '',\n\tf6: '0',\n\tf7: '尾列',\n\tsecret: '不允许输出的秘密'\n}));\nconst dataFields: AsamFieldDefinition[] = [\n\t{ key: 'name', kind: 'text', label: '名称', submit: (value) => value },\n\t{ key: 'enabled', kind: 'single', label: '启用' },\n\t...Array.from({ length: 7 }, (_, i): AsamFieldDefinition => ({\n\t\tkey: `f${i + 1}`,\n\t\tkind: 'text',\n\t\tlabel: `字段 ${i + 1}`\n\t}))\n];\nconst fields: AsamFieldDefinition[] = [\n\t{ key: 'recordKey', kind: 'text', label: 'typed key' },\n\t...dataFields\n];\nconst modes = createAsamFieldModes({\n\tbindings: fields.map((field) => ({ field })),\n\tsubmit: fields.map((field) => ({\n\t\tfield: field.key,\n\t\toutput: field.key === 'name' ? variant.dtoName : field.key\n\t}))\n});\nconst runtime = createAsamDataRuntime();\nruntime.setScope('synthetic-transfer');\nconst list = useAsamListController<Row>({\n\tfields: [],\n\tinitial: {},\n\trowKey: 'id',\n\truntime,\n\tpageSize: 100,\n\tapi: async () => {\n\t\trefreshes.value++;\n\t\tif (service.value === 'refresh-failure' && calls.value > 0) throw new Error('合成刷新失败');\n\t\treturn { list: records.slice(0, 100).map((row) => ({ ...row })), total: records.length };\n\t}\n});\nconst operationResults = new Map<string, AsamTransferWriteResult>();\nconst exportWaits: { start: number; end: number; scope: string }[] = [];\nconst editingGate = createAsamTransferEditingGate();\nlet revision = 0;\nconst editing = useAsamTableEditing({\n\tlist,\n\truntime,\n\tcoordinator: createAsamWriteCoordinator(),\n\tfields: dataFields,\n\tcanWrite: () => !disabled.value && !readonly.value,\n\tconfirmDiscard: async () => true,\n\tsave: async (payload, operation) => {\n\t\tif (\n\t\t\tdisabled.value ||\n\t\t\treadonly.value ||\n\t\t\toperation.scope !== runtime.scope ||\n\t\t\t!editingGate.canCommit(operation.target.operationId)\n\t\t)\n\t\t\treturn { status: 'failure', message: '写入前权限或输入已变化' };\n\t\tcalls.value++;\n\t\tconst row = records.find((row) => row.id === operation.target.id);\n\t\tif (!row) return { status: 'failure', message: '目标已不存在' };\n\t\tObject.assign(row, payload);\n\t\treturn { status: 'success' };\n\t},\n\tsaveOrder: async () => ({ status: 'failure', message: '本例不提供顺序写入' })\n});\nconst decodeKey = (value: unknown): AsamRowKey => {\n\tif (typeof value !== 'string' || !/^[ns]:/.test(value))\n\t\tthrow new Error('typed key 必须明确使用 n:数字 或 s:字符串');\n\tif (value.startsWith('s:')) return value.slice(2);\n\tconst number = Number(value.slice(2));\n\tif (!Number.isFinite(number)) throw new Error('数字key无效');\n\treturn number;\n};\nconst selected = ref<readonly AsamRowKey[]>([0, '0']);\nconst controller = useAsamTableTransfer<Row>({\n\tmodes,\n\tscope: () => runtime.scope,\n\tidentity: () => 'synthetic-user',\n\tdisabled: () => disabled.value,\n\treadonly: () => readonly.value,\n\trequired: ['recordKey', 'name'],\n\tkeyOfInput: (model) => decodeKey(model.recordKey),\n\texistingPatch: (row) =>\n\t\tObject.fromEntries(Object.entries(row.model).filter(([key]) => key !== 'recordKey')),\n\tediting,\n\teditingGate,\n\tconvert: (field, cell) => {\n\t\tif (field !== 'enabled')\n\t\t\treturn cell.text === variant.nullToken\n\t\t\t\t? null\n\t\t\t\t: cell.text === '<undefined>'\n\t\t\t\t\t? undefined\n\t\t\t\t\t: cell.text;\n\t\tif (cell.text === 'true') return true;\n\t\tif (cell.text === 'false') return false;\n\t\tthrow new Error('启用只接受 true/false');\n\t},\n\tvalidate: async (row) =>\n\t\trow.model.name === '' ? [{ field: 'name', message: '名称不能为空' }] : [],\n\toperationId: (row) => `transfer:${revision}:${row.index}`,\n\texternal: {\n\t\tprepare: async (operation, context) => {\n\t\t\tawait new Promise((resolve) => setTimeout(resolve, 100));\n\t\t\treturn async () => {\n\t\t\t\tif (!context.canCommit())\n\t\t\t\t\treturn { status: 'not-applied', message: '最后服务前权限失效' };\n\t\t\t\tcalls.value++;\n\t\t\t\tif (service.value === 'partial' && operation.row.index === 3)\n\t\t\t\t\treturn { status: 'not-applied', message: '合成服务明确拒绝第二行' };\n\t\t\t\tconst key = decodeKey(operation.row.model.recordKey);\n\t\t\t\tlet target = records.find((row) => row.id === key);\n\t\t\t\tif (!target) {\n\t\t\t\t\ttarget = {\n\t\t\t\t\t\tid: key,\n\t\t\t\t\t\tname: '',\n\t\t\t\t\t\tenabled: false,\n\t\t\t\t\t\tf1: '',\n\t\t\t\t\t\tf2: '',\n\t\t\t\t\t\tf3: '',\n\t\t\t\t\t\tf4: '',\n\t\t\t\t\t\tf5: '',\n\t\t\t\t\t\tf6: '',\n\t\t\t\t\t\tf7: '',\n\t\t\t\t\t\tsecret: '新增敏感字段'\n\t\t\t\t\t};\n\t\t\t\t\trecords.push(target);\n\t\t\t\t}\n\t\t\t\tconst payload = operation.row.payload!;\n\t\t\t\tfor (const field of dataFields) {\n\t\t\t\t\tconst dtoKey = field.key === 'name' ? variant.dtoName : field.key;\n\t\t\t\t\tif (Object.hasOwn(payload, dtoKey))\n\t\t\t\t\t\tReflect.set(target, field.key, payload[dtoKey]);\n\t\t\t\t}\n\t\t\t\toperationResults.set(operation.operationId, { status: 'success' });\n\t\t\t\treturn service.value === 'unknown' && operation.row.index === 2\n\t\t\t\t\t? { status: 'unknown', message: '已发送但结果未知，请按原标识核实' }\n\t\t\t\t\t: { status: 'success' };\n\t\t\t};\n\t\t},\n\t\tverify: async (operation) => {\n\t\t\tverifies.value++;\n\t\t\treturn (\n\t\t\t\toperationResults.get(operation.operationId) ?? {\n\t\t\t\t\tstatus: 'not-applied',\n\t\t\t\t\tmessage: '服务已确认未写入'\n\t\t\t\t}\n\t\t\t);\n\t\t}\n\t},\n\trefresh: async () => {\n\t\tconst result = await list.refresh();\n\t\tif (result.status !== 'success') throw new Error('宿主刷新未成功');\n\t},\n\texport: {\n\t\tcurrent: () => list.page.data.value.list,\n\t\tselected: () => selected.value,\n\t\tkeyOf: (row) => row.id,\n\t\tresolveSelected: async (keys) => records.filter((row) => keys.includes(row.id)),\n\t\tall: async (context) => {\n\t\t\tconst start = performance.now();\n\t\t\tawait new Promise((resolve) => setTimeout(resolve, 100));\n\t\t\texportWaits.push({ start, end: performance.now(), scope: context.scope });\n\t\t\treturn {\n\t\t\t\trows: records.map((row) => ({ ...row })),\n\t\t\t\tcomplete: true,\n\t\t\t\tscope: context.scope\n\t\t\t};\n\t\t},\n\t\tcolumns: [\n\t\t\t{ field: 'id', label: 'typed key', read: (row) => `${typeof row.id}:${row.id}` },\n\t\t\t...dataFields.map((field) => ({\n\t\t\t\tfield: field.key,\n\t\t\t\tlabel: field.label,\n\t\t\t\tread: (row: Row, projection: 'display' | 'submit') =>\n\t\t\t\t\tvariant.exportPrefix +\n\t\t\t\t\t(field.key === 'enabled' && projection === 'display'\n\t\t\t\t\t\t? row.enabled\n\t\t\t\t\t\t\t? '启用'\n\t\t\t\t\t\t\t: '停用'\n\t\t\t\t\t\t: String(Reflect.get(row, field.key) ?? ''))\n\t\t\t})),\n\t\t\t{ field: 'secret', label: '敏感', sensitive: true, read: (row) => row.secret }\n\t\t]\n\t}\n});\n\nfunction select() {\n\tselected.value = [0, '0'];\n}\nfunction clearSelection() {\n\tselected.value = [];\n}\nconst headers = fields.map((field) => field.key);\nfunction sample() {\n\trevision++;\n\tcontroller.setInput({\n\t\tformat: 'tsv',\n\t\theader: true,\n\t\tmapping: headers,\n\t\tmode: 'existing',\n\t\ttext: serializeAsamTransferText(\n\t\t\t[\n\t\t\t\theaders,\n\t\t\t\t...records\n\t\t\t\t\t.slice(0, 100)\n\t\t\t\t\t.map((row) => [\n\t\t\t\t\t\t`${typeof row.id === 'number' ? 'n' : 's'}:${row.id}`,\n\t\t\t\t\t\trow.name,\n\t\t\t\t\t\tString(row.enabled),\n\t\t\t\t\t\trow.f1,\n\t\t\t\t\t\trow.f2,\n\t\t\t\t\t\trow.f3,\n\t\t\t\t\t\trow.f4,\n\t\t\t\t\t\trow.f5,\n\t\t\t\t\t\trow.f6,\n\t\t\t\t\t\trow.f7\n\t\t\t\t\t])\n\t\t\t],\n\t\t\t'tsv',\n\t\t\t{ raw: true }\n\t\t)\n\t});\n}\nfunction invalid() {\n\trevision++;\n\tcontroller.setInput({\n\t\tformat: 'tsv',\n\t\theader: true,\n\t\tmapping: ['recordKey', 'name', 'enabled'],\n\t\tmode: 'existing',\n\t\ttext: 'recordKey\\tname\\tenabled\\nn:0\\t\\t错误\\ns:0\\t可恢复\\tfalse'\n\t});\n}\nif (typeof window !== 'undefined')\n\tReflect.set(window, '__transfer', {\n\t\tcontroller,\n\t\texportWaits,\n\t\tlist,\n\t\tediting,\n\t\trecords,\n\t\tsample,\n\t\tinvalid,\n\t\tdisabled,\n\t\treadonly,\n\t\tservice,\n\t\tselected,\n\t\tcalls,\n\t\tverifies,\n\t\trefreshes,\n\t\tnewRevision: () => revision++\n\t});\nonBeforeUnmount(() => {\n\tcontroller.dispose();\n\tediting.dispose();\n\truntime.invalidate();\n});\n</script>\n<style>\nbody {\n\tmargin: 0;\n\tcolor: var(--el-text-color-primary);\n\tbackground: var(--el-bg-color);\n}\nmain {\n\tmax-width: 1180px;\n\tmargin: auto;\n\tpadding: 20px;\n\tbox-sizing: border-box;\n}\n.host-controls {\n\tdisplay: flex;\n\tflex-wrap: wrap;\n\tgap: 12px;\n\talign-items: center;\n}\n.host-controls label {\n\tdisplay: inline-flex;\n\tgap: 6px;\n\talign-items: center;\n}\n.list-scroll {\n\tmax-height: 300px;\n\toverflow: auto;\n}\n.list-scroll table {\n\twidth: 100%;\n\ttext-align: left;\n}\n@media (max-width: 480px) {\n\tmain {\n\t\tpadding: 12px;\n\t}\n}\n@media print {\n\tmain > header,\n\tmain > .host-controls,\n\tmain > p,\n\tmain > section[aria-label='宿主原列表'] {\n\t\tdisplay: none;\n\t}\n}\n</style>\n"
		},
		{
			"path": "tests/v2/table-transfer/Variant.ts",
			"source": "/** 普通消费方可直接修改：DTO名称、空值协议、显示导出与打印布局均由此明确配置。 */\nexport const variant = {\n\tdtoName: 'name',\n\tnullToken: '<null>',\n\texportPrefix: '',\n\tprintTitle: '资料交换清单',\n\tserviceName: '常规合成服务',\n\torientation: 'portrait' as 'portrait' | 'landscape'\n};\n"
		}
	]
}
