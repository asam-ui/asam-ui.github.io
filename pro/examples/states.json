{
	"schemaVersion": 1,
	"entry": "tests/v2/states/Example.vue",
	"bootstrap": "tests/v2/states/Example.vue",
	"files": [
		{
			"path": "tests/v2/states/Example.vue",
			"source": "<template>\n\t<main>\n\t\t<h1>页面状态与交互</h1>\n\t\t<AsamButton @click=\"loading = !loading\" type=\"primary\">切换加载</AsamButton\n\t\t><AsamButton\n\t\t\t@click=\"layout = layout === 'list' ? 'form' : layout === 'form' ? 'detail' : 'list'\"\n\t\t\ttype=\"primary\"\n\t\t>\n\t\t\t切换布局 </AsamButton\n\t\t><AsamPageSkeleton :loading=\"loading\" :layout=\"layout\" :count=\"3\"\n\t\t\t><p>数据已加载：可修改此普通 SFC 的结构</p></AsamPageSkeleton\n\t\t><AsamStatePanel\n\t\t\ttitle=\"操作结果\"\n\t\t\tdescription=\"宿主负责业务操作\"\n\t\t\t:actions=\"actions\"\n\t\t\t:state-key=\"stateKey\"\n\t\t\t@success=\"success++\"\n\t\t\t@failure=\"failures++\"\n\t\t/><AsamButton @click=\"reject = !reject\" type=\"primary\">切换动作失败</AsamButton\n\t\t><AsamButton @click=\"stateKey++\" type=\"primary\">替换业务对象</AsamButton\n\t\t><output aria-label=\"动作成功\">{{ success }}</output\n\t\t><output aria-label=\"动作失败\">{{ failures }}</output\n\t\t><AsamException\n\t\t\ttitle=\"页面暂不可用\"\n\t\t\tdescription=\"请选择恢复操作\"\n\t\t\t:actions=\"[{ id: 'recover', label: '恢复页面', run: recover }]\"\n\t\t/><output aria-label=\"恢复次数\">{{ recovered }}</output\n\t\t><AsamButton @click=\"copy('')\" type=\"primary\">复制空文本</AsamButton\n\t\t><AsamButton @click=\"copy('示例文本')\" type=\"primary\">复制文本</AsamButton\n\t\t><AsamButton @click=\"copyReject = !copyReject\" type=\"primary\">切换复制失败</AsamButton\n\t\t><output aria-label=\"复制状态\">{{ copyStatus }}</output\n\t\t><AsamButton @click=\"showTools = !showTools\" type=\"primary\">挂载监听</AsamButton\n\t\t><ToolFixture v-if=\"showTools\" /><AsamButton\n\t\t\t@click=\"watermarkVisible = !watermarkVisible\"\n\t\t\ttype=\"primary\"\n\t\t\t>隐藏水印</AsamButton\n\t\t><AsamButton @click=\"watermark = watermark === 'ASAM' ? 'UPDATED' : 'ASAM'\" type=\"primary\">\n\t\t\t更新水印 </AsamButton\n\t\t><AsamPageWatermark\n\t\t\t:visible=\"watermarkVisible\"\n\t\t\t:watermark=\"{ content: [watermark, '仅视觉标识'] }\"\n\t\t\t><section class=\"watermark-target\">仅作用此容器</section></AsamPageWatermark\n\t\t><AsamPageWatermark :watermark=\"{ content: '独立实例' }\"\n\t\t\t><div>兄弟水印</div></AsamPageWatermark\n\t\t><AsamButton @click=\"broken = !broken\" type=\"primary\">切换子树错误</AsamButton\n\t\t><AsamButton @click=\"resetKey++\" type=\"primary\">复位边界</AsamButton\n\t\t><AsamErrorBoundary :reset-key=\"resetKey\" :propagate=\"false\" @error=\"boundaryErrors++\"\n\t\t\t><Broken :broken=\"broken\" /></AsamErrorBoundary\n\t\t><AsamErrorBoundary :propagate=\"false\"><p>兄弟边界正常</p></AsamErrorBoundary\n\t\t><output aria-label=\"捕获次数\">{{ boundaryErrors }}</output\n\t\t><AsamFieldAnnotation\n\t\t\tid=\"name-help\"\n\t\t\tfor-id=\"name\"\n\t\t\tlabel=\"名称\"\n\t\t\tdescription=\"填写可读名称\"\n\t\t\t:required=\"true\"\n\t\t\t:error=\"name ? '' : '名称不能为空'\"\n\t\t\t><template #default=\"{ describedby, invalid, required }\"\n\t\t\t\t><AsamInput\n\t\t\t\t\tid=\"name\"\n\t\t\t\t\tv-model=\"name\"\n\t\t\t\t\t:aria-describedby=\"describedby\"\n\t\t\t\t\t:aria-invalid=\"invalid\"\n\t\t\t\t\t:required=\"required\" /></template\n\t\t></AsamFieldAnnotation>\n\t\t<div v-for=\"size in sizes\" :key=\"size\">\n\t\t\t<AsamPageSkeleton :size=\"size\" :count=\"1\" :label=\"size\" />\n\t\t</div>\n\t\t<AsamStatePanel title=\"空结果\" description=\"尚无数据\" /><AsamStatePanel\n\t\t\ttitle=\"禁用操作\"\n\t\t\tdisabled\n\t\t\t:actions=\"actions\"\n\t\t/><AsamStatePanel title=\"只读操作\" readonly :actions=\"actions\" />\n\t</main>\n</template>\n<script setup lang=\"ts\">\nimport { AsamInput } from '@asam-ui/ui';\n\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { defineComponent, h, ref } from 'vue';\nimport {\n\tAsamPageSkeleton,\n\tAsamStatePanel,\n\tAsamException,\n\tAsamPageWatermark,\n\tAsamErrorBoundary,\n\tAsamFieldAnnotation,\n\tuseAsamCopy\n} from '@asam-ui/pro/components';\nimport type {\n\tAsamPageSkeletonProps,\n\tAsamStateAction,\n\tAsamStateSize\n} from '@asam-ui/pro/components';\nimport ToolFixture from './ToolFixture.vue';\nconst loading = ref(true),\n\tlayout = ref<AsamPageSkeletonProps['layout']>('list');\nconst success = ref(0),\n\tfailures = ref(0),\n\treject = ref(false),\n\tstateKey = ref(0),\n\trecovered = ref(0);\nconst actions: AsamStateAction[] = [\n\t{\n\t\tid: 'save',\n\t\tlabel: '执行动作',\n\t\trun: async () => {\n\t\t\tawait new Promise((resolve) => setTimeout(resolve, 120));\n\t\t\tif (reject.value) throw Error('预期业务错误');\n\t\t}\n\t}\n];\nfunction recover() {\n\trecovered.value++;\n}\nconst copyReject = ref(false);\nconst { copy, status: copyStatus } = useAsamCopy({\n\twriteText: async (text) => {\n\t\tif (copyReject.value) throw Error('预期权限拒绝');\n\t\twindow.sessionStorage.setItem('copied', text);\n\t}\n});\nconst showTools = ref(true),\n\twatermarkVisible = ref(true),\n\twatermark = ref('ASAM');\nconst broken = ref(false),\n\tresetKey = ref(0),\n\tboundaryErrors = ref(0),\n\tname = ref('');\nconst Broken = defineComponent({\n\tprops: { broken: Boolean },\n\tsetup: (props) => () => {\n\t\tif (props.broken) throw Error('预期渲染异常');\n\t\treturn h('p', '子树正常');\n\t}\n});\nconst sizes: AsamStateSize[] = ['small', 'default', 'big', 'large'];\n</script>\n<style scoped>\n:global(body) {\n\tmargin: 0;\n\tfont-family: sans-serif;\n\tcolor: var(--el-text-color-primary);\n\tbackground: var(--el-bg-color);\n}\n:global(html.dark) main {\n\t--asam-color-text-primary: var(--el-text-color-primary);\n\t--asam-color-surface: var(--el-bg-color);\n\t--asam-color-border: var(--el-border-color);\n}\nmain {\n\tmax-width: 880px;\n\tmargin: auto;\n\tpadding: 16px;\n}\nbutton:not([class*='el-']) {\n\tmargin: 4px;\n}\n.watermark-target {\n\tmin-height: 100px;\n}\n</style>\n"
		},
		{
			"path": "tests/v2/states/ToolFixture.vue",
			"source": "<template>\n\t<section>\n\t\t<AsamButton @click=\"alternate = !alternate\" type=\"primary\">替换监听目标</AsamButton\n\t\t><AsamButton @click=\"wide = !wide\" type=\"primary\">改变真实尺寸</AsamButton\n\t\t><AsamButton @click=\"scrollTo(160)\" type=\"primary\">滚动到指定位置</AsamButton\n\t\t><AsamButton @click=\"scrollTo()\" type=\"primary\">返回顶部</AsamButton>\n\t\t<div\n\t\t\tv-if=\"!alternate\"\n\t\t\tref=\"target\"\n\t\t\tclass=\"scroller\"\n\t\t\t:style=\"{ width: wide ? '240px' : '180px' }\"\n\t\t>\n\t\t\t<div class=\"content\">真实滚动容器 A</div>\n\t\t</div>\n\t\t<div v-else ref=\"target\" class=\"scroller\" :style=\"{ width: wide ? '240px' : '180px' }\">\n\t\t\t<div class=\"content\">真实滚动容器 B</div>\n\t\t</div>\n\t\t<output aria-label=\"滚动位置\">{{ position.top }}</output\n\t\t><output aria-label=\"尺寸宽度\">{{ size?.width }}</output\n\t\t><output aria-label=\"顶部\">{{ position.atTop }}</output>\n\t</section>\n</template>\n<script setup lang=\"ts\">\nimport { AsamButton } from '@asam-ui/ui';\n\nimport { ref } from 'vue';\nimport { useAsamScroll, useAsamElementSize } from '@asam-ui/pro/components';\nconst target = ref<HTMLElement | null>(null),\n\talternate = ref(false),\n\twide = ref(false);\nconst { position, scrollTo } = useAsamScroll(target, { threshold: 5 });\nconst { size } = useAsamElementSize(target);\n</script>\n<style scoped>\n.scroller {\n\theight: 80px;\n\toverflow: auto;\n\tborder: 1px solid;\n}\n.content {\n\theight: 500px;\n}\n</style>\n"
		}
	]
}
