{
	"schemaVersion": 1,
	"id": "welcome",
	"title": "应用欢迎页",
	"documentation": "/pro/welcome.html",
	"components": [
		"AsamCard",
		"AsamButton",
		"AsamAvatar",
		"AsamTag",
		"AsamSteps",
		"AsamStep",
		"AsamAlert",
		"AsamApplicationProvider",
		"NavigationShell"
	],
	"actions": [
		{
			"name": "浏览数据",
			"route": "/data"
		},
		{
			"name": "工程说明",
			"route": "/about"
		},
		{
			"name": "数据场景",
			"route": "/scenarios"
		},
		{
			"name": "界面偏好",
			"route": "/appearance"
		},
		{
			"name": "接入指南",
			"route": "/integration"
		},
		{
			"name": "调整外观",
			"mechanism": "PreferenceController.choose"
		}
	],
	"entry": {
		"function": "mountWelcome",
		"source": "templates/scaffold/app/application.ts",
		"initialRoute": "/welcome",
		"cleanup": "调用返回的dispose；宿主外部i18n不由本实例销毁"
	},
	"layout": {
		"hero": "内容与工作空间摘要",
		"guides": 3,
		"steps": 3,
		"responsive": "按实际容器宽度重排；窄容器步骤纵向排列",
		"controlSizes": [
			"small",
			"default",
			"big",
			"large"
		]
	},
	"languages": [
		"zh-CN",
		"en"
	],
	"source": "/pro/examples/welcome.json",
	"javascriptSource": "/pro/examples/welcome-js.json",
	"downloads": [
		{
			"language": "ts",
			"project": "https://asam-ui.cn/downloads/releases/c28986dde3665d302c3868cfd38a760391c7820b50824b8486a231486dc05612/pro/examples/templates/welcome.zip",
			"source": "https://asam-ui.cn/downloads/releases/c28986dde3665d302c3868cfd38a760391c7820b50824b8486a231486dc05612/pro/examples/templates/welcome-source.zip"
		},
		{
			"language": "js",
			"project": "https://asam-ui.cn/downloads/releases/c28986dde3665d302c3868cfd38a760391c7820b50824b8486a231486dc05612/pro/examples/templates/welcome-js.zip",
			"source": "https://asam-ui.cn/downloads/releases/c28986dde3665d302c3868cfd38a760391c7820b50824b8486a231486dc05612/pro/examples/templates/welcome-js-source.zip"
		}
	],
	"hostResponsibilities": [
		"真实身份与权限",
		"业务导航资源",
		"请求transport与业务数据"
	],
	"limitations": [
		"使用本地合成数据，不代表已接入真实账号或团队。",
		"原mountApplication仍默认进入/data；欢迎页是同一应用的独立入口。"
	]
}
