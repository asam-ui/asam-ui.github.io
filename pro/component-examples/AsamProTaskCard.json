							"name": "Demo.vue",
							"source": "<template>\n\t<AsamCardGroup label=\"任务卡片列表\">\n\t\t<AsamProTaskCard\n\t\t\tv-for=\"card in cards\"\n\t\t\t:key=\"card.title\"\n\t\t\t:title=\"card.title\"\n\t\t\t:status=\"card.status\"\n\t\t\t:progress=\"card.progress\"\n\t\t>\n\t\t\t<template v-for=\"block in card.content\" :key=\"block.type\">\n\t\t\t\t<img\n\t\t\t\t\tv-if=\"block.type === 'image'\"\n\t\t\t\t\t:src=\"cover\"\n\t\t\t\t\talt=\"蓝色山景项目封面\"\n\t\t\t\t\twidth=\"160\"\n\t\t\t\t\theight=\"60\"\n\t\t\t\t/>\n\t\t\t\t<p v-else>{{ block.text }}</p>\n\t\t\t</template>\n\t\t\t<template #footer-meta>\n\t\t\t\t<time datetime=\"2026-01-01\">2026-01-01</time>\n\t\t\t</template>\n\t\t\t<template #operation=\"{ blocked }\">\n\t\t\t\t<AsamButton\n\t\t\t\t\ttype=\"primary\"\n\t\t\t\t\tplain\n\t\t\t\t\t:disabled=\"blocked\"\n\t\t\t\t\t:aria-label=\"'查看详情：' + card.title\"\n\t\t\t\t\t@click=\"activeTask = card\"\n\t\t\t\t>\n\t\t\t\t\t查看详情\n\t\t\t\t</AsamButton>\n\t\t\t</template>\n\t\t</AsamProTaskCard>\n\t</AsamCardGroup>\n\t<AsamDrawer\n\t\t:model-value=\"activeTask !== null\"\n\t\t:title=\"activeTask?.title\"\n\t\t@update:model-value=\"closeDetails\"\n\t>\n\t\t<p v-if=\"activeTask\">{{ activeTask.status.label }}</p>\n\t</AsamDrawer>\n</template>\n\n<script setup lang=\"ts\">\nimport { shallowRef } from 'vue';\nimport { AsamButton, AsamDrawer } from '@asam-ui/ui';\nimport { AsamCardGroup, AsamProTaskCard } from '@asam-ui/pro/components';\nimport type { AsamTaskStatus } from '@asam-ui/pro/components';\n\ndefineOptions({ name: 'TaskStatusesExample' });\n\ninterface Task {\n\ttitle: string;\n\tstatus: AsamTaskStatus;\n\tprogress?: number;\n\tcontent: readonly ({ type: 'image' } | { type: 'text'; text: string })[];\n}\n\nconst cover =\n\t'data:image/png;base64,';\n\nconst cards: readonly Task[] = [\n\t{\n\t\ttitle: '完善项目说明、交付范围和后续验收计划',\n\t\tstatus: { label: '进行中', tone: 'primary' },\n\t\tcontent: [{ type: 'text', text: '补充目标、排期和成员信息。' }]\n\t},\n\t{\n\t\ttitle: '项目封面',\n\t\tstatus: { label: '通过验收', tone: 'success', completed: true },\n\t\tcontent: [{ type: 'image' }]\n\t},\n\t{\n\t\ttitle: '巡检记录',\n\t\tstatus: { label: '待处理', tone: 'warning' },\n\t\tcontent: [{ type: 'image' }, { type: 'text', text: '补充巡检结果与现场记录。' }]\n\t},\n\t{\n\t\ttitle: '复核交付资料',\n\t\tstatus: { label: '已拒绝', tone: 'danger' },\n\t\tcontent: [{ type: 'text', text: '请根据反馈更新并重新提交。' }, { type: 'image' }]\n\t},\n\t{\n\t\ttitle: '梳理协作进度',\n\t\tstatus: { label: '未分类', tone: 'info' },\n\t\tprogress: 65,\n\t\tcontent: [{ type: 'text', text: '对照排期核对当前进展。' }]\n\t},\n\t{\n\t\ttitle: '兼容中性',\n\t\tstatus: { label: '兼容中性', tone: 'neutral' },\n\t\tcontent: [{ type: 'text', text: '整理任务说明和交付记录。' }]\n\t}\n];\nconst activeTask = shallowRef<Task | null>(null);\n\nfunction closeDetails(open: boolean): void {\n\tif (!open) activeTask.value = null;\n}\n</script>\n"
						}
					]
				},
