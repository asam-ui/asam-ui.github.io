					"entryName": "Demo.vue",
					"files": [
						{
							"name": "Demo.vue",
							"source": "<template>\n\t<div class=\"search-example\">\n\t\t<AsamSearchForm v-model=\"draft\" :fields=\"fields\" @submit=\"apply\" @reset=\"apply\" />\n\t\t<div class=\"search-results\" aria-live=\"polite\">\n\t\t\t<p>找到 {{ matches.length }} 个项目</p>\n\t\t\t<ul v-if=\"matches.length\">\n\t\t\t\t<li v-for=\"project in matches\" :key=\"project.code\">\n\t\t\t\t\t{{ project.name }} · {{ project.owner }} · {{ project.status }}\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t\t<p v-else>请调整查询条件后重试。</p>\n\t\t</div>\n\t</div>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed, shallowRef } from 'vue';\nimport { AsamSearchForm } from '@asam-ui/pro/components';\nimport type { AsamFieldDefinition, AsamFieldModel } from '@asam-ui/pro/components';\nimport { defineAsamOptions } from '@asam-ui/ui';\n\ndefineOptions({ name: 'SearchCardExample' });\n\nconst projects = [\n\t{\n\t\tname: '华东供应链协同平台',\n\t\towner: '陈晨',\n\t\tstatus: '进行中',\n\t\tgroup: '供应链',\n\t\tcode: 'PRJ-001'\n\t},\n\t{ name: '园区设备巡检', owner: '林悦', status: '待启动', group: '运营', code: 'PRJ-002' },\n\t{ name: '研发知识库升级', owner: '张远', status: '进行中', group: '研发', code: 'PRJ-003' },\n\t{ name: '供应商对账自动化', owner: '陈晨', status: '已完成', group: '供应链', code: 'PRJ-004' },\n\t{ name: '质量问题追踪', owner: '林悦', status: '已完成', group: '运营', code: 'PRJ-005' },\n\t{ name: '项目成本分析', owner: '张远', status: '待启动', group: '研发', code: 'PRJ-006' }\n];\n\nfunction options(values: readonly string[]) {\n\treturn defineAsamOptions().static({\n\t\toptions: values.map((value) => ({ label: value, value }))\n\t});\n}\n\nconst fields: readonly AsamFieldDefinition[] = [\n\t{\n\t\tkey: 'name',\n\t\tlabel: '项目名称',\n\t\tkind: 'text',\n\t\tmodes: { query: { componentProps: { placeholder: '输入项目名称' } } }\n\t},\n\t{ key: 'owner', label: '负责人', kind: 'single', source: options(['陈晨', '林悦', '张远']) },\n\t{\n\t\tkey: 'status',\n\t\tlabel: '项目状态',\n\t\tkind: 'single',\n\t\tsource: options(['待启动', '进行中', '已完成'])\n\t},\n\t{\n\t\tkey: 'group',\n\t\tlabel: '项目分组',\n\t\tkind: 'single',\n\t\tsource: options(['供应链', '运营', '研发'])\n\t},\n\t{\n\t\tkey: 'code',\n\t\tlabel: '项目编号',\n\t\tkind: 'text',\n\t\tmodes: { query: { componentProps: { placeholder: '输入项目编号' } } }\n\t}\n];\nconst draft = shallowRef<AsamFieldModel>({});\nconst applied = shallowRef<AsamFieldModel>({});\nfunction apply(query: AsamFieldModel) {\n\tapplied.value = query;\n}\nconst matches = computed(() => {\n\tconst { name, owner, status, group, code } = applied.value;\n\treturn projects.filter(\n\t\t(project) =>\n\t\t\tproject.name.includes(String(name ?? '').trim()) &&\n\t\t\t(!owner || project.owner === owner) &&\n\t\t\t(!status || project.status === status) &&\n\t\t\t(!group || project.group === group) &&\n\t\t\tproject.code.toLowerCase().includes(\n\t\t\t\tString(code ?? '')\n\t\t\t\t\t.trim()\n\t\t\t\t\t.toLowerCase()\n\t\t\t)\n\t);\n});\n</script>\n\n<style scoped>\n.search-example {\n\tdisplay: grid;\n\tgap: var(--asam-space-xl);\n\tbox-sizing: border-box;\n\tmin-width: 0;\n\tpadding: var(--asam-space-xl);\n\tbackground: var(--asam-color-surface-muted);\n}\n\n.search-results > p {\n\tmargin: 0;\n}\n\n.search-results > ul {\n\tmargin-block: var(--asam-space-sm) 0;\n}\n</style>\n"
						}
					]
				},
