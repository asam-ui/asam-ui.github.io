Props: { placeholder: '输入项目编号' } } }\n\t}\n];\nconst draft = shallowRef({});\nconst applied = shallowRef({});\nfunction apply(query) {\n\tapplied.value = query;\n}\nconst matches = computed(() => {\n\tconst { name, owner, status, group, code } = applied.value;\n\treturn projects.filter(\n\t\t(project) =>\n\t\t\tproject.name.includes(String(name ?? '').trim()) &&\n\t\t\t(!owner || project.owner === owner) &&\n\t\t\t(!status || project.status === status) &&\n\t\t\t(!group || project.group === group) &&\n\t\t\tproject.code.toLowerCase().includes(\n\t\t\t\tString(code ?? '')\n\t\t\t\t\t.trim()\n\t\t\t\t\t.toLowerCase()\n\t\t\t)\n\t);\n});\n</script>\n\n<style scoped>\n.search-example {\n\tdisplay: grid;\n\tgap: var(--asam-space-xl);\n\tbox-sizing: border-box;\n\tmin-width: 0;\n\tpadding: var(--asam-space-xl);\n\tbackground: var(--asam-color-surface-muted);\n}\n\n.search-results > p {\n\tmargin: 0;\n}\n\n.search-results > ul {\n\tmargin-block: var(--asam-space-sm) 0;\n}\n</style>\n"
						}
