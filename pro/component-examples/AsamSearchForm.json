							"source": "<template>\n\t<div class=\"search-example-narrow\">\n\t\t<AsamSearchForm\n\t\t\tv-model=\"draft\"\n\t\t\t:fields=\"fields\"\n\t\t\t:columns=\"1\"\n\t\t\t:reset-values=\"initialQuery\"\n\t\t\taction-button-type=\"secondary\"\n\t\t\tsize=\"small\"\n\t\t\t@submit=\"apply\"\n\t\t\t@reset=\"apply\"\n\t\t/>\n\t\t<p role=\"status\">{{ matches.join('、') || '没有符合条件的项目' }}</p>\n\t</div>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed, shallowRef } from 'vue';\nimport { AsamSearchForm } from '@asam-ui/pro/components';\nimport type { AsamFieldDefinition, AsamFieldModel } from '@asam-ui/pro/components';\nimport { defineAsamOptions } from '@asam-ui/ui';\n\ndefineOptions({ name: 'NarrowSearchCardExample' });\n\nconst projects = [\n\t{ name: '园区设备巡检', status: '待启动' },\n\t{ name: '研发知识库升级', status: '进行中' },\n\t{ name: '供应商对账自动化', status: '已完成' }\n];\nconst statuses = ['待启动', '进行中', '已完成'];\nconst fields: readonly AsamFieldDefinition[] = [\n\t{ key: 'name', label: '项目名称', kind: 'text' },\n\t{\n\t\tkey: 'status',\n\t\tlabel: '项目状态',\n\t\tkind: 'single',\n\t\tsource: defineAsamOptions().static({\n\t\t\toptions: statuses.map((value) => ({ label: value, value }))\n\t\t})\n\t}\n];\nconst initialQuery: AsamFieldModel = { status: '进行中' };\nconst draft = shallowRef<AsamFieldModel>({ ...initialQuery });\nconst applied = shallowRef<AsamFieldModel>({ ...initialQuery });\nfunction apply(query: AsamFieldModel) {\n\tapplied.value = query;\n}\nconst matches = computed(() =>\n\tprojects\n\t\t.filter(\n\t\t\t(project) =>\n\t\t\t\tproject.name.includes(String(applied.value.name ?? '').trim()) &&\n\t\t\t\t(!applied.value.status || project.status === applied.value.status)\n\t\t)\n\t\t.map((project) => project.name)\n);\n</script>\n\n<style scoped>\n.search-example-narrow {\n\tdisplay: grid;\n\tgap: var(--asam-space-xl);\n\tbox-sizing: border-box;\n\tmax-width: 28rem;\n\tmin-width: 0;\n\tpadding: var(--asam-space-xl);\n\tbackground: var(--asam-color-surface-muted);\n}\n\n.search-example-narrow > p {\n\tmargin: 0;\n}\n</style>\n"
