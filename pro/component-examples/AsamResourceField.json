							"name": "Demo.vue",
							"source": "<template>\n\t<div class=\"pro-example-stack\">\n\t\t<AsamResourceField v-model=\"value\" :services=\"services\" label=\"项目附件\" />\n\t</div>\n</template>\n\n<script setup lang=\"ts\">\nimport { AsamResourceField } from '@asam-ui/pro/components';\nimport { ref } from 'vue';\nimport type { AsamResourceServices, AsamResourceValue } from '@asam-ui/pro/components';\nconst value = ref<AsamResourceValue>(null);\nlet sequence = 0;\n// 只返回本地元数据；真实上传服务由应用提供。\nconst services: AsamResourceServices = {\n\tupload: async ({ file, progress, signal }) => {\n\t\tif (signal.aborted) throw new Error('上传已取消');\n\t\tprogress(100);\n\t\treturn { id: ++sequence, name: file.name, size: file.size, mimeType: file.type };\n\t}\n};\n</script>\n"
						}
					]
				},
