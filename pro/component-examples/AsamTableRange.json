							"name": "Demo.vue",
							"source": "<template>\n\t<div class=\"pro-example-stack\">\n\t\t<p role=\"status\">{{ selectionSummary }}</p>\n\t\t<AsamTableRange :controller=\"controller\" title=\"项目数据范围\" />\n\t</div>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed, onBeforeUnmount, ref, watch } from 'vue';\nimport { AsamTableRange, createAsamFieldModes, useAsamTableRange } from '@asam-ui/pro/components';\nimport type { AsamFieldDefinition, AsamRangeColumn } from '@asam-ui/pro/components';\ninterface Row {\n\tid: number;\n\tname: string;\n\towner: string;\n\tstatus: string;\n\tbudget: string;\n\tstartDate: string;\n}\nconst rows = ref<Row[]>(\n\tArray.from({ length: 16 }, (_, i) => ({\n\t\tid: i + 1,\n\t\tname: '项目 ' + (i + 1),\n\t\towner: ['陈晨', '林悦', '张远'][i % 3] ?? '陈晨',\n\t\tstatus: i % 3 ? '进行中' : '待启动',\n\t\tbudget: String(30000 + i * 5000),\n\t\tstartDate: '2026-05-' + String(i + 1).padStart(2, '0')\n\t}))\n);\nconst fields: AsamFieldDefinition[] = [\n\t{ key: 'id', kind: 'text', label: '编号' },\n\t{ key: 'name', kind: 'text', label: '项目名称' },\n\t{ key: 'owner', kind: 'text', label: '负责人' },\n\t{ key: 'status', kind: 'text', label: '状态' },\n\t{ key: 'budget', kind: 'text', label: '预算（元）' },\n\t{ key: 'startDate', kind: 'text', label: '开始日期' }\n];\nconst modes = createAsamFieldModes({\n\tbindings: fields.map((field) => ({ field })),\n\tsubmit: fields.map((field) => ({ field: field.key, output: field.key }))\n});\nconst columns: AsamRangeColumn<Row>[] = [\n\t{ field: 'id', label: '编号', writable: false, read: async (row) => String(row.id) },\n\t{ field: 'name', label: '项目名称', read: async (row) => row.name },\n\t{ field: 'owner', label: '负责人', read: async (row) => row.owner },\n\t{ field: 'status', label: '状态', read: async (row) => row.status },\n\t{ field: 'budget', label: '预算（元）', read: async (row) => row.budget },\n\t{ field: 'startDate', label: '开始日期', read: async (row) => row.startDate }\n];\nconst revision = ref(0);\nconst controller = useAsamTableRange<Row>({\n\tprojection: () => ({ rows: rows.value, columns, revision: revision.value }),\n\tkeyOf: (row) => row.id,\n\tscope: () => 'projects',\n\tidentity: () => 'visitor',\n\tmodes,\n\treadonly: () => false,\n\toperationId: (draft, key) => 'range-' + draft + '-' + key,\n\trefresh: async () => {\n\t\trevision.value++;\n\t},\n\texternal: {\n\t\tprepare: async (operation, context) => async () => {\n\t\t\tif (!context.canCommit()) return { status: 'not-applied', message: '操作已取消' };\n\t\t\tconst row = rows.value.find((row) => row.id === operation.row.key);\n\t\t\tif (!row) return { status: 'not-applied', message: '项目不存在' };\n\t\t\tObject.assign(row, operation.row.payload);\n\t\t\treturn { status: 'success' };\n\t\t}\n\t}\n});\nlet initialized = false;\nwatch(\n\tcontroller.readable,\n\t(ready) => {\n\t\tif (!ready || initialized) return;\n\t\tinitialized = true;\n\t\tcontroller.select({ row: 1, column: 1 });\n\t\tcontroller.select({ row: 4, column: 3 }, { extend: true });\n\t},\n\t{ immediate: true }\n);\nconst selectionSummary = computed(() =>\n\tcontroller.ranges.value.length\n\t\t? '已选区域：' +\n\t\t\tcontroller.ranges.value\n\t\t\t\t.map(({ start, end }) => {\n\t\t\t\t\tconst firstRow = Math.min(start.row, end.row) + 1,\n\t\t\t\t\t\tlastRow = Math.max(start.row, end.row) + 1;\n\t\t\t\t\tconst firstColumn = Math.min(start.column, end.column) + 1,\n\t\t\t\t\t\tlastColumn = Math.max(start.column, end.column) + 1;\n\t\t\t\t\treturn (\n\t\t\t\t\t\t'第 ' +\n\t\t\t\t\t\tfirstRow +\n\t\t\t\t\t\t'–' +\n\t\t\t\t\t\tlastRow +\n\t\t\t\t\t\t' 行，第 ' +\n\t\t\t\t\t\tfirstColumn +\n\t\t\t\t\t\t'–' +\n\t\t\t\t\t\tlastColumn +\n\t\t\t\t\t\t' 列（' +\n\t\t\t\t\t\t(lastRow - firstRow + 1) * (lastColumn - firstColumn + 1) +\n\t\t\t\t\t\t' 格）'\n\t\t\t\t\t);\n\t\t\t\t})\n\t\t\t\t.join('；')\n\t\t: '未选择区域'\n);\nonBeforeUnmount(() => controller.dispose());\n</script>\n"
						}
					]
				},
