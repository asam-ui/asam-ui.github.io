							"name": "Demo.vue",
							"source": "<template>\n\t<div class=\"pro-example-stack\">\n\t\t<AsamStatePanel\n\t\t\ttitle=\"处理完成\"\n\t\t\tdescription=\"本地演示主操作与默认次操作，业务导航由宿主提供。\"\n\t\t\ttone=\"success\"\n\t\t\t:actions=\"actions\"\n\t\t/>\n\t\t<p role=\"status\">{{ message }}</p>\n\t</div>\n</template>\n<script setup lang=\"ts\">\nimport { ref } from 'vue';\nimport { AsamStatePanel } from '@asam-ui/pro/components';\nimport type { AsamStateAction } from '@asam-ui/pro/components';\ndefineOptions({ name: 'StatePanelPrimaryActionExample' });\nconst message = ref('');\nconst actions: readonly AsamStateAction[] = [\n\t{\n\t\tid: 'open',\n\t\tlabel: '查看记录',\n\t\tbutton: { type: 'primary', plain: false },\n\t\trun: async () => {\n\t\t\tmessage.value = '已选择查看记录';\n\t\t}\n\t},\n\t{\n\t\tid: 'back',\n\t\tlabel: '返回列表',\n\t\trun: async () => {\n\t\t\tmessage.value = '已选择返回列表';\n\t\t}\n\t}\n];\n</script>\n"
						}
					]
				},
