	"component": "AsamListRowActions",
	"demos": [
		{
			"id": "basic",
			"title": "独立行操作与溢出",
			"variants": [
				{
					"language": "ts",
					"entryName": "Demo.vue",
					"files": [
						{
							"name": "Demo.vue",
							"source": "<template>\n\t<div class=\"pro-example-stack\">\n\t\t<p>同一行四个动作，空间足够时显示两项和更多；只传当前成功结果的原行。</p>\n\t\t<div v-if=\"row\" style=\"width: 260px\">\n\t\t\t<AsamListRowActions :controller=\"list\" :row=\"row\" :actions=\"actions\" />\n\t\t</div>\n\t\t<p role=\"status\">{{ message }}</p>\n\t</div>\n</template>\n<script setup lang=\"ts\">\nimport { computed, onBeforeUnmount, ref } from 'vue';\nimport { createAsamDataRuntime } from '@asam-ui/ui';\nimport { AsamListRowActions, useAsamListController } from '@asam-ui/pro/components';\nimport type { AsamListAction } from '@asam-ui/pro/components';\ndefineOptions({ name: 'ListRowActionsExample' });\ntype Row = { id: number; name: string };\nconst runtime = createAsamDataRuntime();\nconst message = ref('尚未执行动作');\nconst list = useAsamListController<Row>({\n\truntime,\n\trowKey: 'id',\n\tinitial: {},\n\tfields: [],\n\tapi: async () => ({ list: [{ id: 0, name: '合成项目' }], total: 1 })\n});\nconst row = computed(() => list.page.data.value.list[0]);\nconst actions: readonly AsamListAction<Row>[] = ['详情', '编辑', '授权', '删除'].map(\n\t(label, index) => ({\n\t\tid: `action-${index}`,\n\t\tlabel,\n\t\tbutton: { type: index === 3 ? 'danger' : 'primary', plain: true },\n\t\trun: async ({ row }) => {\n\t\t\tmessage.value = `${label}：${row?.name}`;\n\t\t}\n\t})\n);\nonBeforeUnmount(() => runtime.invalidate());\nvoid list.submit();\n</script>\n"
						}
					]
				},
				{
					"language": "js",
					"entryName": "Demo.vue",
					"files": [
						{
							"name": "Demo.vue",
							"source": "<template>\n\t<div class=\"pro-example-stack\">\n\t\t<p>同一行四个动作，空间足够时显示两项和更多；只传当前成功结果的原行。</p>\n\t\t<div v-if=\"row\" style=\"width: 260px\">\n\t\t\t<AsamListRowActions :controller=\"list\" :row=\"row\" :actions=\"actions\" />\n\t\t</div>\n\t\t<p role=\"status\">{{ message }}</p>\n\t</div>\n</template>\n<script setup>\nimport { computed, onBeforeUnmount, ref } from 'vue';\nimport { createAsamDataRuntime } from '@asam-ui/ui';\nimport { AsamListRowActions, useAsamListController } from '@asam-ui/pro/components';\ndefineOptions({ name: 'ListRowActionsExample' });\nconst runtime = createAsamDataRuntime();\nconst message = ref('尚未执行动作');\nconst list = useAsamListController({\n\truntime,\n\trowKey: 'id',\n\tinitial: {},\n\tfields: [],\n\tapi: async () => ({ list: [{ id: 0, name: '合成项目' }], total: 1 })\n});\nconst row = computed(() => list.page.data.value.list[0]);\nconst actions = ['详情', '编辑', '授权', '删除'].map((label, index) => ({\n\tid: `action-${index}`,\n\tlabel,\n\tbutton: { type: index === 3 ? 'danger' : 'primary', plain: true },\n\trun: async ({ row }) => {\n\t\tmessage.value = `${label}：${row?.name}`;\n\t}\n}));\nonBeforeUnmount(() => runtime.invalidate());\nvoid list.submit();\n</script>\n"
