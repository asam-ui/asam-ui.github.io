					"files": [
						{
							"name": "Demo.vue",
							"source": "<template>\n\t<div class=\"pro-example-stack\">\n\t\t<AsamStructuredTable :controller=\"controller\" :columns=\"columns\" mode=\"lazy-tree\" />\n\t</div>\n</template>\n\n<script setup lang=\"ts\">\nimport { AsamStructuredTable, useAsamStructuredTable } from '@asam-ui/pro/components';\nimport { onBeforeUnmount } from 'vue';\n\ntype Project = { id: string; name: string; branch?: boolean };\nconst rows: Project[] = [{ id: 'platform', name: '平台建设', branch: true }];\nconst columns = [{ key: 'name', label: '项目名称' }] as const;\nconst controller = useAsamStructuredTable<Project>({\n\trows,\n\trowKey: 'id',\n\tscope: 'lazy-projects',\n\tmode: 'lazy-tree',\n\thasChildren: (row) => row.branch === true,\n\tloader: async (parent, { signal }) => {\n\t\tawait new Promise<void>((resolve) => setTimeout(resolve, 300));\n\t\tsignal.throwIfAborted();\n\t\treturn [{ id: `${parent.id}-review`, name: '平台建设 · 评审' }];\n\t}\n});\nonBeforeUnmount(() => controller.dispose());\n</script>\n"
						}
					]
				},
