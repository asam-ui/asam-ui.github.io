	"component": "AsamProVirtualTable",
	"demos": [
		{
			"id": "basic",
			"title": "窗口化表格",
			"variants": [
				{
					"language": "ts",
					"entryName": "Demo.vue",
					"files": [
						{
							"name": "Demo.vue",
							"source": "<template>\n\t<div class=\"pro-example-stack\">\n\t\t<div ref=\"host\" class=\"pro-example-width\">\n\t\t\t<AsamProVirtualTable\n\t\t\t\t:rows=\"rows\"\n\t\t\t\t:columns=\"columns\"\n\t\t\t\t:width=\"width\"\n\t\t\t\t:height=\"280\"\n\t\t\t\trow-key=\"id\"\n\t\t\t\tlabel=\"项目列表\"\n\t\t\t/>\n\t\t</div>\n\t</div>\n</template>\n\n<script setup lang=\"ts\">\nimport { AsamProVirtualTable } from '@asam-ui/pro/components';\nimport { onMounted, onBeforeUnmount, ref } from 'vue';\nconst host = ref<HTMLElement | null>(null);\nconst width = ref(320);\nlet observer: ResizeObserver;\nonMounted(() => {\n\tobserver = new ResizeObserver(() => {\n\t\twidth.value = host.value?.clientWidth || 320;\n\t});\n\tobserver.observe(host.value!);\n});\nonBeforeUnmount(() => observer?.disconnect());\nconst rows = Array.from({ length: 100 }, (_, i) => ({ id: i + 1, name: '项目 ' + (i + 1) }));\nconst columns = [\n\t{ key: 'id', label: '编号', width: 100 },\n\t{ key: 'name', label: '项目名称', width: 200 }\n] as const;\n</script>\n"
						}
					]
				},
