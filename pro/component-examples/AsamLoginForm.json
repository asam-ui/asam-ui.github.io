						{
							"name": "Demo.vue",
							"source": "<template>\n\t<div class=\"pro-example-stack\">\n\t\t<AsamLoginForm\n\t\t\tv-model=\"model\"\n\t\t\t:fields=\"fields\"\n\t\t\t:authenticate=\"authenticate\"\n\t\t\t@success=\"message = '登录成功'\"\n\t\t/>\n\t\t<p role=\"status\">{{ message }}</p>\n\t</div>\n</template>\n\n<script setup lang=\"ts\">\nimport { createAsamPasswordField } from '@asam-ui/pro/components';\nimport { AsamLoginForm } from '@asam-ui/pro/components';\nimport { ref } from 'vue';\nconst fields = [\n\t{ key: 'account', kind: 'text' as const, label: '账号' },\n\tcreateAsamPasswordField({ key: 'password', label: '密码' })\n];\nconst model = ref<Record<string, unknown>>({ account: '', password: '' });\nconst message = ref('');\nasync function authenticate(credentials: Readonly<Record<string, unknown>>) {\n\treturn {\n\t\tsuccess: !!credentials.account && !!credentials.password,\n\t\tmessage: '请填写账号和密码'\n\t};\n}\n</script>\n"
						}
					]
				},
