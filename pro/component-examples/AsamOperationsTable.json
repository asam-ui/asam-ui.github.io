	"component": "AsamOperationsTable",
	"demos": [
		{
			"id": "basic",
			"title": "表格与分页",
			"variants": [
				{
					"language": "ts",
					"entryName": "Demo.vue",
					"files": [
						{
							"name": "Demo.vue",
							"source": "<template>\n\t<div class=\"pro-example-stack\">\n\t\t<AsamOperationsTable\n\t\t\treadonly\n\t\t\tpagination\n\t\t\twidth-mode=\"fill\"\n\t\t\tcolumn-settings=\"popover\"\n\t\t\t:controller=\"controller\"\n\t\t\t:selection=\"selection\"\n\t\t\t:preferences=\"preferences\"\n\t\t/>\n\t</div>\n</template>\n\n<script setup lang=\"ts\">\nimport { onBeforeUnmount } from 'vue';\nimport { createAsamDataRuntime } from '@asam-ui/ui';\nimport {\n\tAsamOperationsTable,\n\tuseAsamColumnPreferences,\n\tuseAsamCrossPageSelection,\n\tuseAsamListController\n} from '@asam-ui/pro/components';\n\ntype Row = { id: number; name: string; status: string };\nconst records: Row[] = Array.from({ length: 12 }, (_, index) => ({\n\tid: index + 1,\n\tname: '项目 ' + (index + 1),\n\tstatus: '进行中'\n}));\nconst runtime = createAsamDataRuntime();\nconst controller = useAsamListController<Row>({\n\truntime,\n\trowKey: 'id',\n\tfields: [],\n\tinitial: {},\n\tpageSize: 10,\n\tapi: async ({ currentPage, pageSize }) => ({\n\t\tlist: records.slice((currentPage - 1) * pageSize, currentPage * pageSize),\n\t\ttotal: records.length\n\t})\n});\nconst columns = [\n\t{ key: 'id', label: '编号' },\n\t{ key: 'name', label: '项目名称' },\n\t{ key: 'status', label: '状态' }\n] as const;\n\nconst selection = useAsamCrossPageSelection({ controller, dataset: 'projects' });\nconst preferences = useAsamColumnPreferences<Row>({\n\tcolumns,\n\tscope: { application: 'docs', principal: 'visitor', table: 'projects', version: '1' },\n\tadapter: { load: async () => null, save: async () => {}, reset: async () => {} }\n});\nonBeforeUnmount(() => {\n\tselection.dispose();\n\tpreferences.dispose();\n\truntime.invalidate();\n});\n</script>\n"
						}
					]
				},
				{
