							"name": "Demo.vue",
							"source": "<template>\n\t<SortingDemo mode=\"rows\" />\n</template>\n\n<script setup lang=\"ts\">\nimport SortingDemo from './SortingDemo.vue';\n</script>\n"
						},
						{
							"name": "SortingDemo.vue",
							"source": "<template>\n\t<div class=\"pro-example-stack\">\n\t\t<p>{{ instructions[mode] }}</p>\n\t\t<AsamSortableTable\n\t\t\tv-model=\"rows\"\n\t\t\tv-model:column-order=\"columnOrder\"\n\t\t\trow-key=\"id\"\n\t\t\t:columns=\"columns\"\n\t\t\t:row-sortable=\"mode === 'rows'\"\n\t\t\t:column-sortable=\"mode === 'columns'\"\n\t\t\t:editable=\"false\"\n\t\t\tv-model:border=\"border\"\n\t\t\t@header-dragend=\"showWidthChange\"\n\t\t/>\n\t\t<p v-if=\"mode === 'width'\" role=\"status\">{{ widthChange }}</p>\n\t\t<p v-else>{{ orderSummary }}</p>\n\t</div>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed, shallowRef } from 'vue';\nimport { AsamSortableTable } from '@asam-ui/pro/components';\nimport type { AsamEditableColumn } from '@asam-ui/pro/components';\n\nconst props = defineProps<{ mode: 'rows' | 'columns' | 'width' }>();\ntype Row = { id: number; name: string; owner: string; status: string };\nconst instructions = {\n\trows: '聚焦行首手柄后，可按 Alt + ↑ 或 Alt + ↓ 调整位置。',\n\tcolumns: '聚焦列标题后，可按 Alt + ← 或 Alt + → 调整位置。',\n\twidth: '将鼠标移到可调整列的表头右边界，出现双向箭头后拖动。'\n};\nconst rows = shallowRef<Row[]>([\n\t{ id: 1, name: '供应链协同平台', owner: '陈晨', status: '进行中' },\n\t{ id: 2, name: '园区设备巡检', owner: '林悦', status: '待启动' },\n\t{ id: 3, name: '研发知识库升级', owner: '张远', status: '已完成' },\n\t{ id: 4, name: '客户服务工作台', owner: '陈晨', status: '进行中' }\n]);\nconst columnOrder = shallowRef(['id', 'name', 'owner', 'status']);\nconst columnDefinitions: AsamEditableColumn<Row>[] = [\n\t{ key: 'id', label: '项目编号', width: 92, fixed: 'left', draggable: false },\n\t{ key: 'name', label: '项目名称', minWidth: 220 },\n\t{ key: 'owner', label: '负责人', minWidth: 140 },\n\t{ key: 'status', label: '状态', minWidth: 140 }\n];\nconst columns = computed(() =>\n\tcolumnDefinitions.map((column) => ({\n\t\t...column,\n\t\tresizable: props.mode === 'width' && column.key !== 'id'\n\t}))\n);\nconst columnLabels = new Map<string, string>(\n\tcolumnDefinitions.map(({ key, label }) => [key, label])\n);\nconst orderSummary = computed(() =>\n\tprops.mode === 'rows'\n\t\t? '当前项目顺序：' + rows.value.map((row) => row.id).join(' → ')\n\t\t: '当前列顺序：' + columnOrder.value.map((key) => columnLabels.get(key)).join(' → ')\n);\nconst border = shallowRef(props.mode === 'width');\nconst widthChange = shallowRef('');\nfunction showWidthChange(newWidth: number, oldWidth: number) {\n\twidthChange.value = `列宽已从 ${Math.round(oldWidth)} px 调整到 ${Math.round(newWidth)} px。`;\n}\n</script>\n"
						}
					]
				},
