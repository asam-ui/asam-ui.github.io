					"files": [
						{
							"name": "Demo.vue",
							"source": "<template>\n\t<div class=\"pro-example-stack\">\n\t\t<AsamProList :controller=\"controller\" :content=\"content\" label=\"项目列表\" />\n\t</div>\n</template>\n\n<script setup lang=\"ts\">\nimport { AsamProList } from '@asam-ui/pro/components';\nimport { onBeforeUnmount } from 'vue';\nimport { createAsamDataRuntime } from '@asam-ui/ui';\nimport { useAsamListController } from '@asam-ui/pro/components';\ntype Row = { id: number; name: string; status: string };\nconst records: Row[] = Array.from({ length: 12 }, (_, index) => ({\n\tid: index + 1,\n\tname: '项目 ' + (index + 1),\n\tstatus: '进行中'\n}));\nconst runtime = createAsamDataRuntime();\nconst controller = useAsamListController<Row>({\n\truntime,\n\trowKey: 'id',\n\tfields: [{ key: 'name', label: '项目名称', kind: 'text' }],\n\tinitial: { name: '' },\n\tapi: async (request) => {\n\t\tconst rows = records.filter((row) => row.name.includes(String(request.query.name || '')));\n\t\treturn {\n\t\t\tlist: rows.slice(\n\t\t\t\t(request.currentPage - 1) * request.pageSize,\n\t\t\t\trequest.currentPage * request.pageSize\n\t\t\t),\n\t\t\ttotal: rows.length\n\t\t};\n\t}\n});\nconst columns = [\n\t{ key: 'id', label: '编号' },\n\t{ key: 'name', label: '项目名称' },\n\t{ key: 'status', label: '状态' }\n] as const;\n\nconst content = (row: Row) => ({ title: row.name, description: row.status });\n</script>\n"
						}
					]
				},
